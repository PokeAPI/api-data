        "url": "/api/v2/language/4/"
      },
      "version": {
        "name": "ultra-moon",
        "url": "/api/v2/version/30/"
      }
    },
    {
      "flavor_text": "Les algues vertes formant sa chaîne s’étendent\nsur plusieurs centaines de mètres. Il s’entend\nbien avec Venalgue.",
