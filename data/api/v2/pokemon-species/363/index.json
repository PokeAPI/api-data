      "version": {
        "name": "x",
        "url": "/api/v2/version/23/"
      }
    },
    {
      "flavor_text": "Como no saben nadar muy bien, se mueven\nrápidamente rodando. Cuando están alegres, dan\npalmadas con las aletas.",
