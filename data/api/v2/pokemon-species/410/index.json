      "version": {
        "name": "x",
        "url": "/api/v2/version/23/"
      }
    },
    {
      "flavor_text": "It habitually polishes its face by rubbing it against\ntree trunks. It is weak to attacks from behind.",
      "language": {
        "name": "en",
