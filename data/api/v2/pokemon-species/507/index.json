      },
      "version": {
        "name": "sun",
        "url": "/api/v2/version/27/"
      }
    },
    {
      "flavor_text": "Son poil long et très dur, pousse à une vitesse\nahurissante, et son toilettage coûte un bras.\nUne plaie à élever.",
      "language": {
        "name": "fr",
        "url": "/api/v2/language/5/"
      },
      "version": {
        "name": "sun",
        "url": "/api/v2/version/27/"
      }
    },
    {
      "flavor_text": "Sein dunkles Fell ist sehr widerstandsfähig und\nwächst schnell. Dadurch sind die Kosten für\ndas Trimmen sehr hoch.",
