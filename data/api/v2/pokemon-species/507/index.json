      "version": {
        "name": "sun",
        "url": "/api/v2/version/27/"
      }
    },
    {
      "flavor_text": "La folta pelliccia scura di questo Pokémon\nè estremamente resistente, quindi i prezzi della\ntoelettatura sono sempre piuttosto alti.",
