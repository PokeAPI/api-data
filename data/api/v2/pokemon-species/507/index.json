        "name": "de",
        "url": "/api/v2/language/6/"
      },
      "version": {
        "name": "sun",
        "url": "/api/v2/version/27/"
      }
    },
    {
      "flavor_text": "El recio y oscuro pelaje que le cubre el lomo\ncrece tan rápido que mantenerlo corto resulta\nde lo más caro.",
