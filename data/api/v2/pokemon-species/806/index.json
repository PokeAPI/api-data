  "pal_park_encounters": [],
  "form_descriptions": [],
  "flavor_text_entries": [
    {
      "flavor_text": "クネクネうごいて　ひとに　ちかづくと\nとつぜん　あたまを　ばくはつさせた。\nウルトラビーストの　いっしゅらしい。",
      "language": {
        "name": "ja-hrkt",
        "url": "/api/v2/language/1/"
      },
      "version": {
        "name": "ultra-sun",
        "url": "/api/v2/version/29/"
      }
    },
    {
      "flavor_text": "꿈틀거리며 사람에게 다가오다\n느닷없이 머리를 폭발시킨다.\n울트라비스트의 일종인 듯하다.",
      "language": {
        "name": "ko",
        "url": "/api/v2/language/3/"
      },
      "version": {
        "name": "ultra-sun",
        "url": "/api/v2/version/29/"
      }
    },
    {
      "flavor_text": "會扭動著身體靠近人，\n然後突然讓頭爆炸。\n似乎是究極異獸的一種。",
      "language": {
        "name": "zh-hant",
        "url": "/api/v2/language/4/"
      },
      "version": {
        "name": "ultra-sun",
        "url": "/api/v2/version/29/"
      }
    },
    {
      "flavor_text": "Il s’approche des gens avec son allure\ndésarticulée et fait subitement exploser\nsa tête. Ce serait une Ultra-Chimère.",
      "language": {
        "name": "fr",
        "url": "/api/v2/language/5/"
      },
      "version": {
        "name": "ultra-sun",
        "url": "/api/v2/version/29/"
      }
    },
    {
      "flavor_text": "Dieses Wesen ist vermutlich eine Ultrabestie.\nEs nähert sich Menschen tänzelnd, nur um dann\nplötzlich seinen Kopf explodieren zu lassen.",
      "language": {
        "name": "de",
        "url": "/api/v2/language/6/"
      },
      "version": {
        "name": "ultra-sun",
        "url": "/api/v2/version/29/"
      }
    },
    {
      "flavor_text": "Parece ser uno de los temibles Ultraentes.\nSe acerca a la gente contoneándose y hace\nexplotar su propia cabeza súbitamente.",
      "language": {
        "name": "es",
        "url": "/api/v2/language/7/"
      },
      "version": {
        "name": "ultra-sun",
        "url": "/api/v2/version/29/"
      }
    },
    {
      "flavor_text": "Sembra che sia un’Ultracreatura. Si avvicina\nalle persone ondeggiando e fa esplodere la\nsua testa all’improvviso.",
      "language": {
        "name": "it",
        "url": "/api/v2/language/8/"
      },
      "version": {
        "name": "ultra-sun",
        "url": "/api/v2/version/29/"
      }
    },
    {
      "flavor_text": "It slithers toward people. Then, without warning,\nit triggers the explosion of its own head.\nIt’s apparently one kind of Ultra Beast.",
      "language": {
        "name": "en",
        "url": "/api/v2/language/9/"
      },
      "version": {
        "name": "ultra-sun",
        "url": "/api/v2/version/29/"
      }
    },
    {
      "flavor_text": "クネクネ動いて　人に　近付くと\n突然　頭を　爆発させた。\nウルトラビーストの　一種らしい。",
      "language": {
        "name": "ja",
        "url": "/api/v2/language/11/"
      },
      "version": {
        "name": "ultra-sun",
        "url": "/api/v2/version/29/"
      }
    },
    {
      "flavor_text": "扭啊扭地移动着，\n靠近人后会突然让头爆炸。\n好像是究极异兽中的一种。",
      "language": {
        "name": "zh-hans",
        "url": "/api/v2/language/12/"
      },
      "version": {
        "name": "ultra-sun",
        "url": "/api/v2/version/29/"
      }
    },
    {
      "flavor_text": "Parece ser uno de los temibles Ultraentes.\nSe acerca a la gente contoneándose y hace\nexplotar su propia cabeza súbitamente.",
      "language": {
        "name": "es-419",
        "url": "/api/v2/language/14/"
      },
      "version": {
        "name": "ultra-sun",
        "url": "/api/v2/version/29/"
      }
    },
    {
      "flavor_text": "ウルトラホールから　あらわれたＵＢ。\nばくはつで　あいてを　おどろかし\nそのすきに　せいきを　うばっていた。",
      "language": {
        "name": "ja-hrkt",
        "url": "/api/v2/language/1/"
      },
      "version": {
        "name": "ultra-moon",
        "url": "/api/v2/version/30/"
      }
    },
    {
      "flavor_text": "울트라홀에서 나타난 UB.\n폭발로 상대를 놀라게 하고\n그 틈에 생기를 빼앗는다.",
      "language": {
        "name": "ko",
        "url": "/api/v2/language/3/"
      },
      "version": {
        "name": "ultra-moon",
        "url": "/api/v2/version/30/"
      }
    },
    {
      "flavor_text": "從究極之洞中出現的究極異獸。\n會用爆炸嚇唬對手，\n然後趁機奪取對方的精氣。",
      "language": {
        "name": "zh-hant",
        "url": "/api/v2/language/4/"
      },
      "version": {
        "name": "ultra-moon",
        "url": "/api/v2/version/30/"
      }
    },
    {
      "flavor_text": "Cette Ultra-Chimère sortie d’une Ultra-Brèche\nprovoque des explosions pour surprendre\nl’ennemi et en profite pour voler son énergie.",
      "language": {
        "name": "fr",
        "url": "/api/v2/language/5/"
      },
      "version": {
        "name": "ultra-moon",
        "url": "/api/v2/version/30/"
      }
    },
    {
      "flavor_text": "Eine Ultrabestie, die durch eine Ultrapforte kam.\nSie erschreckt ihre Gegner mit Explosionen\nund raubt ihnen dann ihre Lebenskraft.",
      "language": {
        "name": "de",
        "url": "/api/v2/language/6/"
      },
      "version": {
        "name": "ultra-moon",
        "url": "/api/v2/version/30/"
      }
    },
    {
      "flavor_text": "Un Ultraente surgido de un Ultraumbral. Crea\nuna explosión para sorprender al oponente y\naprovecha para absorber su energía vital.",
      "language": {
        "name": "es",
        "url": "/api/v2/language/7/"
      },
      "version": {
        "name": "ultra-moon",
        "url": "/api/v2/version/30/"
      }
    },
    {
      "flavor_text": "Ultracreatura arrivata attraverso un Ultravarco.\nSorprende le prede con un’esplosione e ne\napprofitta per sottrarre la loro energia vitale.",
      "language": {
        "name": "it",
        "url": "/api/v2/language/8/"
      },
      "version": {
        "name": "ultra-moon",
        "url": "/api/v2/version/30/"
      }
    },
    {
      "flavor_text": "A UB that appeared from an Ultra Wormhole, it\ncauses explosions, then takes advantage of\nopponents’ surprise to rob them of their vitality.",
      "language": {
        "name": "en",
        "url": "/api/v2/language/9/"
      },
      "version": {
        "name": "ultra-moon",
        "url": "/api/v2/version/30/"
      }
    },
    {
      "flavor_text": "ウルトラホールから　現れた　ＵＢ。\n爆発で　相手を　驚かし\nその隙に　生気を　奪っていた。",
      "language": {
        "name": "ja",
        "url": "/api/v2/language/11/"
      },
      "version": {
        "name": "ultra-moon",
        "url": "/api/v2/version/30/"
      }
    },
    {
      "flavor_text": "从究极之洞里出现的究极异兽。\n用爆炸吓唬对手，\n趁那空当夺走对方的生命气息。",
      "language": {
        "name": "zh-hans",
        "url": "/api/v2/language/12/"
      },
      "version": {
        "name": "ultra-moon",
        "url": "/api/v2/version/30/"
      }
    },
    {
