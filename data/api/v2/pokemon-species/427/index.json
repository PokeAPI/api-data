  "flavor_text_entries": [
    {
      "flavor_text": "It slams foes by sharply uncoiling\nits rolled ears. It stings enough\nto make a grown-up cry in pain.",
      "language": {
        "name": "en",
        "url": "/api/v2/language/9/"
      },
      "version": {
        "name": "diamond",
        "url": "/api/v2/version/12/"
      }
    },
    {
      "flavor_text": "When it senses danger, it perks up\nits ears. On cold nights, it sleeps\nwith its head tucked into its fur.",
      "language": {
        "name": "en",
        "url": "/api/v2/language/9/"
      },
      "version": {
        "name": "pearl",
        "url": "/api/v2/version/13/"
      }
    },
    {
      "flavor_text": "Its ears are always rolled up. They\ncan be forcefully extended to\nshatter even a large boulder.",
      "language": {
        "name": "en",
        "url": "/api/v2/language/9/"
      },
      "version": {
        "name": "platinum",
        "url": "/api/v2/version/14/"
      }
    },
    {
      "flavor_text": "You can tell how it feels by the way\nit rolls its ears. When it’s scared,\nboth ears are rolled up.",
      "language": {
