  "flavor_text_entries": [
    {
      "flavor_text": "Il vit dans le sable des déserts.\nLe sable chauffé par le soleil empêche\nson corps de refroidir.",
      "language": {
        "name": "fr",
        "url": "/api/v2/language/5/"
      },
      "version": {
        "name": "black",
        "url": "/api/v2/version/17/"
      }
    },
    {
      "flavor_text": "They live buried in the sands of the\ndesert. The sun-warmed sands prevent\ntheir body temperature from dropping.",
      "language": {
        "name": "en",
        "url": "/api/v2/language/9/"
      },
      "version": {
        "name": "black",
        "url": "/api/v2/version/17/"
      }
    },
    {
      "flavor_text": "Il se déplace dans le sable en gardant\nle nez et les yeux à découvert.\nLa membrane noire protège ses yeux.",
      "language": {
        "name": "fr",
        "url": "/api/v2/language/5/"
      },
      "version": {
        "name": "white",
        "url": "/api/v2/version/18/"
      }
    },
    {
      "flavor_text": "It moves along below the sand’s surface,\nexcept for its nose and eyes. A dark\nmembrane shields its eyes from the sun.",
      "language": {
        "name": "en",
        "url": "/api/v2/language/9/"
      },
      "version": {
        "name": "white",
        "url": "/api/v2/version/18/"
      }
    },
    {
      "flavor_text": "They live hidden under hot desert\nsands in order to keep their body\ntemperature from dropping.",
      "language": {
        "name": "en",
        "url": "/api/v2/language/9/"
      },
      "version": {
        "name": "black-2",
        "url": "/api/v2/version/21/"
      }
    },
    {
      "flavor_text": "They live hidden under hot desert\nsands in order to keep their body\ntemperature from dropping.",
      "language": {
        "name": "en",
        "url": "/api/v2/language/9/"
      },
      "version": {
        "name": "white-2",
        "url": "/api/v2/version/22/"
      }
    },
    {
      "flavor_text": "すなの　なかに　もぐり　めと　はなを\nそとに　だして　いどうする。\nくろい　まくが　めを　まもる。",
      "language": {
        "name": "ja-hrkt",
        "url": "/api/v2/language/1/"
      },
      "version": {
        "name": "x",
        "url": "/api/v2/version/23/"
      }
    },
    {
      "flavor_text": "모래 속에 파고들어 눈과 코를\n밖에 내놓고 이동한다.\n검은 막이 눈을 보호한다.",
      "language": {
        "name": "ko",
        "url": "/api/v2/language/3/"
      },
      "version": {
        "name": "x",
        "url": "/api/v2/version/23/"
      }
    },
    {
      "flavor_text": "Il se déplace dans le sable en gardant le nez et\nles yeux à découvert. La membrane noire protège\nses yeux.",
      "language": {
        "name": "fr",
        "url": "/api/v2/language/5/"
      },
      "version": {
        "name": "x",
        "url": "/api/v2/version/23/"
      }
    },
    {
      "flavor_text": "Wenn es sich durch den Sand gräbt, ragen nur\nnoch Nase und Augen hervor. Die schwarze Haut\ndient als Augenschutz.",
      "language": {
        "name": "de",
        "url": "/api/v2/language/6/"
      },
      "version": {
        "name": "x",
        "url": "/api/v2/version/23/"
      }
    },
    {
      "flavor_text": "Se desplaza hundido en la arena, dejando al\ndescubierto solo los ojos y la nariz. Una membrana\nnegra le protege los ojos.",
      "language": {
        "name": "es",
        "url": "/api/v2/language/7/"
      },
      "version": {
        "name": "x",
        "url": "/api/v2/version/23/"
      }
    },
    {
      "flavor_text": "Si nasconde sotto la sabbia e si sposta cacciando\nfuori gli occhi e il naso. Una membrana nera gli\nprotegge gli occhi.",
      "language": {
        "name": "it",
        "url": "/api/v2/language/8/"
      },
      "version": {
        "name": "x",
        "url": "/api/v2/version/23/"
      }
    },
    {
      "flavor_text": "It moves along below the sand’s surface, except\nfor its nose and eyes. A dark membrane shields its\neyes from the sun.",
      "language": {
        "name": "en",
        "url": "/api/v2/language/9/"
      },
      "version": {
        "name": "x",
        "url": "/api/v2/version/23/"
      }
    },
    {
      "flavor_text": "砂の　中に　潜り　目と　鼻を\n外に　出して　移動する。\n黒い　膜が　目を　守る。",
      "language": {
        "name": "ja",
        "url": "/api/v2/language/11/"
      },
      "version": {
        "name": "x",
        "url": "/api/v2/version/23/"
      }
    },
    {
      "flavor_text": "Se desplaza hundido en la arena, dejando al\ndescubierto solo los ojos y la nariz. Una membrana\nnegra le protege los ojos.",
      "language": {
        "name": "es-419",
        "url": "/api/v2/language/14/"
      },
      "version": {
        "name": "x",
        "url": "/api/v2/version/23/"
      }
    },
    {
      "flavor_text": "さばくの　すなの　なかで　せいかつ。\nたいように　あたためられた　すなが\nたいおんの　ていかを　ふせぐのだ。",
      "language": {
        "name": "ja-hrkt",
        "url": "/api/v2/language/1/"
      },
      "version": {
        "name": "y",
        "url": "/api/v2/version/24/"
      }
    },
    {
      "flavor_text": "사막의 모래 속에서 생활한다.\n태양 때문에 따뜻해진 모래가\n체온 저하를 막아준다.",
      "language": {
        "name": "ko",
        "url": "/api/v2/language/3/"
      },
      "version": {
        "name": "y",
        "url": "/api/v2/version/24/"
      }
    },
    {
      "flavor_text": "Il vit dans le sable des déserts. Le sable chauffé par\nle soleil empêche son corps de refroidir.",
      "language": {
        "name": "fr",
        "url": "/api/v2/language/5/"
      },
      "version": {
        "name": "y",
        "url": "/api/v2/version/24/"
      }
    },
    {
      "flavor_text": "Es lebt im Wüstensand. Der durch die Sonne erhitzte\nSand gewährleistet, dass es immer schön warm\neingepackt ist.",
      "language": {
        "name": "de",
        "url": "/api/v2/language/6/"
      },
      "version": {
        "name": "y",
        "url": "/api/v2/version/24/"
      }
    },
    {
      "flavor_text": "Vive en las arenas desérticas, donde las altas\ntemperaturas de las mismas evitan que su cuerpo\nse enfríe.",
      "language": {
        "name": "es",
        "url": "/api/v2/language/7/"
      },
      "version": {
        "name": "y",
        "url": "/api/v2/version/24/"
      }
    },
    {
      "flavor_text": "Vive nella sabbia del deserto che, scaldata dal sole,\nimpedisce alla sua temperatura corporea di scendere.",
