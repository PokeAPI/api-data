  "flavor_text_entries": [
    {
      "flavor_text": "BEAUTIFLY’s favorite food is the sweet\npollen of flowers. If you want to see\nthis POKéMON, just leave a potted\fflower by an open window. BEAUTIFLY\nis sure to come looking for pollen.",
      "language": {
        "name": "en",
        "url": "/api/v2/language/9/"
      },
      "version": {
        "name": "ruby",
        "url": "/api/v2/version/7/"
      }
    },
    {
      "flavor_text": "BEAUTIFLY has a long mouth like a coiled\nneedle, which is very convenient for\ncollecting pollen from flowers.\fThis POKéMON rides the spring winds as\nit flits around gathering pollen.",
      "language": {
        "name": "en",
        "url": "/api/v2/language/9/"
      },
      "version": {
        "name": "sapphire",
        "url": "/api/v2/version/8/"
      }
    },
    {
