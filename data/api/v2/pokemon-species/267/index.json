        "name": "ko",
        "url": "/api/v2/language/3/"
      },
      "version": {
        "name": "x",
        "url": "/api/v2/version/23/"
      }
    },
    {
      "flavor_text": "Réputé pour les motifs de ses ailes aux couleurs vives.\nIl allonge sa trompe pour butiner le nectar.",
