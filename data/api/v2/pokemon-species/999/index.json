  "flavor_text_entries": [
    {
      "flavor_text": "およそ１５００ねんまえ　たからばこのなかでうまれた。　たからを　ぬすむふらちものの　せいきを　すいとる。",
      "language": {
        "name": "ja-hrkt",
        "url": "/api/v2/language/1/"
      },
      "version": {
        "name": "scarlet",
        "url": "/api/v2/version/40/"
      }
    },
    {
      "flavor_text": "약 1500년 전의 보물 상자 안에서 태어났다. 보물을 훔치려 드는 괘씸한 자의 생기를 흡수한다.",
      "language": {
        "name": "ko",
        "url": "/api/v2/language/3/"
      },
      "version": {
        "name": "scarlet",
        "url": "/api/v2/version/40/"
      }
    },
    {
      "flavor_text": "約１５００年前出生在寶箱裡。如果有惡棍打算偷走寶藏，就會被牠吸走精氣。",
      "language": {
        "name": "zh-hant",
        "url": "/api/v2/language/4/"
      },
      "version": {
        "name": "scarlet",
        "url": "/api/v2/version/40/"
      }
    },
    {
      "flavor_text": "Ce Pokémon est né dans un coffre au trésor, il y a environ 1 500 ans. Il absorbe l’énergie vitale des voyous qui osent voler son magot.",
      "language": {
        "name": "fr",
        "url": "/api/v2/language/5/"
      },
      "version": {
        "name": "scarlet",
        "url": "/api/v2/version/40/"
      }
    },
    {
      "flavor_text": "Es entstand vor etwa 1500 Jahren in einer Schatztruhe. Wenn Diebe versuchen, den Schatz zu stehlen, saugt es ihnen die Lebensenergie aus.",
      "language": {
        "name": "de",
        "url": "/api/v2/language/6/"
      },
      "version": {
        "name": "scarlet",
        "url": "/api/v2/version/40/"
      }
    },
    {
      "flavor_text": "El cofre en el que nació data de hace 1500 años aproximadamente. Absorbe la energía vital de los granujas que intentan hacerse con su tesoro.",
      "language": {
        "name": "es",
        "url": "/api/v2/language/7/"
      },
      "version": {
        "name": "scarlet",
        "url": "/api/v2/version/40/"
      }
    },
    {
      "flavor_text": "Nacque all’interno di un forziere circa 1.500 anni fa. Assorbe l’energia vitale dei furfanti che provano a rubare il suo tesoro.",
      "language": {
        "name": "it",
        "url": "/api/v2/language/8/"
      },
      "version": {
        "name": "scarlet",
        "url": "/api/v2/version/40/"
      }
    },
    {
      "flavor_text": "This Pokémon was born inside a treasure chest about 1,500 years ago. It sucks the life-force out of scoundrels who try to steal the treasure.",
      "language": {
        "name": "en",
        "url": "/api/v2/language/9/"
      },
      "version": {
        "name": "scarlet",
        "url": "/api/v2/version/40/"
      }
    },
    {
      "flavor_text": "およそ１５００年前　宝箱の中で生まれた。　宝を　盗む不埒者の　生気を　吸い取る。",
      "language": {
        "name": "ja",
        "url": "/api/v2/language/11/"
      },
      "version": {
        "name": "scarlet",
        "url": "/api/v2/version/40/"
      }
    },
    {
      "flavor_text": "大约１５００年前在宝箱里出生。若有坏蛋打算偷走宝藏，就会被它吸走精气。",
      "language": {
        "name": "zh-hans",
        "url": "/api/v2/language/12/"
      },
      "version": {
        "name": "scarlet",
        "url": "/api/v2/version/40/"
      }
    },
    {
      "flavor_text": "El cofre en el que nació data de hace 1500 años aproximadamente. Absorbe la energía vital de los granujas que intentan hacerse con su tesoro.",
      "language": {
        "name": "es-419",
        "url": "/api/v2/language/14/"
      },
      "version": {
        "name": "scarlet",
        "url": "/api/v2/version/40/"
      }
    },
    {
      "flavor_text": "ふるびた　たからばこのなかに　すむ。ポケモンと　きづかれず　どうぐやのかたすみに　おかれていることがある。",
      "language": {
        "name": "ja-hrkt",
        "url": "/api/v2/language/1/"
      },
      "version": {
        "name": "violet",
        "url": "/api/v2/version/41/"
      }
    },
    {
      "flavor_text": "낡은 보물 상자 안에 산다. 아무도 포켓몬인 것을 눈치채지 못해 상점 구석에 전시되는 경우도 있다.",
      "language": {
        "name": "ko",
        "url": "/api/v2/language/3/"
      },
      "version": {
        "name": "violet",
        "url": "/api/v2/version/41/"
      }
    },
    {
      "flavor_text": "棲息在老舊的寶箱中。有時會因沒人注意到自己是寶可夢，而被擱置在道具店的角落。",
      "language": {
        "name": "zh-hant",
        "url": "/api/v2/language/4/"
      },
      "version": {
        "name": "violet",
        "url": "/api/v2/version/41/"
      }
    },
    {
      "flavor_text": "Il vit dans un vieux coffre au trésor. On le trouve parfois dans un coin chez l’antiquaire, quand personne ne s’est aperçu que c’était un Pokémon.",
      "language": {
        "name": "fr",
        "url": "/api/v2/language/5/"
      },
      "version": {
        "name": "violet",
        "url": "/api/v2/version/41/"
      }
    },
    {
      "flavor_text": "Es haust in einer alten Schatztruhe und landet manchmal bei Antiquitätenhändlern in der Ladenecke, da man es nicht als Pokémon erkennt.",
      "language": {
        "name": "de",
        "url": "/api/v2/language/6/"
      },
      "version": {
        "name": "violet",
        "url": "/api/v2/version/41/"
      }
    },
    {
      "flavor_text": "Vive en el interior de un viejo cofre desgastado. Al no tomarlo por un Pokémon, a veces termina a la venta por error en tiendas de antigüedades.",
      "language": {
        "name": "es",
        "url": "/api/v2/language/7/"
      },
      "version": {
        "name": "violet",
        "url": "/api/v2/version/41/"
      }
    },
    {
      "flavor_text": "Vive dentro un vecchio forziere. Non sembrando affatto un Pokémon, a volte finisce in un angolo nei negozi di strumenti.",
      "language": {
        "name": "it",
        "url": "/api/v2/language/8/"
      },
      "version": {
        "name": "violet",
        "url": "/api/v2/version/41/"
      }
    },
    {
      "flavor_text": "It lives inside an old treasure chest. Sometimes it gets left in shop corners since no one realizes it’s actually a Pokémon.",
      "language": {
        "name": "en",
        "url": "/api/v2/language/9/"
      },
      "version": {
        "name": "violet",
        "url": "/api/v2/version/41/"
      }
    },
    {
      "flavor_text": "古びた　宝箱の中に　棲む。ポケモンと　気づかれず　道具屋の片隅に　置かれていることがある。",
      "language": {
        "name": "ja",
        "url": "/api/v2/language/11/"
      },
      "version": {
        "name": "violet",
        "url": "/api/v2/version/41/"
      }
    },
    {
      "flavor_text": "栖息在老旧的宝箱中。有时会因没人注意到自己是宝可梦，而被搁置在道具店的角落。",
