  "pal_park_encounters": [],
  "form_descriptions": [],
  "flavor_text_entries": [
    {
      "flavor_text": "こだいの　うみで　くらしていた。\nゴーストポケモンとして　よみがえり\nかつての　すみかを　さまよっている。",
      "language": {
        "name": "ja-hrkt",
        "url": "/api/v2/language/1/"
      },
      "version": {
        "name": "sword",
        "url": "/api/v2/version/33/"
      }
    },
    {
      "flavor_text": "고대의 바다에 살았다.\n고스트포켓몬으로 되살아나\n과거의 보금자리를 떠돌고 있다.",
      "language": {
        "name": "ko",
        "url": "/api/v2/language/3/"
      },
      "version": {
        "name": "sword",
        "url": "/api/v2/version/33/"
      }
    },
    {
      "flavor_text": "曾經棲息在古代的大海。\n在重生為幽靈寶可夢後，\n會在昔日的住處徘徊。",
      "language": {
        "name": "zh-hant",
        "url": "/api/v2/language/4/"
      },
      "version": {
        "name": "sword",
        "url": "/api/v2/version/33/"
      }
    },
    {
      "flavor_text": "Revenu à la vie sous forme de Pokémon Spectre,\nil erre au-dessus de la mer dans laquelle il vivait\nautrefois.",
      "language": {
        "name": "fr",
        "url": "/api/v2/language/5/"
      },
      "version": {
        "name": "sword",
        "url": "/api/v2/version/33/"
      }
    },
    {
      "flavor_text": "In der Urzeit lebte es im Meer. Nun ist es als\nGeister-Pokémon wiedererwacht und irrt rastlos\ndurch seinen früheren Lebensraum.",
      "language": {
        "name": "de",
        "url": "/api/v2/language/6/"
      },
      "version": {
        "name": "sword",
        "url": "/api/v2/version/33/"
      }
    },
    {
      "flavor_text": "Habitaba los mares en tiempos inmemoriales. Ha\nrevivido en forma de Pokémon de tipo Fantasma\npara vagar por su antigua morada.",
      "language": {
        "name": "es",
        "url": "/api/v2/language/7/"
      },
      "version": {
        "name": "sword",
        "url": "/api/v2/version/33/"
      }
    },
    {
      "flavor_text": "Abitava i mari in tempi antichi. È rinato sotto\nforma di Pokémon di tipo Spettro e vaga per\nquella che un tempo era la sua dimora.",
      "language": {
        "name": "it",
        "url": "/api/v2/language/8/"
      },
      "version": {
        "name": "sword",
        "url": "/api/v2/version/33/"
      }
    },
    {
      "flavor_text": "After being reborn as a ghost Pokémon,\nDreepy wanders the areas it used to inhabit\nback when it was alive in prehistoric seas.",
      "language": {
        "name": "en",
        "url": "/api/v2/language/9/"
      },
      "version": {
        "name": "sword",
        "url": "/api/v2/version/33/"
      }
    },
    {
      "flavor_text": "古代の　海で　暮らしていた。\nゴーストポケモンとして　よみがえり\nかつての　すみかを　さまよっている。",
      "language": {
        "name": "ja",
        "url": "/api/v2/language/11/"
      },
      "version": {
        "name": "sword",
        "url": "/api/v2/version/33/"
      }
    },
    {
      "flavor_text": "曾经栖息在古代的大海。\n在重生为幽灵宝可梦后，\n会在昔日的住处徘徊。",
      "language": {
        "name": "zh-hans",
        "url": "/api/v2/language/12/"
      },
      "version": {
        "name": "sword",
        "url": "/api/v2/version/33/"
      }
    },
    {
      "flavor_text": "Habitaba los mares en tiempos inmemoriales. Ha\nrevivido en forma de Pokémon de tipo Fantasma\npara vagar por su antigua morada.",
      "language": {
        "name": "es-419",
        "url": "/api/v2/language/14/"
      },
      "version": {
        "name": "sword",
        "url": "/api/v2/version/33/"
      }
    },
    {
      "flavor_text": "１ぴきでは　こどもにも　まけるくらい\nひりきだが　なかまの　きょうりょくで\nきたえられ　しんかして　つよくなる。",
      "language": {
        "name": "ja-hrkt",
        "url": "/api/v2/language/1/"
      },
      "version": {
        "name": "shield",
        "url": "/api/v2/version/34/"
      }
    },
    {
      "flavor_text": "1마리로는 아이에게도 질 정도로\n힘이 약하지만 동료의 협력으로\n단련하고 진화하면 강해진다.",
      "language": {
        "name": "ko",
        "url": "/api/v2/language/3/"
      },
      "version": {
        "name": "shield",
        "url": "/api/v2/version/34/"
      }
    },
    {
      "flavor_text": "雖然單獨１隻弱得甚至敵不過小孩，\n但會和夥伴合作一起鍛鍊，\n透過進化而變得更強。",
      "language": {
        "name": "zh-hant",
        "url": "/api/v2/language/4/"
      },
      "version": {
        "name": "shield",
        "url": "/api/v2/version/34/"
      }
    },
    {
      "flavor_text": "Seul, il est si faible qu’il ne saurait rivaliser avec\nun enfant, mais en coopérant avec ses semblables,\nil peut devenir assez fort pour évoluer.",
      "language": {
        "name": "fr",
        "url": "/api/v2/language/5/"
      },
      "version": {
        "name": "shield",
        "url": "/api/v2/version/34/"
      }
    },
    {
      "flavor_text": "Alleine ist es sogar gegen ein Kind machtlos,\ndoch mit der Hilfe seiner Gefährten trainiert es,\nentwickelt sich und wird so stärker.",
      "language": {
        "name": "de",
        "url": "/api/v2/language/6/"
      },
      "version": {
        "name": "shield",
        "url": "/api/v2/version/34/"
      }
    },
    {
      "flavor_text": "En solitario es tan débil que no sería rival ni para\nun niño, pero, al entrenarse con sus congéneres,\nevoluciona y se vuelve más fuerte.",
      "language": {
        "name": "es",
        "url": "/api/v2/language/7/"
      },
      "version": {
        "name": "shield",
        "url": "/api/v2/version/34/"
      }
    },
    {
      "flavor_text": "Da solo è più debole di un bambino, ma se\nsi allena con l’aiuto dei suoi simili si evolve\ne diventa più forte.",
      "language": {
        "name": "it",
        "url": "/api/v2/language/8/"
      },
      "version": {
        "name": "shield",
        "url": "/api/v2/version/34/"
      }
    },
    {
      "flavor_text": "If this weak Pokémon is by itself, a mere child\ncould defeat it. But if Dreepy has friends to help\nit train, it can evolve and become much stronger.",
      "language": {
        "name": "en",
        "url": "/api/v2/language/9/"
      },
      "version": {
        "name": "shield",
        "url": "/api/v2/version/34/"
      }
    },
    {
      "flavor_text": "１匹では　子どもにも　負けるくらい\n非力だが　仲間の　協力で\n鍛えられ　進化して　強くなる。",
      "language": {
        "name": "ja",
        "url": "/api/v2/language/11/"
      },
      "version": {
        "name": "shield",
        "url": "/api/v2/version/34/"
      }
    },
    {
      "flavor_text": "虽然单独１只弱得甚至敌不过小孩，\n但会和伙伴合作一起锻炼，\n通过进化而变得更强。",
      "language": {
        "name": "zh-hans",
        "url": "/api/v2/language/12/"
      },
      "version": {
        "name": "shield",
        "url": "/api/v2/version/34/"
      }
    },
    {
      "flavor_text": "En solitario es tan débil que no sería rival ni para\nun niño, pero, al entrenarse con sus congéneres,\nevoluciona y se vuelve más fuerte.",
      "language": {
        "name": "es-419",
        "url": "/api/v2/language/14/"
      },
      "version": {
