        "name": "fr",
        "url": "/api/v2/language/5/"
      },
      "version": {
        "name": "y",
        "url": "/api/v2/version/24/"
      }
    },
    {
      "flavor_text": "Trotz seines riesigen Körpers ist es ein guter Kletterer.\nEs frisst und schläft in Baumkronen.",
      "language": {
        "name": "de",
        "url": "/api/v2/language/6/"
      },
      "version": {
        "name": "y",
        "url": "/api/v2/version/24/"
      }
    },
    {
      "flavor_text": "Aunque es muy grande, no se le da nada mal lo de\ntrepar árboles. Come y duerme en las copas.",
