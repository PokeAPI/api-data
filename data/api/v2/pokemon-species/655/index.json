      "version": {
        "name": "y",
        "url": "/api/v2/version/24/"
      }
    },
    {
      "flavor_text": "Sus poderes psíquicos le permiten controlar vórtices\nde fuego a 3000 °C que envuelven y calcinan a sus\nenemigos.",
