        "name": "fr",
        "url": "/api/v2/language/5/"
      },
      "version": {
        "name": "legends-arceus",
        "url": "/api/v2/version/39/"
      }
    },
    {
      "flavor_text": "Seine meisterhafte Handhabung der beiden Muschelklingen ist wohl auf tägliche Übungen zurückzuführen. Damit stellt es selbst die erfahrensten Schwertkämpfer in den Schatten.",
      "language": {
        "name": "de",
        "url": "/api/v2/language/6/"
      },
      "version": {
        "name": "legends-arceus",
        "url": "/api/v2/version/39/"
      }
    },
    {
      "flavor_text": "Como resultado de un duro entrenamiento diario, su manejo de las dos cuchilleiras excede incluso al de un maestro espadachín.",
