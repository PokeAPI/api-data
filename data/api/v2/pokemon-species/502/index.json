        "name": "es",
        "url": "/api/v2/language/7/"
      },
      "version": {
        "name": "legends-arceus",
        "url": "/api/v2/version/39/"
      }
    },
    {
      "flavor_text": "La sua padronanza nel brandire le duplici mollusciabole eccede quella di un mastro schermidore. La ritengo esser frutto di pratica quotidiana.",
      "language": {
        "name": "it",
        "url": "/api/v2/language/8/"
      },
      "version": {
        "name": "legends-arceus",
        "url": "/api/v2/version/39/"
      }
    },
    {
