        "url": "/api/v2/language/8/"
      },
      "version": {
        "name": "x",
        "url": "/api/v2/version/23/"
      }
    },
    {
      "flavor_text": "It was discovered when Poké Balls were\nintroduced. It is said that there is\nsome connection.",
