        "url": "/api/v2/language/9/"
      },
      "version": {
        "name": "ruby",
        "url": "/api/v2/version/7/"
      }
    },
    {
      "flavor_text": "VOLTORB is extremely sensitive - it\nexplodes at the slightest of shocks.\nIt is rumored that it was first created\fwhen a POKé BALL was exposed to a\npowerful pulse of energy.",
      "language": {
        "name": "en",
        "url": "/api/v2/language/9/"
