        "url": "/api/v2/language/7/"
      },
      "version": {
        "name": "y",
        "url": "/api/v2/version/24/"
      }
    },
    {
      "flavor_text": "È molto sensibile agli umori delle persone e degli altri\nPokémon. Se avverte ostilità, va a nascondersi.",
