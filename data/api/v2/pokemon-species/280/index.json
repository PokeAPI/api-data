      },
      "version": {
        "name": "y",
        "url": "/api/v2/version/24/"
      }
    },
    {
      "flavor_text": "Il est très sensible aux émotions des gens et\ndes Pokémon. Il se cache au moindre signe\nd’hostilité.",
