        "name": "fr",
        "url": "/api/v2/language/5/"
      },
      "version": {
        "name": "y",
        "url": "/api/v2/version/24/"
      }
    },
    {
      "flavor_text": "Es nimmt die Gefühle der Menschen und Pokémon\nmit großer Sorgfalt wahr. Spürt es Feindseligkeit,\nversteckt es sich.",
      "language": {
        "name": "de",
        "url": "/api/v2/language/6/"
      },
      "version": {
        "name": "y",
        "url": "/api/v2/version/24/"
      }
    },
    {
      "flavor_text": "Capta muy bien lo que sienten las personas y los\nPokémon. Cuando nota cierta hostilidad, se esconde.",
