  "pal_park_encounters": [],
  "form_descriptions": [],
  "flavor_text_entries": [
    {
      "flavor_text": "てづくりの　ハンマーを　ふりまわしてみを　まもるが　きんぞくを　たべるポケモンには　よく　うばわれる。",
      "language": {
        "name": "ja-hrkt",
        "url": "/api/v2/language/1/"
      },
      "version": {
        "name": "scarlet",
        "url": "/api/v2/version/40/"
      }
    },
    {
      "flavor_text": "손수 만든 해머를 휘둘러 몸을 지키려 하나 금속을 먹는 포켓몬에게 자주 빼앗기고 만다.",
      "language": {
        "name": "ko",
        "url": "/api/v2/language/3/"
      },
      "version": {
        "name": "scarlet",
        "url": "/api/v2/version/40/"
      }
    },
    {
      "flavor_text": "雖然會揮舞著手工打造的錘子來保護自己，但卻常被以金屬為食的寶可夢搶走。",
      "language": {
        "name": "zh-hant",
        "url": "/api/v2/language/4/"
      },
      "version": {
        "name": "scarlet",
        "url": "/api/v2/version/40/"
      }
    },
    {
      "flavor_text": "Il se défend en brandissant un marteau qu’il a créé lui-même, mais les Pokémon qui se nourrissent de métaux ont tendance à le lui voler.",
      "language": {
        "name": "fr",
        "url": "/api/v2/language/5/"
      },
      "version": {
        "name": "scarlet",
        "url": "/api/v2/version/40/"
      }
    },
    {
      "flavor_text": "Es schwingt seinen handgeschmiedeten Hammer, um sich zu schützen. Dieser wird ihm allerdings oft von Pokémon gestohlen, die Metall fressen.",
      "language": {
        "name": "de",
        "url": "/api/v2/language/6/"
      },
      "version": {
        "name": "scarlet",
        "url": "/api/v2/version/40/"
      }
    },
    {
      "flavor_text": "Agita su martillo forjado a mano para ahuyentar a posibles amenazas, pero los Pokémon que se alimentan a base de metal suelen robárselo.",
      "language": {
        "name": "es",
        "url": "/api/v2/language/7/"
      },
      "version": {
        "name": "scarlet",
        "url": "/api/v2/version/40/"
      }
    },
    {
      "flavor_text": "Si difende adoperando un martello che ha forgiato personalmente, anche se spesso i Pokémon ghiotti di metallo glielo rubano.",
      "language": {
        "name": "it",
        "url": "/api/v2/language/8/"
      },
      "version": {
        "name": "scarlet",
        "url": "/api/v2/version/40/"
      }
    },
    {
      "flavor_text": "It swings its handmade hammer around to protect itself, but the hammer is often stolen by Pokémon that eat metal.",
      "language": {
        "name": "en",
        "url": "/api/v2/language/9/"
      },
      "version": {
        "name": "scarlet",
        "url": "/api/v2/version/40/"
      }
    },
    {
      "flavor_text": "手作りの　ハンマーを　振りまわして身を　守るが　金属を　食べるポケモンには　よく　奪われる。",
      "language": {
        "name": "ja",
        "url": "/api/v2/language/11/"
      },
      "version": {
        "name": "scarlet",
        "url": "/api/v2/version/40/"
      }
    },
    {
      "flavor_text": "挥动手工制造的锤子来保护自己，但却经常被会吃金属的宝可梦抢走锤子。",
      "language": {
        "name": "zh-hans",
        "url": "/api/v2/language/12/"
      },
      "version": {
        "name": "scarlet",
        "url": "/api/v2/version/40/"
      }
    },
    {
      "flavor_text": "Agita su martillo forjado a mano para ahuyentar a posibles amenazas, pero los Pokémon que se alimentan a base de metal suelen robárselo.",
      "language": {
        "name": "es-419",
        "url": "/api/v2/language/14/"
      },
      "version": {
        "name": "scarlet",
        "url": "/api/v2/version/40/"
      }
    },
    {
      "flavor_text": "てつくずを　たたいて　ハンマーをつくる。　なっとくがいく　ものができるまで　なんども　つくりなおす。",
      "language": {
        "name": "ja-hrkt",
        "url": "/api/v2/language/1/"
      },
      "version": {
        "name": "violet",
        "url": "/api/v2/version/41/"
      }
    },
    {
      "flavor_text": "쇠 부스러기를 두드려 해머를 만든다. 만족스러운 물건이 나올 때까지 몇 번이고 다시 만든다.",
      "language": {
        "name": "ko",
        "url": "/api/v2/language/3/"
      },
      "version": {
        "name": "violet",
        "url": "/api/v2/version/41/"
      }
    },
    {
      "flavor_text": "敲打鐵屑來製作錘子。直到做出自己滿意的作品前，會一次又一次地重做。",
      "language": {
        "name": "zh-hant",
        "url": "/api/v2/language/4/"
      },
      "version": {
        "name": "violet",
        "url": "/api/v2/version/41/"
      }
    },
    {
      "flavor_text": "Ce Pokémon frappe des copeaux de ferraille afin de se fabriquer un marteau. Il persévère jusqu’à ce qu’il soit satisfait du résultat.",
      "language": {
        "name": "fr",
        "url": "/api/v2/language/5/"
      },
      "version": {
        "name": "violet",
        "url": "/api/v2/version/41/"
      }
    },
    {
      "flavor_text": "Es stellt seinen Hammer her, indem es Eisenspäne zusammenstampft. Diesen Vorgang wiederholt es so oft, bis es mit dem Ergebnis zufrieden ist.",
      "language": {
        "name": "de",
        "url": "/api/v2/language/6/"
      },
      "version": {
        "name": "violet",
        "url": "/api/v2/version/41/"
      }
    },
    {
      "flavor_text": "Forja su martillo golpeando residuos metálicos. Repite este proceso todas las veces que sean necesarias hasta que le satisfaga el resultado.",
      "language": {
        "name": "es",
        "url": "/api/v2/language/7/"
      },
      "version": {
        "name": "violet",
        "url": "/api/v2/version/41/"
      }
    },
    {
      "flavor_text": "Forgia il suo martello colpendo ripetutamente dei pezzi di ferraglia. Se non è soddisfatto del risultato, ricomincia più e più volte da capo.",
      "language": {
        "name": "it",
        "url": "/api/v2/language/8/"
      },
      "version": {
        "name": "violet",
        "url": "/api/v2/version/41/"
      }
    },
    {
      "flavor_text": "This Pokémon pounds iron scraps together to make a hammer. It will remake the hammer again and again until it’s satisfied with the result.",
      "language": {
        "name": "en",
        "url": "/api/v2/language/9/"
      },
      "version": {
        "name": "violet",
        "url": "/api/v2/version/41/"
      }
    },
    {
      "flavor_text": "鉄くずを　叩いて　ハンマーを作る。　納得がいく　ものができるまで　何度も　作り直す。",
      "language": {
        "name": "ja",
        "url": "/api/v2/language/11/"
      },
      "version": {
        "name": "violet",
        "url": "/api/v2/version/41/"
      }
    },
    {
      "flavor_text": "敲打铁屑来制作锤子。直到做出满意的作品前，会一遍又一遍地重做。",
      "language": {
