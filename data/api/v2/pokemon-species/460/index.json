  "flavor_text_entries": [
    {
      "flavor_text": "It whips up blizzards in mountains\nthat are always buried in snow.\nIt is the abominable snowman.",
      "language": {
        "name": "en",
        "url": "/api/v2/language/9/"
      },
      "version": {
        "name": "diamond",
        "url": "/api/v2/version/12/"
      }
    },
    {
      "flavor_text": "It blankets wide areas in snow by\nwhipping up blizzards. It is also\nknown as “The Ice Monster.”",
      "language": {
        "name": "en",
        "url": "/api/v2/language/9/"
      },
      "version": {
        "name": "pearl",
        "url": "/api/v2/version/13/"
      }
    },
    {
      "flavor_text": "They appear when the snow flowers\nbloom. When the petals fall, they\nretreat to places unknown again.",
      "language": {
        "name": "en",
        "url": "/api/v2/language/9/"
      },
      "version": {
        "name": "platinum",
        "url": "/api/v2/version/14/"
      }
    },
    {
      "flavor_text": "It lives a quiet life on mountains that\nare perpetually covered in snow.\nIt hides itself by whipping up blizzards.",
      "language": {
