      },
      "version": {
        "name": "x",
        "url": "/api/v2/version/23/"
      }
    },
    {
      "flavor_text": "Seine kurzen Arme dehnen sich aus, wenn es\nzuschlägt. Seine Technik ähnelt der von Profi-Boxern.",
