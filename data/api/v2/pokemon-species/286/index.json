        "name": "de",
        "url": "/api/v2/language/6/"
      },
      "version": {
        "name": "x",
        "url": "/api/v2/version/23/"
      }
    },
    {
      "flavor_text": "Sus cortos brazos se expanden cuando da puñetazos.\nTiene una técnica pugilística muy depurada.",
