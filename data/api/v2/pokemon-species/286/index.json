  "flavor_text_entries": [
    {
      "flavor_text": "BRELOOM closes in on its foe with light\nand sprightly footwork, then throws\npunches with its stretchy arms.\fThis POKéMON’s fighting technique puts\nboxers to shame.",
      "language": {
        "name": "en",
