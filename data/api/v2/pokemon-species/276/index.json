        "url": "/api/v2/version/7/"
      }
    },
    {
      "flavor_text": "TAILLOW is young - it has only just\nleft its nest. As a result, it sometimes\nbecomes lonesome and cries at night.\fThis POKéMON feeds on WURMPLE that\nlive in forests.",
      "language": {
        "name": "en",
        "url": "/api/v2/language/9/"
      },
      "version": {
        "name": "sapphire",
        "url": "/api/v2/version/8/"
      }
    },
    {
