  "flavor_text_entries": [
    {
      "flavor_text": "TAILLOW courageously stands its\nground against foes, however strong\nthey may be.\fThis gutsy POKéMON will remain defiant\neven after a loss. On the other hand,\nit cries loudly if it becomes hungry.",
      "language": {
        "name": "en",
