        "url": "/api/v2/language/7/"
      },
      "version": {
        "name": "x",
        "url": "/api/v2/version/23/"
      }
    },
    {
      "flavor_text": "Per il suo aspetto bizzarro, a forma di stella, c’è chi\ncrede che provenga da una meteora.",
