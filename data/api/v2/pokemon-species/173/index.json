        "name": "de",
        "url": "/api/v2/language/6/"
      },
      "version": {
        "name": "y",
        "url": "/api/v2/version/24/"
      }
    },
    {
      "flavor_text": "Muchos aparecen cuando hay estrellas fugaces en el\ncielo nocturno. Se esfuman al amanecer.",
