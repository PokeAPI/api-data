      },
      "version": {
        "name": "y",
        "url": "/api/v2/version/24/"
      }
    },
    {
      "flavor_text": "Se ne vedono molti nelle notti in cui il cielo è pieno\ndi stelle cadenti. Spariscono all’alba.",
