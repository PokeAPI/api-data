        "name": "fr",
        "url": "/api/v2/language/5/"
      },
      "version": {
        "name": "x",
        "url": "/api/v2/version/23/"
      }
    },
    {
      "flavor_text": "Sein dünner, ballonartiger Körper ist mit\nschrecklichem Giftgas gefüllt. Es verbreitet einen\nheftigen Gestank, wenn es in der Nähe ist.",
