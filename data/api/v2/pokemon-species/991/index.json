  "flavor_text_entries": [
    {
      "flavor_text": "オカルトざっしの　きじになったたいこの　ぶんめいが　うみだしたロボットに　かたちが　にている。",
      "language": {
        "name": "ja-hrkt",
        "url": "/api/v2/language/1/"
      },
      "version": {
        "name": "scarlet",
        "url": "/api/v2/version/40/"
      }
    },
    {
      "flavor_text": "오컬트 잡지의 기사에 실렸던 태곳적 문명이 만들어 냈다는 로봇과 모습이 닮았다.",
      "language": {
        "name": "ko",
        "url": "/api/v2/language/3/"
      },
      "version": {
        "name": "scarlet",
        "url": "/api/v2/version/40/"
      }
    },
    {
      "flavor_text": "身形長得很像超自然雜誌所報導的在太古時代的文明下誕生的機器人。",
      "language": {
        "name": "zh-hant",
        "url": "/api/v2/language/4/"
      },
      "version": {
        "name": "scarlet",
        "url": "/api/v2/version/40/"
      }
    },
    {
      "flavor_text": "Sa forme est similaire à celle d’un robot créé par une civilisation antique, d’après un article d’une revue consacrée aux phénomènes paranormaux.",
      "language": {
        "name": "fr",
        "url": "/api/v2/language/5/"
      },
      "version": {
        "name": "scarlet",
        "url": "/api/v2/version/40/"
      }
    },
    {
      "flavor_text": "Seine Form ähnelt der eines Roboters, der laut einem Artikel in einer esoterischen Zeitschrift von einer antiken Zivilisation erschaffen wurde.",
      "language": {
        "name": "de",
        "url": "/api/v2/language/6/"
      },
      "version": {
        "name": "scarlet",
        "url": "/api/v2/version/40/"
      }
    },
    {
      "flavor_text": "Tiene una forma similar a la del robot construido por una civilización antigua mencionado en cierto artículo de una revista esotérica.",
      "language": {
        "name": "es",
        "url": "/api/v2/language/7/"
      },
      "version": {
        "name": "scarlet",
        "url": "/api/v2/version/40/"
      }
    },
    {
      "flavor_text": "La sua forma ricorda quella di un robot descritto in un articolo di una rivista di paranormale come il prodotto di un’antica civiltà.",
      "language": {
        "name": "it",
        "url": "/api/v2/language/8/"
      },
      "version": {
        "name": "scarlet",
        "url": "/api/v2/version/40/"
      }
    },
    {
      "flavor_text": "Its shape is similar to a robot featured in a paranormal magazine article. The robot was said to have been created by an ancient civilization.",
      "language": {
        "name": "en",
        "url": "/api/v2/language/9/"
      },
      "version": {
        "name": "scarlet",
        "url": "/api/v2/version/40/"
      }
    },
    {
      "flavor_text": "オカルト雑誌の　記事になった太古の　文明が　生み出したロボットに　形が　似ている。",
      "language": {
        "name": "ja",
        "url": "/api/v2/language/11/"
      },
      "version": {
        "name": "scarlet",
        "url": "/api/v2/version/40/"
      }
    },
    {
      "flavor_text": "它的外形就像是超自然杂志所报道的诞生于太古文明的机器人。",
      "language": {
        "name": "zh-hans",
        "url": "/api/v2/language/12/"
      },
      "version": {
        "name": "scarlet",
        "url": "/api/v2/version/40/"
      }
    },
    {
      "flavor_text": "Tiene una forma similar a la del robot construido por una civilización antigua mencionado en cierto artículo de una revista esotérica.",
      "language": {
        "name": "es-419",
        "url": "/api/v2/language/14/"
      },
      "version": {
        "name": "scarlet",
        "url": "/api/v2/version/40/"
      }
    },
    {
      "flavor_text": "ふるい　しょもつに　とうじょうするなぞの　ぶったいに　にた　ポケモン。もくげきれいは　かこ　２けんのみ。",
      "language": {
        "name": "ja-hrkt",
        "url": "/api/v2/language/1/"
      },
      "version": {
        "name": "violet",
        "url": "/api/v2/version/41/"
      }
    },
    {
      "flavor_text": "오래된 서적에 등장하는 정체불명의 물체를 닮은 포켓몬. 목격된 사례는 과거에 단 2건뿐이다.",
      "language": {
        "name": "ko",
        "url": "/api/v2/language/3/"
      },
      "version": {
        "name": "violet",
        "url": "/api/v2/version/41/"
      }
    },
    {
      "flavor_text": "與古書裡記載的神秘物體長得很相像的寶可夢。過去只被目擊過２次。",
      "language": {
        "name": "zh-hant",
        "url": "/api/v2/language/4/"
      },
      "version": {
        "name": "violet",
        "url": "/api/v2/version/41/"
      }
    },
    {
      "flavor_text": "Ce Pokémon ressemble à une entité mystérieuse qui figure dans un livre ancien. On ne l’avait aperçu que deux fois jusqu’ici.",
      "language": {
        "name": "fr",
        "url": "/api/v2/language/5/"
      },
      "version": {
        "name": "violet",
        "url": "/api/v2/version/41/"
      }
    },
    {
      "flavor_text": "Es ähnelt einem rätselhaften Objekt, von dem in einer alten Schrift die Rede ist. Bisher wurde dieses Pokémon erst zwei Mal gesichtet.",
      "language": {
        "name": "de",
        "url": "/api/v2/language/6/"
      },
      "version": {
        "name": "violet",
        "url": "/api/v2/version/41/"
      }
    },
    {
      "flavor_text": "Su aspecto encaja con la descripción de un objeto mencionado en unos viejos escritos. Ha habido solo dos avistamientos hasta la fecha.",
      "language": {
        "name": "es",
        "url": "/api/v2/language/7/"
      },
      "version": {
        "name": "violet",
        "url": "/api/v2/version/41/"
      }
    },
    {
      "flavor_text": "Un Pokémon simile a un oggetto misterioso menzionato in un antico documento. È stato avvistato due sole volte in passato.",
      "language": {
        "name": "it",
        "url": "/api/v2/language/8/"
      },
      "version": {
        "name": "violet",
        "url": "/api/v2/version/41/"
      }
    },
    {
      "flavor_text": "It resembles a mysterious object mentioned in an old book. There are only two reported sightings of this Pokémon.",
      "language": {
        "name": "en",
        "url": "/api/v2/language/9/"
      },
      "version": {
        "name": "violet",
        "url": "/api/v2/version/41/"
      }
    },
    {
      "flavor_text": "古い　書物に　登場する謎の　物体に　似た　ポケモン。目撃例は　過去　２件のみ。",
      "language": {
        "name": "ja",
        "url": "/api/v2/language/11/"
      },
      "version": {
        "name": "violet",
        "url": "/api/v2/version/41/"
      }
    },
    {
      "flavor_text": "与古老的书籍中记载的神秘物体相似的宝可梦。过去只被目击过２次。",
      "language": {
        "name": "zh-hans",
        "url": "/api/v2/language/12/"
      },
      "version": {
        "name": "violet",
        "url": "/api/v2/version/41/"
