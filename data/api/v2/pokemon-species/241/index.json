        "name": "de",
        "url": "/api/v2/language/6/"
      },
      "version": {
        "name": "x",
        "url": "/api/v2/version/23/"
      }
    },
    {
      "flavor_text": "Si tiene crías, la leche que produce contiene muchos\nmás nutrientes de lo normal.",
