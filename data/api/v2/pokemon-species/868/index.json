  "flavor_text_entries": [
    {
      "flavor_text": "クリームで　できた　からだを　もつ。\nくうきちゅうの　あまい　かおりの\nせいぶんが　あつまって　うまれた。",
      "language": {
        "name": "ja-hrkt",
        "url": "/api/v2/language/1/"
      },
      "version": {
        "name": "sword",
        "url": "/api/v2/version/33/"
      }
    },
    {
      "flavor_text": "크림으로 이루어진 몸을 가졌다.\n공기 중을 떠도는 달콤한 향기의\n성분이 모여서 태어났다.",
      "language": {
        "name": "ko",
        "url": "/api/v2/language/3/"
      },
      "version": {
        "name": "sword",
        "url": "/api/v2/version/33/"
      }
    },
    {
      "flavor_text": "空氣中甜甜香氣的\n成分集中之後誕生。\n身體由鮮奶油構成。",
      "language": {
        "name": "zh-hant",
        "url": "/api/v2/language/4/"
      },
      "version": {
        "name": "sword",
        "url": "/api/v2/version/33/"
      }
    },
    {
      "flavor_text": "Son corps de crème s’est composé à partir\nde particules au parfum sucré flottant dans l’air.",
      "language": {
        "name": "fr",
        "url": "/api/v2/language/5/"
      },
      "version": {
        "name": "sword",
        "url": "/api/v2/version/33/"
      }
    },
    {
      "flavor_text": "Sein Körper besteht aus Sahne. Es entstand\naus einer Ansammlung süßer Geruchspartikel\nin der Luft.",
      "language": {
        "name": "de",
        "url": "/api/v2/language/6/"
      },
      "version": {
        "name": "sword",
        "url": "/api/v2/version/33/"
      }
    },
    {
      "flavor_text": "Su cremoso cuerpo surgió a partir de la unión\nde partículas odoríferas de dulces aromas\npresentes en el aire.",
      "language": {
        "name": "es",
        "url": "/api/v2/language/7/"
      },
      "version": {
        "name": "sword",
        "url": "/api/v2/version/33/"
      }
    },
    {
      "flavor_text": "Il suo corpo è fatto di panna. È nato dall’unione\ndi particelle di profumo dolce disperse nell’aria.",
      "language": {
        "name": "it",
        "url": "/api/v2/language/8/"
      },
      "version": {
        "name": "sword",
        "url": "/api/v2/version/33/"
      }
    },
    {
      "flavor_text": "This Pokémon was born from sweet-smelling\nparticles in the air. Its body is made of cream.",
      "language": {
        "name": "en",
        "url": "/api/v2/language/9/"
      },
      "version": {
        "name": "sword",
        "url": "/api/v2/version/33/"
      }
    },
    {
      "flavor_text": "クリームで　できた　体を　もつ。\n空気中の　甘い　香りの\n成分が　集まって　生まれた。",
      "language": {
        "name": "ja",
        "url": "/api/v2/language/11/"
      },
      "version": {
        "name": "sword",
        "url": "/api/v2/version/33/"
      }
    },
    {
      "flavor_text": "空气中甜甜香气的\n成分集中之后诞生。\n身体由鲜奶油构成。",
      "language": {
        "name": "zh-hans",
        "url": "/api/v2/language/12/"
      },
      "version": {
        "name": "sword",
        "url": "/api/v2/version/33/"
      }
    },
    {
      "flavor_text": "Su cremoso cuerpo surgió a partir de la unión\nde partículas odoríferas de dulces aromas\npresentes en el aire.",
      "language": {
        "name": "es-419",
        "url": "/api/v2/language/14/"
      },
      "version": {
        "name": "sword",
        "url": "/api/v2/version/33/"
      }
    },
    {
      "flavor_text": "マホミルが　すがたを　みせた\nパティスリーは　だいはんじょうが\nやくそく　されると　いわれている。",
      "language": {
        "name": "ja-hrkt",
        "url": "/api/v2/language/1/"
      },
      "version": {
        "name": "shield",
        "url": "/api/v2/version/34/"
      }
    },
    {
      "flavor_text": "마빌크가 모습을 보인\n디저트 가게는 크게\n번창한다고 전해지고 있다.",
      "language": {
        "name": "ko",
        "url": "/api/v2/language/3/"
      },
      "version": {
        "name": "shield",
        "url": "/api/v2/version/34/"
      }
    },
    {
      "flavor_text": "據說有小仙奶\n現身的蛋糕店\n保證能生意興隆。",
      "language": {
        "name": "zh-hant",
        "url": "/api/v2/language/4/"
      },
      "version": {
        "name": "shield",
        "url": "/api/v2/version/34/"
      }
    },
    {
      "flavor_text": "Les pâtissiers connaissent tous ce vieil adage :\nQuand Crèmy apparaît, le succès est assuré.",
      "language": {
        "name": "fr",
        "url": "/api/v2/language/5/"
      },
      "version": {
        "name": "shield",
        "url": "/api/v2/version/34/"
      }
    },
    {
      "flavor_text": "Es heißt, dass den Konditoreien, in denen sich\nHokumil zeigt, großer Wohlstand verheißen sei.",
      "language": {
        "name": "de",
        "url": "/api/v2/language/6/"
      },
      "version": {
        "name": "shield",
        "url": "/api/v2/version/34/"
      }
    },
    {
      "flavor_text": "Se dice que las pastelerías donde ha aparecido\nMilcery tienen casi todas las papeletas para\nsaborear las mieles del éxito.",
      "language": {
        "name": "es",
        "url": "/api/v2/language/7/"
      },
      "version": {
        "name": "shield",
        "url": "/api/v2/version/34/"
      }
    },
    {
      "flavor_text": "Si dice che le pasticcerie in cui è apparso\nun Milcery avranno un successo assicurato!",
      "language": {
        "name": "it",
        "url": "/api/v2/language/8/"
      },
      "version": {
        "name": "shield",
        "url": "/api/v2/version/34/"
      }
    },
    {
      "flavor_text": "They say that any patisserie visited by Milcery\nis guaranteed success and good fortune.",
      "language": {
        "name": "en",
        "url": "/api/v2/language/9/"
      },
      "version": {
        "name": "shield",
        "url": "/api/v2/version/34/"
      }
    },
    {
      "flavor_text": "マホミルが　姿を　みせた\nパティスリーは　大繁盛が\n約束されると　いわれている。",
      "language": {
        "name": "ja",
        "url": "/api/v2/language/11/"
      },
      "version": {
        "name": "shield",
        "url": "/api/v2/version/34/"
      }
    },
    {
      "flavor_text": "据说有小仙奶\n现身过的蛋糕店\n保证能生意兴隆。",
      "language": {
        "name": "zh-hans",
        "url": "/api/v2/language/12/"
      },
      "version": {
        "name": "shield",
        "url": "/api/v2/version/34/"
      }
    },
    {
      "flavor_text": "Se dice que las pastelerías donde ha aparecido\nMilcery tienen casi todas las papeletas para\nsaborear las mieles del éxito.",
      "language": {
        "name": "es-419",
        "url": "/api/v2/language/14/"
      },
      "version": {
        "name": "shield",
        "url": "/api/v2/version/34/"
      }
    },
    {
      "flavor_text": "あまい　かおりを　とりこむほどにからだは　おおきく　ふくらむがエネルギーが　へると　しぼんでいく。",
      "language": {
        "name": "ja-hrkt",
        "url": "/api/v2/language/1/"
      },
      "version": {
        "name": "scarlet",
        "url": "/api/v2/version/40/"
      }
    },
    {
      "flavor_text": "달콤한 향기를 머금을수록 몸이 크게 부풀어 오르나, 에너지를 소모하면 줄어든다.",
      "language": {
        "name": "ko",
        "url": "/api/v2/language/3/"
      },
      "version": {
        "name": "scarlet",
        "url": "/api/v2/version/40/"
      }
    },
    {
      "flavor_text": "吸取了越多的香甜氣味，身體就會膨脹得越大，但能量減少時就會逐漸縮小。",
      "language": {
        "name": "zh-hant",
        "url": "/api/v2/language/4/"
      },
      "version": {
        "name": "scarlet",
        "url": "/api/v2/version/40/"
      }
    },
    {
      "flavor_text": "Son corps gonfle à mesure qu’il absorbe des arômes sucrés, mais il se rétrécit quand il perd de l’énergie.",
      "language": {
        "name": "fr",
        "url": "/api/v2/language/5/"
      },
      "version": {
        "name": "scarlet",
        "url": "/api/v2/version/40/"
      }
    },
    {
      "flavor_text": "Je mehr süße Düfte es aufnimmt, desto weiter dehnt sich sein Körper aus. Jedoch schrumpft es zusammen, wenn sein Energielevel sinkt.",
      "language": {
        "name": "de",
        "url": "/api/v2/language/6/"
      },
      "version": {
        "name": "scarlet",
        "url": "/api/v2/version/40/"
      }
    },
    {
      "flavor_text": "Su cuerpo va aumentando de tamaño conforme absorbe aromas dulces, pero se desinfla al perder energía.",
      "language": {
        "name": "es",
        "url": "/api/v2/language/7/"
      },
      "version": {
        "name": "scarlet",
        "url": "/api/v2/version/40/"
      }
    },
    {
      "flavor_text": "Quanto più assorbe profumi dolci, tanto più si gonfia. Tuttavia, appena la sua energia diminuisce, si affloscia.",
      "language": {
        "name": "it",
        "url": "/api/v2/language/8/"
      },
      "version": {
        "name": "scarlet",
        "url": "/api/v2/version/40/"
      }
    },
    {
      "flavor_text": "The more sweet aromas it absorbs, the more its body swells. Milcery will deflate when its energy level drops.",
      "language": {
        "name": "en",
        "url": "/api/v2/language/9/"
      },
      "version": {
        "name": "scarlet",
        "url": "/api/v2/version/40/"
      }
    },
    {
      "flavor_text": "甘い　香りを　取りこむほどに体は　大きく　膨らむがエネルギーが　減ると　しぼんでいく。",
      "language": {
        "name": "ja",
        "url": "/api/v2/language/11/"
      },
      "version": {
        "name": "scarlet",
        "url": "/api/v2/version/40/"
      }
    },
    {
      "flavor_text": "吸取越多甜甜香气，身体就会胀得越大，可当能量减少时就会蔫掉。",
      "language": {
        "name": "zh-hans",
        "url": "/api/v2/language/12/"
      },
      "version": {
        "name": "scarlet",
        "url": "/api/v2/version/40/"
      }
    },
    {
      "flavor_text": "Su cuerpo va aumentando de tamaño conforme absorbe aromas dulces, pero se desinfla al perder energía.",
      "language": {
        "name": "es-419",
        "url": "/api/v2/language/14/"
      },
      "version": {
        "name": "scarlet",
        "url": "/api/v2/version/40/"
      }
    },
    {
      "flavor_text": "てきに　おそわれたら　たいあたり。クリームまみれにして　みえなくするかおいしさに　おどろかせて　にげだす。",
      "language": {
        "name": "ja-hrkt",
        "url": "/api/v2/language/1/"
      },
      "version": {
        "name": "violet",
        "url": "/api/v2/version/41/"
      }
    },
    {
      "flavor_text": "적에게 공격을 받으면 몸통박치기를 한다. 상대가 크림 범벅이 되어 앞이 보이지 않거나 달콤한 맛에 놀란 틈을 타서 도망친다.",
      "language": {
        "name": "ko",
        "url": "/api/v2/language/3/"
      },
      "version": {
        "name": "violet",
        "url": "/api/v2/version/41/"
      }
    },
    {
      "flavor_text": "遭到襲擊時，會全身撞向對手，趁著對方沾滿鮮奶油而看不見前方，或因鮮奶油的美味而愣住時迅速逃跑。",
      "language": {
        "name": "zh-hant",
        "url": "/api/v2/language/4/"
      },
      "version": {
        "name": "violet",
        "url": "/api/v2/version/41/"
      }
    },
    {
      "flavor_text": "Si on l’attaque, il charge l’adversaire et s’enfuit après l’avoir recouvert de crème pour l’aveugler ou pour le surprendre avec sa saveur délicieuse.",
      "language": {
        "name": "fr",
        "url": "/api/v2/language/5/"
      },
      "version": {
        "name": "violet",
        "url": "/api/v2/version/41/"
      }
    },
    {
      "flavor_text": "Wenn es angegriffen wird, stürzt es sich auf den Feind. Ist dieser blind vor lauter Sahne oder verblüfft vom leckeren Geschmack, flieht es.",
      "language": {
        "name": "de",
        "url": "/api/v2/language/6/"
      },
      "version": {
        "name": "violet",
        "url": "/api/v2/version/41/"
      }
    },
    {
      "flavor_text": "Si recibe un ataque, carga contra su rival y huye, ya sea gracias a haberlo cegado al recubrirlo de nata o a haberlo abrumado con su suculencia.",
      "language": {
        "name": "es",
        "url": "/api/v2/language/7/"
      },
      "version": {
        "name": "violet",
        "url": "/api/v2/version/41/"
      }
    },
    {
      "flavor_text": "Se un nemico lo attacca, gli si lancia contro e lo cosparge di panna per impedirgli di vedere o lo sorprende con la sua bontà. Poi, scappa via.",
      "language": {
        "name": "it",
        "url": "/api/v2/language/8/"
      },
      "version": {
        "name": "violet",
        "url": "/api/v2/version/41/"
      }
    },
    {
      "flavor_text": "When attacked, it tackles its foe and covers them in cream. With its foe either blinded or astonished by deliciousness, Milcery flees.",
      "language": {
        "name": "en",
        "url": "/api/v2/language/9/"
      },
      "version": {
        "name": "violet",
        "url": "/api/v2/version/41/"
      }
    },
    {
      "flavor_text": "敵に　襲われたら　たいあたり。クリームまみれにして　みえなくするかおいしさに　驚かせて　逃げだす。",
      "language": {
        "name": "ja",
        "url": "/api/v2/language/11/"
      },
      "version": {
        "name": "violet",
        "url": "/api/v2/version/41/"
      }
    },
    {
      "flavor_text": "遭到敌人袭击时会使出撞击，或是令敌人沾满奶油而封住视线，或是趁敌人惊叹美味时逃之夭夭。",
