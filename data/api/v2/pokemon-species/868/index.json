  "flavor_text_entries": [
    {
      "flavor_text": "クリームで　できた　からだを　もつ。\nくうきちゅうの　あまい　かおりの\nせいぶんが　あつまって　うまれた。",
      "language": {
        "name": "ja-hrkt",
        "url": "/api/v2/language/1/"
      },
      "version": {
        "name": "sword",
        "url": "/api/v2/version/33/"
      }
    },
    {
      "flavor_text": "크림으로 이루어진 몸을 가졌다.\n공기 중을 떠도는 달콤한 향기의\n성분이 모여서 태어났다.",
      "language": {
        "name": "ko",
        "url": "/api/v2/language/3/"
      },
      "version": {
        "name": "sword",
        "url": "/api/v2/version/33/"
      }
    },
    {
      "flavor_text": "空氣中甜甜香氣的\n成分集中之後誕生。\n身體由鮮奶油構成。",
      "language": {
        "name": "zh-hant",
        "url": "/api/v2/language/4/"
      },
      "version": {
        "name": "sword",
        "url": "/api/v2/version/33/"
      }
    },
    {
      "flavor_text": "Son corps de crème s’est composé à partir\nde particules au parfum sucré flottant dans l’air.",
      "language": {
        "name": "fr",
        "url": "/api/v2/language/5/"
      },
      "version": {
        "name": "sword",
        "url": "/api/v2/version/33/"
      }
    },
    {
      "flavor_text": "Sein Körper besteht aus Sahne. Es entstand\naus einer Ansammlung süßer Geruchspartikel\nin der Luft.",
      "language": {
        "name": "de",
        "url": "/api/v2/language/6/"
      },
      "version": {
        "name": "sword",
        "url": "/api/v2/version/33/"
      }
    },
    {
      "flavor_text": "Su cremoso cuerpo surgió a partir de la unión\nde partículas odoríferas de dulces aromas\npresentes en el aire.",
      "language": {
        "name": "es",
        "url": "/api/v2/language/7/"
      },
      "version": {
        "name": "sword",
        "url": "/api/v2/version/33/"
      }
    },
    {
      "flavor_text": "Il suo corpo è fatto di panna. È nato dall’unione\ndi particelle di profumo dolce disperse nell’aria.",
      "language": {
        "name": "it",
        "url": "/api/v2/language/8/"
      },
      "version": {
        "name": "sword",
        "url": "/api/v2/version/33/"
      }
    },
    {
      "flavor_text": "This Pokémon was born from sweet-smelling\nparticles in the air. Its body is made of cream.",
      "language": {
        "name": "en",
        "url": "/api/v2/language/9/"
      },
      "version": {
        "name": "sword",
        "url": "/api/v2/version/33/"
      }
    },
    {
      "flavor_text": "クリームで　できた　体を　もつ。\n空気中の　甘い　香りの\n成分が　集まって　生まれた。",
      "language": {
        "name": "ja",
        "url": "/api/v2/language/11/"
      },
      "version": {
        "name": "sword",
        "url": "/api/v2/version/33/"
      }
    },
    {
      "flavor_text": "空气中甜甜香气的\n成分集中之后诞生。\n身体由鲜奶油构成。",
      "language": {
        "name": "zh-hans",
        "url": "/api/v2/language/12/"
      },
      "version": {
        "name": "sword",
        "url": "/api/v2/version/33/"
      }
    },
    {
      "flavor_text": "Su cremoso cuerpo surgió a partir de la unión\nde partículas odoríferas de dulces aromas\npresentes en el aire.",
      "language": {
        "name": "es-419",
        "url": "/api/v2/language/14/"
      },
      "version": {
        "name": "sword",
        "url": "/api/v2/version/33/"
      }
    },
    {
      "flavor_text": "マホミルが　すがたを　みせた\nパティスリーは　だいはんじょうが\nやくそく　されると　いわれている。",
      "language": {
        "name": "ja-hrkt",
        "url": "/api/v2/language/1/"
      },
      "version": {
        "name": "shield",
        "url": "/api/v2/version/34/"
      }
    },
    {
      "flavor_text": "마빌크가 모습을 보인\n디저트 가게는 크게\n번창한다고 전해지고 있다.",
      "language": {
        "name": "ko",
        "url": "/api/v2/language/3/"
      },
      "version": {
        "name": "shield",
        "url": "/api/v2/version/34/"
      }
    },
    {
      "flavor_text": "據說有小仙奶\n現身的蛋糕店\n保證能生意興隆。",
      "language": {
        "name": "zh-hant",
        "url": "/api/v2/language/4/"
      },
      "version": {
        "name": "shield",
        "url": "/api/v2/version/34/"
      }
    },
    {
      "flavor_text": "Les pâtissiers connaissent tous ce vieil adage :\nQuand Crèmy apparaît, le succès est assuré.",
      "language": {
        "name": "fr",
        "url": "/api/v2/language/5/"
      },
      "version": {
        "name": "shield",
        "url": "/api/v2/version/34/"
      }
    },
    {
      "flavor_text": "Es heißt, dass den Konditoreien, in denen sich\nHokumil zeigt, großer Wohlstand verheißen sei.",
      "language": {
        "name": "de",
        "url": "/api/v2/language/6/"
      },
      "version": {
        "name": "shield",
        "url": "/api/v2/version/34/"
      }
    },
    {
      "flavor_text": "Se dice que las pastelerías donde ha aparecido\nMilcery tienen casi todas las papeletas para\nsaborear las mieles del éxito.",
      "language": {
        "name": "es",
        "url": "/api/v2/language/7/"
      },
      "version": {
        "name": "shield",
        "url": "/api/v2/version/34/"
      }
    },
    {
      "flavor_text": "Si dice che le pasticcerie in cui è apparso\nun Milcery avranno un successo assicurato!",
      "language": {
        "name": "it",
        "url": "/api/v2/language/8/"
      },
      "version": {
        "name": "shield",
        "url": "/api/v2/version/34/"
      }
    },
    {
      "flavor_text": "They say that any patisserie visited by Milcery\nis guaranteed success and good fortune.",
      "language": {
        "name": "en",
        "url": "/api/v2/language/9/"
      },
      "version": {
        "name": "shield",
        "url": "/api/v2/version/34/"
      }
    },
    {
      "flavor_text": "マホミルが　姿を　みせた\nパティスリーは　大繁盛が\n約束されると　いわれている。",
      "language": {
        "name": "ja",
        "url": "/api/v2/language/11/"
      },
      "version": {
        "name": "shield",
        "url": "/api/v2/version/34/"
      }
    },
    {
      "flavor_text": "据说有小仙奶\n现身过的蛋糕店\n保证能生意兴隆。",
      "language": {
        "name": "zh-hans",
        "url": "/api/v2/language/12/"
      },
      "version": {
        "name": "shield",
        "url": "/api/v2/version/34/"
      }
    },
    {
      "flavor_text": "Se dice que las pastelerías donde ha aparecido\nMilcery tienen casi todas las papeletas para\nsaborear las mieles del éxito.",
      "language": {
        "name": "es-419",
        "url": "/api/v2/language/14/"
      },
      "version": {
