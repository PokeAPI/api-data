      },
      "version": {
        "name": "x",
        "url": "/api/v2/version/23/"
      }
    },
    {
      "flavor_text": "Son cœur bat tellement vite que son sang bout dans\nses veines, l’empêchant de rester immobile même\nune seconde.",
      "language": {
        "name": "fr",
        "url": "/api/v2/language/5/"
      },
      "version": {
        "name": "x",
        "url": "/api/v2/version/23/"
      }
    },
    {
      "flavor_text": "Sein Puls ist konstant so hoch, dass sein Blut\nimmer in Wallung ist und es keine Sekunde\nstillhalten kann.",
