      "version": {
        "name": "x",
        "url": "/api/v2/version/23/"
      }
    },
    {
      "flavor_text": "I battiti del suo cuore sono rapidissimi e il suo\nsangue scorre con tale impeto che non riesce a\nstare fermo un istante.",
