      "version": {
        "name": "x",
        "url": "/api/v2/version/23/"
      }
    },
    {
      "flavor_text": "Su corazón palpita a un ritmo frenético, haciendo que\nsu sangre bulla, así que no puede estarse quieto ni un\nsegundo.",
