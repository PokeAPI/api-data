      },
      "version": {
        "name": "y",
        "url": "/api/v2/version/24/"
      }
    },
    {
      "flavor_text": "Würde es sich nicht bewegen, würde sein Stress\nunerträglich und es ginge ihm augenblicklich\nschlechter.",
