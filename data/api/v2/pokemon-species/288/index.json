        "name": "ko",
        "url": "/api/v2/language/3/"
      },
      "version": {
        "name": "y",
        "url": "/api/v2/version/24/"
      }
    },
    {
      "flavor_text": "Quand il ne bouge pas, il accumule du stress et\ndevient très irritable.",
