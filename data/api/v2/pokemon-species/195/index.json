      },
      "version": {
        "name": "x",
        "url": "/api/v2/version/23/"
      }
    },
    {
      "flavor_text": "Ein träges Pokémon, das auf dem Grund des Flusses\nliegt und wartet, dass ihm Beute ins Maul schwimmt.",
