        "name": "de",
        "url": "/api/v2/language/6/"
      },
      "version": {
        "name": "x",
        "url": "/api/v2/version/23/"
      }
    },
    {
      "flavor_text": "Su cuerpo es tan ligero, que debe agarrarse bien al\nsuelo con las patas para no irse con el viento.",
