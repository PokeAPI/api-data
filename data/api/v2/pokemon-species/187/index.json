      },
      "version": {
        "name": "x",
        "url": "/api/v2/version/23/"
      }
    },
    {
      "flavor_text": "Son corps est si léger qu’il doit s’agripper au sol pour\néviter de s’envoler les jours de brise.",
      "language": {
        "name": "fr",
        "url": "/api/v2/language/5/"
      },
      "version": {
        "name": "x",
        "url": "/api/v2/version/23/"
      }
    },
    {
      "flavor_text": "Sein Körper ist so leicht, dass es seine Füße im\nBoden verankert, damit es nicht davongeweht wird.",
