        "name": "fr",
        "url": "/api/v2/language/5/"
      },
      "version": {
        "name": "scarlet",
        "url": "/api/v2/version/40/"
      }
    },
    {
      "flavor_text": "Ein extrem seltenes Erz, das in Vulkanregionen zu finden ist, löste seine Entwicklung aus, bei der Teile seines Körpers zu Stein wurden.",
      "language": {
        "name": "de",
        "url": "/api/v2/language/6/"
      },
      "version": {
        "name": "scarlet",
        "url": "/api/v2/version/40/"
      }
    },
    {
      "flavor_text": "Gracias a un mineral extremadamente escaso que se encuentra en zonas volcánicas, parte de su cuerpo se volvió pétreo al evolucionar.",
