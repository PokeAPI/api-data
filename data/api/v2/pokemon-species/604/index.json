      "version": {
        "name": "y",
        "url": "/api/v2/version/24/"
      }
    },
    {
      "flavor_text": "Es schleppt sich mithilfe seiner Arme an Land,\nschnappt nach seiner Beute und zerrt sie\naugenblicklich ins Meer.",
