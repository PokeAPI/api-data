        "name": "ko",
        "url": "/api/v2/language/3/"
      },
      "version": {
        "name": "y",
        "url": "/api/v2/version/24/"
      }
    },
    {
      "flavor_text": "Il peut sortir de l’eau à la force de ses bras pour\nattraper des proies sur la rive. Il retourne à l’eau\nen un instant.",
