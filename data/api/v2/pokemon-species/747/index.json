        "url": "/api/v2/version/34/"
      }
    },
    {
      "flavor_text": "Im Gegensatz zu den Garstella in Alola haben\ndie der Galar-Region noch nicht bemerkt, wie\nköstlich die Arme von Corasonn sind.",
      "language": {
        "name": "de",
        "url": "/api/v2/language/6/"
