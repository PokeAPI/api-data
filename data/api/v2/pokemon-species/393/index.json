        "name": "de",
        "url": "/api/v2/language/6/"
      },
      "version": {
        "name": "y",
        "url": "/api/v2/version/24/"
      }
    },
    {
      "flavor_text": "Es muy orgulloso, por lo que odia aceptar comida de\nla gente. Su grueso plumón lo protege del frío.",
