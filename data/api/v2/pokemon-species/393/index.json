        "name": "fr",
        "url": "/api/v2/language/5/"
      },
      "version": {
        "name": "y",
        "url": "/api/v2/version/24/"
      }
    },
    {
      "flavor_text": "Es ist sehr stolz und nimmt daher kein Futter von\nanderen an. Seine dicken Daunen schützen vor Kälte.",
