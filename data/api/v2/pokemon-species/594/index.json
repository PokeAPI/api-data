      },
      "version": {
        "name": "black",
        "url": "/api/v2/version/17/"
      }
    },
    {
      "flavor_text": "Il vit en dérivant dans les grands\nocéans. Quand il trouve des Pokémon\nblessés, il les ramène jusqu’à la côte.",
