      },
      "version": {
        "name": "ultra-moon",
        "url": "/api/v2/version/30/"
      }
    },
    {
      "flavor_text": "電気を　作る　力は　あまり\n強くないので　かみなりを　浴びて\n充電　するぞ。",
      "language": {
        "name": "ja",
        "url": "/api/v2/language/11/"
