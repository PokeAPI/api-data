      }
    },
    {
      "flavor_text": "せなかの　ながい　けで　かみなりや\nでんきポケモンの　でんげきを　うけて\nでんきぶくろに　じゅうでんする。",
      "language": {
        "name": "ja-hrkt",
        "url": "/api/v2/language/1/"
      },
      "version": {
