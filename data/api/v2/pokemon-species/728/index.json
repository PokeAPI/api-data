        "name": "it",
        "url": "/api/v2/language/8/"
      },
      "version": {
        "name": "moon",
        "url": "/api/v2/version/28/"
      }
    },
    {
      "flavor_text": "This Pokémon can control water bubbles. It\npractices diligently so it can learn to make\nbig bubbles.",
