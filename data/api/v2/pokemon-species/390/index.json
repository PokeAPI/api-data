        "name": "ko",
        "url": "/api/v2/language/3/"
      },
      "version": {
        "name": "x",
        "url": "/api/v2/version/23/"
      }
    },
    {
      "flavor_text": "La flamme de sa queue est alimentée par un gaz de\nson estomac. Même la pluie ne saurait l’éteindre.",
