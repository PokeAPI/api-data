        "name": "fr",
        "url": "/api/v2/language/5/"
      },
      "version": {
        "name": "x",
        "url": "/api/v2/version/23/"
      }
    },
    {
      "flavor_text": "Auf gerader Strecke erreicht es mühelos 100 km/h.\nNur die Kurven bereiten ihm große Schwierigkeiten.",
