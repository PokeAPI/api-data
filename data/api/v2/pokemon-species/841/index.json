      "version": {
        "name": "violet",
        "url": "/api/v2/version/41/"
      }
    },
    {
      "flavor_text": "Schäden an seinem Apfel repariert es mit seiner Körperflüssigkeit. Die Äpfel von kampferprobten Drapfel sind lehmfarben.",
      "language": {
        "name": "de",
        "url": "/api/v2/language/6/"
      },
      "version": {
