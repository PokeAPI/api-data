        "name": "violet",
        "url": "/api/v2/version/41/"
      }
    },
    {
      "flavor_text": "Il renforce sa pomme avec ses fluides corporels. Les pommes des spécimens qui ont vaincu de nombreux ennemis prennent une couleur terreuse.",
      "language": {
        "name": "fr",
        "url": "/api/v2/language/5/"
