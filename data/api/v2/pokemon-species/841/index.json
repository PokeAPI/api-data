      "version": {
        "name": "violet",
        "url": "/api/v2/version/41/"
      }
    },
    {
      "flavor_text": "會用體液修補蘋果。身經百戰的強者，蘋果會佈滿黏土色。",
      "language": {
        "name": "zh-hant",
        "url": "/api/v2/language/4/"
