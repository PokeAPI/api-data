        "url": "/api/v2/language/9/"
      },
      "version": {
        "name": "pearl",
        "url": "/api/v2/version/13/"
      }
    },
    {
      "flavor_text": "It brought rains by opening portals\nto another world. It was revered\nas a bringer of plentiful harvests.",
