  "pal_park_encounters": [],
  "form_descriptions": [],
  "flavor_text_entries": [
    {
      "flavor_text": "ほかの　ポケモンが　みつけた　エサを\nかすめて　くらしている。　ふかふかの\nにくきゅうは　あしおとを　たてない。",
      "language": {
        "name": "ja-hrkt",
        "url": "/api/v2/language/1/"
      },
      "version": {
        "name": "sword",
        "url": "/api/v2/version/33/"
      }
    },
    {
      "flavor_text": "다른 포켓몬이 발견한 먹이를\n훔치며 산다. 푹신푹신한\n볼록살 덕분에 발소리가 나지 않는다.",
      "language": {
        "name": "ko",
        "url": "/api/v2/language/3/"
      },
      "version": {
        "name": "sword",
        "url": "/api/v2/version/33/"
      }
    },
    {
      "flavor_text": "靠搶奪其他寶可夢找到的食物\n為生。腳上長著軟乎乎的肉球，\n走路時不會發出絲毫聲響。",
      "language": {
        "name": "zh-hant",
        "url": "/api/v2/language/4/"
      },
      "version": {
        "name": "sword",
        "url": "/api/v2/version/33/"
      }
    },
    {
      "flavor_text": "Il vit en subtilisant la nourriture des autres\nPokémon. Grâce à ses coussinets moelleux,\nil ne fait aucun bruit quand il marche.",
      "language": {
        "name": "fr",
        "url": "/api/v2/language/5/"
      },
      "version": {
        "name": "sword",
        "url": "/api/v2/version/33/"
      }
    },
    {
      "flavor_text": "Es stibitzt Futter, das andere Pokémon gefunden\nhaben. Dank der samtweichen Ballen an seinen\nPfoten ist sein Gang lautlos.",
      "language": {
        "name": "de",
        "url": "/api/v2/language/6/"
      },
      "version": {
        "name": "sword",
        "url": "/api/v2/version/33/"
      }
    },
    {
      "flavor_text": "Se sustenta con el alimento que roba a otros\nPokémon. Las almohadillas de sus patas son tan\nblandas que no hace ningún ruido al caminar.",
      "language": {
        "name": "es",
        "url": "/api/v2/language/7/"
      },
      "version": {
        "name": "sword",
        "url": "/api/v2/version/33/"
      }
    },
    {
      "flavor_text": "Vive rubando il cibo trovato dagli altri Pokémon.\nI morbidi cuscinetti plantari rendono i suoi passi\nsilenziosi.",
      "language": {
        "name": "it",
        "url": "/api/v2/language/8/"
      },
      "version": {
        "name": "sword",
        "url": "/api/v2/version/33/"
      }
    },
    {
      "flavor_text": "Aided by the soft pads on its feet, it silently raids\nthe food stores of other Pokémon. It survives off\nits ill-gotten gains.",
      "language": {
        "name": "en",
        "url": "/api/v2/language/9/"
      },
      "version": {
        "name": "sword",
        "url": "/api/v2/version/33/"
      }
    },
    {
      "flavor_text": "ほかの　ポケモンが　みつけた　餌を\n掠めて　暮らしている。　ふかふかの\n肉球は　足音を　たてない。",
      "language": {
        "name": "ja",
        "url": "/api/v2/language/11/"
      },
      "version": {
        "name": "sword",
        "url": "/api/v2/version/33/"
      }
    },
    {
      "flavor_text": "靠抢夺其他宝可梦找到的食物\n为生。脚上长着软乎乎的肉球，\n走路时不会发出丝毫声响。",
      "language": {
        "name": "zh-hans",
        "url": "/api/v2/language/12/"
      },
      "version": {
        "name": "sword",
        "url": "/api/v2/version/33/"
      }
    },
    {
      "flavor_text": "Se sustenta con el alimento que roba a otros\nPokémon. Las almohadillas de sus patas son tan\nblandas que no hace ningún ruido al caminar.",
      "language": {
        "name": "es-419",
        "url": "/api/v2/language/14/"
      },
      "version": {
        "name": "sword",
        "url": "/api/v2/version/33/"
      }
    },
    {
      "flavor_text": "ようじん　ぶかく　ずるがしこい。\nエサを　ぬすむと　しっぽで\nあしあとを　けしながら　にげるのだ。",
      "language": {
        "name": "ja-hrkt",
        "url": "/api/v2/language/1/"
      },
      "version": {
        "name": "shield",
        "url": "/api/v2/version/34/"
      }
    },
    {
      "flavor_text": "조심성이 많고 교활하다.\n먹이를 훔치고는 꼬리로\n발자국을 지우며 도망간다.",
      "language": {
        "name": "ko",
        "url": "/api/v2/language/3/"
      },
      "version": {
        "name": "shield",
        "url": "/api/v2/version/34/"
      }
    },
    {
      "flavor_text": "性情謹慎且狡猾。\n在偷盜食物逃走的時候\n會用尾巴擦掉自己的足跡。",
      "language": {
        "name": "zh-hant",
        "url": "/api/v2/language/4/"
      },
      "version": {
        "name": "shield",
        "url": "/api/v2/version/34/"
      }
    },
    {
      "flavor_text": "Rusé et vigilant, il prend la poudre d’escampette\naprès avoir volé de la nourriture en prenant soin\nd’effacer ses traces de pas avec sa queue.",
      "language": {
        "name": "fr",
        "url": "/api/v2/language/5/"
      },
      "version": {
        "name": "shield",
        "url": "/api/v2/version/34/"
      }
    },
    {
      "flavor_text": "Es ist sehr vorsichtig und gerissen. Nachdem es\nFutter stibitzt hat, macht es sich davon und\nverwischt dabei seine Spuren mit seinem Schweif.",
      "language": {
        "name": "de",
        "url": "/api/v2/language/6/"
      },
      "version": {
        "name": "shield",
        "url": "/api/v2/version/34/"
      }
    },
    {
      "flavor_text": "Prudente y astuto, borra con la cola las huellas\nque deja al huir tras robarle el alimento a otro\nPokémon.",
      "language": {
        "name": "es",
        "url": "/api/v2/language/7/"
      },
      "version": {
        "name": "shield",
        "url": "/api/v2/version/34/"
      }
    },
    {
      "flavor_text": "È scaltro e molto prudente. Quando ruba\nil cibo, scappa cancellando le sue orme\ncon la coda.",
      "language": {
        "name": "it",
        "url": "/api/v2/language/8/"
      },
      "version": {
        "name": "shield",
        "url": "/api/v2/version/34/"
      }
    },
    {
      "flavor_text": "Cunning and cautious, this Pokémon survives by\nstealing food from others. It erases its tracks with\nswipes of its tail as it makes off with its plunder.",
      "language": {
        "name": "en",
        "url": "/api/v2/language/9/"
      },
      "version": {
        "name": "shield",
        "url": "/api/v2/version/34/"
      }
    },
    {
      "flavor_text": "用心深く　ずる賢い。\nエサを　盗むと　しっぽで\n足跡を　消しながら　逃げるのだ。",
      "language": {
        "name": "ja",
        "url": "/api/v2/language/11/"
      },
      "version": {
        "name": "shield",
        "url": "/api/v2/version/34/"
      }
    },
    {
      "flavor_text": "性格谨慎且狡猾。\n在偷盗食物逃走的时候\n会用尾巴擦掉自己的足迹。",
      "language": {
        "name": "zh-hans",
        "url": "/api/v2/language/12/"
      },
      "version": {
        "name": "shield",
        "url": "/api/v2/version/34/"
      }
    },
    {
      "flavor_text": "Prudente y astuto, borra con la cola las huellas\nque deja al huir tras robarle el alimento a otro\nPokémon.",
      "language": {
