    },
    {
      "flavor_text": "栖息在臭氧层，成为了\n更强大的宝可梦的食物。\n会在逃跑的过程中掉落到地上。",
      "language": {
        "name": "zh-hans",
        "url": "/api/v2/language/12/"
      },
      "version": {
        "name": "ultra-sun",
        "url": "/api/v2/version/29/"
