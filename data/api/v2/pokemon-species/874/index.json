      "version": {
        "name": "scarlet",
        "url": "/api/v2/version/40/"
      }
    },
    {
      "flavor_text": "Sein Körper setzt sich aus Steinen zusammen, die mit dem Grundgestein einer weit von seinem Lebensraum entfernten Gegend identisch sind.",
      "language": {
        "name": "de",
        "url": "/api/v2/language/6/"
      },
      "version": {
        "name": "scarlet",
        "url": "/api/v2/version/40/"
      }
    },
    {
