        "url": "/api/v2/language/5/"
      },
      "version": {
        "name": "black",
        "url": "/api/v2/version/17/"
      }
    },
    {
      "flavor_text": "Upon finding a small Pokémon, it weaves\nclothing for it from leaves, using the\ncutters on its arms and sticky silk.",
