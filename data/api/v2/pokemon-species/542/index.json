        "url": "/api/v2/language/3/"
      },
      "version": {
        "name": "x",
        "url": "/api/v2/version/23/"
      }
    },
    {
      "flavor_text": "Il fabrique des vêtements de feuilles pour les\nPokémon encore jeunes grâce à son fil de soie\nadhésif.",
