        "name": "fr",
        "url": "/api/v2/language/5/"
      },
      "version": {
        "name": "y",
        "url": "/api/v2/version/24/"
      }
    },
    {
      "flavor_text": "Man sagt, es zeigt sich nur gutherzigen und\neinfühlsamen Menschen. Es überschüttet sie\nmit Freude.",
