        "url": "/api/v2/language/5/"
      },
      "version": {
        "name": "x",
        "url": "/api/v2/version/23/"
      }
    },
    {
      "flavor_text": "Während es schläft, hält sein Schweif Wache.\nDieser benötigt keinen Schlaf.",
