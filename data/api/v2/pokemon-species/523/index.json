        "name": "fr",
        "url": "/api/v2/language/5/"
      },
      "version": {
        "name": "x",
        "url": "/api/v2/version/23/"
      }
    },
    {
      "flavor_text": "Ein stürmischer Geselle. Wenn es wütend ist,\nfeuert es über seine Mähne in alle Richtungen\nStromsalven ab.",
