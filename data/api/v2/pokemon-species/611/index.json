  "flavor_text_entries": [
    {
      "flavor_text": "Comme ses crocs brisés ne repoussent\npas, il les aiguise après le combat grâce\nà une pierre ramassée près d’un fleuve.",
      "language": {
        "name": "fr",
        "url": "/api/v2/language/5/"
      },
      "version": {
        "name": "black",
        "url": "/api/v2/version/17/"
      }
    },
    {
      "flavor_text": "Since a broken tusk will not grow back,\nthey diligently sharpen their tusks on\nriver rocks after they’ve been fighting.",
      "language": {
        "name": "en",
        "url": "/api/v2/language/9/"
      },
      "version": {
        "name": "black",
        "url": "/api/v2/version/17/"
      }
    },
    {
      "flavor_text": "Leurs crocs peuvent découper des\nrochers. Leurs querelles de territoire\nsont extrêmement violentes.",
