        "url": "/api/v2/language/5/"
      },
      "version": {
        "name": "white",
        "url": "/api/v2/version/18/"
      }
    },
    {
      "flavor_text": "Their tusks can shatter rocks.\nTerritory battles between Fraxure\ncan be intensely violent.",
