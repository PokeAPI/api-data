        "name": "it",
        "url": "/api/v2/language/8/"
      },
      "version": {
        "name": "ultra-sun",
        "url": "/api/v2/version/29/"
      }
    },
    {
      "flavor_text": "They can often be seen in packs in the morning,\nslowly moving their bodies through a series\nof poses.",
