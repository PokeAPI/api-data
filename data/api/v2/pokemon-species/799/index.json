        "url": "/api/v2/version/30/"
      }
    },
    {
      "flavor_text": "Cette créature inconnue appelée\n« Ultra-Chimère » semble constamment\naffamée : elle mange en permanence.",
      "language": {
        "name": "fr",
        "url": "/api/v2/language/5/"
      },
      "version": {
        "name": "ultra-moon",
        "url": "/api/v2/version/30/"
      }
    },
    {
      "flavor_text": "Eine unbekannte Lebensform, die zu den\nUltrabestien gehört. Sie scheint immer hungrig\nzu sein, da sie ununterbrochen frisst.",
      "language": {
        "name": "de",
        "url": "/api/v2/language/6/"
      },
      "version": {
        "name": "ultra-moon",
        "url": "/api/v2/version/30/"
      }
    },
    {
      "flavor_text": "Uno de los extraños Ultraentes. Siempre está\ncomiendo algo, como poseído de un hambre\ninsaciable.",
      "language": {
