      },
      "version": {
        "name": "scarlet",
        "url": "/api/v2/version/40/"
      }
    },
    {
      "flavor_text": "Mithilfe der langen Zunge, die es um seinen Hals gewickelt hat, kann es Luftströme spüren und so die Präsenz verborgener Gegner erahnen.",
      "language": {
        "name": "de",
