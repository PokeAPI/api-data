        "name": "it",
        "url": "/api/v2/language/8/"
      },
      "version": {
        "name": "x",
        "url": "/api/v2/version/23/"
      }
    },
    {
      "flavor_text": "Since they have two divided brains, at times they\nsuddenly try to take two different actions at once.",
      "language": {
        "name": "en",
        "url": "/api/v2/language/9/"
      },
