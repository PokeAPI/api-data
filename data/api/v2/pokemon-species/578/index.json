  "flavor_text_entries": [
    {
      "flavor_text": "Il possède deux cerveaux séparés\nqui le font parfois agir de façon\ntotalement incohérente.",
      "language": {
        "name": "fr",
        "url": "/api/v2/language/5/"
      },
      "version": {
        "name": "black",
        "url": "/api/v2/version/17/"
      }
    },
    {
      "flavor_text": "Since they have two divided brains,\nat times they suddenly try to take two\ndifferent actions at once.",
      "language": {
        "name": "en",
        "url": "/api/v2/language/9/"
      },
      "version": {
        "name": "black",
        "url": "/api/v2/version/17/"
      }
    },
    {
      "flavor_text": "Il dégage sa puissance maximale\nquand ses cerveaux réfléchissent\nà la même chose.",
      "language": {
        "name": "fr",
        "url": "/api/v2/language/5/"
      },
      "version": {
        "name": "white",
        "url": "/api/v2/version/18/"
      }
    },
    {
      "flavor_text": "When their brains, now divided in two,\nare thinking the same thoughts, these\nPokémon exhibit their maximum power.",
      "language": {
        "name": "en",
        "url": "/api/v2/language/9/"
      },
      "version": {
        "name": "white",
        "url": "/api/v2/version/18/"
      }
    },
    {
      "flavor_text": "When their two divided brains\nthink the same thoughts,\ntheir psychic power is maximized.",
      "language": {
        "name": "en",
        "url": "/api/v2/language/9/"
      },
      "version": {
        "name": "black-2",
        "url": "/api/v2/version/21/"
      }
    },
    {
      "flavor_text": "When their two divided brains\nthink the same thoughts,\ntheir psychic power is maximized.",
