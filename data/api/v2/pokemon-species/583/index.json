      "version": {
        "name": "sun",
        "url": "/api/v2/version/27/"
      }
    },
    {
      "flavor_text": "Son corps fond les jours de canicule. Il suffit\nheureusement de le congeler pour qu’il reprenne\nforme, mais il restera un tantinet flagada.",
