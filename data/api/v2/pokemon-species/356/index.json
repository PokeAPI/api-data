        "name": "ja",
        "url": "/api/v2/language/11/"
      },
      "version": {
        "name": "legends-arceus",
        "url": "/api/v2/version/39/"
      }
    },
    {
      "flavor_text": "全身被绷带所包裹。传闻若试图去窥看绷带内侧，就会被吸进绷带缝隙里永远失踪。由于太过可怕，本人不敢确认传闻是否属实。",
      "language": {
