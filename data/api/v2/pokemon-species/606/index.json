  "flavor_text_entries": [
    {
      "flavor_text": "Il peut manipuler les souvenirs de\nses ennemis et fait clignoter ses doigts\ntricolores pour discuter avec ses amis.",
      "language": {
        "name": "fr",
        "url": "/api/v2/language/5/"
      },
      "version": {
        "name": "black",
        "url": "/api/v2/version/17/"
      }
    },
    {
      "flavor_text": "It can manipulate an opponent’s memory.\nApparently, it communicates by flashing\nits three different-colored fingers.",
      "language": {
        "name": "en",
        "url": "/api/v2/language/9/"
      },
      "version": {
        "name": "black",
        "url": "/api/v2/version/17/"
      }
    },
    {
      "flavor_text": "Il manipule l’esprit avec ses pouvoirs\npsychiques et peut modifier les images\nconservées dans les souvenirs.",
