        "name": "de",
        "url": "/api/v2/language/6/"
      },
      "version": {
        "name": "y",
        "url": "/api/v2/version/24/"
      }
    },
    {
      "flavor_text": "Antiguamente, estos Pokémon desempeñaban el\ncometido de guardián del rey en la región de Kalos.",
