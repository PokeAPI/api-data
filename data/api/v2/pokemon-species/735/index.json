      "version": {
        "name": "ultra-moon",
        "url": "/api/v2/version/30/"
      }
    },
    {
      "flavor_text": "È un Pokémon molto paziente, ma quando\ntrova un Rattata, di cui va pazzo, perde\nil controllo e lo assale.",
      "language": {
