      "version": {
        "name": "x",
        "url": "/api/v2/version/23/"
      }
    },
    {
      "flavor_text": "It claws if displeased and purrs when affectionate.\nIts fickleness is very popular among some.",
      "language": {
        "name": "en",
        "url": "/api/v2/language/9/"
      },
      "version": {
        "name": "x",
        "url": "/api/v2/version/23/"
