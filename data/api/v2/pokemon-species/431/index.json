        "name": "ko",
        "url": "/api/v2/language/3/"
      },
      "version": {
        "name": "x",
        "url": "/api/v2/version/23/"
      }
    },
    {
      "flavor_text": "Il griffe quand il est en colère et ronronne quand\nil est heureux. Certains aiment ce côté lunatique.",
      "language": {
        "name": "fr",
        "url": "/api/v2/language/5/"
      },
      "version": {
        "name": "x",
        "url": "/api/v2/version/23/"
      }
    },
    {
      "flavor_text": "Es schlägt mit Krallen zu oder schnurrt,\nje nachdem, ob es gerade wütend oder zutraulich ist.",
      "language": {
        "name": "de",
        "url": "/api/v2/language/6/"
      },
      "version": {
        "name": "x",
        "url": "/api/v2/version/23/"
      }
    },
    {
      "flavor_text": "Araña cuando está enfadado y ronronea cuando está\ncariñoso. Su imprevisibilidad es famosa.",
