        "url": "/api/v2/language/7/"
      },
      "version": {
        "name": "x",
        "url": "/api/v2/version/23/"
      }
    },
    {
      "flavor_text": "La sua grande vitalità gli permette di adattarsi e\nproliferare anche nelle acque dei fiumi più inquinati.",
