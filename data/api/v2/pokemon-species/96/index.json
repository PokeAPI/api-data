      "version": {
        "name": "y",
        "url": "/api/v2/version/24/"
      }
    },
    {
      "flavor_text": "Si vous pensez avoir rêvé mais que vous ne vous en\nsouvenez pas, c’est que Soporifik a tout mangé.",
