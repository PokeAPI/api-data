  "flavor_text_entries": [
    {
      "flavor_text": "Il se meut grâce à l’énergie stockée\ndans son corps. Personne ne sait d’où\nvient cette énergie mystérieuse.",
      "language": {
        "name": "fr",
        "url": "/api/v2/language/5/"
      },
      "version": {
        "name": "black",
        "url": "/api/v2/version/17/"
      }
    },
    {
      "flavor_text": "The energy that burns inside it\nenables it to move, but no one has yet\nbeen able to identify this energy.",
      "language": {
        "name": "en",
        "url": "/api/v2/language/9/"
      },
      "version": {
        "name": "black",
        "url": "/api/v2/version/17/"
      }
    },
    {
      "flavor_text": "On pense que ce Pokémon est\nle produit de la technologie\nd’une civilisation ancienne.",
      "language": {
        "name": "fr",
        "url": "/api/v2/language/5/"
      },
      "version": {
        "name": "white",
        "url": "/api/v2/version/18/"
      }
    },
    {
      "flavor_text": "These Pokémon are thought to have been\ncreated by the science of an ancient\nand mysterious civilization.",
      "language": {
        "name": "en",
        "url": "/api/v2/language/9/"
      },
      "version": {
        "name": "white",
        "url": "/api/v2/version/18/"
      }
    },
    {
      "flavor_text": "Ancient science fashioned this\nPokémon from clay. It’s been\nactive for thousands of years.",
      "language": {
        "name": "en",
        "url": "/api/v2/language/9/"
      },
      "version": {
        "name": "black-2",
        "url": "/api/v2/version/21/"
      }
    },
    {
      "flavor_text": "Ancient science fashioned this\nPokémon from clay. It’s been\nactive for thousands of years.",
      "language": {
        "name": "en",
        "url": "/api/v2/language/9/"
      },
      "version": {
        "name": "white-2",
        "url": "/api/v2/version/22/"
      }
    },
    {
      "flavor_text": "たいないで　もえる　エネルギーに\nよって　かつどうしているが　どんな\nエネルギーなのかは　ふめいである。",
      "language": {
        "name": "ja-hrkt",
        "url": "/api/v2/language/1/"
      },
      "version": {
        "name": "x",
        "url": "/api/v2/version/23/"
      }
    },
    {
      "flavor_text": "체내에서 불타는 에너지로\n인해 활동하고 있지만 어떤\n에너지인지는 불명이다.",
      "language": {
        "name": "ko",
        "url": "/api/v2/language/3/"
      },
      "version": {
        "name": "x",
        "url": "/api/v2/version/23/"
      }
    },
    {
      "flavor_text": "Il se meut grâce à l’énergie stockée dans son corps.\nPersonne ne sait d’où vient cette énergie mystérieuse.",
      "language": {
        "name": "fr",
        "url": "/api/v2/language/5/"
      },
      "version": {
        "name": "x",
        "url": "/api/v2/version/23/"
      }
    },
    {
      "flavor_text": "Es wird durch eine Energie angetrieben, die seinem\nKörper entspringt. Keiner weiß jedoch, woher diese\nEnergie stammt.",
      "language": {
        "name": "de",
        "url": "/api/v2/language/6/"
      },
      "version": {
        "name": "x",
        "url": "/api/v2/version/23/"
      }
    },
    {
      "flavor_text": "Se mueve gracias a la energía que quema dentro de su\ncuerpo, pero el origen de esta energía es incierto.",
      "language": {
        "name": "es",
        "url": "/api/v2/language/7/"
      },
      "version": {
        "name": "x",
        "url": "/api/v2/version/23/"
      }
    },
    {
      "flavor_text": "Si muove grazie all’energia che gli brucia dentro,\nma nessuno sa di che tipo di energia si tratti.",
      "language": {
        "name": "it",
        "url": "/api/v2/language/8/"
      },
      "version": {
        "name": "x",
        "url": "/api/v2/version/23/"
      }
    },
    {
      "flavor_text": "The energy that burns inside it enables it to move,\nbut no one has yet been able to identify\nthis energy.",
      "language": {
        "name": "en",
        "url": "/api/v2/language/9/"
      },
      "version": {
        "name": "x",
        "url": "/api/v2/version/23/"
      }
    },
    {
      "flavor_text": "体内で　燃える　エネルギーに　よって\n活動しているが　どんな\nエネルギーなのかは　不明である。",
      "language": {
        "name": "ja",
        "url": "/api/v2/language/11/"
      },
      "version": {
        "name": "x",
        "url": "/api/v2/version/23/"
      }
    },
    {
      "flavor_text": "Se mueve gracias a la energía que quema dentro de su\ncuerpo, pero el origen de esta energía es incierto.",
      "language": {
        "name": "es-419",
        "url": "/api/v2/language/14/"
      },
      "version": {
        "name": "x",
        "url": "/api/v2/version/23/"
      }
    },
    {
      "flavor_text": "こだいの　かがくりょくに　よって\nねんどから　つくられた　ポケモン。\nすうせんねん　うごきつづける。",
      "language": {
        "name": "ja-hrkt",
        "url": "/api/v2/language/1/"
      },
      "version": {
        "name": "y",
        "url": "/api/v2/version/24/"
      }
    },
    {
      "flavor_text": "고대 과학의 힘으로\n점토에서 만들어진 포켓몬.\n수천 년 동안 계속 움직일 수 있다.",
      "language": {
        "name": "ko",
        "url": "/api/v2/language/3/"
      },
      "version": {
        "name": "y",
        "url": "/api/v2/version/24/"
      }
    },
    {
      "flavor_text": "Ce Pokémon fait de terre glaise, produit de la\ntechnologie d’une civilisation antique, vit depuis\ndes millénaires.",
      "language": {
        "name": "fr",
        "url": "/api/v2/language/5/"
      },
      "version": {
        "name": "y",
        "url": "/api/v2/version/24/"
      }
    },
    {
      "flavor_text": "Es wurde von einer uralten Kultur aus Lehm erschaffen\nund kann mehrere Jahrtausende in Bewegung bleiben.",
      "language": {
        "name": "de",
        "url": "/api/v2/language/6/"
      },
      "version": {
        "name": "y",
        "url": "/api/v2/version/24/"
      }
    },
    {
      "flavor_text": "Un Pokémon creado a partir del barro gracias a la\nciencia de antaño. Lleva activo miles de años.",
      "language": {
        "name": "es",
        "url": "/api/v2/language/7/"
      },
      "version": {
        "name": "y",
        "url": "/api/v2/version/24/"
      }
    },
    {
