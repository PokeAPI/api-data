        "name": "de",
        "url": "/api/v2/language/6/"
      },
      "version": {
        "name": "omega-ruby",
        "url": "/api/v2/version/25/"
      }
    },
    {
      "flavor_text": "Hitmonlee tiene la facilidad de encoger y estirar las patas.\nCon extremidades tan flexibles, propina unas patadas\ndemoledoras. Tras la lucha, se masajea las piernas y relaja\nlos músculos para descansar.",
      "language": {
        "name": "es",
        "url": "/api/v2/language/7/"
      },
      "version": {
        "name": "omega-ruby",
        "url": "/api/v2/version/25/"
      }
    },
    {
