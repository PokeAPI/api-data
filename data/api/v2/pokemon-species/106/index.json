        "url": "/api/v2/language/5/"
      },
      "version": {
        "name": "omega-ruby",
        "url": "/api/v2/version/25/"
      }
    },
    {
      "flavor_text": "Kicklee kann seine Beine ausfahren und einziehen. Es verblüfft\nseine Gegner mit brutalen Tritten. Nach einem Kampf massiert\nes seine Beine und lockert die Muskeln, um der Erschöpfung\nvorzubeugen.",
