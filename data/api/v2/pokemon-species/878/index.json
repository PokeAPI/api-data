    },
    {
      "flavor_text": "能夠舉起重達５噸的貨物。天一亮就會成群結隊前往洞窟找礦石來吃。",
      "language": {
        "name": "zh-hant",
        "url": "/api/v2/language/4/"
      },
      "version": {
        "name": "violet",
        "url": "/api/v2/version/41/"
      }
    },
    {
      "flavor_text": "Il peut soulever des charges de cinq tonnes. Le matin, il se rend dans les grottes avec son troupeau, en quête du minerai dont il se nourrit.",
      "language": {
        "name": "fr",
        "url": "/api/v2/language/5/"
      },
      "version": {
        "name": "violet",
        "url": "/api/v2/version/41/"
      }
    },
    {
      "flavor_text": "Kupfanti kann ein Gewicht von 5 t stemmen. Morgens macht es sich mit seiner Herde auf den Weg zu Höhlen, wo es Erz zum Fressen sucht.",
      "language": {
        "name": "de",
