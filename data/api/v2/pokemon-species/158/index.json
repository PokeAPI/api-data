        "name": "es",
        "url": "/api/v2/language/7/"
      },
      "version": {
        "name": "x",
        "url": "/api/v2/version/23/"
      }
    },
    {
      "flavor_text": "Piccolo, ma forte e deciso. Non esita ad avventarsi\nsu qualsiasi cosa si muova.",
