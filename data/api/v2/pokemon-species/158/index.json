      },
      "version": {
        "name": "x",
        "url": "/api/v2/version/23/"
      }
    },
    {
      "flavor_text": "Petit mais costaud, il n’hésite pas à mordre tout\nce qui passe à portée de ses dents.",
      "language": {
        "name": "fr",
        "url": "/api/v2/language/5/"
      },
      "version": {
        "name": "x",
        "url": "/api/v2/version/23/"
      }
    },
    {
      "flavor_text": "Es ist klein, aber zäh und stark. Es zögert nicht,\njeden anzugreifen, wenn dieser ihm zu nahe kommt.",
      "language": {
        "name": "de",
        "url": "/api/v2/language/6/"
      },
      "version": {
        "name": "x",
        "url": "/api/v2/version/23/"
      }
    },
    {
      "flavor_text": "Es pequeño pero violento. No dudará en morder\ncualquier cosa que se mueva cerca.",
