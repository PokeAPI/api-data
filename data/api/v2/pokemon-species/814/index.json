      },
      "version": {
        "name": "scarlet",
        "url": "/api/v2/version/40/"
      }
    },
    {
      "flavor_text": "蓬松的体毛让它更容易提升火之能量的温度，放出更强的火焰。",
      "language": {
        "name": "zh-hans",
        "url": "/api/v2/language/12/"
