        "name": "de",
        "url": "/api/v2/language/6/"
      },
      "version": {
        "name": "sword",
        "url": "/api/v2/version/33/"
      }
    },
    {
      "flavor_text": "Expulsa esporas venenosas. Crecerán setas\nen cualquier superficie con la que entren en\ncontacto si no se lava de inmediato.",
