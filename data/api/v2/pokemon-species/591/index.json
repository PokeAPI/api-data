        "name": "es",
        "url": "/api/v2/language/7/"
      },
      "version": {
        "name": "sword",
        "url": "/api/v2/version/33/"
      }
    },
    {
      "flavor_text": "Sparge spore velenose. Se non vengono lavate\nvia in fretta, nel luogo in cui si sono depositate\ncresceranno dei funghi.",
      "language": {
        "name": "it",
        "url": "/api/v2/language/8/"
