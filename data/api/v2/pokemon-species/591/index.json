  "flavor_text_entries": [
    {
      "flavor_text": "Il danse en faisant tournoyer les\ncoupoles en forme de Poké Ball de\nses bras pour attirer ses proies.",
      "language": {
        "name": "fr",
        "url": "/api/v2/language/5/"
      },
      "version": {
        "name": "black",
        "url": "/api/v2/version/17/"
      }
    },
    {
      "flavor_text": "It lures prey close by dancing and\nwaving its arm caps, which resemble\nPoké Balls, in a swaying motion.",
      "language": {
        "name": "en",
        "url": "/api/v2/language/9/"
      },
      "version": {
        "name": "black",
        "url": "/api/v2/version/17/"
      }
    },
    {
      "flavor_text": "Il se sert de ses coupoles en forme de\nPoké Ball pour attirer ses proies, mais\npeu de Pokémon se laissent avoir.",
      "language": {
        "name": "fr",
        "url": "/api/v2/language/5/"
      },
      "version": {
        "name": "white",
        "url": "/api/v2/version/18/"
      }
    },
    {
