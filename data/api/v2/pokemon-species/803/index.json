  "pal_park_encounters": [],
  "form_descriptions": [],
  "flavor_text_entries": [
    {
      "flavor_text": "いせかいに　おいては　たびだちの\nパートナーに　えらばれるほど\nしたしまれている　ウルトラビースト。",
      "language": {
        "name": "ja-hrkt",
        "url": "/api/v2/language/1/"
      },
      "version": {
        "name": "ultra-sun",
        "url": "/api/v2/version/29/"
      }
    },
    {
      "flavor_text": "다른 세계에서는 여행\n파트너로 삼을 정도로\n친근한 울트라비스트다.",
      "language": {
        "name": "ko",
        "url": "/api/v2/language/3/"
      },
      "version": {
        "name": "ultra-sun",
        "url": "/api/v2/version/29/"
      }
    },
    {
      "flavor_text": "在異世界是人們十分熟悉的\n究極異獸，有時甚至會被選為\n踏上旅程時的夥伴。",
      "language": {
        "name": "zh-hant",
        "url": "/api/v2/language/4/"
      },
      "version": {
        "name": "ultra-sun",
        "url": "/api/v2/version/29/"
      }
    },
    {
      "flavor_text": "Dans son monde, cette Ultra-Chimère est fort\nappréciée pour son naturel conciliant, qui fait\nd’elle un compagnon de voyage idéal.",
      "language": {
        "name": "fr",
        "url": "/api/v2/language/5/"
      },
      "version": {
        "name": "ultra-sun",
        "url": "/api/v2/version/29/"
      }
    },
    {
      "flavor_text": "Diese Ultrabestie wird in der Welt, aus der sie\nkommt, so gemocht, dass sie oft als Partner für\nReisen gewählt wird.",
      "language": {
        "name": "de",
        "url": "/api/v2/language/6/"
      },
      "version": {
        "name": "ultra-sun",
        "url": "/api/v2/version/29/"
      }
    },
    {
      "flavor_text": "En su mundo, este Ultraente se considera tan\nentrañable como para ser elegido compañero de\nviaje.",
      "language": {
        "name": "es",
        "url": "/api/v2/language/7/"
      },
      "version": {
        "name": "ultra-sun",
        "url": "/api/v2/version/29/"
      }
    },
    {
      "flavor_text": "Un’Ultracreatura talmente socievole da essere\nspesso scelta come compagno di viaggio nel\nmondo da cui proviene.",
      "language": {
        "name": "it",
        "url": "/api/v2/language/8/"
      },
      "version": {
        "name": "ultra-sun",
        "url": "/api/v2/version/29/"
      }
    },
    {
      "flavor_text": "This Ultra Beast is well enough liked to be\nchosen as a first partner in its own world.",
      "language": {
        "name": "en",
        "url": "/api/v2/language/9/"
      },
      "version": {
        "name": "ultra-sun",
        "url": "/api/v2/version/29/"
      }
    },
    {
      "flavor_text": "異世界に　おいては　旅立ちの\nパートナーに　選ばれるほど\n親しまれている　ウルトラビースト。",
      "language": {
        "name": "ja",
        "url": "/api/v2/language/11/"
      },
      "version": {
        "name": "ultra-sun",
        "url": "/api/v2/version/29/"
      }
    },
    {
      "flavor_text": "在异世界是亲切的究极异兽，\n甚至能被选为踏上旅程的同伴。",
      "language": {
        "name": "zh-hans",
        "url": "/api/v2/language/12/"
      },
      "version": {
        "name": "ultra-sun",
        "url": "/api/v2/version/29/"
      }
    },
    {
      "flavor_text": "En su mundo, este Ultraente se considera tan\nentrañable como para ser elegido compañero de\nviaje.",
      "language": {
        "name": "es-419",
        "url": "/api/v2/language/14/"
      },
      "version": {
        "name": "ultra-sun",
        "url": "/api/v2/version/29/"
      }
    },
    {
      "flavor_text": "いせかいに　すむ　ウルトラビースト。\nあたまの　どくばりから　どくえきを\nあいてに　かけて　ケラケラ　わらう。",
      "language": {
        "name": "ja-hrkt",
        "url": "/api/v2/language/1/"
      },
      "version": {
        "name": "ultra-moon",
        "url": "/api/v2/version/30/"
      }
    },
    {
      "flavor_text": "다른 세계에 사는 울트라비스트.\n머리의 독침에서 나온 독액을\n상대에게 끼얹고 깔깔 웃는다.",
      "language": {
        "name": "ko",
        "url": "/api/v2/language/3/"
      },
      "version": {
        "name": "ultra-moon",
        "url": "/api/v2/version/30/"
      }
    },
    {
      "flavor_text": "棲息在異世界的究極異獸。\n會從頭上的毒針朝對手\n噴出毒液，然後放聲大笑。",
      "language": {
        "name": "zh-hant",
        "url": "/api/v2/language/4/"
      },
      "version": {
        "name": "ultra-moon",
        "url": "/api/v2/version/30/"
      }
    },
    {
      "flavor_text": "Cette Ultra-Chimère venue d’un autre monde\nricane lorsqu’elle asperge ses proies de venin\ngrâce au dard qu’elle a sur la tête.",
      "language": {
        "name": "fr",
        "url": "/api/v2/language/5/"
      },
      "version": {
        "name": "ultra-moon",
        "url": "/api/v2/version/30/"
      }
    },
    {
      "flavor_text": "Diese Ultrabestie aus einer anderen Welt\nbesprüht Gegner laut lachend mit einer giftigen\nFlüssigkeit aus den Stacheln auf ihrem Kopf.",
      "language": {
        "name": "de",
        "url": "/api/v2/language/6/"
      },
      "version": {
        "name": "ultra-moon",
        "url": "/api/v2/version/30/"
      }
    },
    {
      "flavor_text": "Un Ultraente originario de otro mundo. Se burla\ndel oponente mientras lo rocía de veneno con el\naguijón que tiene en la cabeza.",
      "language": {
        "name": "es",
        "url": "/api/v2/language/7/"
      },
      "version": {
        "name": "ultra-moon",
        "url": "/api/v2/version/30/"
      }
    },
    {
      "flavor_text": "Un’Ultracreatura che vive in un altro mondo.\nSghignazza felice quando avvelena gli avversari\ncon il pungiglione che ha sul capo.",
      "language": {
