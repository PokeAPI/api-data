        "name": "de",
        "url": "/api/v2/language/6/"
      },
      "version": {
        "name": "x",
        "url": "/api/v2/version/23/"
      }
    },
    {
      "flavor_text": "Cuando sus ojos brillan como el oro, puede ver presas\nescondidas, incluso detrás de un muro.",
