        "name": "fr",
        "url": "/api/v2/language/5/"
      },
      "version": {
        "name": "x",
        "url": "/api/v2/version/23/"
      }
    },
    {
      "flavor_text": "Leuchten seine Augen golden auf, kann es Beute,\ndie sich versteckt, sehen. Es kann durch Wände sehen.",
