        "name": "en",
        "url": "/api/v2/language/9/"
      },
      "version": {
        "name": "ruby",
        "url": "/api/v2/version/7/"
      }
    },
    {
      "flavor_text": "FLYGON whips up a sandstorm by\nflapping its wings. The wings create a\nseries of notes that sound like singing.\fBecause the “singing” is the only thing\nthat can be heard in a sandstorm, this\nPOKéMON is said to be the desert spirit.",
      "language": {
        "name": "en",
        "url": "/api/v2/language/9/"
