        "name": "fr",
        "url": "/api/v2/language/5/"
      },
      "version": {
        "name": "y",
        "url": "/api/v2/version/24/"
      }
    },
    {
      "flavor_text": "Hat es sich mit Elektrizität aufgeladen, leuchtet sein\nSchweif und es feuert Haare ab, die sich entladen.",
