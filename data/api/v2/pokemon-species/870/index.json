        "url": "/api/v2/version/41/"
      }
    },
    {
      "flavor_text": "El líder utiliza su cuerno, capaz de expandirse y contraerse, para ordenar a los demás que cambien la formación.",
      "language": {
        "name": "es",
        "url": "/api/v2/language/7/"
