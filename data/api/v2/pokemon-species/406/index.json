  "flavor_text_entries": [
    {
      "flavor_text": "Over the winter, it closes its bud\nand endures the cold. In spring,\nthe bud opens and releases pollen.",
      "language": {
        "name": "en",
        "url": "/api/v2/language/9/"
      },
      "version": {
        "name": "diamond",
        "url": "/api/v2/version/12/"
      }
    },
    {
      "flavor_text": "It lives alongside clear ponds.\nIt scatters pollen that induces\nharsh sneezing and runny noses.",
      "language": {
        "name": "en",
        "url": "/api/v2/language/9/"
      },
      "version": {
        "name": "pearl",
        "url": "/api/v2/version/13/"
      }
    },
    {
      "flavor_text": "Sensitive to changing temperature,\nthe bud is said to bloom when it\nfeels the sun’s warm touch.",
      "language": {
        "name": "en",
        "url": "/api/v2/language/9/"
      },
      "version": {
        "name": "platinum",
        "url": "/api/v2/version/14/"
      }
    },
    {
      "flavor_text": "When it feels the sun’s warm touch,\nit opens its bud to release pollen.\nIt lives alongside clear pools.",
      "language": {
