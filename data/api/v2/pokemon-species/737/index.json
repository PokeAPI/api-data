      "version": {
        "name": "sword",
        "url": "/api/v2/version/33/"
      }
    },
    {
      "flavor_text": "Es schützt sich mithilfe seines robusten Panzers.\nDurch die Spitzen an seinem Kiefer leitet es\nStrom, mit dem es sich gegen Angreifer wehrt.",
      "language": {
