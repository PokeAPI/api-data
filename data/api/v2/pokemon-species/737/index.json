        "name": "es",
        "url": "/api/v2/language/7/"
      },
      "version": {
        "name": "sword",
        "url": "/api/v2/version/33/"
      }
    },
    {
      "flavor_text": "È protetto da un robusto esoscheletro.\nContrattacca con l’elettricità che rilascia\ndalle punte che ha sulla mandibola.",
