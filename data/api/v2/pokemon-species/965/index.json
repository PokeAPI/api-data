  "pal_park_encounters": [],
  "form_descriptions": [],
  "flavor_text_entries": [
    {
      "flavor_text": "スクラップこうじょうに　ほうちされたエンジンに　なぞの　どくポケモンがはいりこんで　うまれたと　いわれる。",
      "language": {
        "name": "ja-hrkt",
        "url": "/api/v2/language/1/"
      },
      "version": {
        "name": "scarlet",
        "url": "/api/v2/version/40/"
      }
    },
    {
      "flavor_text": "고철 처리장에 방치된 엔진에 정체불명의 독포켓몬이 들어가 탄생한 것으로 전해지고 있다.",
      "language": {
        "name": "ko",
        "url": "/api/v2/language/3/"
      },
      "version": {
        "name": "scarlet",
        "url": "/api/v2/version/40/"
      }
    },
    {
      "flavor_text": "據說牠是神秘的毒寶可夢鑽進了被放置在廢鐵工廠的引擎裡而誕生的。",
      "language": {
        "name": "zh-hant",
        "url": "/api/v2/language/4/"
      },
      "version": {
        "name": "scarlet",
        "url": "/api/v2/version/40/"
      }
    },
    {
      "flavor_text": "On raconte qu’il est né lorsqu’un mystérieux Pokémon Poison a pris possession d’un moteur laissé à l’abandon dans une casse.",
      "language": {
        "name": "fr",
        "url": "/api/v2/language/5/"
      },
      "version": {
        "name": "scarlet",
        "url": "/api/v2/version/40/"
      }
    },
    {
      "flavor_text": "Es soll entstanden sein, als ein unbekanntes Gift-Pokémon von einem Motor Besitz ergriff, der in einer Schrottfabrik zurückgelassen wurde.",
      "language": {
        "name": "de",
        "url": "/api/v2/language/6/"
      },
      "version": {
        "name": "scarlet",
        "url": "/api/v2/version/40/"
      }
    },
    {
      "flavor_text": "Se dice que surgió cuando un misterioso Pokémon venenoso tomó posesión de un motor abandonado en un desguace.",
      "language": {
        "name": "es",
        "url": "/api/v2/language/7/"
      },
      "version": {
        "name": "scarlet",
        "url": "/api/v2/version/40/"
      }
    },
    {
      "flavor_text": "Pare sia nato quando un misterioso Pokémon di tipo Veleno prese possesso di un motore abbandonato in un deposito di rottami.",
      "language": {
        "name": "it",
        "url": "/api/v2/language/8/"
      },
      "version": {
        "name": "scarlet",
        "url": "/api/v2/version/40/"
      }
    },
    {
      "flavor_text": "It is said that this Pokémon was born when an unknown poison Pokémon entered and inspirited an engine left at a scrap-processing factory.",
      "language": {
        "name": "en",
        "url": "/api/v2/language/9/"
      },
      "version": {
        "name": "scarlet",
        "url": "/api/v2/version/40/"
      }
    },
    {
      "flavor_text": "スクラップ工場に　放置されたエンジンに　謎の　毒ポケモンが入り込んで　生まれたと　言われる。",
      "language": {
        "name": "ja",
        "url": "/api/v2/language/11/"
      },
      "version": {
        "name": "scarlet",
        "url": "/api/v2/version/40/"
      }
    },
    {
      "flavor_text": "据说是神秘的毒宝可梦钻进了放置于废弃工厂的引擎里，从而诞生了它。",
      "language": {
        "name": "zh-hans",
        "url": "/api/v2/language/12/"
      },
      "version": {
        "name": "scarlet",
        "url": "/api/v2/version/40/"
      }
    },
    {
      "flavor_text": "Se dice que surgió cuando un misterioso Pokémon venenoso tomó posesión de un motor abandonado en un desguace.",
      "language": {
        "name": "es-419",
        "url": "/api/v2/language/14/"
      },
      "version": {
        "name": "scarlet",
        "url": "/api/v2/version/40/"
      }
    },
    {
      "flavor_text": "はがねの　からだが　ほんたい。いわに　はりつき　そのせいぶんをエネルギーに　かえて　かつどうする。",
      "language": {
        "name": "ja-hrkt",
        "url": "/api/v2/language/1/"
      },
      "version": {
        "name": "violet",
        "url": "/api/v2/version/41/"
      }
    },
    {
      "flavor_text": "강철로 된 몸이 본체다. 바위에 달라붙은 다음, 그 성분을 에너지로 바꿔 활동한다.",
      "language": {
        "name": "ko",
        "url": "/api/v2/language/3/"
      },
      "version": {
        "name": "violet",
        "url": "/api/v2/version/41/"
      }
    },
    {
      "flavor_text": "鋼鐵身軀才是本體。會貼在岩石上將其成分轉換成活動用的能量。",
      "language": {
        "name": "zh-hant",
        "url": "/api/v2/language/4/"
      },
      "version": {
        "name": "violet",
        "url": "/api/v2/version/41/"
      }
    },
    {
      "flavor_text": "Son corps correspond à la partie en acier. Il s’accroche à des roches et convertit les minéraux qu’elles contiennent en énergie.",
      "language": {
        "name": "fr",
        "url": "/api/v2/language/5/"
      },
      "version": {
        "name": "violet",
        "url": "/api/v2/version/41/"
      }
    },
    {
      "flavor_text": "Der stählerne Teil ist sein eigentlicher Körper. Es heftet sich an Felsen, um deren Bestandteile in Energie für sich selbst umzuwandeln.",
      "language": {
        "name": "de",
        "url": "/api/v2/language/6/"
      },
      "version": {
        "name": "violet",
        "url": "/api/v2/version/41/"
      }
    },
    {
      "flavor_text": "La parte metálica es su verdadero cuerpo. Se adhiere a rocas para procesar sus minerales y generar energía para moverse.",
      "language": {
        "name": "es",
        "url": "/api/v2/language/7/"
      },
      "version": {
        "name": "violet",
        "url": "/api/v2/version/41/"
      }
    },
    {
      "flavor_text": "Il suo corpo è la parte d’acciaio. Si attacca alle rocce per trasformare la materia di cui sono composte nell’energia che usa per muoversi.",
      "language": {
        "name": "it",
        "url": "/api/v2/language/8/"
      },
      "version": {
        "name": "violet",
        "url": "/api/v2/version/41/"
      }
    },
    {
      "flavor_text": "The steel section is Varoom’s actual body. This Pokémon clings to rocks and converts the minerals within into energy to fuel its activities.",
      "language": {
        "name": "en",
        "url": "/api/v2/language/9/"
      },
      "version": {
        "name": "violet",
        "url": "/api/v2/version/41/"
      }
    },
    {
      "flavor_text": "鋼の　体が　本体。岩に　張りつき　その成分をエネルギーに　変えて　活動する。",
      "language": {
        "name": "ja",
        "url": "/api/v2/language/11/"
      },
      "version": {
        "name": "violet",
        "url": "/api/v2/version/41/"
      }
    },
    {
      "flavor_text": "钢铁的身躯才是本体。会贴在岩石上将其成分转换为活动所需的能量。",
      "language": {
        "name": "zh-hans",
        "url": "/api/v2/language/12/"
      },
      "version": {
        "name": "violet",
        "url": "/api/v2/version/41/"
      }
    },
    {
