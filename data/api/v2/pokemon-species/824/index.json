  "pal_park_encounters": [],
  "form_descriptions": [],
  "flavor_text_entries": [
    {
      "flavor_text": "いつも　せっせと　じょうほうを\nあつめているので　かしこい。\nただし　ちからは　いまいちだ。",
      "language": {
        "name": "ja-hrkt",
        "url": "/api/v2/language/1/"
      },
      "version": {
        "name": "sword",
        "url": "/api/v2/version/33/"
      }
    },
    {
      "flavor_text": "언제나 부지런히 정보를\n모으기 때문에 똑똑하다.\n단, 힘은 그저 그렇다.",
      "language": {
        "name": "ko",
        "url": "/api/v2/language/3/"
      },
      "version": {
        "name": "sword",
        "url": "/api/v2/version/33/"
      }
    },
    {
      "flavor_text": "總是孜孜不倦地收集情報，\n所以頭腦相當地聰明，\n但是力量方面就差了一些。",
      "language": {
        "name": "zh-hant",
        "url": "/api/v2/language/4/"
      },
      "version": {
        "name": "sword",
        "url": "/api/v2/version/33/"
      }
    },
    {
      "flavor_text": "Comme il passe tout son temps à recueillir des\ninformations, son intelligence est très développée,\nmais sa force physique laisse à désirer.",
      "language": {
        "name": "fr",
        "url": "/api/v2/language/5/"
      },
      "version": {
        "name": "sword",
        "url": "/api/v2/version/33/"
      }
    },
    {
      "flavor_text": "Sensect ist ein schlaues Pokémon, da es immer\nfleißig Informationen sammelt. Seine Stärke lässt\njedoch zu wünschen übrig.",
      "language": {
        "name": "de",
        "url": "/api/v2/language/6/"
      },
      "version": {
        "name": "sword",
        "url": "/api/v2/version/33/"
      }
    },
    {
      "flavor_text": "Siempre está recopilando información, por lo\nque es muy inteligente, aunque su fuerza deja\nbastante que desear.",
      "language": {
        "name": "es",
        "url": "/api/v2/language/7/"
      },
      "version": {
        "name": "sword",
        "url": "/api/v2/version/33/"
      }
    },
    {
      "flavor_text": "Sempre impegnato a raccogliere informazioni,\nha sviluppato molto la sua intelligenza, ma non\nha una grande forza.",
      "language": {
        "name": "it",
        "url": "/api/v2/language/8/"
      },
      "version": {
        "name": "sword",
        "url": "/api/v2/version/33/"
      }
    },
    {
      "flavor_text": "A constant collector of information, this Pokémon\nis very smart. Very strong is what it isn’t.",
      "language": {
        "name": "en",
        "url": "/api/v2/language/9/"
      },
      "version": {
        "name": "sword",
        "url": "/api/v2/version/33/"
      }
    },
    {
      "flavor_text": "いつも　せっせと　情報を\n集めているので　賢い。\nただし　力は　いまいちだ。",
      "language": {
        "name": "ja",
        "url": "/api/v2/language/11/"
      },
      "version": {
        "name": "sword",
        "url": "/api/v2/version/33/"
      }
    },
    {
      "flavor_text": "总是孜孜不倦地收集情报，\n所以头脑相当地聪明，\n但力量方面就差了一些。",
      "language": {
        "name": "zh-hans",
        "url": "/api/v2/language/12/"
      },
      "version": {
        "name": "sword",
        "url": "/api/v2/version/33/"
      }
    },
    {
      "flavor_text": "Siempre está recopilando información, por lo\nque es muy inteligente, aunque su fuerza deja\nbastante que desear.",
      "language": {
        "name": "es-419",
        "url": "/api/v2/language/14/"
      },
      "version": {
        "name": "sword",
        "url": "/api/v2/version/33/"
      }
    },
    {
      "flavor_text": "はたけで　よくみかける　ポケモン。\nからだに　はえた　けで　まわりで\nおきていることを　かんじとる。",
      "language": {
        "name": "ja-hrkt",
        "url": "/api/v2/language/1/"
      },
      "version": {
        "name": "shield",
        "url": "/api/v2/version/34/"
      }
    },
    {
      "flavor_text": "밭에서 자주 보이는 포켓몬이다.\n몸에 난 털로 주위에서\n일어나는 일을 감지한다.",
      "language": {
        "name": "ko",
        "url": "/api/v2/language/3/"
      },
      "version": {
        "name": "shield",
        "url": "/api/v2/version/34/"
      }
    },
    {
      "flavor_text": "經常出現在田地裡的寶可夢。\n會透過長在身體上的毛\n來感應周圍發生的事。",
      "language": {
        "name": "zh-hant",
        "url": "/api/v2/language/4/"
      },
      "version": {
        "name": "shield",
        "url": "/api/v2/version/34/"
      }
    },
    {
      "flavor_text": "On le voit souvent dans les champs.\nLes poils de son corps lui servent à capter\nce qu’il se passe autour de lui.",
      "language": {
        "name": "fr",
        "url": "/api/v2/language/5/"
      },
      "version": {
        "name": "shield",
        "url": "/api/v2/version/34/"
      }
    },
    {
      "flavor_text": "Dieses Pokémon trifft man oft auf Feldern an.\nMit den Haaren, die an seinem Körper wachsen,\nspürt es, was in der Umgebung vor sich geht.",
      "language": {
        "name": "de",
        "url": "/api/v2/language/6/"
      },
      "version": {
        "name": "shield",
        "url": "/api/v2/version/34/"
      }
    },
    {
      "flavor_text": "Es habitual verlo en el campo. Los pelos que\ntiene son sensores con los que percibe lo que\nocurre a su alrededor.",
      "language": {
        "name": "es",
        "url": "/api/v2/language/7/"
      },
      "version": {
        "name": "shield",
        "url": "/api/v2/version/34/"
      }
    },
    {
      "flavor_text": "Si incontra spesso nei campi. Le setole che\ncrescono sul suo corpo gli permettono di\npercepire ciò che accade attorno a lui.",
      "language": {
        "name": "it",
        "url": "/api/v2/language/8/"
      },
      "version": {
        "name": "shield",
        "url": "/api/v2/version/34/"
      }
    },
    {
      "flavor_text": "Often found in gardens, this Pokémon has hairs\non its body that it uses to assess its surroundings.",
      "language": {
        "name": "en",
        "url": "/api/v2/language/9/"
      },
      "version": {
        "name": "shield",
        "url": "/api/v2/version/34/"
      }
    },
    {
      "flavor_text": "畑で　よく見かける　ポケモン。\n体に　生えた　毛で　まわりで\n起きていることを　感じとる。",
      "language": {
        "name": "ja",
        "url": "/api/v2/language/11/"
      },
      "version": {
        "name": "shield",
        "url": "/api/v2/version/34/"
      }
    },
    {
      "flavor_text": "经常出现在田地里的宝可梦。\n会通过长在身体上的毛\n来感应周围发生的事。",
      "language": {
        "name": "zh-hans",
        "url": "/api/v2/language/12/"
      },
      "version": {
        "name": "shield",
        "url": "/api/v2/version/34/"
      }
    },
    {
      "flavor_text": "Es habitual verlo en el campo. Los pelos que\ntiene son sensores con los que percibe lo que\nocurre a su alrededor.",
      "language": {
        "name": "es-419",
        "url": "/api/v2/language/14/"
      },
