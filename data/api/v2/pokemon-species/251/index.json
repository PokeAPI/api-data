        "name": "ko",
        "url": "/api/v2/language/3/"
      },
      "version": {
        "name": "y",
        "url": "/api/v2/version/24/"
      }
    },
    {
      "flavor_text": "Il a le pouvoir de voyager dans le temps.\nCependant, on dit qu’il n’apparaît qu’en temps de\npaix.",
