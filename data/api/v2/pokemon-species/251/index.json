      },
      "version": {
        "name": "x",
        "url": "/api/v2/version/23/"
      }
    },
    {
      "flavor_text": "Dieses Pokémon reist durch Zeit und Raum.\nBäume und Wiesen wuchern, wenn es in der Nähe ist.",
      "language": {
        "name": "de",
        "url": "/api/v2/language/6/"
      },
      "version": {
        "name": "x",
        "url": "/api/v2/version/23/"
      }
    },
    {
      "flavor_text": "Este Pokémon vaga por el tiempo. La hierba y los\nárboles crecen por los campos por donde pasa.",
