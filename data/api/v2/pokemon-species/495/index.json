  "flavor_text_entries": [
    {
      "flavor_text": "Un Pokémon intelligent et très calme.\nLorsqu’il a reçu suffisamment de\nlumière du soleil, il devient plus agile.",
      "language": {
        "name": "fr",
        "url": "/api/v2/language/5/"
      },
      "version": {
        "name": "black",
        "url": "/api/v2/version/17/"
      }
    },
    {
      "flavor_text": "It is very intelligent and calm.\nBeing exposed to lots of sunlight makes\nits movements swifter.",
      "language": {
        "name": "en",
        "url": "/api/v2/language/9/"
      },
      "version": {
        "name": "black",
        "url": "/api/v2/version/17/"
      }
    },
    {
      "flavor_text": "Il laisse sa queue prendre le soleil pour\nsa photosynthèse. Quand il est malade,\nsa queue pend tristement.",
      "language": {
        "name": "fr",
        "url": "/api/v2/language/5/"
      },
      "version": {
        "name": "white",
        "url": "/api/v2/version/18/"
      }
    },
    {
      "flavor_text": "They photosynthesize by bathing their\ntails in sunlight. When they are not\nfeeling well, their tails droop.",
      "language": {
        "name": "en",
        "url": "/api/v2/language/9/"
      },
      "version": {
        "name": "white",
        "url": "/api/v2/version/18/"
      }
    },
    {
      "flavor_text": "Being exposed to sunlight makes\nits movements swifter. It uses\nvines more adeptly than its hands.",
      "language": {
        "name": "en",
        "url": "/api/v2/language/9/"
      },
      "version": {
        "name": "black-2",
        "url": "/api/v2/version/21/"
      }
    },
    {
      "flavor_text": "Being exposed to sunlight makes\nits movements swifter. It uses\nvines more adeptly than its hands.",
      "language": {
        "name": "en",
        "url": "/api/v2/language/9/"
      },
      "version": {
        "name": "white-2",
        "url": "/api/v2/version/22/"
      }
    },
    {
      "flavor_text": "たいようの　ひかりを　あびると\nいつもよりも　すばやく　うごける。\nてよりも　ツルを　うまくつかう。",
      "language": {
        "name": "ja-hrkt",
        "url": "/api/v2/language/1/"
      },
      "version": {
        "name": "x",
        "url": "/api/v2/version/23/"
      }
    },
    {
      "flavor_text": "태양의 빛을 받으면\n평소보다 빨리 움직일 수 있다.\n손보다 덩굴을 잘 사용한다.",
      "language": {
        "name": "ko",
        "url": "/api/v2/language/3/"
      },
      "version": {
        "name": "x",
        "url": "/api/v2/version/23/"
      }
    },
    {
      "flavor_text": "La lumière du soleil augmente fortement son agilité.\nSes lianes sont plus habiles que ses mains.",
      "language": {
        "name": "fr",
        "url": "/api/v2/language/5/"
      },
      "version": {
        "name": "x",
        "url": "/api/v2/version/23/"
      }
    },
    {
      "flavor_text": "Im Sonnenlicht erhöht sich das Tempo seiner\nBewegungen. Es ist mit seinen Schlingen\ngeschickter als mit den Händen.",
      "language": {
        "name": "de",
        "url": "/api/v2/language/6/"
      },
      "version": {
        "name": "x",
        "url": "/api/v2/version/23/"
      }
    },
    {
      "flavor_text": "Cuando recibe los rayos de sol, se mueve mucho más\nrápido que de costumbre. Usa mejor sus lianas que\nsus manos.",
      "language": {
        "name": "es",
        "url": "/api/v2/language/7/"
      },
      "version": {
        "name": "x",
        "url": "/api/v2/version/23/"
      }
    },
    {
      "flavor_text": "Quando è esposto alla luce solare può muoversi\npiù velocemente. Usa le sue liane meglio dei suoi\nstessi arti.",
      "language": {
        "name": "it",
        "url": "/api/v2/language/8/"
      },
      "version": {
        "name": "x",
        "url": "/api/v2/version/23/"
      }
    },
    {
      "flavor_text": "Being exposed to sunlight makes its movements\nswifter. It uses vines more adeptly than its hands.",
      "language": {
        "name": "en",
        "url": "/api/v2/language/9/"
      },
      "version": {
        "name": "x",
        "url": "/api/v2/version/23/"
      }
    },
    {
      "flavor_text": "太陽の　光を　浴びると\nいつもよりも　素早く　動ける。\n手よりも　ツルを　うまく使う。",
      "language": {
        "name": "ja",
        "url": "/api/v2/language/11/"
      },
      "version": {
        "name": "x",
        "url": "/api/v2/version/23/"
      }
    },
    {
      "flavor_text": "Cuando recibe los rayos de sol, se mueve mucho más\nrápido que de costumbre. Usa mejor sus lianas que\nsus manos.",
      "language": {
        "name": "es-419",
        "url": "/api/v2/language/14/"
      },
      "version": {
        "name": "x",
        "url": "/api/v2/version/23/"
      }
    },
    {
      "flavor_text": "しっぽで　たいようを　あびて\nこうごうせいを　する。げんきを\nなくすと　しっぽが　たれさがる。",
      "language": {
        "name": "ja-hrkt",
        "url": "/api/v2/language/1/"
      },
      "version": {
        "name": "y",
        "url": "/api/v2/version/24/"
      }
    },
    {
      "flavor_text": "꼬리로 태양의 빛을 받아\n광합성한다. 기운이\n빠지면 꼬리가 축 늘어진다.",
      "language": {
        "name": "ko",
        "url": "/api/v2/language/3/"
      },
      "version": {
        "name": "y",
        "url": "/api/v2/version/24/"
      }
    },
    {
      "flavor_text": "Il laisse sa queue prendre le soleil pour sa\nphotosynthèse. Quand il est malade, sa queue pend\ntristement.",
      "language": {
        "name": "fr",
        "url": "/api/v2/language/5/"
      },
      "version": {
        "name": "y",
        "url": "/api/v2/version/24/"
      }
    },
    {
      "flavor_text": "Fängt mit dem Schweif Sonnenlicht auf,\num Photosynthese zu betreiben. Fehlt ihm\ndie Kraft, hängt sein Schweif schlaff herab.",
      "language": {
        "name": "de",
        "url": "/api/v2/language/6/"
      },
      "version": {
        "name": "y",
        "url": "/api/v2/version/24/"
      }
    },
    {
      "flavor_text": "Sintetiza la luz del sol que recoge con su cola. Esta\nse le queda abatida cuando le fallan las energías.",
      "language": {
        "name": "es",
        "url": "/api/v2/language/7/"
      },
      "version": {
        "name": "y",
        "url": "/api/v2/version/24/"
      }
    },
    {
      "flavor_text": "Assorbe i raggi solari dalla coda per operare la\nfotosintesi. Quando non sta bene, la sua coda si\naffloscia.",
      "language": {
        "name": "it",
        "url": "/api/v2/language/8/"
      },
      "version": {
        "name": "y",
        "url": "/api/v2/version/24/"
      }
    },
    {
      "flavor_text": "They photosynthesize by bathing their tails in\nsunlight. When they are not feeling well, their\ntails droop.",
      "language": {
        "name": "en",
        "url": "/api/v2/language/9/"
      },
      "version": {
        "name": "y",
        "url": "/api/v2/version/24/"
