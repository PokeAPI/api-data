        "url": "/api/v2/language/8/"
      },
      "version": {
        "name": "x",
        "url": "/api/v2/version/23/"
      }
    },
    {
      "flavor_text": "It increases the power of its punches by vibrating\nthe bumps on its fists. It can turn a boulder to\nrubble with one punch.",
