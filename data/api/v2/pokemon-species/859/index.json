  "pal_park_encounters": [],
  "form_descriptions": [],
  "flavor_text_entries": [
    {
      "flavor_text": "ひとや　ポケモンが　いやがる　ときに\nはっする　マイナスエネルギーを\nはなから　すいこみ　げんきになる。",
      "language": {
        "name": "ja-hrkt",
        "url": "/api/v2/language/1/"
      },
      "version": {
        "name": "sword",
        "url": "/api/v2/version/33/"
      }
    },
    {
      "flavor_text": "사람이나 포켓몬이 싫어하는 감정을\n가질 때 발생시키는 마이너스 에너지를\n코로 빨아들여서 건강해진다.",
      "language": {
        "name": "ko",
        "url": "/api/v2/language/3/"
      },
      "version": {
        "name": "sword",
        "url": "/api/v2/version/33/"
      }
    },
    {
      "flavor_text": "會用鼻子吸收人類或寶可夢\n情緒糟糕時產生的負能量，\n來為自己補充活力。",
      "language": {
        "name": "zh-hant",
        "url": "/api/v2/language/4/"
      },
      "version": {
        "name": "sword",
        "url": "/api/v2/version/33/"
      }
    },
    {
      "flavor_text": "Pour se refaire une santé, il hume l’énergie\nnégative que les humains et les Pokémon\ndégagent quand ils sont irrités.",
      "language": {
        "name": "fr",
        "url": "/api/v2/language/5/"
      },
      "version": {
        "name": "sword",
        "url": "/api/v2/version/33/"
      }
    },
    {
      "flavor_text": "Es wird kräftiger, indem es die von unzufriedenen\nMenschen und Pokémon ausgestoßene negative\nEnergie einatmet.",
      "language": {
        "name": "de",
        "url": "/api/v2/language/6/"
      },
      "version": {
        "name": "sword",
        "url": "/api/v2/version/33/"
      }
    },
    {
      "flavor_text": "Con el fin de revitalizarse, inhala por la nariz la\nenergía negativa que desprenden tanto personas\ncomo Pokémon cuando están descontentos.",
      "language": {
        "name": "es",
        "url": "/api/v2/language/7/"
      },
      "version": {
        "name": "sword",
        "url": "/api/v2/version/33/"
      }
    },
    {
      "flavor_text": "Recupera le forze inalando dal naso l’energia\nnegativa emessa da persone e Pokémon quando\nsono irritati.",
      "language": {
        "name": "it",
        "url": "/api/v2/language/8/"
      },
      "version": {
        "name": "sword",
        "url": "/api/v2/version/33/"
      }
    },
    {
      "flavor_text": "Through its nose, it sucks in the emanations\nproduced by people and Pokémon when they\nfeel annoyed. It thrives off this negative energy.",
      "language": {
        "name": "en",
        "url": "/api/v2/language/9/"
      },
      "version": {
        "name": "sword",
        "url": "/api/v2/version/33/"
      }
    },
    {
      "flavor_text": "人や　ポケモンが　嫌がる　ときに\n発する　マイナスエネルギーを\n鼻から　吸いこみ　元気になる。",
      "language": {
        "name": "ja",
        "url": "/api/v2/language/11/"
      },
      "version": {
        "name": "sword",
        "url": "/api/v2/version/33/"
      }
    },
    {
      "flavor_text": "会用鼻子吸收人类或宝可梦\n情绪糟糕时产生的负能量，\n来为自己补充活力。",
      "language": {
        "name": "zh-hans",
        "url": "/api/v2/language/12/"
      },
      "version": {
        "name": "sword",
        "url": "/api/v2/version/33/"
      }
    },
    {
      "flavor_text": "Con el fin de revitalizarse, inhala por la nariz la\nenergía negativa que desprenden tanto personas\ncomo Pokémon cuando están descontentos.",
      "language": {
        "name": "es-419",
        "url": "/api/v2/language/14/"
      },
      "version": {
        "name": "sword",
        "url": "/api/v2/version/33/"
      }
    },
    {
      "flavor_text": "みんかに　しのびこみ　ぬすみを\nはたらき　さらに　くやしがる　ひとの\nマイナスエネルギーも　いただくのだ。",
      "language": {
        "name": "ja-hrkt",
        "url": "/api/v2/language/1/"
      },
      "version": {
        "name": "shield",
        "url": "/api/v2/version/34/"
      }
    },
    {
      "flavor_text": "민가에 숨어들어 도둑질을\n하고 속상해하는 사람의\n마이너스 에너지도 얻는다.",
      "language": {
        "name": "ko",
        "url": "/api/v2/language/3/"
      },
      "version": {
        "name": "shield",
        "url": "/api/v2/version/34/"
      }
    },
    {
      "flavor_text": "不但會溜進民宅偷盜，\n還會吸收人們悔恨時\n的負面能量。",
      "language": {
        "name": "zh-hant",
        "url": "/api/v2/language/4/"
      },
      "version": {
        "name": "shield",
        "url": "/api/v2/version/34/"
      }
    },
    {
      "flavor_text": "Il se glisse dans les foyers pour commettre\nun larcin et en profite pour se nourrir de l’énergie\nnégative des habitants contrariés.",
      "language": {
        "name": "fr",
        "url": "/api/v2/language/5/"
      },
      "version": {
        "name": "shield",
        "url": "/api/v2/version/34/"
      }
    },
    {
      "flavor_text": "Es schleicht sich in Häuser ein und geht dort auf\nDiebeszug. Zudem verleibt es sich die negative\nEnergie der deshalb verärgerten Menschen ein.",
      "language": {
        "name": "de",
        "url": "/api/v2/language/6/"
      },
      "version": {
        "name": "shield",
        "url": "/api/v2/version/34/"
      }
    },
    {
      "flavor_text": "Se infiltra en las casas para hurtar a sus anchas y,\npor si fuera poco, nutrirse de la energía negativa\nque liberan sus contrariados habitantes.",
      "language": {
        "name": "es",
        "url": "/api/v2/language/7/"
      },
      "version": {
        "name": "shield",
        "url": "/api/v2/version/34/"
      }
    },
    {
      "flavor_text": "Si intrufola nelle case, ruba, e come se non\nbastasse si nutre anche dell’energia negativa\ndei padroni di casa rattristati per il furto.",
      "language": {
        "name": "it",
        "url": "/api/v2/language/8/"
      },
      "version": {
        "name": "shield",
        "url": "/api/v2/version/34/"
      }
    },
    {
      "flavor_text": "It sneaks into people’s homes, stealing things\nand feasting on the negative energy of the\nfrustrated occupants.",
      "language": {
        "name": "en",
        "url": "/api/v2/language/9/"
      },
      "version": {
        "name": "shield",
        "url": "/api/v2/version/34/"
      }
    },
    {
      "flavor_text": "民家に　忍びこみ　盗みを\n働き　さらに　悔しがる　人の\nマイナスエネルギーも　いただくのだ。",
      "language": {
        "name": "ja",
        "url": "/api/v2/language/11/"
      },
      "version": {
        "name": "shield",
        "url": "/api/v2/version/34/"
      }
    },
    {
      "flavor_text": "不但会溜进民宅偷盗，\n还会吸收人们悔恨时\n的负面能量。",
      "language": {
        "name": "zh-hans",
        "url": "/api/v2/language/12/"
      },
      "version": {
        "name": "shield",
        "url": "/api/v2/version/34/"
      }
    },
    {
      "flavor_text": "Se infiltra en las casas para hurtar a sus anchas y,\npor si fuera poco, nutrirse de la energía negativa\nque liberan sus contrariados habitantes.",
      "language": {
        "name": "es-419",
        "url": "/api/v2/language/14/"
      },
      "version": {
        "name": "shield",
        "url": "/api/v2/version/34/"
      }
    }
