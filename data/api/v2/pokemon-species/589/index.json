        "url": "/api/v2/language/7/"
      },
      "version": {
        "name": "sword",
        "url": "/api/v2/version/33/"
      }
    },
    {
      "flavor_text": "Si appropria della conchiglia di Shelmet e la usa\nper proteggere tutto il suo corpo. È amatissimo\ndagli abitanti di Galar.",
