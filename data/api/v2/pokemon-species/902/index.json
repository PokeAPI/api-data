        "name": "violet",
        "url": "/api/v2/version/41/"
      }
    },
    {
      "flavor_text": "Es verfügt über eine nahezu unheimliche Sprungkraft. Der Zorn von verstorbenen Artgenossen färbt seinen Körper rot.",
      "language": {
        "name": "de",
        "url": "/api/v2/language/6/"
