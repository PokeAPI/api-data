      },
      "version": {
        "name": "x",
        "url": "/api/v2/version/23/"
      }
    },
    {
      "flavor_text": "It chats with others using the sounds of its colliding\nantennae. These sounds are fall hallmarks.",
      "language": {
        "name": "en",
