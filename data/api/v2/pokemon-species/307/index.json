        "name": "fr",
        "url": "/api/v2/language/5/"
      },
      "version": {
        "name": "x",
        "url": "/api/v2/version/23/"
      }
    },
    {
      "flavor_text": "Trainiert tief in den Bergen. Erhöht es seine\nspirituelle Kraft durch Meditation, kann es schweben.",
