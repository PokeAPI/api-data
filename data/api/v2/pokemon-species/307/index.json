        "name": "ko",
        "url": "/api/v2/language/3/"
      },
      "version": {
        "name": "y",
        "url": "/api/v2/version/24/"
      }
    },
    {
      "flavor_text": "Il ne mange qu’une Baie par jour. La faim lui a forgé\nune volonté de fer.",
