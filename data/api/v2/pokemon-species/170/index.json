      },
      "version": {
        "name": "sword",
        "url": "/api/v2/version/33/"
      }
    },
    {
      "flavor_text": "Sus otrora dos aletas han evolucionado a las\nactuales antenas y ambas tienen carga positiva\ny negativa.",
