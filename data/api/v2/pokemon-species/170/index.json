      "version": {
        "name": "shield",
        "url": "/api/v2/version/34/"
      }
    },
    {
      "flavor_text": "어두운 해저에서는 항상\n깜빡거리는 촉수의 빛이\n유일한 통신 수단이다.",
      "language": {
        "name": "ko",
