      "version": {
        "name": "y",
        "url": "/api/v2/version/24/"
      }
    },
    {
      "flavor_text": "Es stürzt sich von Decken und Wänden auf Beute.\nSein feuriger Schweif ist nur eine seiner Waffen.",
