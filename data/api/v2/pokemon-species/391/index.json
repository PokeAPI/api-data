        "name": "ko",
        "url": "/api/v2/language/3/"
      },
      "version": {
        "name": "y",
        "url": "/api/v2/version/24/"
      }
    },
    {
      "flavor_text": "Il attaque en prenant appui sur les murs et les\nplafonds. Sa queue ardente n’est pas son seul atout.",
