        "name": "fr",
        "url": "/api/v2/language/5/"
      },
      "version": {
        "name": "y",
        "url": "/api/v2/version/24/"
      }
    },
    {
      "flavor_text": "Die Antenne auf seinem Kopf empfängt Radiowellen\naus einer anderen Dimension.",
