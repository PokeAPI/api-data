    },
    {
      "flavor_text": "弾力のある　体の　中に\n行き場のない　魂を　取りこんで\nあの世に　連れていくと　言われる。",
      "language": {
        "name": "ja",
        "url": "/api/v2/language/11/"
      },
      "version": {
