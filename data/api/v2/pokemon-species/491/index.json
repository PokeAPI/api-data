        "name": "fr",
        "url": "/api/v2/language/5/"
      },
      "version": {
        "name": "y",
        "url": "/api/v2/version/24/"
      }
    },
    {
      "flavor_text": "Es kann andere in Schlaf versetzen und ihnen\nTräume geben. Es ist nur bei Neumond aktiv.",
