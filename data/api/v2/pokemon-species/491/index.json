        "url": "/api/v2/language/5/"
      },
      "version": {
        "name": "x",
        "url": "/api/v2/version/23/"
      }
    },
    {
      "flavor_text": "Es vertreibt Eindringlinge aus seinem Revier,\nindem es sie in Schlaf versetzt und mit\nAlpträumen quält.",
      "language": {
        "name": "de",
        "url": "/api/v2/language/6/"
      },
      "version": {
        "name": "x",
        "url": "/api/v2/version/23/"
      }
    },
    {
      "flavor_text": "Defiende su territorio de personas y Pokémon\nhaciéndoles dormir y provocándoles pesadillas.",
      "language": {
