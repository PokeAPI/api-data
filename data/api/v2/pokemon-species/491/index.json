        "url": "/api/v2/language/6/"
      },
      "version": {
        "name": "y",
        "url": "/api/v2/version/24/"
      }
    },
    {
      "flavor_text": "Puede adormecer a la gente y hacerles soñar. Está\nactivo en las noches de luna nueva.",
