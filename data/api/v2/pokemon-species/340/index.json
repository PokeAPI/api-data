        "name": "ko",
        "url": "/api/v2/language/3/"
      },
      "version": {
        "name": "y",
        "url": "/api/v2/version/24/"
      }
    },
    {
      "flavor_text": "Il fait son nid au fond des marais. Il ne se pose pas\nde questions et avale toutes les créatures qui passent\nprès de lui.",
