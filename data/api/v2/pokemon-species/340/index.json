        "name": "es",
        "url": "/api/v2/language/7/"
      },
      "version": {
        "name": "shield",
        "url": "/api/v2/version/34/"
      }
    },
    {
      "flavor_text": "Stabilisce il suo territorio nelle grandi paludi.\nSe un nemico si avvicina, si scatena provocando\ngrossi terremoti.",
      "language": {
