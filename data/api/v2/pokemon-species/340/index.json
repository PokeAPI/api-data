        "name": "de",
        "url": "/api/v2/language/6/"
      },
      "version": {
        "name": "x",
        "url": "/api/v2/version/23/"
      }
    },
    {
      "flavor_text": "Habita en grandes pantanos. Si se acerca un enemigo,\nse alborota y causa temblores monumentales.",
