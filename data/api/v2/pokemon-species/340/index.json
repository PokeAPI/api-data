        "name": "es",
        "url": "/api/v2/language/7/"
      },
      "version": {
        "name": "x",
        "url": "/api/v2/version/23/"
      }
    },
    {
      "flavor_text": "Stabilisce il suo territorio nelle grandi paludi. Se\nil nemico gli si accosta, provoca un terremoto.",
