        "name": "ko",
        "url": "/api/v2/language/3/"
      },
      "version": {
        "name": "x",
        "url": "/api/v2/version/23/"
      }
    },
    {
      "flavor_text": "Il a besoin d’un étang entier pour vivre. Si un ennemi\ns’approche, il s’énerve et déclenche un séisme.",
      "language": {
        "name": "fr",
        "url": "/api/v2/language/5/"
      },
      "version": {
        "name": "x",
        "url": "/api/v2/version/23/"
      }
    },
    {
      "flavor_text": "Sein Revier hat es im Sumpfland. Nähert sich ein Feind,\nzappelt es wie wild und erzeugt so Erdbeben.",
