        "name": "fr",
        "url": "/api/v2/language/5/"
      },
      "version": {
        "name": "y",
        "url": "/api/v2/version/24/"
      }
    },
    {
      "flavor_text": "Sein Nest baut es am Grund von Sümpfen. Es frisst\nalles, wenn es nur lebendig ist. Welsar frisst einfach\nalles.",
      "language": {
        "name": "de",
        "url": "/api/v2/language/6/"
      },
      "version": {
        "name": "y",
        "url": "/api/v2/version/24/"
      }
    },
    {
