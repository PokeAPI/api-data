  "flavor_text_entries": [
    {
      "flavor_text": "WHISCASH is extremely territorial.\nJust one of these POKéMON will claim a\nlarge pond as its exclusive territory.\fIf a foe approaches it, it thrashes\nabout and triggers a massive\nearthquake.",
      "language": {
        "name": "en",
        "url": "/api/v2/language/9/"
      },
      "version": {
        "name": "ruby",
        "url": "/api/v2/version/7/"
      }
    },
    {
      "flavor_text": "If WHISCASH goes on a wild rampage,\nit sets off a quake-like tremor with a\nradius of over three miles.\fThis POKéMON has the ability to predict\nreal earthquakes.",
      "language": {
        "name": "en",
        "url": "/api/v2/language/9/"
      },
      "version": {
        "name": "sapphire",
        "url": "/api/v2/version/8/"
      }
    },
    {
      "flavor_text": "Mysteriously, it can foretell earthquakes.\nIn the daytime, it sleeps in mud at the\nbottom of a pond. When it awakens, it\ncontinually feeds throughout the night.",
      "language": {
        "name": "en",
        "url": "/api/v2/language/9/"
      },
      "version": {
        "name": "emerald",
        "url": "/api/v2/version/9/"
      }
    },
    {
      "flavor_text": "It makes its nest at the bottom of\nswamps. It will eat anything - if it is\nalive, WHISCASH will eat it.",
      "language": {
        "name": "en",
        "url": "/api/v2/language/9/"
      },
      "version": {
        "name": "firered",
        "url": "/api/v2/version/10/"
      }
    },
    {
