        "url": "/api/v2/version/3/"
      }
    },
    {
      "flavor_text": "It is dangerous.\nIf it has too much\nelectricity and\fhas nothing to do,\nit amuses itself\nby exploding.",
      "language": {
        "name": "en",
        "url": "/api/v2/language/9/"
