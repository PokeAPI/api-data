        "url": "/api/v2/language/7/"
      },
      "version": {
        "name": "x",
        "url": "/api/v2/version/23/"
      }
    },
    {
      "flavor_text": "Può esplodere anche alla minima provocazione.\nLo chiamano “Bomba Ball”.",
