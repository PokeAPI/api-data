        "url": "/api/v2/language/9/"
      },
      "version": {
        "name": "diamond",
        "url": "/api/v2/version/12/"
      }
    },
    {
      "flavor_text": "Emanations from its fingertips\nsolidify the air into invisible walls\nthat repel even harsh attacks.",
