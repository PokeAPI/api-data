  "form_descriptions": [],
  "flavor_text_entries": [
    {
      "flavor_text": "ガラルの　いたるところに　いる。\nさゆうの　ほっぺに　きのみを\nたくわえていないと　ふあん。",
      "language": {
        "name": "ja-hrkt",
        "url": "/api/v2/language/1/"
      },
      "version": {
        "name": "sword",
        "url": "/api/v2/version/33/"
      }
    },
    {
      "flavor_text": "가라르의 여기저기에 있다.\n양쪽 볼에 나무열매를\n비축해두지 않으면 불안해한다.",
      "language": {
        "name": "ko",
        "url": "/api/v2/language/3/"
      },
      "version": {
        "name": "sword",
        "url": "/api/v2/version/33/"
      }
    },
    {
      "flavor_text": "在伽勒爾隨處可見。\n如果不往兩邊的頰囊裡\n塞滿樹果，就會感到不安。",
      "language": {
        "name": "zh-hant",
        "url": "/api/v2/language/4/"
      },
      "version": {
        "name": "sword",
        "url": "/api/v2/version/33/"
      }
    },
    {
      "flavor_text": "On le trouve partout à Galar. S’il n’a pas de Baies\nen réserve dans ses deux joues, il devient anxieux.",
      "language": {
        "name": "fr",
        "url": "/api/v2/language/5/"
      },
      "version": {
        "name": "sword",
        "url": "/api/v2/version/33/"
      }
    },
    {
      "flavor_text": "Es ist überall in der Galar-Region anzutreffen.\nHat es keine Beeren, die es in seinen beiden\nBacken horten kann, wird es unruhig.",
      "language": {
        "name": "de",
        "url": "/api/v2/language/6/"
      },
      "version": {
        "name": "sword",
        "url": "/api/v2/version/33/"
      }
    },
    {
      "flavor_text": "Este Pokémon se encuentra por todo Galar.\nNo se queda tranquilo hasta que tiene ambos\ncarrillos atiborrados de bayas.",
      "language": {
        "name": "es",
        "url": "/api/v2/language/7/"
      },
      "version": {
        "name": "sword",
        "url": "/api/v2/version/33/"
      }
    },
    {
      "flavor_text": "Si trova ovunque a Galar. Se non ha una scorta\ndi bacche dentro le guance, si fa prendere\ndall’ansia.",
      "language": {
        "name": "it",
        "url": "/api/v2/language/8/"
      },
      "version": {
        "name": "sword",
        "url": "/api/v2/version/33/"
      }
    },
    {
      "flavor_text": "Found throughout the Galar region, this Pokémon\nbecomes uneasy if its cheeks are ever completely\nempty of berries.",
      "language": {
        "name": "en",
        "url": "/api/v2/language/9/"
      },
      "version": {
        "name": "sword",
        "url": "/api/v2/version/33/"
      }
    },
    {
      "flavor_text": "ガラルの　いたるところに　いる。\n左右の　ほっぺに　木の実を\n蓄えていないと　不安。",
      "language": {
        "name": "ja",
        "url": "/api/v2/language/11/"
      },
      "version": {
        "name": "sword",
        "url": "/api/v2/version/33/"
      }
    },
    {
      "flavor_text": "在伽勒尔随处可见。\n如果不往两边的颊囊里\n塞满树果，就会感到不安。",
      "language": {
        "name": "zh-hans",
        "url": "/api/v2/language/12/"
      },
      "version": {
        "name": "sword",
        "url": "/api/v2/version/33/"
      }
    },
    {
      "flavor_text": "Este Pokémon se encuentra por todo Galar.\nNo se queda tranquilo hasta que tiene ambos\ncarrillos atiborrados de bayas.",
      "language": {
        "name": "es-419",
        "url": "/api/v2/language/14/"
      },
      "version": {
        "name": "sword",
        "url": "/api/v2/version/33/"
      }
    },
    {
      "flavor_text": "つねに　きのみを　くっているので\nみかけいじょうに　タフ。　きのみを\nねらって　はたけに　あらわれる。",
      "language": {
        "name": "ja-hrkt",
        "url": "/api/v2/language/1/"
      },
      "version": {
        "name": "shield",
        "url": "/api/v2/version/34/"
      }
    },
    {
      "flavor_text": "항상 나무열매를 먹고 있어\n보기보다 튼튼하다. 나무열매를\n노리고 밭에 출몰한다.",
      "language": {
        "name": "ko",
        "url": "/api/v2/language/3/"
      },
      "version": {
        "name": "shield",
        "url": "/api/v2/version/34/"
      }
    },
    {
      "flavor_text": "由於牠無論何時都在吃樹果，\n使得牠比外表看起來還要頑強。\n會出現在田地裡尋找樹果。",
      "language": {
        "name": "zh-hant",
        "url": "/api/v2/language/4/"
      },
      "version": {
        "name": "shield",
        "url": "/api/v2/version/34/"
      }
    },
    {
      "flavor_text": "Comme il mange tout le temps des Baies, il est\nplus costaud qu’il n’en a l’air. Il parcourt les\nchamps à la recherche de sa précieuse denrée.",
      "language": {
        "name": "fr",
        "url": "/api/v2/language/5/"
      },
      "version": {
        "name": "shield",
        "url": "/api/v2/version/34/"
      }
    },
    {
      "flavor_text": "Da es unentwegt Beeren futtert, ist es zäher als\nes aussieht. Man sieht es oft auf Feldern, wo es\nnach Beeren sucht.",
      "language": {
        "name": "de",
        "url": "/api/v2/language/6/"
      },
      "version": {
        "name": "shield",
        "url": "/api/v2/version/34/"
      }
    },
    {
      "flavor_text": "Siempre están comiendo bayas, por lo que son\nmás robustos de lo que aparentan. Frecuentan\nlos huertos en busca de su preciado manjar.",
      "language": {
        "name": "es",
        "url": "/api/v2/language/7/"
      },
      "version": {
        "name": "shield",
        "url": "/api/v2/version/34/"
      }
    },
    {
      "flavor_text": "Per via dell’abitudine di mangiare senza sosta,\nè più forte di quanto possa sembrare. Fa incetta\ndi bacche nei campi coltivati.",
      "language": {
        "name": "it",
        "url": "/api/v2/language/8/"
      },
      "version": {
        "name": "shield",
        "url": "/api/v2/version/34/"
      }
    },
    {
      "flavor_text": "It eats berries nonstop—a habit that has made\nit more resilient than it looks. It’ll show up on\nfarms, searching for yet more berries.",
      "language": {
        "name": "en",
        "url": "/api/v2/language/9/"
      },
      "version": {
        "name": "shield",
        "url": "/api/v2/version/34/"
      }
    },
    {
      "flavor_text": "つねに　木の実を　食っているので\n見かけ以上に　タフ。　木の実を\n狙って　畑に　現れる。",
      "language": {
        "name": "ja",
        "url": "/api/v2/language/11/"
      },
      "version": {
        "name": "shield",
        "url": "/api/v2/version/34/"
      }
    },
    {
      "flavor_text": "由于它无论何时都在吃树果，\n使得它比外表看起来还要顽强。\n会出现在田地里寻找树果。",
      "language": {
        "name": "zh-hans",
        "url": "/api/v2/language/12/"
      },
      "version": {
        "name": "shield",
        "url": "/api/v2/version/34/"
      }
    },
    {
      "flavor_text": "Siempre están comiendo bayas, por lo que son\nmás robustos de lo que aparentan. Frecuentan\nlos huertos en busca de su preciado manjar.",
      "language": {
        "name": "es-419",
        "url": "/api/v2/language/14/"
      },
      "version": {
        "name": "shield",
        "url": "/api/v2/version/34/"
      }
    }
