        "name": "en",
        "url": "/api/v2/language/9/"
      },
      "version": {
        "name": "ruby",
        "url": "/api/v2/version/7/"
      }
    },
    {
      "flavor_text": "SILCOON was thought to endure hunger\nand not consume anything before its\nevolution. However, it is now thought\fthat this POKéMON slakes its thirst by\ndrinking rainwater that collects on its\nsilk.",
      "language": {
        "name": "en",
