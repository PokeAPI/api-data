        "url": "/api/v2/language/6/"
      },
      "version": {
        "name": "y",
        "url": "/api/v2/version/24/"
      }
    },
    {
      "flavor_text": "Prefiere entornos áridos. Sus ojos expulsan agua\npara ajustar sus niveles de hidratación corporal.",
