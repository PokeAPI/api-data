        "url": "/api/v2/language/5/"
      },
      "version": {
        "name": "black",
        "url": "/api/v2/version/17/"
      }
    },
    {
      "flavor_text": "Starry skies thousands of light-years\naway are visible in the space distorted\nby their intense psychic power.",
      "language": {
        "name": "en",
        "url": "/api/v2/language/9/"
      },
      "version": {
        "name": "black",
        "url": "/api/v2/version/17/"
      }
    },
    {
      "flavor_text": "Prédit l’avenir à partir de la position\net du mouvement des étoiles. Perçoit\naussi l’espérance de vie des Dresseurs.",
