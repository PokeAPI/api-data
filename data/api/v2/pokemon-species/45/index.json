      "version": {
        "name": "ruby",
        "url": "/api/v2/version/7/"
      }
    },
    {
      "flavor_text": "VILEPLUME has the world’s largest\npetals. They are used to attract prey\nthat are then doused with toxic spores.\fOnce the prey are immobilized, this\nPOKéMON catches and devours them.",
      "language": {
        "name": "en",
        "url": "/api/v2/language/9/"
