        "name": "es",
        "url": "/api/v2/language/7/"
      },
      "version": {
        "name": "y",
        "url": "/api/v2/version/24/"
      }
    },
    {
      "flavor_text": "Vive nelle foreste e nei campi muovendosi in grandi\ngruppi. Se due gruppi si incontrano, lottano\nper il territorio.",
