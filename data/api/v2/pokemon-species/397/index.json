      },
      "version": {
        "name": "x",
        "url": "/api/v2/version/23/"
      }
    },
    {
      "flavor_text": "They maintain huge flocks, although fierce scuffles\nbreak out between various flocks.",
      "language": {
        "name": "en",
        "url": "/api/v2/language/9/"
      },
