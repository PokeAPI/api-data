        "name": "de",
        "url": "/api/v2/language/6/"
      },
      "version": {
        "name": "y",
        "url": "/api/v2/version/24/"
      }
    },
    {
      "flavor_text": "Vive en bosques y campos. Si dos bandadas se\nencuentran, pelean por el territorio.",
