        "name": "ruby",
        "url": "/api/v2/version/7/"
      }
    },
    {
      "flavor_text": "NINCADA lives underground. It uses its\nsharp claws to carve the roots of trees\nand absorb moisture and nutrients.\fThis POKéMON can’t withstand bright\nsunlight so avoids it.",
      "language": {
        "name": "en",
        "url": "/api/v2/language/9/"
      },
      "version": {
        "name": "sapphire",
        "url": "/api/v2/version/8/"
      }
    },
    {
