        "name": "ko",
        "url": "/api/v2/language/3/"
      },
      "version": {
        "name": "x",
        "url": "/api/v2/version/23/"
      }
    },
    {
      "flavor_text": "Il est prisonnier d’une coquille d’acier. Ses yeux\nvigilants sont la seule partie visible de son corps.",
