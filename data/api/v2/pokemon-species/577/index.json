        "url": "/api/v2/language/5/"
      },
      "version": {
        "name": "sword",
        "url": "/api/v2/version/33/"
      }
    },
    {
      "flavor_text": "Monozyto kommunizieren untereinander mittels\nTelepathie. Erfährt es eine starke Erschütterung,\nläuft die Flüssigkeit, die es umgibt, aus.",
