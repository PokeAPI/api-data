        "name": "de",
        "url": "/api/v2/language/6/"
      },
      "version": {
        "name": "sword",
        "url": "/api/v2/version/33/"
      }
    },
    {
      "flavor_text": "Se comunica mediante telepatía. Si recibe un\nfuerte golpe, la sustancia viscosa que lo envuelve\nse desparrama.",
