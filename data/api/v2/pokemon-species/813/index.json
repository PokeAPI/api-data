        "url": "/api/v2/version/40/"
      }
    },
    {
      "flavor_text": "ほのおエネルギーが　あつまるあしの　にくきゅうは　こうおんになりあいてに　だいダメージを　あたえる。",
      "language": {
        "name": "ja-hrkt",
        "url": "/api/v2/language/1/"
