      },
      "version": {
        "name": "violet",
        "url": "/api/v2/version/41/"
      }
    },
    {
      "flavor_text": "聚集了火之能量的腳底肉球會升至高溫，帶給對手巨大的傷害。",
      "language": {
        "name": "zh-hant",
        "url": "/api/v2/language/4/"
      },
      "version": {
