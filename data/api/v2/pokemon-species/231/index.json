        "name": "en",
        "url": "/api/v2/language/9/"
      },
      "version": {
        "name": "silver",
        "url": "/api/v2/version/5/"
      }
    },
    {
      "flavor_text": "During the desert­\ned morning hours,\nit comes ashore\fwhere it deftly\nuses its trunk to\ntake a shower.",
