        "url": "/api/v2/language/5/"
      },
      "version": {
        "name": "x",
        "url": "/api/v2/version/23/"
      }
    },
    {
      "flavor_text": "Als Zeichen seiner Zuneigung stupst es dich mit\ndem Rüssel, was dich aber buchstäblich umwerfen\nkönnte.",
