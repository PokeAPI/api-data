        "url": "/api/v2/version/6/"
      }
    },
    {
      "flavor_text": "For its nest, PHANPY digs a vertical pit\nin the ground at the edge of a river.\nIt marks the area around its nest with\fits trunk to let the others know that\nthe area has been claimed.",
      "language": {
        "name": "en",
        "url": "/api/v2/language/9/"
