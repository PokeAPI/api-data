    },
    {
      "flavor_text": "Presiente desastres inminentes y se aparece a la gente\npara advertir del peligro.",
      "language": {
        "name": "es-419",
        "url": "/api/v2/language/14/"
      },
      "version": {
        "name": "x",
        "url": "/api/v2/version/23/"
