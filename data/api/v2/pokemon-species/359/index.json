        "url": "/api/v2/version/34/"
      }
    },
    {
      "flavor_text": "Absol kann Gefahr verspüren, weshalb Menschen\nirrtümlicherweise dachten, dieses Pokémon\nbringe ihnen Unheil.",
      "language": {
        "name": "de",
        "url": "/api/v2/language/6/"
