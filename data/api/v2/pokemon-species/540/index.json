      "version": {
        "name": "scarlet",
        "url": "/api/v2/version/40/"
      }
    },
    {
      "flavor_text": "Usa como patrón la ropa que le teje Leavanny para aprender a elaborar él mismo atavíos con las hojas de los árboles que recorta.",
