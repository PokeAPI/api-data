        "name": "fr",
        "url": "/api/v2/language/5/"
      },
      "version": {
        "name": "y",
        "url": "/api/v2/version/24/"
      }
    },
    {
      "flavor_text": "Unter Modeschöpfern gilt es als beliebtes\nMaskottchen, da es sich aus Blättern\nKleidchen schneidert.",
