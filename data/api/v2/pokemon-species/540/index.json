      "version": {
        "name": "y",
        "url": "/api/v2/version/24/"
      }
    },
    {
      "flavor_text": "Usa hojas como material para fabricar su propia ropa,\npor lo que los diseñadores más famosos los tienen\ncomo mascota.",
