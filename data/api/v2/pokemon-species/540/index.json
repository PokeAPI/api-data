  "flavor_text_entries": [
    {
      "flavor_text": "Quand il éclot, Manternel lui coud son\nvêtement. Il dort en cachant son\nvisage sous sa capuche.",
      "language": {
        "name": "fr",
        "url": "/api/v2/language/5/"
      },
      "version": {
        "name": "black",
        "url": "/api/v2/version/17/"
      }
    },
    {
      "flavor_text": "Leavanny dress it in clothes they made\nfor it when it hatched. It hides its head\nin its hood while it is sleeping.",
      "language": {
        "name": "en",
        "url": "/api/v2/language/9/"
      },
      "version": {
        "name": "black",
        "url": "/api/v2/version/17/"
      }
    },
    {
      "flavor_text": "Il fait des vêtements en découpant des\nfeuilles et en les cousant avec le fil\nadhésif qu’il sécrète par la bouche.",
