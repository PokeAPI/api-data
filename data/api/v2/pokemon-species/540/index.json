        "url": "/api/v2/version/40/"
      }
    },
    {
      "flavor_text": "Rosicchia le foglie degli alberi per crearsi vestiti prendendo a modello quello che gli ha fatto indossare Leavanny.",
      "language": {
        "name": "it",
        "url": "/api/v2/language/8/"
