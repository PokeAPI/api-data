        "url": "/api/v2/version/23/"
      }
    },
    {
      "flavor_text": "がんじょうな　カラに　まもられて\nいっしょうの　うちに　１こだけ\nみごとな　しんじゅを　つくる。",
      "language": {
        "name": "ja-hrkt",
