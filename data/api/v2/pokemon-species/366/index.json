        "url": "/api/v2/language/5/"
      },
      "version": {
        "name": "x",
        "url": "/api/v2/version/23/"
      }
    },
    {
      "flavor_text": "Es entwickelt sich nur einmal im Leben, wobei es\neine wundersame Perle erzeugt, die Psycho-Kräfte\nverstärkt.",
