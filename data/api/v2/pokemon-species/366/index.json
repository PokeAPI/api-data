        "url": "/api/v2/language/6/"
      },
      "version": {
        "name": "y",
        "url": "/api/v2/version/24/"
      }
    },
    {
      "flavor_text": "Está protegido por una sólida concha. Puede llegar a\nformar una perla extraordinaria.",
