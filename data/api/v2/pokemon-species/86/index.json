        "url": "/api/v2/language/4/"
      },
      "version": {
        "name": "ultra-moon",
        "url": "/api/v2/version/30/"
      }
    },
    {
      "flavor_text": "Sa couche de gras lui permet d’être à l’aise\ndans les eaux les plus froides. Il a par contre\nplus de mal à supporter les mers chaudes.",
      "language": {
