        "url": "/api/v2/version/33/"
      }
    },
    {
      "flavor_text": "Il attire ses proies et les endort grâce\nau clignotement de ses spores. Il aspire ensuite\nleur énergie vitale du bout de ses doigts.",
      "language": {
        "name": "fr",
        "url": "/api/v2/language/5/"
