      "version": {
        "name": "sword",
        "url": "/api/v2/version/33/"
      }
    },
    {
      "flavor_text": "Mit blinkenden Sporen lullt es seine Beute in\nden Schlaf und saugt ihr dann über seine\nFingerspitzen die Lebenskraft aus.",
