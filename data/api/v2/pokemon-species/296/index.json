      },
      "version": {
        "name": "ruby",
        "url": "/api/v2/version/7/"
      }
    },
    {
      "flavor_text": "MAKUHITA has a tireless spirit -\nit will never give up hope. It eats a lot\nof food, gets plenty of sleep, and it\ftrains very rigorously. By living that\nway, this POKéMON packs its body with\nenergy.",
      "language": {
        "name": "en",
        "url": "/api/v2/language/9/"
