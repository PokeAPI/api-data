        "url": "/api/v2/language/5/"
      },
      "version": {
        "name": "black",
        "url": "/api/v2/version/17/"
      }
    },
    {
      "flavor_text": "Its mane shines when it discharges\nelectricity. They use their flashing\nmanes to communicate with one another.",
