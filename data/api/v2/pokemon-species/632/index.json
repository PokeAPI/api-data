  "flavor_text_entries": [
    {
      "flavor_text": "Ils portent une armure de fer et se\nregroupent pour contrer les attaques\nde leurs prédateurs, les Aflamanoir.",
      "language": {
        "name": "fr",
        "url": "/api/v2/language/5/"
      },
      "version": {
        "name": "black",
        "url": "/api/v2/version/17/"
      }
    },
    {
      "flavor_text": "They attack in groups, covering\nthemselves in steel armor to\nprotect themselves from Heatmor.",
      "language": {
        "name": "en",
        "url": "/api/v2/language/9/"
      },
      "version": {
        "name": "black",
        "url": "/api/v2/version/17/"
      }
    },
    {
      "flavor_text": "Ils creusent des galeries dans les\nmontagnes. Les tunnels des Fermite\nsont de vrais labyrinthes.",
      "language": {
        "name": "fr",
        "url": "/api/v2/language/5/"
      },
      "version": {
        "name": "white",
        "url": "/api/v2/version/18/"
      }
    },
    {
      "flavor_text": "Durant dig nests in mountains.\nThey build their complicated,\ninterconnected tunnels into mazes.",
      "language": {
        "name": "en",
        "url": "/api/v2/language/9/"
      },
      "version": {
        "name": "white",
        "url": "/api/v2/version/18/"
      }
    },
    {
      "flavor_text": "Individuals each play different roles in\ndriving Heatmor, their natural predator,\naway from their colony.",
      "language": {
        "name": "en",
        "url": "/api/v2/language/9/"
      },
      "version": {
        "name": "black-2",
        "url": "/api/v2/version/21/"
      }
    },
    {
      "flavor_text": "Individuals each play different roles in\ndriving Heatmor, their natural predator,\naway from their colony.",
      "language": {
        "name": "en",
        "url": "/api/v2/language/9/"
      },
      "version": {
        "name": "white-2",
        "url": "/api/v2/version/22/"
      }
    },
    {
      "flavor_text": "てんてきの　クイタランに　たいして\nみんなで　やくわりぶんたん　しながら\nはんげきして　すから　おいはらう。",
      "language": {
        "name": "ja-hrkt",
        "url": "/api/v2/language/1/"
      },
      "version": {
        "name": "x",
        "url": "/api/v2/version/23/"
      }
    },
    {
      "flavor_text": "천적인 앤티골에 대해서\n모두와 역할 분담을 하면서\n반격해 둥지에서 쫓아낸다.",
      "language": {
        "name": "ko",
        "url": "/api/v2/language/3/"
      },
      "version": {
        "name": "x",
        "url": "/api/v2/version/23/"
      }
    },
    {
      "flavor_text": "Ils travaillent de concert pour protéger leur colonie\ndes terribles attaques de leur prédateur naturel,\nAflamanoir.",
      "language": {
        "name": "fr",
        "url": "/api/v2/language/5/"
      },
      "version": {
        "name": "x",
        "url": "/api/v2/version/23/"
      }
    },
    {
      "flavor_text": "Eine ausgeklügelte Rollenverteilung hilft ihnen dabei,\nihren natürlichen Feind Furnifraß\naus dem Nest zu verjagen.",
      "language": {
        "name": "de",
        "url": "/api/v2/language/6/"
      },
      "version": {
        "name": "x",
        "url": "/api/v2/version/23/"
      }
    },
    {
      "flavor_text": "Actúan en grupo para expulsar de sus colonias a los\nHeatmor, sus depredadores naturales.",
      "language": {
        "name": "es",
        "url": "/api/v2/language/7/"
      },
      "version": {
        "name": "x",
        "url": "/api/v2/version/23/"
      }
    },
    {
      "flavor_text": "Heatmor è il loro acerrimo nemico, e quando\nvogliono cacciarlo dalla tana si dividono i compiti\ne partono all’attacco!",
      "language": {
        "name": "it",
        "url": "/api/v2/language/8/"
      },
      "version": {
        "name": "x",
        "url": "/api/v2/version/23/"
      }
    },
    {
      "flavor_text": "Individuals each play different roles in driving\nHeatmor, their natural predator, away from\ntheir colony.",
      "language": {
        "name": "en",
        "url": "/api/v2/language/9/"
      },
      "version": {
        "name": "x",
        "url": "/api/v2/version/23/"
      }
    },
    {
      "flavor_text": "天敵の　クイタランに　対して\nみんなで　役割分担　しながら\n反撃して　巣から　追い払う。",
      "language": {
        "name": "ja",
        "url": "/api/v2/language/11/"
      },
      "version": {
        "name": "x",
        "url": "/api/v2/version/23/"
      }
    },
    {
      "flavor_text": "Actúan en grupo para expulsar de sus colonias a los\nHeatmor, sus depredadores naturales.",
      "language": {
        "name": "es-419",
        "url": "/api/v2/language/14/"
      },
      "version": {
        "name": "x",
        "url": "/api/v2/version/23/"
      }
    },
    {
      "flavor_text": "はがねの　よろいを　みにまとう。\nてんてきの　クイタランの　こうげきを\nしゅうだんで　ふせぎ　はんげきする。",
      "language": {
        "name": "ja-hrkt",
        "url": "/api/v2/language/1/"
      },
      "version": {
        "name": "y",
        "url": "/api/v2/version/24/"
      }
    },
    {
      "flavor_text": "강철의 갑옷을 몸에 걸친다.\n천적인 앤티골의 공격을\n집단으로 막아 반격한다.",
      "language": {
        "name": "ko",
        "url": "/api/v2/language/3/"
      },
      "version": {
        "name": "y",
        "url": "/api/v2/version/24/"
      }
    },
    {
      "flavor_text": "Ils portent une armure de fer et se regroupent pour\ncontrer les attaques de leurs prédateurs,\nles Aflamanoir.",
      "language": {
        "name": "fr",
        "url": "/api/v2/language/5/"
      },
      "version": {
        "name": "y",
        "url": "/api/v2/version/24/"
      }
    },
    {
      "flavor_text": "Ein eiserner Panzer umgibt seinen Leib. Angriffe von\nFurnifraß, seinem Feind, schlägt es in der Gruppe\nzurück.",
      "language": {
        "name": "de",
        "url": "/api/v2/language/6/"
      },
      "version": {
        "name": "y",
        "url": "/api/v2/version/24/"
      }
    },
    {
      "flavor_text": "Llevan una armadura de acero. Se defienden en grupo\npara contrarrestar a sus depredadores, los Heatmor.",
      "language": {
        "name": "es",
        "url": "/api/v2/language/7/"
      },
      "version": {
        "name": "y",
        "url": "/api/v2/version/24/"
      }
    },
    {
      "flavor_text": "È protetto da un’armatura d’acciaio. Si riunisce in\ngruppi per respingere gli attacchi di Heatmor, il suo\npredatore.",
      "language": {
        "name": "it",
        "url": "/api/v2/language/8/"
      },
      "version": {
        "name": "y",
        "url": "/api/v2/version/24/"
      }
    },
    {
      "flavor_text": "They attack in groups, covering themselves in steel\narmor to protect themselves from Heatmor.",
      "language": {
        "name": "en",
        "url": "/api/v2/language/9/"
      },
      "version": {
        "name": "y",
        "url": "/api/v2/version/24/"
      }
