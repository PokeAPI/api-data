  "flavor_text_entries": [
    {
      "flavor_text": "トゲの　さきから　でんきを　はなつ。\nするどい　はで　いわに　ついた\nかいそうを　こそいで　たべる。",
      "language": {
        "name": "ja-hrkt",
        "url": "/api/v2/language/1/"
      },
      "version": {
        "name": "sword",
        "url": "/api/v2/version/33/"
      }
    },
    {
      "flavor_text": "가시 끝에서 전기를 발산한다.\n날카로운 이빨로 바위에 붙은\n해초를 갉아 먹는다.",
      "language": {
        "name": "ko",
        "url": "/api/v2/language/3/"
      },
      "version": {
        "name": "sword",
        "url": "/api/v2/version/33/"
      }
    },
    {
      "flavor_text": "能從刺的尖端放電。\n會用銳利的牙齒刮取\n附在岩石上的海藻來吃。",
      "language": {
        "name": "zh-hant",
        "url": "/api/v2/language/4/"
      },
      "version": {
        "name": "sword",
        "url": "/api/v2/version/33/"
      }
    },
    {
      "flavor_text": "Il libère de l’électricité depuis la pointe de ses\népines, et se nourrit des algues accrochées aux\nrochers en les arrachant avec ses dents aiguisées.",
      "language": {
        "name": "fr",
        "url": "/api/v2/language/5/"
      },
      "version": {
        "name": "sword",
        "url": "/api/v2/version/33/"
      }
    },
    {
      "flavor_text": "Aus den Spitzen seiner Stacheln setzt es\nElektrizität frei. Mit seinen scharfen Zähnen\nschabt es Algen von Steinen ab und frisst sie.",
      "language": {
        "name": "de",
        "url": "/api/v2/language/6/"
      },
      "version": {
        "name": "sword",
        "url": "/api/v2/version/33/"
      }
    },
    {
      "flavor_text": "Libera electricidad por la punta de las púas.\nCon sus afilados dientes raspa las algas pegadas\na las rocas para ingerirlas.",
      "language": {
        "name": "es",
        "url": "/api/v2/language/7/"
      },
      "version": {
        "name": "sword",
        "url": "/api/v2/version/33/"
      }
    },
    {
      "flavor_text": "Sprigiona elettricità dalla punta dei suoi aculei.\nUsa i denti affilati per raschiare dalle rocce\nle alghe di cui si nutre.",
      "language": {
        "name": "it",
        "url": "/api/v2/language/8/"
      },
      "version": {
        "name": "sword",
        "url": "/api/v2/version/33/"
      }
    },
    {
      "flavor_text": "It feeds on seaweed, using its teeth to scrape it\noff rocks. Electric current flows from the tips of\nits spines.",
      "language": {
        "name": "en",
        "url": "/api/v2/language/9/"
      },
      "version": {
        "name": "sword",
        "url": "/api/v2/version/33/"
      }
    },
    {
      "flavor_text": "棘の　先から　電気を　放つ。\n鋭い　歯で　岩に　ついた\n海藻を　こそいで　食べる。",
      "language": {
        "name": "ja",
        "url": "/api/v2/language/11/"
      },
      "version": {
        "name": "sword",
        "url": "/api/v2/version/33/"
      }
    },
    {
      "flavor_text": "能从刺的尖端放电。\n会用锐利的牙齿刮取\n附在岩石上的海藻吃。",
      "language": {
        "name": "zh-hans",
        "url": "/api/v2/language/12/"
      },
      "version": {
        "name": "sword",
        "url": "/api/v2/version/33/"
      }
    },
    {
      "flavor_text": "Libera electricidad por la punta de las púas.\nCon sus afilados dientes raspa las algas pegadas\na las rocas para ingerirlas.",
      "language": {
        "name": "es-419",
        "url": "/api/v2/language/14/"
      },
      "version": {
        "name": "sword",
        "url": "/api/v2/version/33/"
      }
    },
    {
      "flavor_text": "トゲの　１ぽん　１ぽんに　でんきを\nたくわえる。　おれた　トゲでも\n３じかんは　ほうでんを　つづけるぞ。",
      "language": {
        "name": "ja-hrkt",
        "url": "/api/v2/language/1/"
      },
      "version": {
        "name": "shield",
        "url": "/api/v2/version/34/"
      }
    },
    {
      "flavor_text": "가시 하나하나에 전기를\n비축하고 있다. 부러진 가시도\n3시간 동안 방전을 계속한다.",
      "language": {
        "name": "ko",
        "url": "/api/v2/language/3/"
      },
      "version": {
        "name": "shield",
        "url": "/api/v2/version/34/"
      }
    },
    {
      "flavor_text": "每根刺裡都儲存著電力。\n即使是折斷的刺也至少\n能持續放電３小時。",
      "language": {
        "name": "zh-hant",
        "url": "/api/v2/language/4/"
      },
      "version": {
        "name": "shield",
        "url": "/api/v2/version/34/"
      }
    },
    {
      "flavor_text": "Chacune de ses épines est chargée en électricité.\nS’il en perd une, celle-ci continue d’émettre\nun courant électrique pendant trois heures.",
      "language": {
        "name": "fr",
        "url": "/api/v2/language/5/"
      },
      "version": {
        "name": "shield",
        "url": "/api/v2/version/34/"
      }
    },
    {
      "flavor_text": "In jedem einzelnen seiner Stacheln speichert es\nElektrizität. Selbst abgebrochene Stacheln sind\nnoch drei Stunden lang geladen.",
      "language": {
        "name": "de",
        "url": "/api/v2/language/6/"
      },
      "version": {
        "name": "shield",
        "url": "/api/v2/version/34/"
      }
    },
    {
      "flavor_text": "Acumula electricidad en cada una de sus púas.\nAunque estas se rompan, son capaces de seguir\ndescargando energía durante 3 h.",
      "language": {
        "name": "es",
        "url": "/api/v2/language/7/"
      },
      "version": {
        "name": "shield",
        "url": "/api/v2/version/34/"
      }
    },
    {
      "flavor_text": "Ogni singolo aculeo è carico di elettricità.\nQuando se ne rompe uno, continua a emettere\nscariche elettriche per tre ore.",
      "language": {
        "name": "it",
        "url": "/api/v2/language/8/"
      },
      "version": {
        "name": "shield",
        "url": "/api/v2/version/34/"
      }
    },
    {
      "flavor_text": "It stores electricity in each spine. Even if one gets\nbroken off, it still continues to emit electricity for\nat least three hours.",
      "language": {
        "name": "en",
        "url": "/api/v2/language/9/"
      },
      "version": {
        "name": "shield",
        "url": "/api/v2/version/34/"
      }
    },
    {
      "flavor_text": "棘の　１本　１本に　電気を\n蓄える。　折れた　棘でも\n３時間は　放電を　続けるぞ。",
      "language": {
        "name": "ja",
        "url": "/api/v2/language/11/"
      },
      "version": {
        "name": "shield",
        "url": "/api/v2/version/34/"
      }
    },
    {
      "flavor_text": "每根刺里都储存着电力。\n即使是折断的刺也至少\n能连续放电３小时。",
      "language": {
        "name": "zh-hans",
        "url": "/api/v2/language/12/"
      },
      "version": {
        "name": "shield",
        "url": "/api/v2/version/34/"
      }
    },
    {
      "flavor_text": "Acumula electricidad en cada una de sus púas.\nAunque estas se rompan, son capaces de seguir\ndescargando energía durante 3 h.",
      "language": {
