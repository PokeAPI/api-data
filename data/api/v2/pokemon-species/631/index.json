  "flavor_text_entries": [
    {
      "flavor_text": "Il aspire de l’air par la queue et\nentretient un brasier dans son corps.\nC’est le prédateur des Fermite.",
      "language": {
        "name": "fr",
        "url": "/api/v2/language/5/"
      },
      "version": {
        "name": "black",
        "url": "/api/v2/version/17/"
      }
    },
    {
      "flavor_text": "It breathes through a hole in its tail\nwhile it burns with an internal fire.\nDurant is its prey.",
      "language": {
        "name": "en",
        "url": "/api/v2/language/9/"
      },
      "version": {
        "name": "black",
        "url": "/api/v2/version/17/"
      }
    },
    {
      "flavor_text": "Avec sa langue de feu à haute\ntempérature, il fait fondre le corps\nd’acier des Fermite pour les dévorer.",
      "language": {
        "name": "fr",
        "url": "/api/v2/language/5/"
      },
      "version": {
        "name": "white",
        "url": "/api/v2/version/18/"
      }
    },
    {
      "flavor_text": "Using their very hot, flame-covered\ntongues, they burn through Durant’s\nsteel bodies and consume their insides.",
      "language": {
        "name": "en",
        "url": "/api/v2/language/9/"
      },
      "version": {
        "name": "white",
        "url": "/api/v2/version/18/"
      }
    },
    {
      "flavor_text": "It draws in air through its tail,\ntransforms it into fire, and uses it like\na tongue. It melts Durant and eats them.",
      "language": {
