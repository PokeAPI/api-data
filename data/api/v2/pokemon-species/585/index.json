        "name": "de",
        "url": "/api/v2/language/6/"
      },
      "version": {
        "name": "x",
        "url": "/api/v2/version/23/"
      }
    },
    {
      "flavor_text": "El color de su cuerpo cambia no solo con las\nestaciones, sino también con los cambios de humedad\ny temperatura.",
      "language": {
        "name": "es",
