        "name": "x",
        "url": "/api/v2/version/23/"
      }
    },
    {
      "flavor_text": "Según los rumores, en lo más profundo del bosque\ndonde mora Tranquill, hay un mundo pacífico y exento\nde luchas.",
      "language": {
        "name": "es-419",
        "url": "/api/v2/language/14/"
