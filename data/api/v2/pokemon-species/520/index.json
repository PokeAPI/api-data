        "name": "black",
        "url": "/api/v2/version/17/"
      }
    },
    {
      "flavor_text": "It can return to its Trainer’s location\nregardless of the distance\nseparating them.",
      "language": {
        "name": "en",
        "url": "/api/v2/language/9/"
      },
      "version": {
        "name": "black",
        "url": "/api/v2/version/17/"
      }
    },
    {
      "flavor_text": "On dit que tout au fond de la forêt\noù il vit, il y aurait un pays paisible\nqui n’a jamais connu la guerre.",
      "language": {
        "name": "fr",
        "url": "/api/v2/language/5/"
      },
      "version": {
        "name": "white",
        "url": "/api/v2/version/18/"
      }
    },
    {
      "flavor_text": "Many people believe that, deep in the\nforest where Tranquill live, there is\na peaceful place where there is no war.",
      "language": {
        "name": "en",
        "url": "/api/v2/language/9/"
      },
      "version": {
        "name": "white",
        "url": "/api/v2/version/18/"
      }
    },
    {
