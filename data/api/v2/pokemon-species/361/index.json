        "name": "es",
        "url": "/api/v2/language/7/"
      },
      "version": {
        "name": "y",
        "url": "/api/v2/version/24/"
      }
    },
    {
      "flavor_text": "Secondo alcune leggende delle regioni fredde, uno\nSnorunt porta prosperità alla casa in cui vive.",
