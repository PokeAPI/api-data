        "url": "/api/v2/language/7/"
      },
      "version": {
        "name": "x",
        "url": "/api/v2/version/23/"
      }
    },
    {
      "flavor_text": "Si dice che gli Snorunt vivano in armonia riuniti\nsotto gigantesche foglie.",
