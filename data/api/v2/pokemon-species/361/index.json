        "name": "de",
        "url": "/api/v2/language/6/"
      },
      "version": {
        "name": "y",
        "url": "/api/v2/version/24/"
      }
    },
    {
      "flavor_text": "En las zonas nevadas, las leyendas dicen que si un\nSnorunt vive en una casa, trae prosperidad.",
