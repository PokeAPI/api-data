  "flavor_text_entries": [
    {
      "flavor_text": "SNORUNT live in regions with heavy\nsnowfall. In seasons without snow, such\nas spring and summer, this POKéMON\fsteals away to live quietly among\nstalactites and stalagmites deep in\ncaverns.",
      "language": {
        "name": "en",
        "url": "/api/v2/language/9/"
      },
      "version": {
        "name": "ruby",
        "url": "/api/v2/version/7/"
      }
    },
    {
      "flavor_text": "SNORUNT survives by eating only snow\nand ice.\nOld folklore claims that a house visited\fby this POKéMON is sure to prosper for\nmany generations to come.",
      "language": {
        "name": "en",
        "url": "/api/v2/language/9/"
      },
      "version": {
        "name": "sapphire",
        "url": "/api/v2/version/8/"
      }
    },
    {
      "flavor_text": "They tend to move about in groups of\naround five SNORUNT. In snowy regions,\nit is said that when they are seen late at\nnight, snowfall will arrive by morning.",
      "language": {
        "name": "en",
        "url": "/api/v2/language/9/"
      },
      "version": {
        "name": "emerald",
        "url": "/api/v2/version/9/"
      }
    },
    {
      "flavor_text": "It is said that a home visited by a\nSNORUNT will prosper. It can withstand\ncold of minus 150 degrees Fahrenheit.",
      "language": {
