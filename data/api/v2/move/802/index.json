  "flavor_text_entries": [
    {
      "flavor_text": "じぶんの　まわりに　いる　すべてを\nこうげき　するが　つかうと　ひんしになる。\nミストフィールドで　いりょくが　あがる。",
      "language": {
        "name": "ja-hrkt",
        "url": "/api/v2/language/1/"
      },
      "version_group": {
        "name": "sword-shield",
        "url": "/api/v2/version-group/20/"
      }
    },
    {
      "flavor_text": "자신의 주위에 있는 모두를\n공격하지만 사용하면 기절한다.\n미스트필드일 때 위력이 올라간다.",
      "language": {
        "name": "ko",
        "url": "/api/v2/language/3/"
      },
      "version_group": {
        "name": "sword-shield",
        "url": "/api/v2/version-group/20/"
      }
    },
    {
      "flavor_text": "對自己周圍的所有寶可夢進行攻擊，\n但使出後，自己會陷入瀕死。\n在薄霧場地時，招式威力會提高。",
      "language": {
        "name": "zh-hant",
        "url": "/api/v2/language/4/"
      },
      "version_group": {
        "name": "sword-shield",
        "url": "/api/v2/version-group/20/"
      }
    },
    {
      "flavor_text": "Le lanceur frappe tous les Pokémon autour de lui\nen explosant, ce qui le met K.O. La puissance de\ncette attaque augmente si un Champ Brumeux est actif.",
      "language": {
        "name": "fr",
        "url": "/api/v2/language/5/"
      },
      "version_group": {
        "name": "sword-shield",
        "url": "/api/v2/version-group/20/"
      }
    },
    {
      "flavor_text": "Der Anwender greift alle Pokémon im Umkreis an und\nwird danach kampfunfähig. Die Stärke dieser Attacke\nsteigt, wenn ein Nebelfeld aktiv ist.",
      "language": {
        "name": "de",
        "url": "/api/v2/language/6/"
      },
      "version_group": {
        "name": "sword-shield",
        "url": "/api/v2/version-group/20/"
      }
    },
    {
      "flavor_text": "El usuario ataca a todos a su alrededor, pero se debilita\nde inmediato. La potencia del movimiento aumenta si el\nterreno está cubierto por un campo de niebla.",
      "language": {
        "name": "es",
        "url": "/api/v2/language/7/"
      },
      "version_group": {
        "name": "sword-shield",
        "url": "/api/v2/version-group/20/"
      }
    },
    {
      "flavor_text": "Chi la usa attacca tutti i Pokémon che ha intorno,\nma poi va KO. La potenza della mossa aumenta\nquando è attivo un Campo Nebbioso.",
      "language": {
        "name": "it",
        "url": "/api/v2/language/8/"
      },
      "version_group": {
        "name": "sword-shield",
        "url": "/api/v2/version-group/20/"
      }
    },
