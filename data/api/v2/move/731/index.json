      "version_group": {
        "name": "lets-go-pikachu-lets-go-eevee",
        "url": "/api/v2/version-group/19/"
      }
    },
    {
      "flavor_text": "Pikachu schwebt nach oben und stürzt dann unvermittelt\nauf das Ziel herab. Das Ziel schreckt eventuell zurück.",
