  "effect_entries": [
    {
      "effect": "La cible ne peut pas utiliser son objet tenu pendant cinq tours.  Si la cible quitte le terrain, cet effet prend fin.\n\nSi un Pokémon sous cet effet utilise Piqûre ou Picore sur un Pokémon portant une baie, la baie est détruite mais pas utilisée.  Si un Pokémon sous cet effet utilise Dégommage, elle échouera.\n\nCet effet est transmis par Relais.",
      "short_effect": "La cible ne peut pas utiliser d'objets tenus.",
      "language": {
        "name": "fr",
        "url": "/api/v2/language/5/"
      }
    },
    {
      "effect": "Target cannot use its held item for five turns.  If the target leaves the field, this effect ends.\n\nIf a Pokémon under this effect uses Bug Bite or Pluck on a Pokémon holding a berry, the berry is destroyed but not used.  If a Pokémon under this effect uses Fling, it will fail.\n\nThis effect is passed by Baton Pass.",
      "short_effect": "Target cannot use held items.",
      "language": {
        "name": "en",
        "url": "/api/v2/language/9/"
      }
    }
