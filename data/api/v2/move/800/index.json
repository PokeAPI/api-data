  "flavor_text_entries": [
    {
      "flavor_text": "１ターンめに　うちゅうの　ちからを\nあつめることで　とくこうが　あがり\n２ターンめに　あいてを　こうげきする。",
      "language": {
        "name": "ja-hrkt",
        "url": "/api/v2/language/1/"
      },
      "version_group": {
        "name": "sword-shield",
        "url": "/api/v2/version-group/20/"
      }
    },
    {
      "flavor_text": "1턴째에 우주의 힘을 모아서\n특수공격을 올리고\n2턴째에 상대를 공격한다.",
      "language": {
        "name": "ko",
        "url": "/api/v2/language/3/"
      },
      "version_group": {
        "name": "sword-shield",
        "url": "/api/v2/version-group/20/"
      }
    },
    {
      "flavor_text": "使用後的第１回合會聚集\n宇宙的力量來提高特攻，\n並於第２回合攻擊對手。",
      "language": {
        "name": "zh-hant",
        "url": "/api/v2/language/4/"
      },
      "version_group": {
        "name": "sword-shield",
        "url": "/api/v2/version-group/20/"
      }
    },
    {
      "flavor_text": "Le lanceur concentre l’énergie cosmique au premier\ntour, ce qui augmente son Attaque Spéciale, et frappe\nau second.",
      "language": {
        "name": "fr",
        "url": "/api/v2/language/5/"
      },
      "version_group": {
        "name": "sword-shield",
        "url": "/api/v2/version-group/20/"
      }
    },
    {
      "flavor_text": "Der Anwender sammelt in Runde 1 kosmische Kräfte\nund erhöht damit seinen Spezial-Angriff, bevor er in\nRunde 2 das Ziel angreift.",
      "language": {
        "name": "de",
        "url": "/api/v2/language/6/"
      },
      "version_group": {
        "name": "sword-shield",
        "url": "/api/v2/version-group/20/"
      }
    },
    {
      "flavor_text": "El usuario dedica el primer turno a aumentar su\nAtaque Especial acumulando energía cósmica y lanza\nsu ofensiva contra el objetivo en el segundo.",
      "language": {
        "name": "es",
        "url": "/api/v2/language/7/"
      },
      "version_group": {
        "name": "sword-shield",
        "url": "/api/v2/version-group/20/"
      }
    },
    {
      "flavor_text": "Chi la usa accumula l’energia dello spazio nel primo\nturno per aumentare l’Attacco Speciale, quindi\nattacca nel turno successivo.",
      "language": {
        "name": "it",
        "url": "/api/v2/language/8/"
      },
      "version_group": {
        "name": "sword-shield",
        "url": "/api/v2/version-group/20/"
      }
    },
