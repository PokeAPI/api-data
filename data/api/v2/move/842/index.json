        "url": "/api/v2/language/4/"
      },
      "version_group": {
        "name": "legends-arceus",
        "url": "/api/v2/version-group/24/"
      }
    },
    {
      "flavor_text": "Rend la peau du lanceur dure comme un mur de fer. Augmente sa puissance défensive. Les attaques de la cible deviennent plus faciles à esquiver.",
