        "name": "fr",
        "url": "/api/v2/language/5/"
      },
      "version_group": {
        "name": "legends-arceus",
        "url": "/api/v2/version-group/24/"
      }
    },
    {
      "flavor_text": "Der Anwender macht seine Haut so hart wie Eisen und erhöht dadurch seine Defensivkraft. Bewirkt zudem, dass gegnerische Attacken den Anwender häufiger verfehlen.",
      "language": {
