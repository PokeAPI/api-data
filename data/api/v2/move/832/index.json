      "version_group": {
        "name": "legends-arceus",
        "url": "/api/v2/version-group/24/"
      }
    },
    {
      "flavor_text": "用不可思議的力量強化自己。 偏向攻擊時會提高進攻力， 偏向防禦時會提高防守力。",
