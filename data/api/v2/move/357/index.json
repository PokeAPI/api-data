  "effect_entries": [
    {
      "effect": "Réinitialise l'esquive de la cible à la normale et empêche n'importe quel futur boost jusqu'à ce que la cible quitte le terrain.  Un Pokémon Ténèbres sous cet effet prend des dégâts normaux des capacités Psy.  Cette capacité ignore elle-même les modifications de précision et d'esquive.",
      "short_effect": "Force la cible à ne pas pouvoir fuir, et la rend sensible aux capacités Psy même si elle est Ténèbres.",
      "language": {
        "name": "fr",
        "url": "/api/v2/language/5/"
      }
    },
    {
      "effect": "Resets the target’s evasion to normal and prevents any further boosting until the target leaves the field.  A Dark Pokémon under this effect takes normal damage from Psychic moves.  This move itself ignores accuracy and evasion modifiers.",
      "short_effect": "Forces the target to have no evasion, and allows it to be hit by Psychic moves even if it’s Dark.",
