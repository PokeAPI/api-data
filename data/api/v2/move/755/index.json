      "version_group": {
        "name": "sword-shield",
        "url": "/api/v2/version-group/20/"
      }
    },
    {
      "flavor_text": "Le lanceur mord sa cible avec ses solides branchies.\nSi cette capacité est lancée avant que la cible n’attaque,\nelle infligera deux fois plus de dégâts.",
      "language": {
        "name": "fr",
        "url": "/api/v2/language/5/"
