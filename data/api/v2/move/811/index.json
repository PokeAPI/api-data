  "flavor_text_entries": [
    {
      "flavor_text": "てきかくな　しどうを　おこなうことで　\nみかた　ぜんいんの\nこうげきと　ぼうぎょを　あげる。",
      "language": {
        "name": "ja-hrkt",
        "url": "/api/v2/language/1/"
      },
      "version_group": {
        "name": "sword-shield",
        "url": "/api/v2/version-group/20/"
      }
    },
    {
      "flavor_text": "적절한 지도를 통해서\n같은 편 전원의\n공격과 방어를 올린다.",
      "language": {
        "name": "ko",
        "url": "/api/v2/language/3/"
      },
      "version_group": {
        "name": "sword-shield",
        "url": "/api/v2/version-group/20/"
      }
    },
    {
      "flavor_text": "透過適切的指導，\n提高我方全體的攻擊和防禦。",
      "language": {
        "name": "zh-hant",
        "url": "/api/v2/language/4/"
      },
      "version_group": {
        "name": "sword-shield",
        "url": "/api/v2/version-group/20/"
      }
    },
    {
      "flavor_text": "Le lanceur coache ses alliés, augmentant ainsi\nleur Attaque et leur Défense.",
      "language": {
        "name": "fr",
        "url": "/api/v2/language/5/"
      },
      "version_group": {
        "name": "sword-shield",
        "url": "/api/v2/version-group/20/"
      }
    },
    {
      "flavor_text": "Der Anwender sorgt durch geschickte Anweisungen\ndafür, dass der Angriff und die Verteidigung seiner\nMitstreiter steigen.",
      "language": {
        "name": "de",
        "url": "/api/v2/language/6/"
      },
      "version_group": {
        "name": "sword-shield",
        "url": "/api/v2/version-group/20/"
      }
    },
    {
      "flavor_text": "El usuario imparte indicaciones precisas a sus aliados,\nque ven aumentados su Ataque y su Defensa.",
      "language": {
        "name": "es",
        "url": "/api/v2/language/7/"
      },
      "version_group": {
        "name": "sword-shield",
        "url": "/api/v2/version-group/20/"
      }
    },
    {
      "flavor_text": "Chi la usa aumenta l’Attacco e la Difesa di tutti\ngli alleati dando loro indicazioni precise.",
      "language": {
        "name": "it",
        "url": "/api/v2/language/8/"
      },
      "version_group": {
        "name": "sword-shield",
        "url": "/api/v2/version-group/20/"
      }
    },
    {
      "flavor_text": "The user properly coaches its ally Pokémon,\nboosting their Attack and Defense stats.",
      "language": {
        "name": "en",
        "url": "/api/v2/language/9/"
      },
      "version_group": {
        "name": "sword-shield",
        "url": "/api/v2/version-group/20/"
      }
    },
    {
      "flavor_text": "的確な　指導を　おこなうことで　\n味方　全員の\n攻撃と　防御を　上げる。",
      "language": {
        "name": "ja",
