  "flavor_text_entries": [
    {
      "flavor_text": "こうげきした　あと\nものすごい　スピードで　もどってきて\nひかえの　ポケモンと　いれかわる。",
      "language": {
        "name": "ja-hrkt",
        "url": "/api/v2/language/1/"
      },
      "version_group": {
        "name": "sword-shield",
        "url": "/api/v2/version-group/20/"
      }
    },
    {
      "flavor_text": "공격한 뒤\n굉장한 스피드로 돌아와서\n교대 포켓몬과 교체한다.",
      "language": {
        "name": "ko",
        "url": "/api/v2/language/3/"
      },
      "version_group": {
        "name": "sword-shield",
        "url": "/api/v2/version-group/20/"
      }
    },
    {
      "flavor_text": "攻擊後迅速返回，\n和後備寶可夢進行替換。",
      "language": {
        "name": "zh-hant",
        "url": "/api/v2/language/4/"
      },
      "version_group": {
        "name": "sword-shield",
        "url": "/api/v2/version-group/20/"
      }
    },
    {
      "flavor_text": "Après son attaque, le lanceur revient à toute vitesse\net change de place avec un Pokémon de l’équipe prêt\nau combat.",
      "language": {
