        "name": "es",
        "url": "/api/v2/language/7/"
      },
      "version_group": {
        "name": "sword-shield",
        "url": "/api/v2/version-group/20/"
      }
    },
    {
      "flavor_text": "Chi usa questa mossa fa marcia indietro per farsi\nsostituire dopo aver sferrato l’attacco.",
