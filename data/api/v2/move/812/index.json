        "url": "/api/v2/language/5/"
      },
      "version_group": {
        "name": "sword-shield",
        "url": "/api/v2/version-group/20/"
      }
    },
    {
      "flavor_text": "Nach der Attacke eilt der Anwender zurück und\ntauscht den Platz mit einem anderen Pokémon.",
