      "version_group": {
        "name": "sun-moon",
        "url": "/api/v2/version-group/17/"
      }
    },
    {
      "flavor_text": "Verhindert für fünf Runden, dass Pokémon am Boden\nvon Attacken mit hoher Erstschlagquote getroffen\nwerden. Erhöht die Stärke von Psycho-Attacken.",
