  "effect_entries": [
    {
      "effect": "Répand des rochers pointus sur le terrain adverses, infligeant des dégâts à n'importe quel Pokémon qui entre sur le terrain d'1/8 de ses PV max.  Ces dégâts sont affectés par la vulnérabilité du Pokémon entrant aux capacités Roche.\n\nTour Rapide supprime cet effet du côté du terrain du lanceur.",
      "short_effect": "Cause des dégâts quand un Pokémon adverse entre sur le terrain.",
      "language": {
        "name": "fr",
        "url": "/api/v2/language/5/"
      }
    },
    {
      "effect": "Spreads sharp rocks around the opposing field, damaging any Pokémon that enters the field for 1/8 its max HP.  This damage is affected by the entering Pokémon’s susceptibility to Rock moves.\n\nRapid Spin removes this effect from its user’s side of the field.",
      "short_effect": "Causes damage when opposing Pokémon switch in.",
      "language": {
        "name": "en",
        "url": "/api/v2/language/9/"
      }
