        "name": "es",
        "url": "/api/v2/language/7/"
      },
      "version_group": {
        "name": "lets-go-pikachu-lets-go-eevee",
        "url": "/api/v2/version-group/19/"
      }
    },
    {
      "flavor_text": "Chi la usa attacca il bersaglio due volte ruotando su se\nstesso e colpendolo con le braccia. Può anche farlo\ntentennare.",
      "language": {
