      "version_group": {
        "name": "omega-ruby-alpha-sapphire",
        "url": "/api/v2/version-group/16/"
      }
    },
    {
      "flavor_text": "Ataca al objetivo con una ráfaga de golpes que pasan\npor alto los efectos de movimientos como Protección\no Detección. Hace que baje la Defensa del usuario.",
      "language": {
        "name": "es",
        "url": "/api/v2/language/7/"
