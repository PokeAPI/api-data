  "flavor_text_entries": [
    {
      "flavor_text": "たくさんの　うでを　つかって　まもるや\n きりを　むしした　れんぞくこうげき。\nじぶんの　ぼうぎょが　さがる。",
      "language": {
        "name": "ja-hrkt",
        "url": "/api/v2/language/1/"
      },
      "version_group": {
        "name": "omega-ruby-alpha-sapphire",
        "url": "/api/v2/version-group/16/"
      }
    },
    {
      "flavor_text": "많은 팔을 사용하여 방어와\n판별을 무시하는 연속 공격이다.\n자신의 방어가 떨어진다.",
      "language": {
        "name": "ko",
        "url": "/api/v2/language/3/"
      },
      "version_group": {
        "name": "omega-ruby-alpha-sapphire",
        "url": "/api/v2/version-group/16/"
      }
    },
    {
      "flavor_text": "Le Pokémon utilise sa multitude de bras pour infliger\nune nuée de coups qui ignorent les capacités telles\nqu’Abri ou Détection. Baisse la Défense du lanceur. ",
      "language": {
        "name": "fr",
        "url": "/api/v2/language/5/"
      },
      "version_group": {
        "name": "omega-ruby-alpha-sapphire",
        "url": "/api/v2/version-group/16/"
      }
    },
    {
      "flavor_text": "Eine Angriffsserie mit vielen Armen, die die Wirkung\nvon Schutzschild und Scanner durchbricht.\nDabei sinkt die Verteidigung des Anwenders.",
