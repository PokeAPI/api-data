  "flavor_text_entries": [
    {
      "flavor_text": "サイコパワーで　かみついて\nあいてを　こうげきする。　ひかりのかべや\nリフレクター　なども　はかいできる。",
      "language": {
        "name": "ja-hrkt",
        "url": "/api/v2/language/1/"
      },
      "version_group": {
        "name": "sun-moon",
        "url": "/api/v2/version-group/17/"
      }
    },
    {
      "flavor_text": "사이코 파워로 물어서\n상대를 공격한다. 빛의장막이나\n리플렉터도 파괴할 수 있다.",
      "language": {
        "name": "ko",
        "url": "/api/v2/language/3/"
      },
      "version_group": {
        "name": "sun-moon",
        "url": "/api/v2/version-group/17/"
      }
    },
    {
      "flavor_text": "利用精神力量咬住對手進行攻擊。\n並可破壞光牆和反射壁等。",
      "language": {
        "name": "zh-hant",
        "url": "/api/v2/language/4/"
      },
      "version_group": {
        "name": "sun-moon",
        "url": "/api/v2/version-group/17/"
      }
    },
    {
      "flavor_text": "Le lanceur mord la cible avec ses pouvoirs\npsychiques. Brise aussi les barrières comme\nMur Lumière et Protection.",
      "language": {
        "name": "fr",
        "url": "/api/v2/language/5/"
      },
      "version_group": {
        "name": "sun-moon",
        "url": "/api/v2/version-group/17/"
      }
    },
    {
      "flavor_text": "Der Anwender beißt das Ziel mithilfe von\nPsycho-Kräften. Die Attacke durchbricht auch\nBarrieren wie Lichtschild und Reflektor.",
      "language": {
        "name": "de",
        "url": "/api/v2/language/6/"
      },
      "version_group": {
        "name": "sun-moon",
        "url": "/api/v2/version-group/17/"
      }
    },
    {
      "flavor_text": "Ataca a sus rivales con poderes psíquicos que\nademás destruyen barreras como Pantalla de Luz y\nReflejo.",
      "language": {
        "name": "es",
        "url": "/api/v2/language/7/"
