        "url": "/api/v2/version-group/15/"
      },
      "language": {
        "name": "fr",
        "url": "/api/v2/language/5/"
      }
    },
    {
      "text": "Das Ziel wird mit der Handkante angegriffen.\nBarrieren wie Lichtschild oder Reflektor\nwerden zerstört.",
