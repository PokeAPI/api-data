        "name": "x-y",
        "url": "/api/v2/version-group/15/"
      },
      "language": {
        "name": "de",
        "url": "/api/v2/language/6/"
      }
    },
    {
      "text": "Canto que sirve de ataque. Su fuerza aumenta\ncuantos más Pokémon lo usan en cadena.",
