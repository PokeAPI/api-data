  "effect_entries": [],
  "flavor_text_entries": [
    {
      "text": "ヨロイじまに　いくための　パス。\nブラッシータウンの　えきで\nえきいんさんに　みせよう。",
      "version_group": {
        "name": "sword-shield",
        "url": "/api/v2/version-group/20/"
      },
      "language": {
        "name": "ja-hrkt",
        "url": "/api/v2/language/1/"
      }
    },
    {
      "text": "갑옷섬에 갈 수 있는 패스.\n브래시마을역에 있는\n역무원에게 보여주자.",
      "version_group": {
        "name": "sword-shield",
        "url": "/api/v2/version-group/20/"
      },
      "language": {
        "name": "ko",
        "url": "/api/v2/language/3/"
      }
    },
    {
      "text": "前往鎧島的車票。\n在木桿鎮的車站\n把它出示給站務員看吧。",
      "version_group": {
        "name": "sword-shield",
        "url": "/api/v2/version-group/20/"
      },
      "language": {
        "name": "zh-hant",
        "url": "/api/v2/language/4/"
      }
    },
    {
      "text": "Un pass pour se rendre à Isolarmure.\nMontrez-le à l’employé de la Gare de Brasswick.",
      "version_group": {
        "name": "sword-shield",
        "url": "/api/v2/version-group/20/"
      },
      "language": {
        "name": "fr",
        "url": "/api/v2/language/5/"
      }
    },
    {
      "text": "Ein Pass, mit dem du zur Rüstungsinsel gelangst.\nZeige ihn dem Personal am Brassbury-Bahnhof.",
      "version_group": {
        "name": "sword-shield",
        "url": "/api/v2/version-group/20/"
      },
      "language": {
        "name": "de",
        "url": "/api/v2/language/6/"
      }
    },
    {
      "text": "Un pase que permite viajar hasta la Isla de la Armadura.\nHay que mostrárselo al empleado de la estación de\nPueblo Par.",
      "version_group": {
        "name": "sword-shield",
        "url": "/api/v2/version-group/20/"
      },
      "language": {
        "name": "es",
        "url": "/api/v2/language/7/"
      }
    },
    {
      "text": "Un pass necessario per raggiungere l’Isola\ndell’Armatura. Mostralo al personale della\nStazione di Brassbury.",
      "version_group": {
        "name": "sword-shield",
        "url": "/api/v2/version-group/20/"
      },
      "language": {
        "name": "it",
        "url": "/api/v2/language/8/"
      }
    },
    {
      "text": "A pass to go to the Isle of Armor. Show it to the rail\nstaff at Wedgehurst Station.",
      "version_group": {
        "name": "sword-shield",
        "url": "/api/v2/version-group/20/"
      },
      "language": {
        "name": "en",
        "url": "/api/v2/language/9/"
      }
    },
    {
      "text": "ヨロイ島に　行くための　パス。\nブラッシータウンの　駅で\n駅員さんに　見せよう。",
      "version_group": {
        "name": "sword-shield",
        "url": "/api/v2/version-group/20/"
      },
      "language": {
        "name": "ja",
        "url": "/api/v2/language/11/"
      }
    },
    {
      "text": "前往铠岛的车票。\n在木杆镇的车站，\n把它出示给站务员看吧。",
      "version_group": {
        "name": "sword-shield",
        "url": "/api/v2/version-group/20/"
      },
      "language": {
        "name": "zh-hans",
        "url": "/api/v2/language/12/"
      }
    },
    {
      "text": "Un pase que permite viajar hasta la Isla de la Armadura.\nHay que mostrárselo al empleado de la estación de\nPueblo Par.",
      "version_group": {
        "name": "sword-shield",
        "url": "/api/v2/version-group/20/"
      },
      "language": {
        "name": "es-419",
        "url": "/api/v2/language/14/"
      }
    }
