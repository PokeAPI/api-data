        "url": "/api/v2/version-group/20/"
      },
      "language": {
        "name": "fr",
        "url": "/api/v2/language/5/"
      }
    },
    {
      "text": "Der Anwender greift das Ziel mit einer heftigen\nGanzkörper-Attacke an.",
