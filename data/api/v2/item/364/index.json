        "url": "/api/v2/version-group/19/"
      },
      "language": {
        "name": "fr",
        "url": "/api/v2/language/5/"
      }
    },
    {
      "text": "Brutaler Ramm-Angriff mit spitzem,\nbeeindruckendem Horn.",
