  "effect_entries": [
    {
      "effect": "Tenu au combat\n:   Quand le porteur est paralysé, cela consomme cet objet pour soigner la paralysie.\n\nUtilisé sur un Pokémon de l'équipe\n:   Soigne la paralysie.",
      "short_effect": "Tenu: Consommé quand paralysé pour soigner la paralysie.",
      "language": {
        "name": "fr",
        "url": "/api/v2/language/5/"
      }
    },
    {
      "effect": "Held in battle\n:   When the holder is paralyzed, it consumes this item to cure the paralysis.\n\nUsed on a party Pokémon\n:   Cures paralysis.",
      "short_effect": "Held: Consumed when paralyzed to cure paralysis.",
      "language": {
        "name": "en",
        "url": "/api/v2/language/9/"
      }
    }
  ],
  "flavor_text_entries": [
    {
      "text": "A hold item that\nheals paralysis\nin battle.",
      "version_group": {
        "name": "ruby-sapphire",
        "url": "/api/v2/version-group/5/"
      },
      "language": {
        "name": "en",
        "url": "/api/v2/language/9/"
      }
    },
    {
      "text": "A hold item that\nheals paralysis\nin battle.",
      "version_group": {
        "name": "emerald",
        "url": "/api/v2/version-group/6/"
      },
      "language": {
        "name": "en",
        "url": "/api/v2/language/9/"
      }
    },
    {
      "text": "When held by a POKéMON, it will be\nused in battle to heal paralysis.",
      "version_group": {
        "name": "firered-leafgreen",
        "url": "/api/v2/version-group/7/"
      },
      "language": {
        "name": "en",
        "url": "/api/v2/language/9/"
      }
    },
    {
      "text": "A Poffin ingredient. It may be used\nor held by a Pokémon to recover from\nparalysis.",
      "version_group": {
        "name": "diamond-pearl",
        "url": "/api/v2/version-group/8/"
      },
      "language": {
        "name": "en",
        "url": "/api/v2/language/9/"
      }
    },
    {
      "text": "A Poffin ingredient. It may be used\nor held by a Pokémon to recover from\nparalysis.",
      "version_group": {
        "name": "platinum",
        "url": "/api/v2/version-group/9/"
      },
      "language": {
        "name": "en",
        "url": "/api/v2/language/9/"
      }
    },
    {
      "text": "It may be used or held by a Pokémon to\nrecover from paralysis.",
      "version_group": {
        "name": "heartgold-soulsilver",
        "url": "/api/v2/version-group/10/"
      },
      "language": {
        "name": "en",
        "url": "/api/v2/language/9/"
      }
    },
    {
      "text": "Baie qui soigne la paralysie lorsqu’elle\nest tenue par un Pokémon.",
      "version_group": {
        "name": "black-white",
        "url": "/api/v2/version-group/11/"
      },
      "language": {
        "name": "fr",
        "url": "/api/v2/language/5/"
      }
    },
    {
      "text": "If held by a Pokémon,\nit recovers from paralysis.",
      "version_group": {
        "name": "black-white",
        "url": "/api/v2/version-group/11/"
      },
      "language": {
        "name": "en",
        "url": "/api/v2/language/9/"
      }
    },
    {
      "text": "If held by a Pokémon,\nit recovers from paralysis.",
