        "name": "scarlet-violet",
        "url": "/api/v2/version-group/25/"
      },
      "language": {
        "name": "fr",
        "url": "/api/v2/language/5/"
      }
    },
    {
      "text": "Bei der Herstellung dieser sehr sauren Zutat wird das Gemüse in einer Lake aus Gewürzen und Essig eingelegt.",
