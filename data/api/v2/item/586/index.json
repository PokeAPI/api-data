  "effect_entries": [
    {
      "effect": "Tenu\n:   Quand l'un des types de l'utilisateur devrait l'immuniser à des dégâts, ce type est ignoré pour le calcul des dégâts.",
      "short_effect": "Tenu: Annule les immunités de type du porteur. Les immunités aux talents ne sont pas supprimées.",
      "language": {
        "name": "fr",
        "url": "/api/v2/language/5/"
      }
    },
    {
      "effect": "Held\n:   When one of the user’s types would render it immune to damage, that type is ignored for damage calculation.",
      "short_effect": "Held: Negates the holder’s type immunities. Ability immunities are not removed.",
      "language": {
        "name": "en",
        "url": "/api/v2/language/9/"
      }
    }
  ],
  "flavor_text_entries": [
    {
      "text": "Un Pokémon tenant cet objet devient\nsensible aux capacités autrement\ninefficaces en raison de son type.",
