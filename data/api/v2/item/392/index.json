        "name": "fr",
        "url": "/api/v2/language/5/"
      }
    },
    {
      "text": "The user pecks the target. If the\ntarget is holding a Berry, the user\nplucks it and gains its effect.",
      "version_group": {
        "name": "black-white",
        "url": "/api/v2/version-group/11/"
      },
      "language": {
