  "effect_entries": [
    {
      "effect": "Tenu: Quand le porteur est touché par une capacité spéciale, augmente sa Défense Spéciale d'un niveau.",
      "short_effect": "Tenu: Quand le porteur est touché par une capacité spéciale, augmente sa Défense Spéciale d'un niveau.",
      "language": {
        "name": "fr",
        "url": "/api/v2/language/5/"
      }
    },
    {
      "effect": "Held: When the holder is hit by a special move, increases its Special Defense by one stage.",
      "short_effect": "Held: When the holder is hit by a special move, increases its Special Defense by one stage.",
      "language": {
        "name": "en",
        "url": "/api/v2/language/9/"
      }
    }
  ],
  "flavor_text_entries": [
    {
      "text": "ポケモンに　もたせると\nとくしゅわざを　うけたとき\nじぶんの　とくぼうが　あがる。",
      "version_group": {
        "name": "x-y",
        "url": "/api/v2/version-group/15/"
      },
      "language": {
        "name": "ja-hrkt",
        "url": "/api/v2/language/1/"
      }
    },
    {
      "text": "포켓몬에게 지니게 하면\n특수 기술을 당했을 때\n자신의 특수방어가 올라간다.",
      "version_group": {
        "name": "x-y",
        "url": "/api/v2/version-group/15/"
      },
      "language": {
        "name": "ko",
        "url": "/api/v2/language/3/"
      }
    },
    {
      "text": "Baie à tenir augmentant la Défense Spéciale\ndu Pokémon lorsqu’il est touché par une attaque\nspéciale.",
      "version_group": {
        "name": "x-y",
        "url": "/api/v2/version-group/15/"
      },
      "language": {
        "name": "fr",
        "url": "/api/v2/language/5/"
      }
    },
    {
      "text": "Als getragenes Item erhöht diese Beere die\nSpezial-Verteidigung des Trägers, wenn dieser\nvon Spezial-Attacken getroffen wird.",
      "version_group": {
        "name": "x-y",
        "url": "/api/v2/version-group/15/"
      },
      "language": {
        "name": "de",
        "url": "/api/v2/language/6/"
      }
    },
    {
      "text": "Baúl ligero de increíble capacidad donde pueden\nguardarse todas las prendas de ropa adquiridas.",
      "version_group": {
        "name": "x-y",
        "url": "/api/v2/version-group/15/"
      },
      "language": {
        "name": "es",
        "url": "/api/v2/language/7/"
      }
    },
    {
      "text": "Bacca da dare a un Pokémon.\nSe chi ce l’ha subisce una mossa speciale,\nla sua Difesa Speciale aumenta.",
      "version_group": {
        "name": "x-y",
        "url": "/api/v2/version-group/15/"
      },
      "language": {
        "name": "it",
        "url": "/api/v2/language/8/"
      }
    },
    {
      "text": "If held by a Pokémon, this Berry will\nincrease the holder’s Sp. Def\nif it’s hit with a special move.",
      "version_group": {
        "name": "x-y",
        "url": "/api/v2/version-group/15/"
      },
      "language": {
        "name": "en",
        "url": "/api/v2/language/9/"
      }
    },
    {
      "text": "ポケモンに　持たせると\n特殊技を　受けたとき\n自分の　特防が　あがる。",
      "version_group": {
        "name": "x-y",
        "url": "/api/v2/version-group/15/"
      },
      "language": {
        "name": "ja",
        "url": "/api/v2/language/11/"
      }
    },
    {
      "text": "Baúl ligero de increíble capacidad donde pueden\nguardarse todas las prendas de ropa adquiridas.",
      "version_group": {
        "name": "x-y",
        "url": "/api/v2/version-group/15/"
      },
      "language": {
        "name": "es-419",
        "url": "/api/v2/language/14/"
      }
    },
    {
      "text": "ポケモンに　もたせると\nとくしゅわざを　うけたとき\nじぶんの　とくぼうが　あがる。",
