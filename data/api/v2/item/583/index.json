        "name": "x-y",
        "url": "/api/v2/version-group/15/"
      },
      "language": {
        "name": "it",
        "url": "/api/v2/language/8/"
      }
    },
    {
      "text": "An item to be held by a Pokémon.\nIf the holder is hit, the attacker will\nalso be damaged upon contact.",
