  "effect_entries": [
    {
      "effect": "Tenu\n:   Quand le porteur est touché par une capacité à contact, le Pokémon attaquant subit 1/6 ses PV max en dégâts.",
      "short_effect": "Tenu: Quand le porteur est touché par une capacité à contact, le Pokémon attaquant subit 1/6 de ses PV max en dégâts.",
      "language": {
        "name": "fr",
        "url": "/api/v2/language/5/"
      }
    },
    {
      "effect": "Held\n:   When the holder is hit by a contact move, the attacking Pokémon takes 1/6 its max HP in damage.",
      "short_effect": "Held: When the holder is hit by a contact move, the attacking Pokémon takes 1/6 its max HP in damage.",
      "language": {
        "name": "en",
        "url": "/api/v2/language/9/"
      }
    }
  ],
  "flavor_text_entries": [
    {
      "text": "Tenu, cet objet inflige des dégâts\nà l’attaquant si ce dernier utilise une\nattaque physique qui atteint son but.",
      "version_group": {
        "name": "black-white",
        "url": "/api/v2/version-group/11/"
      },
      "language": {
        "name": "fr",
        "url": "/api/v2/language/5/"
      }
    },
    {
      "text": "If the holder of this item takes damage,\nthe attacker will also be damaged\nupon contact.",
      "version_group": {
        "name": "black-white",
        "url": "/api/v2/version-group/11/"
      },
      "language": {
        "name": "en",
        "url": "/api/v2/language/9/"
      }
    },
    {
      "text": "If the holder of this item takes damage,\nthe attacker will also be damaged\nupon contact.",
      "version_group": {
        "name": "black-2-white-2",
        "url": "/api/v2/version-group/14/"
      },
      "language": {
        "name": "en",
        "url": "/api/v2/language/9/"
      }
    },
    {
      "text": "ポケモンに　もたせると\nだげきわざを　うけたとき\nあいてにも　ダメージを　あたえる。",
      "version_group": {
        "name": "x-y",
        "url": "/api/v2/version-group/15/"
      },
      "language": {
        "name": "ja-hrkt",
        "url": "/api/v2/language/1/"
      }
    },
    {
      "text": "포켓몬에게 지니게 하면\n타격 기술을 당했을 때\n상대에게도 데미지를 준다.",
      "version_group": {
        "name": "x-y",
        "url": "/api/v2/version-group/15/"
      },
      "language": {
        "name": "ko",
        "url": "/api/v2/language/3/"
      }
    },
    {
      "text": "Tenu, cet objet inflige des dégâts à l’attaquant\nsi ce dernier utilise une attaque physique qui\natteint son but.",
      "version_group": {
        "name": "x-y",
        "url": "/api/v2/version-group/15/"
      },
      "language": {
        "name": "fr",
        "url": "/api/v2/language/5/"
      }
    },
    {
      "text": "Wird der Träger von einer physischen\nAttacke getroffen, erleidet der Angreifer\nebenfalls Schaden.",
      "version_group": {
        "name": "x-y",
        "url": "/api/v2/version-group/15/"
      },
      "language": {
        "name": "de",
        "url": "/api/v2/language/6/"
      }
    },
    {
      "text": "Joya de un solo uso que potencia los\nmovimientos de tipo Roca. Debe llevarla\nun Pokémon.",
      "version_group": {
        "name": "x-y",
        "url": "/api/v2/version-group/15/"
      },
      "language": {
        "name": "es",
        "url": "/api/v2/language/7/"
      }
    },
    {
      "text": "Se il Pokémon che ha questo strumento è colpito\nda una mossa fisica, anche il nemico subisce\ndei danni.",
