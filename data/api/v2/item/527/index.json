{
  "id": 527,
  "name": "mach-bike",
  "fling_power": null,
  "fling_effect": null,
  "attributes": [],
  "category": {
    "name": "gameplay",
    "url": "/api/v2/item-category/21/"
  },
  "effect_entries": [
    {
      "effect": "Augmente la vitesse de déplacement à l'extérieur ou dans les grottes.  Plus rapide que le Vélo Cross.  Permet au dresseur de gravir des pentes boueuses.",
      "short_effect": "Plus rapide que le Vélo Cross, et peut gravir des pentes sablonneuses et rouler sur des sols fissurés.",
      "language": {
        "name": "fr",
        "url": "/api/v2/language/5/"
      }
    },
    {
      "effect": "Increases movement speed outside or in caves.  Faster than the Acro Bike.  Allows the trainer to ascend muddy slopes.",
      "short_effect": "Faster than the Acro Bike, and can ride up sandy slopes and across cracked floors.",
      "language": {
        "name": "en",
        "url": "/api/v2/language/9/"
      }
    }
  ],
  "flavor_text_entries": [
    {
      "text": "A folding bicycle\nthat more than\ndoubles foot speed.",
      "version_group": {
        "name": "ruby-sapphire",
        "url": "/api/v2/version-group/5/"
      },
      "language": {
        "name": "en",
        "url": "/api/v2/language/9/"
      }
    },
    {
      "text": "A folding bicycle\nthat doubles your\nspeed or better.",
      "version_group": {
        "name": "emerald",
        "url": "/api/v2/version-group/6/"
      },
      "language": {
        "name": "en",
        "url": "/api/v2/language/9/"
      }
    },
    {
      "text": "A folding bicycle that is at least\ntwice as fast as walking.",
      "version_group": {
        "name": "firered-leafgreen",
        "url": "/api/v2/version-group/7/"
      },
      "language": {
        "name": "en",
        "url": "/api/v2/language/9/"
      }
    },
    {
      "text": "２ばい　いじょうの\nはやさで　いどう　できる\nおりたたみの　じてんしゃ。",
      "version_group": {
        "name": "sun-moon",
        "url": "/api/v2/version-group/17/"
      },
      "language": {
        "name": "ja-hrkt",
        "url": "/api/v2/language/1/"
      }
    },
    {
      "text": "2배 이상의\n스피드로 이동할 수 있는\n접이식 자전거다.",
      "version_group": {
        "name": "sun-moon",
        "url": "/api/v2/version-group/17/"
      },
      "language": {
        "name": "ko",
        "url": "/api/v2/language/3/"
      }
    },
    {
      "text": "能以２倍以上速度移動的\n折疊式自行車。",
      "version_group": {
        "name": "sun-moon",
        "url": "/api/v2/version-group/17/"
      },
      "language": {
        "name": "zh-hant",
        "url": "/api/v2/language/4/"
      }
    },
    {
      "text": "Un vélo pliable qui roule jusqu’à deux fois plus vite\nqu’une bicyclette ordinaire.",
      "version_group": {
        "name": "sun-moon",
        "url": "/api/v2/version-group/17/"
      },
      "language": {
        "name": "fr",
        "url": "/api/v2/language/5/"
      }
    },
    {
      "text": "Ein Klapprad, mit dem du dich doppelt so schnell\nfortbewegen kannst wie gewöhnlich.",
      "version_group": {
        "name": "sun-moon",
        "url": "/api/v2/version-group/17/"
      },
      "language": {
        "name": "de",
        "url": "/api/v2/language/6/"
      }
    },
    {
      "text": "Bicicleta plegable que va a más del doble de\nvelocidad que otras.",
      "version_group": {
        "name": "sun-moon",
        "url": "/api/v2/version-group/17/"
      },
      "language": {
        "name": "es",
        "url": "/api/v2/language/7/"
      }
    },
    {
      "text": "Bici pieghevole che permette di spostarsi al doppio\ndella velocità normale.",
      "version_group": {
        "name": "sun-moon",
        "url": "/api/v2/version-group/17/"
      },
      "language": {
        "name": "it",
        "url": "/api/v2/language/8/"
      }
    },
