  "effect_entries": [
    {
      "effect": "Tenu\n:   Quand le porteur subit des dommages directs d'une capacité et n'est pas mis KO, il est retiré pour un autre au hasard, Pokémon non KO de son équipe.\nCet effet ne s'active pas si un autre effet empêche le porteur de se retirer.",
      "short_effect": "Tenu: Quand le porteur subit des dégâts d'une capacité, l'adversaire se retire pour un autre Pokémon aléatoire de l'équipe. Consommé après utilisation.",
      "language": {
        "name": "fr",
        "url": "/api/v2/language/5/"
      }
    },
    {
      "effect": "Held\n:   When the holder takes damage directly from a move and does not faint, it switches out for another random, non-fainted Pokémon in its party.\nThis effect does not activate if another effect prevents the holder from switching out.",
      "short_effect": "Held: When the holder takes damage from a move, the opponent switches out for another random party Pokémon. Consumed after use.",
      "language": {
        "name": "en",
        "url": "/api/v2/language/9/"
      }
    }
  ],
  "flavor_text_entries": [
    {
      "text": "Carte au pouvoir mystérieux.\nTenue, elle force un Pokémon touchant\nle porteur à se retirer du combat.",
      "version_group": {
        "name": "black-white",
        "url": "/api/v2/version-group/11/"
      },
      "language": {
        "name": "fr",
        "url": "/api/v2/language/5/"
      }
    },
    {
      "text": "A card with a mysterious power. When\nthe holder is struck by a foe, the\nattacker is removed from battle.",
      "version_group": {
        "name": "black-white",
        "url": "/api/v2/version-group/11/"
      },
      "language": {
        "name": "en",
        "url": "/api/v2/language/9/"
      }
    },
    {
      "text": "A card with a mysterious power. When\nthe holder is struck by a foe, the\nattacker is removed from battle.",
