      },
      "language": {
        "name": "en",
        "url": "/api/v2/language/9/"
      }
    },
    {
      "text": "Coupe l’ennemi avec des lames ou des\ngriffes. Hors combat, permet de couper\ndes arbres fins.",
      "version_group": {
        "name": "black-white",
        "url": "/api/v2/version-group/11/"
