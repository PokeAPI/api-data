  "category": {
    "name": "apricorn-balls",
    "url": "/api/v2/item-category/39/"
  },
  "effect_entries": [
    {
      "effect": "Utilisé par un dresseur en combat\n:   Tente de capturer un Pokémon sauvage.  Si utilisé en combat de dresseurs, rien ne se passe et la ball est perdue.\n\n:   Si la Vitesse de base du Pokémon sauvage est 100 ou plus, son taux de capture est 4× le normal.",
      "short_effect": "4× plus efficace sur un Pokémon avec une vitesse de base de 100 ou plus. (Gén II: Pokémon Errant ou Fuyard). Fait à partir de Noigrume Blc.",
      "language": {
        "name": "fr",
        "url": "/api/v2/language/5/"
      }
    },
    {
      "effect": "Used by a trainer in battle\n:   Attempts to catch a wild Pokémon.  If used in a trainer battle, nothing happens and the ball is lost.\n\n:   If the wild Pokémon’s base speed is 100 or more, its catch rate is 4× normal.",
      "short_effect": "4× effectiveness on Pokémon with 100 or greater base speed. (Gen II: Roaming or Fleeing Pokémon). Made from Wht Apricorn.",
      "language": {
        "name": "en",
        "url": "/api/v2/language/9/"
      }
    }
  ],
  "flavor_text_entries": [
    {
      "text": "A Poké Ball that makes it easier to\ncatch fast Pokémon.",
