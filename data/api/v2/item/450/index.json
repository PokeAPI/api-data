{
  "id": 450,
  "name": "level-ball",
  "fling_power": null,
  "fling_effect": null,
  "attributes": [],
  "category": {
    "name": "apricorn-balls",
    "url": "/api/v2/item-category/39/"
  },
  "effect_entries": [
    {
      "effect": "Utilisé par un dresseur en combat\n:   Tente de capturer un Pokémon sauvage.  Si utilisé en combat de dresseurs, rien ne se passe et la ball est perdue.\n\nSi le niveau du Pokémon du dresseur est plus grand de:\n\n     * quatre fois celui du Pokémon sauvage, le taux de capture du Pokémon sauvage 8× le normal.\n     * deux fois celui du Pokémon sauvage, le taux de capture du Pokémon sauvage est 4× le normal.\n     * celui du Pokémon sauvage, le taux de capture du Pokémon sauvage est 2× le normal.",
      "short_effect": "Le taux de succès dépend des niveaux du Pokémon de l'utilisateur et de la cible. Fait à partir de Noigrume Rge.",
      "language": {
        "name": "fr",
        "url": "/api/v2/language/5/"
      }
    },
    {
      "effect": "Used by trainer in battle\n:   Attempts to catch a wild Pokémon.  If used in a trainer battle, nothing happens and the ball is lost.\n\n    If the trainer’s Pokémon’s level is higher than:\n\n    * four times the wild Pokémon’s, the wild Pokémon’s catch rate is 8× normal.\n    * than twice the wild Pokémon’s, the wild Pokémon’s catch rate is 4× normal.\n    * the wild Pokémon’s, the wild Pokémon’s catch rate is 2× normal.",
      "short_effect": "Success rate based off of fraction target Pokémon is of user’s Pokémon. Made from Red Apricorn.",
      "language": {
        "name": "en",
        "url": "/api/v2/language/9/"
      }
    }
  ],
  "flavor_text_entries": [
    {
      "text": "A Poké Ball for catching Pokémon that\nare a lower level than your own.",
      "version_group": {
        "name": "heartgold-soulsilver",
        "url": "/api/v2/version-group/10/"
      },
      "language": {
        "name": "en",
        "url": "/api/v2/language/9/"
      }
    },
    {
      "text": "Une Poké Ball un peu spéciale qui\nfonctionne particulièrement bien sur\nles Pokémon de niveau inférieur au sien.",
      "version_group": {
        "name": "black-white",
        "url": "/api/v2/version-group/11/"
      },
      "language": {
        "name": "fr",
        "url": "/api/v2/language/5/"
      }
    },
    {
      "text": "A Poké Ball for catching Pokémon that\nare a lower level than your own.",
      "version_group": {
        "name": "black-white",
        "url": "/api/v2/version-group/11/"
      },
      "language": {
        "name": "en",
        "url": "/api/v2/language/9/"
      }
    },
    {
      "text": "A Poké Ball for catching Pokémon that\nare a lower level than your own.",
      "version_group": {
        "name": "black-2-white-2",
        "url": "/api/v2/version-group/14/"
      },
      "language": {
        "name": "en",
        "url": "/api/v2/language/9/"
      }
    },
    {
      "text": "じぶんの　ポケモンより　レベルが\nひくいほど　つかまえやすくなる\nちょっと　かわった　ボール。",
      "version_group": {
        "name": "x-y",
        "url": "/api/v2/version-group/15/"
      },
      "language": {
        "name": "ja-hrkt",
        "url": "/api/v2/language/1/"
      }
    },
    {
      "text": "자신의 포켓몬보다 레벨이\n낮을수록 잡기 쉬워지는\n조금 특이한 볼.",
      "version_group": {
        "name": "x-y",
        "url": "/api/v2/version-group/15/"
      },
      "language": {
        "name": "ko",
        "url": "/api/v2/language/3/"
      }
    },
    {
      "text": "Une Poké Ball un peu spéciale qui fonctionne\nparticulièrement bien sur les Pokémon de niveau\ninférieur au sien.",
      "version_group": {
        "name": "x-y",
        "url": "/api/v2/version-group/15/"
      },
      "language": {
        "name": "fr",
        "url": "/api/v2/language/5/"
      }
    },
    {
      "text": "Ein Ball, mit dem sich Pokémon umso leichter\nfangen lassen, je niedriger ihr Level im Vergleich\nzu deinem Team ist.",
      "version_group": {
        "name": "x-y",
        "url": "/api/v2/version-group/15/"
      },
      "language": {
        "name": "de",
        "url": "/api/v2/language/6/"
      }
    },
    {
      "text": "Contiene los datos del Pokéathlon con el número\nde victorias en Rompelosas.",
