  "category": {
    "name": "miracle-shooter",
    "url": "/api/v2/item-category/43/"
  },
  "effect_entries": [
    {
      "effect": "Utilisé sur un Pokémon de l'équipe au combat\n:   Sélectionne un autre Pokémon allié au hasard.  Si ce Pokémon tient un objet, cet objet est retiré pour la durée du combat.\n\nCet objet ne peut être obtenu ou utilisé que via le Shooter Miracle.",
      "short_effect": "Force un Pokémon allié à lâcher son objet tenu.",
      "language": {
        "name": "fr",
        "url": "/api/v2/language/5/"
      }
    },
    {
      "effect": "Used on a party Pokémon in battle\n:   Selects another friendly Pokémon at random.  If that Pokémon is holding an item, that item is removed for the duration of the battle.\n\nThis item can only be obtained or used via the Wonder Launcher.",
      "short_effect": "Forces a friendly Pokémon to drop its held item.",
      "language": {
        "name": "en",
        "url": "/api/v2/language/9/"
      }
    }
  ],
  "flavor_text_entries": [
