        "name": "black-white",
        "url": "/api/v2/version-group/11/"
      },
      "language": {
        "name": "fr",
        "url": "/api/v2/language/5/"
      }
    },
    {
      "text": "A fossil of an ancient Pokémon that\nlived in the sea in ancient times.\nIt appears to be part of its back.",
      "version_group": {
        "name": "black-white",
        "url": "/api/v2/version-group/11/"
      },
      "language": {
        "name": "en",
        "url": "/api/v2/language/9/"
      }
    },
    {
      "text": "A fossil of an ancient Pokémon that\nlived in the sea in ancient times.\nIt appears to be part of its back.",
