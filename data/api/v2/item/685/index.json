  "effect_entries": [
    {
      "effect": "Permet à un Pokémon d'alterner entre ses deux Talents (non cachés) possibles.",
      "short_effect": "Permet à un Pokémon d'alterner entre ses deux Talents (non cachés) possibles.",
      "language": {
        "name": "fr",
        "url": "/api/v2/language/5/"
      }
    },
    {
      "effect": "Switches a Pokémon between its two possible (non-Hidden) Abilities.",
      "short_effect": "Switches a Pokémon between its two possible (non-Hidden) Abilities.",
      "language": {
        "name": "en",
        "url": "/api/v2/language/9/"
      }
    }
  ],
  "flavor_text_entries": [
    {
      "text": "２しゅるいの　とくせいを　もつ\nポケモンに　つかうと　いまとはちがう\nとくせいに　かえられる　カプセル。",
      "version_group": {
        "name": "x-y",
        "url": "/api/v2/version-group/15/"
      },
      "language": {
        "name": "ja-hrkt",
        "url": "/api/v2/language/1/"
      }
    },
    {
      "text": "2종류의 특성을 가진\n포켓몬에게 사용하면 지금과는 다른\n특성으로 바꿀 수 있는 캡슐.",
      "version_group": {
        "name": "x-y",
        "url": "/api/v2/version-group/15/"
      },
      "language": {
        "name": "ko",
        "url": "/api/v2/language/3/"
      }
    },
    {
      "text": "Une capsule permettant à un Pokémon pouvant\navoir deux talents de changer de l’un à l’autre.",
      "version_group": {
        "name": "x-y",
        "url": "/api/v2/version-group/15/"
      },
      "language": {
        "name": "fr",
        "url": "/api/v2/language/5/"
      }
    },
    {
      "text": "Bei Anwendung auf ein Pokémon, das zwei\nverschiedene Fähigkeiten haben kann, wird seine\naktuelle Fähigkeit mit der anderen ausgewechselt.",
      "version_group": {
        "name": "x-y",
        "url": "/api/v2/version-group/15/"
      },
      "language": {
        "name": "de",
        "url": "/api/v2/language/6/"
      }
    },
    {
      "text": "Una de las misteriosas Megapiedras. Permite\nmegaevolucionar a Blaziken en combate.",
      "version_group": {
        "name": "x-y",
        "url": "/api/v2/version-group/15/"
      },
      "language": {
        "name": "es",
        "url": "/api/v2/language/7/"
      }
    },
    {
      "text": "Se usata su un Pokémon che ha due abilità,\nquesta capsula permette di cambiare quella\nattiva.",
      "version_group": {
        "name": "x-y",
        "url": "/api/v2/version-group/15/"
      },
      "language": {
        "name": "it",
        "url": "/api/v2/language/8/"
      }
    },
    {
      "text": "A capsule that allows a Pokémon with\ntwo Abilities to switch between these\nAbilities when it is used.",
