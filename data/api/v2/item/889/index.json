        "name": "sun-moon",
        "url": "/api/v2/version-group/17/"
      },
      "language": {
        "name": "es",
        "url": "/api/v2/language/7/"
      }
    },
    {
      "text": "Nettare ottenuto dai fiori del Prato Ula Ula.\nFa cambiare forma a una determinata\nspecie di Pokémon.",
