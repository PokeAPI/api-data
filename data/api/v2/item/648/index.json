  "effect_entries": [
    {
      "effect": "Utilisé sur un Pokémon de l'équipe au combat\n:   Augmente l'Attaque Spéciale de la cible de six niveaux.\nCet objet ne peut être obtenu ou utilisé que via le Shooter Miracle.",
      "short_effect": "Augmente la Défense Spéciale de six niveaux au combat.  Shooter Miracle seulement.",
      "language": {
        "name": "fr",
        "url": "/api/v2/language/5/"
      }
    },
    {
      "effect": "Used on a party Pokémon in battle\n:   Raises the target’s Special Defense by six stages.\nThis item can only be obtained or used via the Wonder Launcher.",
      "short_effect": "Raises Special Defense by six stages in battle.  Wonder Launcher only.",
      "language": {
        "name": "en",
        "url": "/api/v2/language/9/"
      }
    }
  ],
  "flavor_text_entries": [
    {
      "text": "Monte fortement la Déf. Spé. pendant\nun combat. L’effet s’estompe\nsi le Pokémon se retire.",
      "version_group": {
        "name": "black-white",
        "url": "/api/v2/version-group/11/"
      },
      "language": {
        "name": "fr",
        "url": "/api/v2/language/5/"
      }
    },
    {
      "text": "It raises the Sp. Def stat of a Pokémon\nin battle immensely. It wears off if the\nPokémon is withdrawn.",
      "version_group": {
        "name": "black-white",
        "url": "/api/v2/version-group/11/"
      },
      "language": {
        "name": "en",
        "url": "/api/v2/language/9/"
      }
    },
    {
      "text": "It raises the Sp. Def stat of a Pokémon\nin battle immensely. It wears off if the\nPokémon is withdrawn.",
      "version_group": {
        "name": "black-2-white-2",
        "url": "/api/v2/version-group/14/"
      },
      "language": {
        "name": "en",
        "url": "/api/v2/language/9/"
      }
    },
    {
      "text": "せんとうちゅうの　ポケモンの\nとくぼうを　ものすごく　あげる。\nひっこめると　もとに　もどる。",
      "version_group": {
        "name": "x-y",
        "url": "/api/v2/version-group/15/"
      },
      "language": {
        "name": "ja-hrkt",
        "url": "/api/v2/language/1/"
      }
    },
    {
      "text": "배틀 중인 포켓몬의 특수방어를\n엄청나게 올린다. 포켓몬을 볼에\n넣어버리면 원래대로 되돌아간다.",
      "version_group": {
        "name": "x-y",
        "url": "/api/v2/version-group/15/"
      },
      "language": {
        "name": "ko",
        "url": "/api/v2/language/3/"
      }
    },
    {
      "text": "Augmente fortement la Défense Spéciale pendant\nun combat. L’effet s’estompe si le Pokémon\nse retire.",
      "version_group": {
        "name": "x-y",
        "url": "/api/v2/version-group/15/"
      },
      "language": {
        "name": "fr",
        "url": "/api/v2/language/5/"
      }
    },
    {
      "text": "Hebt den Spezial-Verteidigungs-Wert eines\nPokémon im Kampf enorm an. Die Wirkung endet\nmit dem Austausch des Pokémon.",
