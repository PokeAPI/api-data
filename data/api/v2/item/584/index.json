  "effect_entries": [
    {
      "effect": "Tenu :   Le porteur est immunisé aux capacités de type Sol, Picots, Pics Toxik, et Piège Sable.\n\n    Cet effet ne s'applique pas sous Gravité ou Racines.\n\n    Quand le porteur subit des dégâts d'une capacité, cet objet est consommé.",
      "short_effect": "Tenu: Donne l'immunité aux capacités de type Sol, Picots et Pics Toxik. Consommé quand le porteur prend des dégâts d'une capacité.",
      "language": {
        "name": "fr",
        "url": "/api/v2/language/5/"
      }
    },
    {
      "effect": "Held\n:   Holder is immune to Ground-type moves, Spikes, Toxic Spikes, and Arena Trap.\n\n    This effect does not apply during Gravity or Ingrain.\n\n    When the holder takes damage from a move, this item is consumed.",
      "short_effect": "Held: Grants immunity to Ground-type moves, Spikes, and Toxic Spikes. Consumed when the holder takes damage from a move.",
      "language": {
        "name": "en",
        "url": "/api/v2/language/9/"
      }
    }
  ],
  "flavor_text_entries": [
    {
      "text": "Tenu par un Pokémon, cet objet lui\npermet de flotter dans les airs.\nIl éclate en cas d’attaque.",
      "version_group": {
        "name": "black-white",
        "url": "/api/v2/version-group/11/"
      },
      "language": {
        "name": "fr",
        "url": "/api/v2/language/5/"
      }
    },
    {
      "text": "When held by a Pokémon, the Pokémon\nwill float into the air. When the holder\nis attacked, this item will burst.",
      "version_group": {
        "name": "black-white",
        "url": "/api/v2/version-group/11/"
      },
      "language": {
        "name": "en",
        "url": "/api/v2/language/9/"
      }
    },
    {
      "text": "When held by a Pokémon, the Pokémon\nwill float into the air. When the holder\nis attacked, this item will burst.",
      "version_group": {
        "name": "black-2-white-2",
        "url": "/api/v2/version-group/14/"
      },
      "language": {
        "name": "en",
        "url": "/api/v2/language/9/"
      }
    },
    {
      "text": "ポケモンに　もたせると\nポケモンが　ちゅうに　うく。\nこうげきを　うけると　われてしまう。",
      "version_group": {
        "name": "x-y",
        "url": "/api/v2/version-group/15/"
      },
      "language": {
        "name": "ja-hrkt",
        "url": "/api/v2/language/1/"
      }
    },
    {
      "text": "포켓몬에게 지니게 하면\n포켓몬이 허공에 뜬다.\n공격을 받으면 터져버린다.",
      "version_group": {
        "name": "x-y",
        "url": "/api/v2/version-group/15/"
      },
      "language": {
        "name": "ko",
        "url": "/api/v2/language/3/"
      }
    },
    {
      "text": "Tenu par un Pokémon, cet objet lui permet de\nflotter dans les airs. Il éclate en cas d’attaque.",
      "version_group": {
        "name": "x-y",
        "url": "/api/v2/version-group/15/"
      },
      "language": {
        "name": "fr",
        "url": "/api/v2/language/5/"
      }
    },
    {
      "text": "Gibt man ihn einem Pokémon zum Tragen,\nfängt es an zu schweben. Wird es getroffen,\nplatzt der Luftballon.",
      "version_group": {
        "name": "x-y",
        "url": "/api/v2/version-group/15/"
      },
      "language": {
        "name": "de",
        "url": "/api/v2/language/6/"
      }
    },
    {
      "text": "Joya de un solo uso que potencia los\nmovimientos de tipo Fantasma. Debe llevarla\nun Pokémon.",
      "version_group": {
        "name": "x-y",
        "url": "/api/v2/version-group/15/"
      },
      "language": {
        "name": "es",
        "url": "/api/v2/language/7/"
      }
    },
    {
      "text": "Permette al Pokémon che ha questo strumento\ndi fluttuare in aria. Scoppia se il Pokémon\nè colpito da un attacco.",
      "version_group": {
        "name": "x-y",
        "url": "/api/v2/version-group/15/"
      },
      "language": {
        "name": "it",
        "url": "/api/v2/language/8/"
      }
    },
    {
      "text": "An item to be held by a Pokémon.\nThe holder will float in the air until hit.\nOnce hit, this item will burst.",
      "version_group": {
        "name": "x-y",
        "url": "/api/v2/version-group/15/"
      },
      "language": {
        "name": "en",
        "url": "/api/v2/language/9/"
