        "name": "x-y",
        "url": "/api/v2/version-group/15/"
      },
      "language": {
        "name": "de",
        "url": "/api/v2/language/6/"
      }
    },
    {
      "text": "Si la lleva un Pokémon, debilita un ataque\nsupereficaz de tipo Planta de un enemigo.",
