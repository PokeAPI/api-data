        "name": "x-y",
        "url": "/api/v2/version-group/15/"
      },
      "language": {
        "name": "fr",
        "url": "/api/v2/language/5/"
      }
    },
    {
      "text": "Isst ein Pokémon diese Beere, stärkt dies\neure Freundschaft, verringert aber seinen\nAngriffs-Basiswert.",
