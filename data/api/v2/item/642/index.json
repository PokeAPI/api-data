        "name": "x-y",
        "url": "/api/v2/version-group/15/"
      },
      "language": {
        "name": "fr",
        "url": "/api/v2/language/5/"
      }
    },
    {
      "text": "Hebt den Spezial-Verteidigungs-Wert eines\nPokémon im Kampf stark an. Die Wirkung endet\nmit dem Austausch des Pokémon.",
