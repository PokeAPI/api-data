  "effect_entries": [
    {
      "effect": "Utilisé sur un Pokémon de l'équipe au combat\n:   Augmente l'Attaque Spéciale de la cible de trois niveaux.\nCet objet ne peut être obtenu ou utilisé que via le Shooter Miracle.",
      "short_effect": "Augmente la Défense Spéciale de trois niveaux au combat.  Shooter Miracle seulement.",
      "language": {
        "name": "fr",
        "url": "/api/v2/language/5/"
      }
    },
    {
      "effect": "Used on a party Pokémon in battle\n:   Raises the target’s Special Defense by three stages.\nThis item can only be obtained or used via the Wonder Launcher.",
      "short_effect": "Raises Special Defense by three stages in battle.  Wonder Launcher only.",
      "language": {
        "name": "en",
        "url": "/api/v2/language/9/"
      }
    }
  ],
  "flavor_text_entries": [
    {
      "text": "Monte sensiblement la Déf. Spé.\npendant un combat. L’effet s’estompe\nsi le Pokémon se retire.",
