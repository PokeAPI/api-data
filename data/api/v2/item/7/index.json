        "name": "en",
        "url": "/api/v2/language/9/"
      }
    },
    {
      "text": "Une Poké Ball un peu spéciale qui\nfonctionne particulièrement bien\nsur les Pokémon sous-marins.",
      "version_group": {
        "name": "black-white",
        "url": "/api/v2/version-group/11/"
