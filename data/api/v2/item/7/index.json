        "name": "x-y",
        "url": "/api/v2/version-group/15/"
      },
      "language": {
        "name": "de",
        "url": "/api/v2/language/6/"
      }
    },
    {
      "text": "Es algo distinta a las demás. Funciona\nespecialmente bien con los Pokémon que viven\nbajo el agua.",
      "version_group": {
        "name": "x-y",
        "url": "/api/v2/version-group/15/"
