        "name": "emerald",
        "url": "/api/v2/version-group/6/"
      },
      "language": {
        "name": "en",
        "url": "/api/v2/language/9/"
      }
    },
    {
      "text": "A somewhat different BALL that\nworks especially well on POKéMON\ndeep in the sea.",
