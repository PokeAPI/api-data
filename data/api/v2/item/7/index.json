        "url": "/api/v2/version-group/7/"
      },
      "language": {
        "name": "en",
        "url": "/api/v2/language/9/"
      }
    },
    {
      "text": "A somewhat different Poké Ball that\nworks especially well on Pokémon that\nlive in the sea.",
      "version_group": {
        "name": "diamond-pearl",
        "url": "/api/v2/version-group/8/"
      },
      "language": {
        "name": "en",
        "url": "/api/v2/language/9/"
      }
    },
    {
      "text": "A somewhat different Poké Ball that\nworks especially well on Pokémon that\nlive in the sea.",
      "version_group": {
        "name": "platinum",
        "url": "/api/v2/version-group/9/"
      },
      "language": {
        "name": "en",
        "url": "/api/v2/language/9/"
      }
    },
    {
      "text": "A somewhat different Poké Ball that\nworks especially well on Pokémon that\nlive in the sea.",
      "version_group": {
