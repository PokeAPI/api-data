        "name": "ruby-sapphire",
        "url": "/api/v2/version-group/5/"
      },
      "language": {
        "name": "en",
        "url": "/api/v2/language/9/"
      }
    },
    {
      "text": "A BALL that works\nbetter on POKéMON\non the ocean floor.",
