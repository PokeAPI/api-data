  "flavor_text_entries": [
    {
      "text": "It holds Pokéathlon records. It’s a\ncard that shows how many times your\nPokémon have failed.",
      "version_group": {
        "name": "heartgold-soulsilver",
        "url": "/api/v2/version-group/10/"
      },
      "language": {
        "name": "en",
        "url": "/api/v2/language/9/"
      }
    },
    {
      "text": "Contient vos données du Pokéathlon.\nSur cette carte est inscrit le nombre\nd’erreurs de vos Pokémon.",
      "version_group": {
        "name": "black-white",
        "url": "/api/v2/version-group/11/"
      },
      "language": {
        "name": "fr",
        "url": "/api/v2/language/5/"
      }
    },
    {
      "text": "It holds Pokéathlon records. It’s a\ncard that shows how many times your\nPokémon have failed.",
      "version_group": {
