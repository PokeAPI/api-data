        "url": "/api/v2/version-group/20/"
      },
      "language": {
        "name": "es",
        "url": "/api/v2/language/7/"
      }
    },
    {
      "text": "Pugno che assorbe energia. Fa recuperare una\nquantità di PS pari alla metà del danno inferto.",
