        "name": "sword-shield",
        "url": "/api/v2/version-group/20/"
      },
      "language": {
        "name": "it",
        "url": "/api/v2/language/8/"
      }
    },
    {
      "text": "An energy-draining punch. The user’s HP is restored\nby half the damage taken by the target.",
