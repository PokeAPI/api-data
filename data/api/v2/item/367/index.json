        "url": "/api/v2/version-group/20/"
      },
      "language": {
        "name": "de",
        "url": "/api/v2/language/6/"
      }
    },
    {
      "text": "Un golpe que drena energía. El Pokémon recupera la\nmitad de los PS arrebatados al objetivo.",
