  "category": {
    "name": "apricorn-balls",
    "url": "/api/v2/item-category/39/"
  },
  "effect_entries": [
    {
      "effect": "Utilisé par un dresseur en combat\n:   Tente de capturer un Pokémon sauvage.  Si utilisé en combat de dresseurs, rien ne se passe et la ball est perdue.\n\n    Si le Pokémon sauvage pèse:\n\n    * 409.6 kg (903.0 lb) ou plus, son taux de capture est 40 supérieur à le normal.\n    * 307.2 kg (677.3 lb) ou plus, son taux de capture est 30 supérieur à le normal.\n    * 204.8 kg (451.5 lb) ou plus, son taux de capture est 20 supérieur à le normal.\n    * moins de 204.8 kg (451.5 lb), son taux de capture est 20 inférieur à le normal.",
      "short_effect": "A un bonus ou une pénalité fixe sur le taux de capture selon la classe de poids de la cible. Fait à partir de Noigrume Noi.",
      "language": {
        "name": "fr",
        "url": "/api/v2/language/5/"
      }
    },
    {
      "effect": "Used by a trainer in battle\n:   Attempts to catch a wild Pokémon.  If used in a trainer battle, nothing happens and the ball is lost.\n\n    If the wild Pokémon weighs:\n\n    * 409.6 kg (903.0 lb) or more, its catch rate is 40 more than normal.\n    * 307.2 kg (677.3 lb) or more, its catch rate is 30 more than normal.\n    * 204.8 kg (451.5 lb) or more, its catch rate is 20 more than normal.\n    * less than 204.8 kg (451.5 lb), its catch rate is 20 less than normal.",
      "short_effect": "Has flat bonus or penalty to catch rate depending on weight class of target. Made from Blk Apricorn.",
      "language": {
        "name": "en",
        "url": "/api/v2/language/9/"
      }
    }
  ],
