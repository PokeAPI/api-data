  "effect_entries": [
    {
      "effect": "Fait évoluer Doudou en Solgaleo quand utilisé à l'Autel du Soleil.",
      "short_effect": "Fait évoluer Doudou en Solgaleo quand utilisé à l'Autel du Soleil.",
      "language": {
