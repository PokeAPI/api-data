  "effect_entries": [
    {
      "effect": "Tenu au combat\n:   Quand le porteur est endormi, cela consomme cet objet pour le réveiller.\n\nUtilisé sur un Pokémon de l'équipe\n:   Soigne le sommeil.",
      "short_effect": "Tenu: Consommé quand endormi pour soigner le sommeil.",
      "language": {
        "name": "fr",
        "url": "/api/v2/language/5/"
      }
    },
    {
      "effect": "Held in battle\n:   When the holder is asleep, it consumes this item to wake up.\n\nUsed on a party Pokémon\n:   Cures sleep.",
      "short_effect": "Held: Consumed when asleep to cure sleep.",
      "language": {
        "name": "en",
        "url": "/api/v2/language/9/"
      }
    }
  ],
  "flavor_text_entries": [
    {
      "text": "A hold item that\nawakens POKéMON\nin battle.",
      "version_group": {
        "name": "ruby-sapphire",
        "url": "/api/v2/version-group/5/"
      },
      "language": {
        "name": "en",
        "url": "/api/v2/language/9/"
      }
    },
    {
      "text": "A hold item that\nawakens POKéMON\nin battle.",
      "version_group": {
        "name": "emerald",
        "url": "/api/v2/version-group/6/"
      },
      "language": {
        "name": "en",
        "url": "/api/v2/language/9/"
      }
    },
    {
      "text": "When held by a POKéMON, it will be\nused in battle to wake up.",
      "version_group": {
        "name": "firered-leafgreen",
        "url": "/api/v2/version-group/7/"
      },
      "language": {
        "name": "en",
        "url": "/api/v2/language/9/"
      }
    },
    {
      "text": "A Poffin ingredient. It may be used\nor held by a Pokémon to recover from\nsleep.",
      "version_group": {
        "name": "diamond-pearl",
        "url": "/api/v2/version-group/8/"
      },
      "language": {
        "name": "en",
        "url": "/api/v2/language/9/"
      }
    },
    {
      "text": "A Poffin ingredient. It may be used\nor held by a Pokémon to recover from\nsleep.",
      "version_group": {
        "name": "platinum",
        "url": "/api/v2/version-group/9/"
      },
      "language": {
        "name": "en",
        "url": "/api/v2/language/9/"
      }
    },
    {
      "text": "It may be used or held by a Pokémon to\nrecover from sleep.",
      "version_group": {
        "name": "heartgold-soulsilver",
        "url": "/api/v2/version-group/10/"
      },
      "language": {
        "name": "en",
        "url": "/api/v2/language/9/"
      }
    },
    {
      "text": "Baie qui soigne le sommeil lorsqu’elle\nest tenue par un Pokémon.",
      "version_group": {
        "name": "black-white",
        "url": "/api/v2/version-group/11/"
      },
      "language": {
        "name": "fr",
        "url": "/api/v2/language/5/"
      }
    },
    {
      "text": "If held by a Pokémon,\nit recovers from sleep.",
      "version_group": {
        "name": "black-white",
        "url": "/api/v2/version-group/11/"
      },
      "language": {
        "name": "en",
        "url": "/api/v2/language/9/"
      }
    },
    {
      "text": "If held by a Pokémon,\nit recovers from sleep.",
      "version_group": {
        "name": "black-2-white-2",
        "url": "/api/v2/version-group/14/"
      },
      "language": {
        "name": "en",
        "url": "/api/v2/language/9/"
      }
    },
    {
      "text": "ポケモンに　もたせると\nねむりを　かいふくする。\n",
      "version_group": {
        "name": "x-y",
        "url": "/api/v2/version-group/15/"
      },
      "language": {
        "name": "ja-hrkt",
        "url": "/api/v2/language/1/"
      }
    },
    {
      "text": "포켓몬에게 지니게 하면\n잠듦을 회복한다.",
      "version_group": {
        "name": "x-y",
        "url": "/api/v2/version-group/15/"
      },
      "language": {
        "name": "ko",
        "url": "/api/v2/language/3/"
      }
    },
    {
      "text": "Une Baie qui soigne le sommeil lorsqu’elle est\ntenue par un Pokémon.",
      "version_group": {
        "name": "x-y",
        "url": "/api/v2/version-group/15/"
      },
      "language": {
        "name": "fr",
        "url": "/api/v2/language/5/"
      }
    },
    {
      "text": "Gibst du die Beere einem Pokémon zum Tragen,\nerwacht es dadurch aus dem Schlaf.",
      "version_group": {
        "name": "x-y",
        "url": "/api/v2/version-group/15/"
      },
      "language": {
        "name": "de",
        "url": "/api/v2/language/6/"
      }
    },
    {
      "text": "Una baya muy rara en la región de Teselia.",
      "version_group": {
        "name": "x-y",
        "url": "/api/v2/version-group/15/"
      },
      "language": {
        "name": "es",
        "url": "/api/v2/language/7/"
      }
    },
    {
      "text": "Se un Pokémon ha questa bacca, si risveglia\ndal sonno.",
