        "name": "ultra-sun-ultra-moon",
        "url": "/api/v2/version-group/18/"
      },
      "language": {
        "name": "fr",
        "url": "/api/v2/language/5/"
      }
    },
    {
      "text": "Ein Schlüssel, der eine Tür in der Dukatia-Passage\nvon Dukatia City öffnet.",
