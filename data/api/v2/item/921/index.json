  "flavor_text_entries": [
    {
      "text": "コガネちかどうに　ある　とびらを\nあける　カギ。\n",
      "version_group": {
        "name": "ultra-sun-ultra-moon",
        "url": "/api/v2/version-group/18/"
      },
      "language": {
        "name": "ja-hrkt",
        "url": "/api/v2/language/1/"
      }
    },
    {
      "text": "금빛지하도에 있는 문을\n여는 열쇠.",
      "version_group": {
        "name": "ultra-sun-ultra-moon",
        "url": "/api/v2/version-group/18/"
      },
      "language": {
        "name": "ko",
        "url": "/api/v2/language/3/"
      }
    },
    {
      "text": "用來打開滿金地下道的\n門的鑰匙。",
