        "name": "x-y",
        "url": "/api/v2/version-group/15/"
      },
      "language": {
        "name": "de",
        "url": "/api/v2/language/6/"
      }
    },
    {
      "text": "Es algo particular. Hace que sea más fácil\ncapturar a los Pokémon salvajes por la noche\no en lugares oscuros.",
