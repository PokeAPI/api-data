  "effect_entries": [
    {
      "effect": "Utilisé par un dresseur en combat\n:   Tente de capturer un Pokémon sauvage.  Si utilisé en combat de dresseurs, rien ne se passe et la ball est perdue.\n\n    Si capturé, le bonheur du Pokémon sauvage commence à 200.",
      "short_effect": "Les Pokémon capturés commencent avec 200 de bonheur. Fait à partir de Noigrume Ver.",
      "language": {
        "name": "fr",
        "url": "/api/v2/language/5/"
      }
    },
    {
      "effect": "Used by a trainer in battle\n:   Attempts to catch a wild Pokémon.  If used in a trainer battle, nothing happens and the ball is lost.\n\n    If caught, the wild Pokémon’s happiness starts at 200.",
      "short_effect": "Caught Pokémon start with 200 happiness. Made from Grn Apricorn.",
      "language": {
        "name": "en",
        "url": "/api/v2/language/9/"
      }
    }
  ],
