        "name": "lets-go-pikachu-lets-go-eevee",
        "url": "/api/v2/version-group/19/"
      },
      "language": {
        "name": "it",
        "url": "/api/v2/language/8/"
      }
    },
    {
      "text": "A Berry that makes you slightly more likely\nto get an item when it’s given to Pokémon you’re\ntrying to catch.",
