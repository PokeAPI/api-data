        "name": "sword-shield",
        "url": "/api/v2/version-group/20/"
      },
      "language": {
        "name": "fr",
        "url": "/api/v2/language/5/"
      }
    },
    {
      "text": "Der Anwender verursacht eine Explosion, mit der er bei\nallen Pokémon im Umkreis Riesenschaden anrichtet und\nselbst kampfunfähig wird.",
      "version_group": {
        "name": "sword-shield",
        "url": "/api/v2/version-group/20/"
      },
      "language": {
        "name": "de",
        "url": "/api/v2/language/6/"
      }
    },
    {
      "text": "El atacante explota y hiere a todos a su alrededor.\nEl usuario se debilita de inmediato.",
