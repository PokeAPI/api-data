  "effect_entries": [
    {
      "effect": "Tenu\n:   Les capacités utilisées par le porteur qui piègent et infligent des dégâts à la cible sur plusieurs tours (e.g. Étreinte, Danse Flammes) infligent le double des dégâts par tour habituels.",
      "short_effect": "Tenu: Double les dégâts par tour des capacités piégeantes multitours.",
      "language": {
        "name": "fr",
        "url": "/api/v2/language/5/"
      }
    },
    {
      "effect": "Held\n:   Moves used by the holder that trap and damage a target for multiple turns (e.g. Bind, Fire Spin) inflict twice their usual per-turn damage.",
      "short_effect": "Held: Doubles the per-turn damage of multi-turn trapping moves.",
      "language": {
        "name": "en",
        "url": "/api/v2/language/9/"
      }
    }
  ],
