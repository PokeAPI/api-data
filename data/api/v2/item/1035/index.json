  "effect_entries": [],
  "flavor_text_entries": [
    {
      "text": "ただ　ひとりの　トレーナーへの\nきもちを　こめて　いっしょうけんめい\nつくった　ささやかな　はなたば。",
      "version_group": {
        "name": "lets-go-pikachu-lets-go-eevee",
        "url": "/api/v2/version-group/19/"
      },
      "language": {
        "name": "ja-hrkt",
        "url": "/api/v2/language/1/"
      }
    },
    {
      "text": "단 하나뿐인 트레이너를 향한\n마음을 담아 정성껏 만든\n작은 꽃다발.",
      "version_group": {
        "name": "lets-go-pikachu-lets-go-eevee",
        "url": "/api/v2/version-group/19/"
      },
      "language": {
        "name": "ko",
        "url": "/api/v2/language/3/"
      }
    },
    {
      "text": "竭盡心力製作的花束。\n雖然不起眼，但裡頭\n充滿了對訓練家的心意。",
      "version_group": {
        "name": "lets-go-pikachu-lets-go-eevee",
        "url": "/api/v2/version-group/19/"
      },
      "language": {
        "name": "zh-hant",
        "url": "/api/v2/language/4/"
      }
    },
    {
      "text": "Un petit bouquet arrangé avec amour pour\nun[VAR (00FF,0B09)] Dresseure Dresseuse vraiment unique.",
      "version_group": {
        "name": "lets-go-pikachu-lets-go-eevee",
        "url": "/api/v2/version-group/19/"
      },
      "language": {
        "name": "fr",
        "url": "/api/v2/language/5/"
      }
    },
    {
      "text": "Ein Blumenstrauß, der sorgfältig und mit viel Mühe\nfür einen ganz besonderen Trainer gesteckt wurde.",
      "version_group": {
        "name": "lets-go-pikachu-lets-go-eevee",
        "url": "/api/v2/version-group/19/"
      },
      "language": {
        "name": "de",
        "url": "/api/v2/language/6/"
      }
    },
    {
      "text": "Pequeño ramo de flores confeccionado con dedicación\ny esmero solo para ti.",
      "version_group": {
        "name": "lets-go-pikachu-lets-go-eevee",
        "url": "/api/v2/version-group/19/"
      },
      "language": {
        "name": "es",
        "url": "/api/v2/language/7/"
      }
    },
    {
      "text": "Un piccolo mazzo di fiori composto con cura\ne amore per un[VAR (00FF,0B0A)] Allenator’Allenatrice unic[VAR (00FF,0101)]oa al mondo.",
      "version_group": {
        "name": "lets-go-pikachu-lets-go-eevee",
        "url": "/api/v2/version-group/19/"
      },
      "language": {
        "name": "it",
        "url": "/api/v2/language/8/"
      }
    },
    {
      "text": "A small bouquet that was made with heart and soul\nfor a single Trainer.",
      "version_group": {
        "name": "lets-go-pikachu-lets-go-eevee",
        "url": "/api/v2/version-group/19/"
      },
      "language": {
        "name": "en",
        "url": "/api/v2/language/9/"
      }
    },
    {
      "text": "ただ　ひとりの　トレーナーへの\n気持ちを　こめて　一生懸命\n作った　ささやかな　花束。",
      "version_group": {
        "name": "lets-go-pikachu-lets-go-eevee",
        "url": "/api/v2/version-group/19/"
      },
      "language": {
        "name": "ja",
        "url": "/api/v2/language/11/"
      }
    },
    {
      "text": "竭尽心力制作的素雅花束。\n里面满满都是对训练家的心意。",
      "version_group": {
        "name": "lets-go-pikachu-lets-go-eevee",
        "url": "/api/v2/version-group/19/"
