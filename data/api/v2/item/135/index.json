  "effect_entries": [
    {
      "effect": "Tenu au combat\n:   Quand le porteur a 1/2 de ses PV max restants ou moins, cela consomme cet objet pour restaurer 1/4 de ses PV max.\n\nUtilisé sur un Pokémon de l'équipe\n:   Restaure 1/4 des PV max du Pokémon.",
      "short_effect": "Tenu: Consommé à 1/2 des PV max pour regagner 1/4 des PV max.",
      "language": {
        "name": "fr",
        "url": "/api/v2/language/5/"
      }
    },
    {
      "effect": "Held in battle\n:   When the holder has 1/2 its max HP remaining or less, it consumes this item to restore 1/4 its max HP.\n\nUsed on a party Pokémon\n:   Restores 1/4 the Pokémon’s max HP.",
      "short_effect": "Held: Consumed at 1/2 max HP to recover 1/4 max HP.",
      "language": {
        "name": "en",
        "url": "/api/v2/language/9/"
      }
    }
  ],
