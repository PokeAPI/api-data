  "effect_entries": [
    {
      "effect": "Ne peut être utilisé seulement dans la forêt du Heylink, pour capturer les Pokémon rencontrés dans le Dream World.\n\nUtilisé au combat\n:   Capture un Pokémon sauvage sans échouer.",
      "short_effect": "Capture les Pokémon trouvés dans le Dream World.",
      "language": {
        "name": "fr",
        "url": "/api/v2/language/5/"
      }
    },
    {
      "effect": "Can only be used in Entree Forest, to catch Pokémon encountered in the Dream World.\n\nUsed in battle\n:   Catches a wild Pokémon without fail.",
      "short_effect": "Catches Pokémon found in the Dream World.",
      "language": {
        "name": "en",
        "url": "/api/v2/language/9/"
      }
    }
  ],
  "flavor_text_entries": [
    {
      "text": "Poké Ball du rêve. Apparue dans le\nSac à la Forêt du Heylink. Permet\nd’attraper n’importe quel Pokémon.",
