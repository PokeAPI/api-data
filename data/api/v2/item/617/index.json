        "name": "black-white",
        "url": "/api/v2/version-group/11/"
      },
      "language": {
        "name": "fr",
        "url": "/api/v2/language/5/"
      }
    },
    {
      "text": "A special Poké Ball that appears out of\nnowhere in a bag at the Entree Forest.\nIt can catch any Pokémon.",
      "version_group": {
        "name": "black-white",
        "url": "/api/v2/version-group/11/"
      },
      "language": {
        "name": "en",
        "url": "/api/v2/language/9/"
      }
    },
    {
      "text": "A special Poké Ball that appears out of\nnowhere in a bag at the Entree Forest.\nIt can catch any Pokémon.",
