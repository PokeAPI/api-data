  "effect_entries": [
    {
      "effect": "Tenu: Permet à Mysdibule de Méga-Évoluer en Méga-Mysdibule.",
      "short_effect": "Tenu: Permet à Mysdibule de Méga-Évoluer en Méga-Mysdibule.",
      "language": {
