  "flavor_text_entries": [
    {
      "text": "えんとつやまで　てにいれた　いんせき。\nほのかに　かがやきを　はなっている。",
      "version_group": {
        "name": "ultra-sun-ultra-moon",
        "url": "/api/v2/version-group/18/"
      },
      "language": {
        "name": "ja-hrkt",
        "url": "/api/v2/language/1/"
      }
    },
    {
      "text": "굴뚝산에서 손에 넣은 운석.\n은은하게 빛을 발하고 있다.",
      "version_group": {
        "name": "ultra-sun-ultra-moon",
        "url": "/api/v2/version-group/18/"
      },
      "language": {
        "name": "ko",
        "url": "/api/v2/language/3/"
      }
    },
    {
      "text": "在煙囪山上獲得的隕石。\n隱約散發著光芒。",
      "version_group": {
        "name": "ultra-sun-ultra-moon",
        "url": "/api/v2/version-group/18/"
      },
      "language": {
        "name": "zh-hant",
        "url": "/api/v2/language/4/"
      }
    },
    {
      "text": "Une météorite trouvée au Mont Chimnée.\nElle émet une légère lueur.",
      "version_group": {
        "name": "ultra-sun-ultra-moon",
        "url": "/api/v2/version-group/18/"
      },
      "language": {
        "name": "fr",
        "url": "/api/v2/language/5/"
      }
    },
    {
      "text": "Ein Meteorit, den du beim Schlotberg erhalten hast.\nVom ihm geht ein schwaches Leuchten aus.",
      "version_group": {
        "name": "ultra-sun-ultra-moon",
        "url": "/api/v2/version-group/18/"
      },
      "language": {
        "name": "de",
        "url": "/api/v2/language/6/"
      }
    },
    {
      "text": "Meteorito obtenido en el Monte Cenizo.\nDesprende un tenue brillo.",
      "version_group": {
        "name": "ultra-sun-ultra-moon",
        "url": "/api/v2/version-group/18/"
      },
      "language": {
        "name": "es",
        "url": "/api/v2/language/7/"
      }
    },
    {
      "text": "Meteorite ottenuto sul Monte Camino.\nEmette una debole luminescenza.",
      "version_group": {
        "name": "ultra-sun-ultra-moon",
        "url": "/api/v2/version-group/18/"
      },
      "language": {
        "name": "it",
        "url": "/api/v2/language/8/"
      }
    },
    {
      "text": "A Meteorite that you got at Mt. Chimney. It gives off\na faint glow.",
      "version_group": {
        "name": "ultra-sun-ultra-moon",
        "url": "/api/v2/version-group/18/"
      },
      "language": {
        "name": "en",
