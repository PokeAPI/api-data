  "effect_entries": [],
  "flavor_text_entries": [
    {
      "text": "たくさん　収納できる　バスケットにポケモンと　ピクニックを　するための道具が　あれこれ　つまっている。",
      "version_group": {
        "name": "scarlet-violet",
        "url": "/api/v2/version-group/25/"
      },
      "language": {
        "name": "ja-hrkt",
        "url": "/api/v2/language/1/"
      }
    },
    {
      "text": "잔뜩 수납할 수 있는 바구니에 포켓몬과 피크닉을 즐길 때 쓰이는 다양한 도구들이 들어 있다.",
      "version_group": {
        "name": "scarlet-violet",
        "url": "/api/v2/version-group/25/"
      },
      "language": {
        "name": "ko",
        "url": "/api/v2/language/3/"
      }
    },
    {
      "text": "收納空間寬敞的野餐籃內，裝滿了和寶可夢野餐時要使用的各式道具。",
      "version_group": {
        "name": "scarlet-violet",
        "url": "/api/v2/version-group/25/"
      },
      "language": {
        "name": "zh-hant",
        "url": "/api/v2/language/4/"
      }
    },
    {
      "text": "Un panier rempli de toutes les choses nécessaires pour faire un bon pique-nique avec ses Pokémon.",
      "version_group": {
        "name": "scarlet-violet",
        "url": "/api/v2/version-group/25/"
      },
      "language": {
        "name": "fr",
        "url": "/api/v2/language/5/"
      }
    },
    {
      "text": "Ein Korb mit großem Fassungsvermögen, der randvoll mit allerlei Dingen gefüllt ist, die man für ein Picknick mit seinen Pokémon benötigt.",
      "version_group": {
        "name": "scarlet-violet",
        "url": "/api/v2/version-group/25/"
      },
      "language": {
        "name": "de",
        "url": "/api/v2/language/6/"
      }
    },
    {
      "text": "Una espaciosa cesta repleta de toda clase de enseres para disfrutar de pícnics junto a los Pokémon.",
      "version_group": {
        "name": "scarlet-violet",
        "url": "/api/v2/version-group/25/"
      },
      "language": {
        "name": "es",
        "url": "/api/v2/language/7/"
      }
    },
    {
      "text": "Cestino molto capiente stracolmo di strumenti per fare un bel picnic assieme ai Pokémon.",
      "version_group": {
        "name": "scarlet-violet",
        "url": "/api/v2/version-group/25/"
      },
      "language": {
        "name": "it",
        "url": "/api/v2/language/8/"
      }
    },
    {
      "text": "A roomy basket packed with all sorts of things for use when enjoying picnicking with your Pokémon.",
      "version_group": {
        "name": "scarlet-violet",
        "url": "/api/v2/version-group/25/"
      },
      "language": {
        "name": "en",
        "url": "/api/v2/language/9/"
      }
    },
    {
      "text": "たくさん　収納できる　バスケットにポケモンと　ピクニックを　するための道具が　あれこれ　つまっている。",
      "version_group": {
