  "effect_entries": [
    {
      "effect": "Tenu au combat\n:   Quand le porteur est gelé, cela consomme cet objet pour le dégeler.\n\nUtilisé sur un Pokémon de l'équipe\n:   Soigne le gel.",
      "short_effect": "Tenu: Consommé quand gelé pour soigner le gel.",
      "language": {
        "name": "fr",
        "url": "/api/v2/language/5/"
      }
    },
    {
      "effect": "Held in battle\n:   When the holder is frozen, it consumes this item to thaw itself.\n\nUsed on a party Pokémon\n:   Cures freezing.",
      "short_effect": "Held: Consumed when frozen to cure frozen.",
      "language": {
        "name": "en",
        "url": "/api/v2/language/9/"
      }
    }
  ],
  "flavor_text_entries": [
    {
      "text": "A hold item that\ndefrosts POKéMON\nin battle.",
      "version_group": {
        "name": "ruby-sapphire",
        "url": "/api/v2/version-group/5/"
      },
      "language": {
        "name": "en",
        "url": "/api/v2/language/9/"
      }
    },
    {
      "text": "A hold item that\ndefrosts POKéMON\nin battle.",
      "version_group": {
        "name": "emerald",
        "url": "/api/v2/version-group/6/"
      },
      "language": {
        "name": "en",
        "url": "/api/v2/language/9/"
      }
    },
    {
      "text": "When held by a POKéMON, it will be\nused in battle for defrosting.",
      "version_group": {
        "name": "firered-leafgreen",
        "url": "/api/v2/version-group/7/"
      },
      "language": {
        "name": "en",
        "url": "/api/v2/language/9/"
      }
    },
    {
      "text": "A Poffin ingredient. It may be used\nor held by a Pokémon to defrost it.\n",
      "version_group": {
        "name": "diamond-pearl",
        "url": "/api/v2/version-group/8/"
      },
      "language": {
        "name": "en",
        "url": "/api/v2/language/9/"
      }
    },
    {
      "text": "A Poffin ingredient. It may be used\nor held by a Pokémon to defrost it.\n",
      "version_group": {
        "name": "platinum",
        "url": "/api/v2/version-group/9/"
      },
      "language": {
        "name": "en",
        "url": "/api/v2/language/9/"
      }
    },
    {
      "text": "It may be used or held by a Pokémon to\ndefrost it.\n",
      "version_group": {
        "name": "heartgold-soulsilver",
        "url": "/api/v2/version-group/10/"
      },
      "language": {
        "name": "en",
        "url": "/api/v2/language/9/"
      }
    },
    {
      "text": "Baie qui soigne le gel lorsqu’elle\nest tenue par un Pokémon.",
      "version_group": {
        "name": "black-white",
        "url": "/api/v2/version-group/11/"
      },
      "language": {
        "name": "fr",
        "url": "/api/v2/language/5/"
      }
    },
    {
      "text": "If held by a Pokémon,\nit defrosts it.",
      "version_group": {
        "name": "black-white",
        "url": "/api/v2/version-group/11/"
      },
      "language": {
        "name": "en",
        "url": "/api/v2/language/9/"
      }
    },
    {
      "text": "If held by a Pokémon,\nit defrosts it.",
      "version_group": {
        "name": "black-2-white-2",
        "url": "/api/v2/version-group/14/"
      },
      "language": {
        "name": "en",
        "url": "/api/v2/language/9/"
      }
    },
    {
      "text": "ポケモンに　もたせると\nこおりを　かいふくする。\n",
      "version_group": {
        "name": "x-y",
        "url": "/api/v2/version-group/15/"
      },
      "language": {
        "name": "ja-hrkt",
        "url": "/api/v2/language/1/"
      }
    },
    {
      "text": "포켓몬에게 지니게 하면\n얼음을 회복한다.",
      "version_group": {
        "name": "x-y",
        "url": "/api/v2/version-group/15/"
      },
      "language": {
        "name": "ko",
        "url": "/api/v2/language/3/"
      }
    },
    {
      "text": "Une Baie qui soigne le gel lorsqu’elle est\ntenue par un Pokémon.",
      "version_group": {
        "name": "x-y",
        "url": "/api/v2/version-group/15/"
      },
      "language": {
        "name": "fr",
        "url": "/api/v2/language/5/"
      }
    },
    {
      "text": "Gibst du die Beere einem Pokémon zum Tragen,\nheilt diese es von Frost.",
      "version_group": {
        "name": "x-y",
        "url": "/api/v2/version-group/15/"
      },
      "language": {
        "name": "de",
        "url": "/api/v2/language/6/"
      }
    },
    {
      "text": "Al usarla con un Pokémon, se gana su amistad,\npero también reduce su Ataque de base.",
      "version_group": {
        "name": "x-y",
        "url": "/api/v2/version-group/15/"
      },
      "language": {
        "name": "es",
        "url": "/api/v2/language/7/"
      }
    },
    {
      "text": "Se un Pokémon ha questa bacca, guarisce\ndal congelamento.",
      "version_group": {
        "name": "x-y",
        "url": "/api/v2/version-group/15/"
      },
      "language": {
        "name": "it",
        "url": "/api/v2/language/8/"
      }
    },
    {
      "text": "A Berry to be consumed by Pokémon.\nIf a Pokémon holds one, it can recover\nfrom being frozen on its own in battle.",
      "version_group": {
        "name": "x-y",
        "url": "/api/v2/version-group/15/"
      },
      "language": {
        "name": "en",
        "url": "/api/v2/language/9/"
      }
    },
    {
      "text": "ポケモンに　持たせると\nこおりを　回復する。\n",
      "version_group": {
        "name": "x-y",
        "url": "/api/v2/version-group/15/"
      },
      "language": {
        "name": "ja",
