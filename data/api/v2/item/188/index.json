  },
  "effect_entries": [
    {
      "effect": "Tenu au combat\n:   Quand le porteur suvit des dégâts physiques, cela consomme cet objet pour infliger au Pokémon attaquant 1/8 de ses PV max en dégâts.",
      "short_effect": "Tenu: Consommé pour infliger 1/8 des PV max à l'adversaire quand le porteur est touché par une capacité physique.",
      "language": {
        "name": "fr",
        "url": "/api/v2/language/5/"
      }
    },
    {
      "effect": "Held in battle\n:   When the holder takes physical damage, it consumes this item to damage the attacking Pokémon for 1/8 its max HP.",
      "short_effect": "Held: Consumed to deal 1/8 attacker’s max HP when holder is struck by a physical attack.",
      "language": {
        "name": "en",
        "url": "/api/v2/language/9/"
      }
    }
  ],
  "flavor_text_entries": [
    {
      "text": "A Poffin ingredient. If held by a\nPokémon, and if a foe’s physical attack\nlands, the foe also takes damage.",
      "version_group": {
        "name": "diamond-pearl",
        "url": "/api/v2/version-group/8/"
      },
      "language": {
        "name": "en",
        "url": "/api/v2/language/9/"
      }
    },
    {
      "text": "A Poffin ingredient. If held by a\nPokémon, and if a foe’s physical attack\nlands, the foe also takes damage.",
      "version_group": {
        "name": "platinum",
        "url": "/api/v2/version-group/9/"
      },
      "language": {
        "name": "en",
        "url": "/api/v2/language/9/"
      }
    },
    {
      "text": "If held by a Pokémon and a foe’s\nphysical attack lands, the foe also\ntakes damage.",
      "version_group": {
        "name": "heartgold-soulsilver",
        "url": "/api/v2/version-group/10/"
      },
      "language": {
        "name": "en",
        "url": "/api/v2/language/9/"
      }
    },
    {
      "text": "Tenue, cette Baie inflige des dégâts\nà l’ennemi s’il utilise une attaque\nphysique qui atteint son but.",
      "version_group": {
        "name": "black-white",
        "url": "/api/v2/version-group/11/"
      },
      "language": {
        "name": "fr",
        "url": "/api/v2/language/5/"
      }
    },
    {
      "text": "If held by a Pokémon and a physical\nattack lands, the attacker also\ntakes damage.",
      "version_group": {
        "name": "black-white",
        "url": "/api/v2/version-group/11/"
      },
      "language": {
        "name": "en",
        "url": "/api/v2/language/9/"
      }
    },
    {
      "text": "If held by a Pokémon and a physical\nattack lands, the attacker also\ntakes damage.",
      "version_group": {
        "name": "black-2-white-2",
        "url": "/api/v2/version-group/14/"
      },
      "language": {
        "name": "en",
        "url": "/api/v2/language/9/"
      }
    },
    {
      "text": "ポケモンに　もたせると\nぶつりわざを　うけたとき\nあいてにも　ダメージを　あたえる。",
      "version_group": {
        "name": "x-y",
        "url": "/api/v2/version-group/15/"
      },
      "language": {
        "name": "ja-hrkt",
        "url": "/api/v2/language/1/"
      }
    },
    {
      "text": "포켓몬에게 지니게 하면\n물리 기술을 당했을 때\n상대에게도 데미지를 준다.",
      "version_group": {
        "name": "x-y",
        "url": "/api/v2/version-group/15/"
      },
      "language": {
        "name": "ko",
        "url": "/api/v2/language/3/"
      }
    },
    {
      "text": "Tenue, cette Baie inflige des dégâts à\nl’attaquant s’il utilise une attaque physique\nqui atteint son but.",
      "version_group": {
        "name": "x-y",
        "url": "/api/v2/version-group/15/"
      },
      "language": {
        "name": "fr",
        "url": "/api/v2/language/5/"
      }
    },
    {
      "text": "Als getragenes Item bewirkt diese Beere\nSchaden bei jenen, die den Träger mit einer\nphysischen Attacke treffen.",
      "version_group": {
        "name": "x-y",
        "url": "/api/v2/version-group/15/"
      },
      "language": {
        "name": "de",
        "url": "/api/v2/language/6/"
      }
    },
    {
      "text": "Debe llevarla un Pokémon. Permite huir siempre\nde combates contra Pokémon salvajes.",
      "version_group": {
        "name": "x-y",
        "url": "/api/v2/version-group/15/"
      },
      "language": {
        "name": "es",
        "url": "/api/v2/language/7/"
      }
    },
    {
      "text": "Se un Pokémon ha questa bacca, chi attacca\nsubirà danni se la sua mossa fisica va a segno.",
      "version_group": {
        "name": "x-y",
        "url": "/api/v2/version-group/15/"
      },
      "language": {
        "name": "it",
        "url": "/api/v2/language/8/"
      }
    },
    {
      "text": "A Berry to be consumed by Pokémon.\nIf a physical attack hits the Pokémon\nholding it, the attacker will also be hurt.",
      "version_group": {
        "name": "x-y",
        "url": "/api/v2/version-group/15/"
      },
      "language": {
        "name": "en",
        "url": "/api/v2/language/9/"
      }
    },
    {
      "text": "ポケモンに　持たせると\n物理技を　受けたとき\n相手にも　ダメージを　あたえる。",
