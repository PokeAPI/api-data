      },
      "language": {
        "name": "es",
        "url": "/api/v2/language/7/"
      }
    },
    {
      "text": "Pietra dotata di un misterioso potere.\nDurante la lotta reagisce alle Megapietre e può\ninnescare la megaevoluzione dei Pokémon.",
      "version_group": {
        "name": "lets-go-pikachu-lets-go-eevee",
