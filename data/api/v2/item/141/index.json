        "url": "/api/v2/version-group/16/"
      },
      "language": {
        "name": "es",
        "url": "/api/v2/language/7/"
      }
    },
    {
      "text": "Bacca arancione dal sapore piccante usata per creare Pokémelle che aumentano la Classe del Pokémon.",
