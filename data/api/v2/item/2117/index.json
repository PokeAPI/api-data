  "effect_entries": [],
  "flavor_text_entries": [
    {
      "text": "きのみが　ねりこまれた　もち。ポケモン　１匹の　素早さの基礎ポイントを　あげる。",
      "version_group": {
        "name": "scarlet-violet",
        "url": "/api/v2/version-group/25/"
      },
      "language": {
        "name": "ja-hrkt",
        "url": "/api/v2/language/1/"
      }
    },
    {
      "text": "으깬 나무열매가 들어 있는 떡. 포켓몬 1마리의 스피드 기초 포인트를 올린다.",
      "version_group": {
        "name": "scarlet-violet",
        "url": "/api/v2/version-group/25/"
      },
      "language": {
        "name": "ko",
        "url": "/api/v2/language/3/"
      }
    },
    {
      "text": "加入樹果揉製而成的麻糬。能提高１隻寶可夢的速度的基礎點數。",
      "version_group": {
        "name": "scarlet-violet",
        "url": "/api/v2/version-group/25/"
      },
      "language": {
        "name": "zh-hant",
        "url": "/api/v2/language/4/"
      }
    },
    {
      "text": "Un mochi contenant des Baies qui augmente la Vitesse de base d’un Pokémon.",
      "version_group": {
        "name": "scarlet-violet",
        "url": "/api/v2/version-group/25/"
      },
      "language": {
        "name": "fr",
        "url": "/api/v2/language/5/"
      }
    },
    {
      "text": "Ein mit Beeren gefüllter Mochi, der die Initiative- Basispunkte eines Pokémon dauerhaft erhöht.",
      "version_group": {
        "name": "scarlet-violet",
        "url": "/api/v2/version-group/25/"
      },
      "language": {
        "name": "de",
        "url": "/api/v2/language/6/"
      }
    },
    {
      "text": "La masa de este mochi está preparada con bayas. Aumenta la Velocidad de base de un Pokémon.",
      "version_group": {
        "name": "scarlet-violet",
        "url": "/api/v2/version-group/25/"
      },
      "language": {
        "name": "es",
        "url": "/api/v2/language/7/"
      }
    },
    {
      "text": "Mochi preparato con un impasto a base di bacche. Aumenta i punti base della Velocità.",
      "version_group": {
        "name": "scarlet-violet",
        "url": "/api/v2/version-group/25/"
      },
      "language": {
        "name": "it",
        "url": "/api/v2/language/8/"
      }
    },
    {
      "text": "A mochi cake with Berries kneaded into its dough. It increases base points for a Pokémon’s Speed stat.",
      "version_group": {
        "name": "scarlet-violet",
        "url": "/api/v2/version-group/25/"
      },
      "language": {
        "name": "en",
        "url": "/api/v2/language/9/"
      }
    },
    {
      "text": "きのみが　ねりこまれた　もち。ポケモン　１匹の　素早さの基礎ポイントを　あげる。",
      "version_group": {
        "name": "scarlet-violet",
        "url": "/api/v2/version-group/25/"
      },
      "language": {
        "name": "ja",
        "url": "/api/v2/language/11/"
      }
    },
    {
      "text": "糅合树果的粘糕。能提高１只宝可梦的速度的基础点数。",
      "version_group": {
        "name": "scarlet-violet",
        "url": "/api/v2/version-group/25/"
      },
      "language": {
