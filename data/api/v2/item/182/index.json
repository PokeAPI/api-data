  "effect_entries": [
    {
      "effect": "Tenu au combat\n:   Quand le porteur a 1/4 de ses PV max restants ou moins, cela consomme cet objet pour augmenter sa Défense Spéciale d'un niveau.",
      "short_effect": "Tenu: Consommé à 1/4 des PV max pour booster la Défense Spéciale.",
      "language": {
        "name": "fr",
        "url": "/api/v2/language/5/"
      }
    },
    {
      "effect": "Held in battle\n:   When the holder has 1/4 its max HP remaining or less, it consumes this item to raise its Special Defense by one stage.",
      "short_effect": "Held: Consumed at 1/4 max HP to boost Special Defense.",
      "language": {
        "name": "en",
        "url": "/api/v2/language/9/"
      }
    }
  ],
