        "name": "emerald",
        "url": "/api/v2/version-group/6/"
      },
      "language": {
        "name": "en",
        "url": "/api/v2/language/9/"
      }
    },
    {
      "text": "When held by a POKéMON, it will be\nused in battle to restore 10 PP.",
      "version_group": {
        "name": "firered-leafgreen",
        "url": "/api/v2/version-group/7/"
      },
      "language": {
        "name": "en",
        "url": "/api/v2/language/9/"
      }
    },
    {
      "text": "A Poffin ingredient. It may be used\nor held by a Pokémon to restore a\nmove’s PP by 10.",
      "version_group": {
        "name": "diamond-pearl",
        "url": "/api/v2/version-group/8/"
      },
      "language": {
        "name": "en",
        "url": "/api/v2/language/9/"
      }
    },
    {
      "text": "A Poffin ingredient. It may be used\nor held by a Pokémon to restore a\nmove’s PP by 10.",
      "version_group": {
        "name": "platinum",
        "url": "/api/v2/version-group/9/"
      },
      "language": {
        "name": "en",
        "url": "/api/v2/language/9/"
      }
    },
    {
      "text": "It may be used or held by a Pokémon to\nrestore a move’s PP by 10.",
      "version_group": {
        "name": "heartgold-soulsilver",
        "url": "/api/v2/version-group/10/"
      },
      "language": {
        "name": "en",
        "url": "/api/v2/language/9/"
      }
    },
    {
      "text": "Baie qui restaure 10 PP lorsqu’elle\nest tenue par un Pokémon.",
      "version_group": {
        "name": "black-white",
        "url": "/api/v2/version-group/11/"
      },
      "language": {
        "name": "fr",
        "url": "/api/v2/language/5/"
      }
    },
    {
      "text": "If held by a Pokémon,\nit restores a move’s PP by 10.",
      "version_group": {
        "name": "black-white",
        "url": "/api/v2/version-group/11/"
      },
      "language": {
        "name": "en",
        "url": "/api/v2/language/9/"
      }
    },
    {
      "text": "If held by a Pokémon,\nit restores a move’s PP by 10.",
