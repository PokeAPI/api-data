        "url": "/api/v2/version-group/20/"
      },
      "language": {
        "name": "de",
        "url": "/api/v2/language/6/"
      }
    },
    {
      "text": "Ataca al objetivo con cuchillas formadas por energía\npsíquica. Suele ser crítico.",
