        "name": "legends-za",
        "url": "/api/v2/version-group/30/"
      },
      "language": {
        "name": "de",
        "url": "/api/v2/language/6/"
      }
    },
    {
      "text": "Una de las misteriosas Megapiedras. Permite megaevolucionar a Heatran en combate.",
