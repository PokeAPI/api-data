  "effect_entries": [
    {
      "effect": "Utilisé sur un Pokémon de l'équipe au combat\n:   Augmente la Vitesse de la cible de six niveaux.\nCet objet ne peut être obtenu ou utilisé que via le Shooter Miracle.",
      "short_effect": "Augmente la Vitesse de six niveaux au combat.  Shooter Miracle seulement.",
      "language": {
        "name": "fr",
        "url": "/api/v2/language/5/"
      }
    },
    {
      "effect": "Used on a party Pokémon in battle\n:   Raises the target’s Speed by six stages.\nThis item can only be obtained or used via the Wonder Launcher.",
      "short_effect": "Raises Speed by six stages in battle.  Wonder Launcher only.",
      "language": {
        "name": "en",
        "url": "/api/v2/language/9/"
      }
    }
  ],
  "flavor_text_entries": [
    {
      "text": "Monte fortement la Vitesse pendant\nun combat. L’effet s’estompe\nsi le Pokémon se retire.",
      "version_group": {
        "name": "black-white",
        "url": "/api/v2/version-group/11/"
      },
      "language": {
        "name": "fr",
        "url": "/api/v2/language/5/"
      }
    },
    {
      "text": "It raises the Speed stat of a Pokémon\nin battle immensely. It wears off if the\nPokémon is withdrawn.",
      "version_group": {
        "name": "black-white",
        "url": "/api/v2/version-group/11/"
      },
      "language": {
        "name": "en",
        "url": "/api/v2/language/9/"
      }
    },
    {
      "text": "It raises the Speed stat of a Pokémon\nin battle immensely. It wears off if the\nPokémon is withdrawn.",
