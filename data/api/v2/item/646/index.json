        "name": "x-y",
        "url": "/api/v2/version-group/15/"
      },
      "language": {
        "name": "ko",
        "url": "/api/v2/language/3/"
      }
    },
    {
      "text": "Augmente fortement la Vitesse pendant\nun combat. L’effet s’estompe si le Pokémon\nse retire.",
