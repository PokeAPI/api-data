        "url": "/api/v2/version-group/15/"
      },
      "language": {
        "name": "de",
        "url": "/api/v2/language/6/"
      }
    },
    {
      "text": "Lanza una bola oscura que puede bajar la\nDefensa Especial del objetivo.",
