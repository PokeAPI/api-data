        "name": "omega-ruby-alpha-sapphire",
        "url": "/api/v2/version-group/16/"
      },
      "language": {
        "name": "de",
        "url": "/api/v2/language/6/"
      }
    },
    {
      "text": "Se utiliza en la producción de Pokécubos que potencian la belleza. Es una baya muy rara en otras regiones.",
