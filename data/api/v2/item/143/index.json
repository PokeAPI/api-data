        "url": "/api/v2/version-group/16/"
      },
      "language": {
        "name": "es",
        "url": "/api/v2/language/7/"
      }
    },
    {
      "text": "Bacca rosa dal sapore dolce usata per creare Pokémelle che aumentano la Grazia del Pokémon.",
