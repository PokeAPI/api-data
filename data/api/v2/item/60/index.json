        "url": "/api/v2/version-group/15/"
      },
      "language": {
        "name": "de",
        "url": "/api/v2/language/6/"
      }
    },
    {
      "text": "Aumenta la Precisión de los ataques en combate.\nAl cambiar de Pokémon, el efecto desaparece.",
