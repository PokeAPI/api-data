  "flavor_text_entries": [
    {
      "text": "Sphère mystérieuse contenant\nl’Aura d’Unys et utilisable\navec l’Offri-Aura.",
      "version_group": {
        "name": "black-white",
        "url": "/api/v2/version-group/11/"
      },
      "language": {
        "name": "fr",
        "url": "/api/v2/language/5/"
      }
    },
    {
      "text": "A mysterious orb containing the power\nof the Unova region, to be used when\ngenerating Pass Power.",
      "version_group": {
        "name": "black-white",
        "url": "/api/v2/version-group/11/"
      },
      "language": {
        "name": "en",
        "url": "/api/v2/language/9/"
      }
    },
    {
      "text": "A mysterious orb containing the power\nof the Unova region, to be used when\ngenerating Pass Power.",
