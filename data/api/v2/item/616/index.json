        "name": "x-y",
        "url": "/api/v2/version-group/15/"
      },
      "language": {
        "name": "ko",
        "url": "/api/v2/language/3/"
      }
    },
    {
      "text": "Une sphère mystérieuse contenant l’Aura d’Unys\net permettant l’utilisation des Offri-Auras.",
