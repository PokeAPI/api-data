        "name": "sword-shield",
        "url": "/api/v2/version-group/20/"
      },
      "language": {
        "name": "ja",
        "url": "/api/v2/language/11/"
      }
    },
    {
      "text": "没有它，石之塔就会\n崩塌的重要石头。\n有时能从石头里听到声音。",
      "version_group": {
        "name": "sword-shield",
        "url": "/api/v2/version-group/20/"
      },
      "language": {
        "name": "zh-hans",
        "url": "/api/v2/language/12/"
      }
    },
    {
      "text": "Vital para impedir que una torre de piedra se derrumbe.\nA veces se oyen voces en su interior.",
      "version_group": {
        "name": "sword-shield",
        "url": "/api/v2/version-group/20/"
      },
      "language": {
        "name": "es-419",
        "url": "/api/v2/language/14/"
      }
    }
