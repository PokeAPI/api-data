  "effect_entries": [
    {
      "effect": "À placer sur la tour sur la Route 209.  Vérifie la pierre pour rencontrer un Spiritomb, quand la carte de statut du Souterrain de Sinnoh du dresseur compte au moins 32 salutations.",
      "short_effect": "À utiliser sur la tour de la Route 209 pour rencontrer Spiritomb si vous avez au moins 32 salutations dans le Souterrain.",
      "language": {
        "name": "fr",
        "url": "/api/v2/language/5/"
      }
    },
    {
      "effect": "Place in the tower on Route 209.  Check the stone to encounter a Spiritomb, as long as the trainer’s Underground status card counts at least 32 greetings.",
      "short_effect": "Use on the tower on Route 209 to encounter Spiritomb if you have at least 32 Underground greetings.",
      "language": {
        "name": "en",
        "url": "/api/v2/language/9/"
      }
    }
  ],
  "flavor_text_entries": [
    {
      "text": "A vital item that is needed to keep a\nstone tower from collapsing. Voices\ncan be heard from it occasionally.",
      "version_group": {
        "name": "diamond-pearl",
        "url": "/api/v2/version-group/8/"
      },
      "language": {
        "name": "en",
        "url": "/api/v2/language/9/"
      }
    },
    {
      "text": "A vital item that is needed to keep a\nstone tower from collapsing. Voices\ncan be heard from it occasionally.",
      "version_group": {
        "name": "platinum",
        "url": "/api/v2/version-group/9/"
      },
      "language": {
        "name": "en",
        "url": "/api/v2/language/9/"
      }
    },
    {
      "text": "A vital item that is needed to keep a\nstone tower from collapsing. Voices\ncan be heard from it occasionally.",
      "version_group": {
        "name": "heartgold-soulsilver",
        "url": "/api/v2/version-group/10/"
      },
      "language": {
        "name": "en",
        "url": "/api/v2/language/9/"
      }
    },
    {
      "text": "Objet très important qui empêche une\ntour en pierre de s’écrouler. Des\nbruits de voix en sortent parfois.",
      "version_group": {
        "name": "black-white",
        "url": "/api/v2/version-group/11/"
      },
      "language": {
        "name": "fr",
        "url": "/api/v2/language/5/"
      }
    },
    {
      "text": "A vital item that is needed to keep a\nstone tower from collapsing. Voices\ncan be heard from it occasionally.",
      "version_group": {
        "name": "black-white",
        "url": "/api/v2/version-group/11/"
      },
      "language": {
        "name": "en",
        "url": "/api/v2/language/9/"
      }
    },
    {
      "text": "A vital item that is needed to keep a\nstone tower from collapsing. Voices\ncan be heard from it occasionally.",
      "version_group": {
        "name": "black-2-white-2",
        "url": "/api/v2/version-group/14/"
      },
      "language": {
        "name": "en",
        "url": "/api/v2/language/9/"
      }
    },
    {
      "text": "これがないと　いしのとうが\nくずれてしまう　だいじないし。\nときどき　いしから　こえがきこえる。",
      "version_group": {
        "name": "x-y",
        "url": "/api/v2/version-group/15/"
      },
      "language": {
        "name": "ja-hrkt",
        "url": "/api/v2/language/1/"
      }
    },
    {
      "text": "이것이 없으면 돌탑이\n무너져버리는 중요한 돌.\n가끔 돌에서 목소리가 들린다.",
      "version_group": {
        "name": "x-y",
        "url": "/api/v2/version-group/15/"
      },
      "language": {
        "name": "ko",
        "url": "/api/v2/language/3/"
      }
    },
    {
      "text": "Un objet très important qui empêche une tour\nen pierre de s’écrouler. Des bruits de voix\nen sortent parfois.",
      "version_group": {
        "name": "x-y",
        "url": "/api/v2/version-group/15/"
      },
      "language": {
        "name": "fr",
        "url": "/api/v2/language/5/"
      }
    },
    {
      "text": "Ein wichtiges Item, mit dem ein Steinturm\nrepariert werden kann.",
      "version_group": {
        "name": "x-y",
        "url": "/api/v2/version-group/15/"
      },
      "language": {
        "name": "de",
        "url": "/api/v2/language/6/"
      }
    },
    {
      "text": "Vital para impedir que una torre de piedra se\nderrumbe. A veces se oyen voces en su interior.",
      "version_group": {
        "name": "x-y",
        "url": "/api/v2/version-group/15/"
      },
      "language": {
        "name": "es",
        "url": "/api/v2/language/7/"
      }
    },
    {
      "text": "Strumento importante che impedisce il crollo\ndi un pozzo di pietra. A volte dal suo interno\nprovengono delle voci.",
      "version_group": {
        "name": "x-y",
        "url": "/api/v2/version-group/15/"
      },
      "language": {
        "name": "it",
        "url": "/api/v2/language/8/"
      }
    },
    {
      "text": "A vital item that is needed to keep a\nstone tower from collapsing. Voices\ncan be heard from it occasionally.",
      "version_group": {
        "name": "x-y",
        "url": "/api/v2/version-group/15/"
      },
      "language": {
        "name": "en",
        "url": "/api/v2/language/9/"
      }
    },
