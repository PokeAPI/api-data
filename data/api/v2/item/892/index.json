        "url": "/api/v2/version-group/17/"
      },
      "language": {
        "name": "zh-hant",
        "url": "/api/v2/language/4/"
      }
    },
    {
      "text": "Un nectar obtenu au Jardin de Poni.\nPermet à un certain Pokémon de changer\nd’apparence.",
