  "effect_entries": [
    {
      "effect": "Tenu au combat\n:   Quand le porteur a 1/4 de ses PV max restants ou moins, cela consomme cet objet pour augmenter sa Défense d'un niveau.",
      "short_effect": "Tenu: Consommé à 1/4 des PV max pour booster la Défense.",
      "language": {
        "name": "fr",
        "url": "/api/v2/language/5/"
      }
    },
    {
      "effect": "Held in battle\n:   When the holder has 1/4 its max HP remaining or less, it consumes this item to raise its Defense by one stage.",
      "short_effect": "Held: Consumed at 1/4 max HP to boost Defense.",
      "language": {
        "name": "en",
        "url": "/api/v2/language/9/"
      }
    }
  ],
  "flavor_text_entries": [
    {
      "text": "A hold item that\nraises DEFENSE in\na pinch.",
