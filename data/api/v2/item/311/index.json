        "url": "/api/v2/version-group/19/"
      },
      "language": {
        "name": "es",
        "url": "/api/v2/language/7/"
      }
    },
    {
      "text": "Permette di eludere tutti gli attacchi.\nSe usata in successione può fallire.",
