        "name": "sun-moon",
        "url": "/api/v2/version-group/17/"
      },
      "language": {
        "name": "fr",
        "url": "/api/v2/language/5/"
      }
    },
    {
      "text": "Ein Beutel zum Aufbewahren der Zutaten, die man\nim Dschungel sammelt. Er wird bei Mahos Prüfung\nbenutzt.",
