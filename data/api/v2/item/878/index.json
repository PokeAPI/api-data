        "name": "sun-moon",
        "url": "/api/v2/version-group/17/"
      },
      "language": {
        "name": "de",
        "url": "/api/v2/language/6/"
      }
    },
    {
      "text": "Saco para guardar ingredientes, indispensable en la\nJungla Umbría para superar la prueba de Lulú.",
