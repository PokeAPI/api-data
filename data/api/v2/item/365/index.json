        "name": "sword-shield",
        "url": "/api/v2/version-group/20/"
      },
      "language": {
        "name": "en",
        "url": "/api/v2/language/9/"
      }
    },
    {
      "text": "超能力で　自分と　相手の\n防御と　特防の\n能力変化を　入れ替える。",
