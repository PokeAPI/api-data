        "name": "x-y",
        "url": "/api/v2/version-group/15/"
      },
      "language": {
        "name": "fr",
        "url": "/api/v2/language/5/"
      }
    },
    {
      "text": "Ein Ball, dessen Erfolgsquote besonders bei\nPokémon mit niedrigem Level sehr hoch ist.",
