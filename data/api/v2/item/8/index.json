  "effect_entries": [
    {
      "effect": "Utilisé au combat\n:   Tente de capturer un Pokémon sauvage.  A un taux de capture de 3.9Si le Pokémon sauvage a été rencontré en surfant ou pêchant, cette ball a un taux de capture de 3.5x.  Sinon, elle a un taux de capture de 1x.\n\n    Si utilisé pendant un combat de dresseurs, rien ne se passe et la ball est perdue.",
      "short_effect": "Tente de capturer un Pokémon sauvage. Le taux de succès est 3.9× pour un Pokémon niveau 1, et baisse régulièrement jusqu'à 1× au niveau 30.",
      "language": {
        "name": "fr",
        "url": "/api/v2/language/5/"
      }
    },
    {
      "effect": "Used in battle\n:   Attempts to catch a wild Pokémon.  Has a catch rate of given by `(40 - level) / 10`, where `level` is the wild Pokémon’s level, to a maximum of 3.9× for level 1 Pokémon.  If the wild Pokémon’s level is higher than 30, this ball has a catch rate of 1×.\n\n    If used in a trainer battle, nothing happens and the ball is lost.",
      "short_effect": "Tries to catch a wild Pokémon.  Success rate is 3.9× for level 1 Pokémon, and drops steadily to 1× at level 30.",
      "language": {
        "name": "en",
        "url": "/api/v2/language/9/"
      }
    }
  ],
  "flavor_text_entries": [
