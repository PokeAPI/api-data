        "name": "x-y",
        "url": "/api/v2/version-group/15/"
      },
      "language": {
        "name": "it",
        "url": "/api/v2/language/8/"
      }
    },
    {
      "text": "The user sharpens its claws to\nboost its Attack stat and accuracy.",
