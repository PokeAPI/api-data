        "url": "/api/v2/version-group/20/"
      },
      "language": {
        "name": "fr",
        "url": "/api/v2/language/5/"
      }
    },
    {
      "text": "Ein besonderer Ball, der in der Safari-Zone der\nKanto-Region und im Großmoor der Sinnoh-Region\neingesetzt wird.",
