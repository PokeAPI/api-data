        "url": "/api/v2/version-group/20/"
      },
      "language": {
        "name": "de",
        "url": "/api/v2/language/6/"
      }
    },
    {
      "text": "Poké Ball especial que se utilizaba en lugares como\nla Zona Safari de Kanto y el Gran Pantano de Sinnoh.",
