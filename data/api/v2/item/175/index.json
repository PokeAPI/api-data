  "effect_entries": [
    {
      "effect": "Tenu au combat\n:   Quand le porteur devrait subir des dégâts super efficaces de type Ténèbres, cela consomme cet objet pour diviser par deux la quantité de dégâts subis.",
      "short_effect": "Tenu:  Consommé quand touché par une attaque Ténèbres super efficace pour diviser par deux les dégâts subis.",
      "language": {
        "name": "fr",
        "url": "/api/v2/language/5/"
      }
    },
    {
      "effect": "Held in battle\n:   When the holder would take super-effective Dark-type damage, it consumes this item to halve the amount of damage taken.",
      "short_effect": "Held: Consumed when struck by a super-effective Dark-type attack to halve the damage.",
      "language": {
        "name": "en",
        "url": "/api/v2/language/9/"
      }
    }
  ],
  "flavor_text_entries": [
    {
      "text": "A Poffin ingredient. If held by a\nPokémon, it weakens a foe’s\nsupereffective Dark-type attack.",
