  "id": 590,
  "name": "eject-button",
  "fling_power": 30,
  "fling_effect": null,
  "attributes": [],
  "category": {
    "name": "held-items",
    "url": "/api/v2/item-category/12/"
  },
  "effect_entries": [
    {
      "effect": "Tenu\n:   Quand le porteur subit des dommages directs d'une capacité et n'est pas mis KO, il est retiré pour un autre Pokémon non KO de son équipe, choisi par le Dresseur.\nCet effet ne s'active pas si un autre effet empêche le porteur de se retirer.",
      "short_effect": "Tenu: Lorsque le porteur subit des dégâts d'une capacité, il se retire pour un Pokémon de l'équipe au choix du Dresseur.",
      "language": {
        "name": "fr",
        "url": "/api/v2/language/5/"
      }
    },
    {
      "effect": "Held\n:   When the holder takes damage directly from a move and does not faint, it switches out for another non-fainted Pokémon in its party, as chosen by the Trainer.\nThis effect does not activate if another effect prevents the holder from switching out.",
      "short_effect": "Held: When the holder takes damage from a move, it switches out for a party Pokémon of the Trainer’s choice.",
      "language": {
        "name": "en",
        "url": "/api/v2/language/9/"
      }
    }
  ],
  "flavor_text_entries": [
    {
      "text": "Si le Pokémon qui le tient subit une\nattaque, il s’enfuit pour être remplacé\npar un autre membre de l’équipe.",
      "version_group": {
        "name": "black-white",
        "url": "/api/v2/version-group/11/"
      },
      "language": {
        "name": "fr",
        "url": "/api/v2/language/5/"
      }
    },
    {
      "text": "If the holder is hit by an attack, it will\nswitch with another Pokémon in\nyour party.",
      "version_group": {
        "name": "black-white",
        "url": "/api/v2/version-group/11/"
      },
      "language": {
        "name": "en",
        "url": "/api/v2/language/9/"
      }
    },
    {
      "text": "If the holder is hit by an attack, it will\nswitch with another Pokémon in\nyour party.",
      "version_group": {
        "name": "black-2-white-2",
        "url": "/api/v2/version-group/14/"
      },
      "language": {
        "name": "en",
        "url": "/api/v2/language/9/"
      }
    },
    {
      "text": "もたせて　わざを　うけると\nせんとうから　だっしゅつして\nてもちと　いれかわる　ことができる。",
      "version_group": {
        "name": "x-y",
        "url": "/api/v2/version-group/15/"
      },
      "language": {
        "name": "ja-hrkt",
        "url": "/api/v2/language/1/"
      }
    },
    {
      "text": "지니게 하고 기술을 받으면\n배틀에서 탈출하여\n지닌 포켓몬과 교체할 수 있다.",
      "version_group": {
        "name": "x-y",
        "url": "/api/v2/version-group/15/"
      },
      "language": {
        "name": "ko",
        "url": "/api/v2/language/3/"
      }
    },
    {
      "text": "Si le Pokémon qui le tient subit une attaque,\nil s’enfuit pour être remplacé par un autre\nmembre de l’équipe.",
      "version_group": {
        "name": "x-y",
        "url": "/api/v2/version-group/15/"
      },
      "language": {
        "name": "fr",
        "url": "/api/v2/language/5/"
      }
    },
    {
      "text": "Wird der Träger getroffen, flieht er aus dem Kampf\nund wird mit einem Team-Pokémon ausgetauscht.",
      "version_group": {
        "name": "x-y",
        "url": "/api/v2/version-group/15/"
      },
      "language": {
        "name": "de",
        "url": "/api/v2/language/6/"
      }
    },
    {
      "text": "Pluma que aumenta un poco el Ataque de base\nde un Pokémon.",
      "version_group": {
        "name": "x-y",
        "url": "/api/v2/version-group/15/"
      },
      "language": {
        "name": "es",
        "url": "/api/v2/language/7/"
      }
    },
    {
      "text": "Se il Pokémon che ha questo strumento è colpito\nda un attacco, viene immediatamente sostituito\nda un compagno.",
      "version_group": {
        "name": "x-y",
        "url": "/api/v2/version-group/15/"
      },
      "language": {
        "name": "it",
        "url": "/api/v2/language/8/"
      }
    },
    {
      "text": "An item to be held by a Pokémon.\nIf the holder is hit by an attack, it\nwill be switched out of battle.",
      "version_group": {
        "name": "x-y",
        "url": "/api/v2/version-group/15/"
      },
      "language": {
        "name": "en",
        "url": "/api/v2/language/9/"
      }
    },
    {
      "text": "持たせて　技を　受けると\n戦闘から　脱出して\n手持ちと　入れ替わる　ことができる。",
