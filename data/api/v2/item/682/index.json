      }
    },
    {
      "effect": "Held: When the holder is hit by a super effective move, its Attack and Special Attack raise by two stages.",
      "short_effect": "Held: When the holder is hit by a super effective move, its Attack and Special Attack raise by two stages.",
      "language": {
