  "flavor_text_entries": [
    {
      "text": "ロトムパワーの　ひとつ。\nしょうぶの　あとに　もらえる\nけいけんちが　すこし　ふえる。",
      "version_group": {
        "name": "ultra-sun-ultra-moon",
        "url": "/api/v2/version-group/18/"
      },
      "language": {
        "name": "ja-hrkt",
        "url": "/api/v2/language/1/"
      }
    },
    {
      "text": "로토무파워 중 하나.\n승부 후에 얻는\n경험치가 조금 늘어난다.",
      "version_group": {
        "name": "ultra-sun-ultra-moon",
        "url": "/api/v2/version-group/18/"
      },
      "language": {
        "name": "ko",
        "url": "/api/v2/language/3/"
      }
    },
    {
      "text": "洛托姆之力的一種。\n對戰後可獲得的\n經驗值將會稍微增加。",
      "version_group": {
        "name": "ultra-sun-ultra-moon",
        "url": "/api/v2/version-group/18/"
      },
      "language": {
        "name": "zh-hant",
        "url": "/api/v2/language/4/"
      }
    },
    {
      "text": "Une des Motism’Auras. Elle permet d’augmenter\nlégèrement l’expérience gagnée par vos Pokémon\nen combat.",
      "version_group": {
        "name": "ultra-sun-ultra-moon",
        "url": "/api/v2/version-group/18/"
      },
      "language": {
        "name": "fr",
        "url": "/api/v2/language/5/"
      }
    },
    {
      "text": "Diese Rotom-Kraft bewirkt, dass Pokémon im\nKampf mehr Erfahrungspunkte erhalten.",
      "version_group": {
        "name": "ultra-sun-ultra-moon",
        "url": "/api/v2/version-group/18/"
      },
      "language": {
        "name": "de",
        "url": "/api/v2/language/6/"
      }
    },
    {
      "text": "Poder Rotom que incrementa ligeramente los Puntos\nde Experiencia obtenidos en combate.",
      "version_group": {
        "name": "ultra-sun-ultra-moon",
        "url": "/api/v2/version-group/18/"
      },
      "language": {
        "name": "es",
        "url": "/api/v2/language/7/"
      }
    },
    {
      "text": "Potere Rotom che fa aumentare un po’\ni Punti Esperienza ottenuti dopo ogni lotta.",
      "version_group": {
        "name": "ultra-sun-ultra-moon",
        "url": "/api/v2/version-group/18/"
      },
      "language": {
        "name": "it",
        "url": "/api/v2/language/8/"
      }
    },
    {
      "text": "One of the Rotom Powers.\nIt increases the Exp. Points your Pokémon receive\nafter battle a little.",
      "version_group": {
        "name": "ultra-sun-ultra-moon",
        "url": "/api/v2/version-group/18/"
      },
      "language": {
        "name": "en",
        "url": "/api/v2/language/9/"
      }
    },
