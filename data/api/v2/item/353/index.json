        "name": "black-white",
        "url": "/api/v2/version-group/11/"
      },
      "language": {
        "name": "fr",
        "url": "/api/v2/language/5/"
      }
    },
    {
      "text": "The user attacks the target with an\nechoing voice. If this move is used\nevery turn, it does greater damage.",
      "version_group": {
        "name": "black-white",
        "url": "/api/v2/version-group/11/"
      },
      "language": {
        "name": "en",
        "url": "/api/v2/language/9/"
      }
    },
    {
      "text": "The user attacks the target with an\nechoing voice. If this move is used\nevery turn, it does greater damage.",
