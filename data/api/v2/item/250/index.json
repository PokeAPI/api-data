        "name": "x-y",
        "url": "/api/v2/version-group/15/"
      },
      "language": {
        "name": "de",
        "url": "/api/v2/language/6/"
      }
    },
    {
      "text": "Potencia la Defensa de base, pero reduce la\nVelocidad en combate. Debe llevarlo un\nPokémon.",
