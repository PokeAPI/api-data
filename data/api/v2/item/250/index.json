        "name": "x-y",
        "url": "/api/v2/version-group/15/"
      },
      "language": {
        "name": "fr",
        "url": "/api/v2/language/5/"
      }
    },
    {
      "text": "Ein Item zum Tragen. Dieser bizarre Orb fügt\nseinem Träger Verbrennungen zu.",
