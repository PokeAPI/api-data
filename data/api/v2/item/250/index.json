        "name": "x-y",
        "url": "/api/v2/version-group/15/"
      },
      "language": {
        "name": "es",
        "url": "/api/v2/language/7/"
      }
    },
    {
      "text": "Strumento da dare a un Pokémon.\nSfera bizzarra che procura una scottatura\na chi l’ha con sé in una lotta.",
