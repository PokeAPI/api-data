        "url": "/api/v2/version-group/20/"
      },
      "language": {
        "name": "zh-hant",
        "url": "/api/v2/language/4/"
      }
    },
    {
      "text": "Une attaque dont la puissance et le type varient\nen fonction du temps qu’il fait.",
