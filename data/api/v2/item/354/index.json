        "name": "sword-shield",
        "url": "/api/v2/version-group/20/"
      },
      "language": {
        "name": "de",
        "url": "/api/v2/language/6/"
      }
    },
    {
      "text": "Dispara rápido de dos a cinco ráfagas de semillas de\nmanera consecutiva.",
