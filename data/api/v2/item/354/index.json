        "url": "/api/v2/version-group/20/"
      },
      "language": {
        "name": "es",
        "url": "/api/v2/language/7/"
      }
    },
    {
      "text": "Chi la usa spara da due a cinque raffiche di semi\ncontro il bersaglio in successione.",
