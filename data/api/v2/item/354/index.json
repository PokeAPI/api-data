        "name": "sword-shield",
        "url": "/api/v2/version-group/20/"
      },
      "language": {
        "name": "fr",
        "url": "/api/v2/language/5/"
      }
    },
    {
      "text": "Der Anwender wirft zwei- bis fünfmal in rascher Folge\nSamen auf das Ziel.",
