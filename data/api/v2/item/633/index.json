        "name": "x-y",
        "url": "/api/v2/version-group/15/"
      },
      "language": {
        "name": "ko",
        "url": "/api/v2/language/3/"
      }
    },
    {
      "text": "Augmente le taux de critiques.\nPlus efficace à chaque utilisation.\nL’effet s’estompe si le Pokémon se retire.",
