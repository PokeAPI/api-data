  "effect_entries": [
    {
      "effect": "Tenu: Permet à Raichu d'Alola d'améliorer Tonnerre en Électro-Surf Survolté.",
      "short_effect": "Tenu: Permet à Raichu d'Alola d'améliorer Tonnerre en Électro-Surf Survolté.",
