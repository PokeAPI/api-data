    },
    {
      "text": "A long, thin, bright-red string to\nbe held by a Pokémon. If the holder\nbecomes infatuated, the foe does too.",
      "version_group": {
        "name": "black-2-white-2",
        "url": "/api/v2/version-group/14/"
      },
      "language": {
        "name": "en",
        "url": "/api/v2/language/9/"
