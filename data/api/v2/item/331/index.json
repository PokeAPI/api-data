        "url": "/api/v2/version-group/20/"
      },
      "language": {
        "name": "fr",
        "url": "/api/v2/language/5/"
      }
    },
    {
      "text": "Eis-Attacke, die gegnerischen Pokémon Schaden zufügt\nund ihren Initiative-Wert senkt.",
