        "name": "sword-shield",
        "url": "/api/v2/version-group/20/"
      },
      "language": {
        "name": "zh-hant",
        "url": "/api/v2/language/4/"
      }
    },
    {
      "text": "Une bourrasque de vent froid blesse l’ennemi.\nRéduit aussi sa Vitesse.",
