  "effect_entries": [
    {
      "effect": "Utilisé par le dresseur dans le Centre Galactique de Vestigion, au rez-de-chaussée, à gauche de la télévision\n:   Débloque la salle secrète Motisma, dans laquelle se trouvent cinq appareils permettant de changer la forme de Motisma.",
      "short_effect": "Gén IV: La clé pour la pièce des appareils de Motisma. Gen III: La clé de l'arène de Cramois'Île.",
      "language": {
        "name": "fr",
        "url": "/api/v2/language/5/"
      }
    },
    {
      "effect": "Used by trainer in the Galactic Eterna Building, on the ground floor, to the left of the TV\n:   Unlocks the secret Rotom room, in which there are five appliances which can change Rotom’s form.",
      "short_effect": "Gen IV: The key to Rotom’s appliance room. Gen III: The key to Cinnabar Gym.",
      "language": {
        "name": "en",
        "url": "/api/v2/language/9/"
      }
    }
  ],
  "flavor_text_entries": [
    {
