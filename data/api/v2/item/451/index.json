  "attributes": [],
  "category": {
    "name": "apricorn-balls",
    "url": "/api/v2/item-category/39/"
  },
  "effect_entries": [
    {
      "effect": "Utilisé par un dresseur en combat\n:   Tente de capturer un Pokémon sauvage.  Si utilisé en combat de dresseurs, rien ne se passe et la ball est perdue.\n\nSi le Pokémon sauvage est un Mélofée, Nidoran♂, Nidoran♀, Rondoudou, Skitty, ou une de leurs évolutions, le Pokémon sauvage a 4× son taux de capture.",
      "short_effect": "4× plus efficace sur les familles de Pokémon qui contiennent une évolution avec une Pierre Lune. Fait à partir de Noigrume Jne.",
      "language": {
        "name": "fr",
        "url": "/api/v2/language/5/"
      }
    },
    {
      "effect": "Used by trainer in battle\n:   Attempts to catch a wild Pokémon.  If used in a trainer battle, nothing happens and the ball is lost.\n\n    If the wild Pokémon is a Clefairy, Nidoran♂, Nidoran♀, Jigglypuff, Skitty, or any evolution thereof, the wild Pokémon has 4× its catch rate.",
      "short_effect": "4× effectiveness on familes of Pokémon with a Moon Stone evolution. Made from Ylw Apricorn.",
      "language": {
        "name": "en",
        "url": "/api/v2/language/9/"
      }
    }
  ],
  "flavor_text_entries": [
    {
      "text": "A Poké Ball for catching Pokémon that\nevolve using the Moon Stone.",
