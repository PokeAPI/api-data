        "name": "ultra-sun-ultra-moon",
        "url": "/api/v2/version-group/18/"
      },
      "language": {
        "name": "de",
        "url": "/api/v2/language/6/"
      }
    },
    {
      "text": "Bicicleta plegable con la que se va más rápido\nque corriendo.",
      "version_group": {
        "name": "ultra-sun-ultra-moon",
        "url": "/api/v2/version-group/18/"
      },
      "language": {
        "name": "es",
        "url": "/api/v2/language/7/"
      }
    },
    {
      "text": "Bici pieghevole che permette di spostarsi\npiù velocemente che con le Scarpe da Corsa.",
