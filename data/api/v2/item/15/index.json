  "effect_entries": [
    {
      "effect": "Utilisé au combat\n:   Tente de capturer un Pokémon sauvage, utilisant un taux de capture de 4× au premier tour du combat, mais 1× à n'importe quel autre moment.\n\n    Si utilisé pendant un combat de dresseurs, rien ne se passe et la ball est perdue.",
      "short_effect": "Tente de capturer un Pokémon sauvage. Le taux de succès est 4× (Gén V : 5x), mais seulement le premier tour.",
      "language": {
        "name": "fr",
        "url": "/api/v2/language/5/"
      }
    },
    {
      "effect": "Used in battle\n:   Attempts to catch a wild Pokémon, using a catch rate of 4× on the first turn of a battle, but 1× any other time.\n\n    If used in a trainer battle, nothing happens and the ball is lost.",
      "short_effect": "Tries to catch a wild Pokémon. Success rate is 4× (Gen V: 5×), but only on the first turn.",
      "language": {
        "name": "en",
        "url": "/api/v2/language/9/"
      }
    }
  ],
  "flavor_text_entries": [
