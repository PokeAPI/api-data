    "url": "/api/v2/item-category/21/"
  },
  "effect_entries": [
    {
      "effect": "Augmente la vitesse de déplacement à l'extérieur ou dans les grottes.  Plus lent que le Vélo de Course.  Permet d'effectuer diverses figures, permettant au dresseur d'atteindre certaines zones spéciales.",
      "short_effect": "Plus manœuvrable que le Vélo de Course, et permet de sauter le long des rails.",
      "language": {
        "name": "fr",
        "url": "/api/v2/language/5/"
      }
    },
    {
      "effect": "Increases movement speed outside or in caves.  Slower than the Mach Bike.  Can perform various tricks, allowing the trainer to reach certain special areas.",
      "short_effect": "More maneuverable than the Mach Bike, and allows hopping along rails.",
      "language": {
        "name": "en",
        "url": "/api/v2/language/9/"
      }
    }
  ],
  "flavor_text_entries": [
    {
      "text": "A folding bicycle\ncapable of jumps\nand wheelies.",
      "version_group": {
        "name": "ruby-sapphire",
        "url": "/api/v2/version-group/5/"
      },
      "language": {
        "name": "en",
        "url": "/api/v2/language/9/"
      }
    },
    {
      "text": "A folding bicycle\ncapable of jumps\nand wheelies.",
      "version_group": {
        "name": "emerald",
        "url": "/api/v2/version-group/6/"
      },
      "language": {
        "name": "en",
        "url": "/api/v2/language/9/"
      }
    },
    {
      "text": "A folding bicycle that is capable\nof stunts like jumps and wheelies.",
      "version_group": {
        "name": "firered-leafgreen",
        "url": "/api/v2/version-group/7/"
      },
      "language": {
        "name": "en",
        "url": "/api/v2/language/9/"
      }
    },
    {
      "text": "ジャンプや　ウィリーの\nアクションが　できる\nおりたたみの　じてんしゃ。",
      "version_group": {
        "name": "sun-moon",
        "url": "/api/v2/version-group/17/"
      },
      "language": {
        "name": "ja-hrkt",
        "url": "/api/v2/language/1/"
      }
    },
    {
      "text": "점프나 윌리 액션을\n할 수 있는\n접이식 자전거다.",
      "version_group": {
        "name": "sun-moon",
        "url": "/api/v2/version-group/17/"
      },
      "language": {
        "name": "ko",
        "url": "/api/v2/language/3/"
      }
    },
    {
      "text": "能做出跳躍或抬前輪動作的\n折疊式自行車。",
      "version_group": {
        "name": "sun-moon",
        "url": "/api/v2/version-group/17/"
      },
      "language": {
        "name": "zh-hant",
        "url": "/api/v2/language/4/"
      }
    },
    {
      "text": "Un vélo pliable qui permet de bondir et de rouler\nsur la roue arrière.",
      "version_group": {
        "name": "sun-moon",
        "url": "/api/v2/version-group/17/"
      },
      "language": {
        "name": "fr",
        "url": "/api/v2/language/5/"
      }
    },
    {
      "text": "Ein Klapprad, mit dem du Kunststücke wie Sprünge\noder Wheelies ausführen kannst.",
      "version_group": {
        "name": "sun-moon",
        "url": "/api/v2/version-group/17/"
      },
      "language": {
        "name": "de",
        "url": "/api/v2/language/6/"
      }
    },
    {
      "text": "Bicicleta plegable capaz de correr sobre una sola\nrueda, realizar saltos y otras acrobacias.",
      "version_group": {
        "name": "sun-moon",
        "url": "/api/v2/version-group/17/"
      },
      "language": {
        "name": "es",
        "url": "/api/v2/language/7/"
      }
    },
    {
      "text": "Bici pieghevole con cui si possono fare acrobazie\ncome salti o impennate.",
      "version_group": {
        "name": "sun-moon",
        "url": "/api/v2/version-group/17/"
      },
      "language": {
        "name": "it",
        "url": "/api/v2/language/8/"
      }
    },
    {
      "text": "This folding Bike allows you to perform actions\nsuch as wheelies and bunny hops.",
      "version_group": {
        "name": "sun-moon",
        "url": "/api/v2/version-group/17/"
      },
      "language": {
        "name": "en",
        "url": "/api/v2/language/9/"
