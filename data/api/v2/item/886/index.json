        "name": "sun-moon",
        "url": "/api/v2/version-group/17/"
      },
      "language": {
        "name": "zh-hant",
        "url": "/api/v2/language/4/"
      }
    },
    {
      "text": "Un appareil permettant d’appeler une Poké Monture\ninstantanément en tapant le bon numéro.",
