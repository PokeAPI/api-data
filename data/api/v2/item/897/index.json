    "url": "/api/v2/item-category/12/"
  },
  "effect_entries": [
    {
      "effect": "Tenu: Empêche les effets secondaires des capacités à contact utilisées sur le porteur.",
      "short_effect": "Tenu: Empêche les effets secondaires des capacités à contact utilisées sur le porteur.",
      "language": {
        "name": "fr",
        "url": "/api/v2/language/5/"
      }
    },
    {
      "effect": "Held: Prevents side effects of contact moves used on the holder.",
      "short_effect": "Held: Prevents side effects of contact moves used on the holder.",
      "language": {
        "name": "en",
        "url": "/api/v2/language/9/"
      }
    }
  ],
  "flavor_text_entries": [
    {
      "text": "こうげき　する　あいてに\nさわって　うける　こうかを\nうけないように　する。",
      "version_group": {
        "name": "sun-moon",
        "url": "/api/v2/version-group/17/"
      },
      "language": {
        "name": "ja-hrkt",
        "url": "/api/v2/language/1/"
      }
    },
    {
      "text": "공격하는 상대와\n접촉해서 받게 되는\n효과를 받지 않게 한다.",
      "version_group": {
        "name": "sun-moon",
        "url": "/api/v2/version-group/17/"
      },
      "language": {
        "name": "ko",
        "url": "/api/v2/language/3/"
      }
    },
    {
      "text": "觸碰要攻擊的對手時，\n不會受到本應受到的效果。",
      "version_group": {
        "name": "sun-moon",
        "url": "/api/v2/version-group/17/"
      },
      "language": {
        "name": "zh-hant",
        "url": "/api/v2/language/4/"
      }
    },
    {
      "text": "Annule les effets subis par le porteur quand il\nutilise une attaque directe sur un autre Pokémon.",
      "version_group": {
        "name": "sun-moon",
        "url": "/api/v2/version-group/17/"
      },
      "language": {
        "name": "fr",
        "url": "/api/v2/language/5/"
      }
    },
    {
      "text": "Greift der Träger ein Ziel an, ist er vor Effekten,\ndie durch direkten Kontakt mit diesem ausgelöst\nwerden, geschützt.",
      "version_group": {
        "name": "sun-moon",
        "url": "/api/v2/version-group/17/"
      },
      "language": {
        "name": "de",
        "url": "/api/v2/language/6/"
      }
    },
    {
      "text": "Protege al Pokémon de los efectos que le produciría\nel contacto directo en combate.",
      "version_group": {
        "name": "sun-moon",
        "url": "/api/v2/version-group/17/"
      },
      "language": {
        "name": "es",
        "url": "/api/v2/language/7/"
      }
    },
    {
      "text": "Elimina gli effetti causati da attacchi diretti subiti\ndal Pokémon.",
      "version_group": {
        "name": "sun-moon",
        "url": "/api/v2/version-group/17/"
      },
      "language": {
        "name": "it",
        "url": "/api/v2/language/8/"
      }
    },
    {
      "text": "An item to be held by a Pokémon. These pads\nprotect the holder from effects caused by\nmaking direct contact with the target.",
      "version_group": {
        "name": "sun-moon",
        "url": "/api/v2/version-group/17/"
      },
      "language": {
        "name": "en",
        "url": "/api/v2/language/9/"
      }
    },
    {
      "text": "攻撃　する　相手に\nさわって　受ける　効果を\n受けないように　する。",
      "version_group": {
        "name": "sun-moon",
        "url": "/api/v2/version-group/17/"
      },
      "language": {
        "name": "ja",
        "url": "/api/v2/language/11/"
      }
    },
    {
      "text": "不会受到触碰攻击对手时\n本应受到的效果。",
