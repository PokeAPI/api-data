        "name": "black-white",
        "url": "/api/v2/version-group/11/"
      },
      "language": {
        "name": "en",
        "url": "/api/v2/language/9/"
      }
    },
    {
      "text": "Castelia City’s specialty, soft-serve\nice cream. It heals all the status\nproblems of a single Pokémon.",
