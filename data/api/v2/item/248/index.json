  },
  "effect_entries": [
    {
      "effect": "Tenu: Quand le porteur utilise une capacité qui requiert un premier tour de chargement (Rebond, Tunnel, Plongée, Vol, Coupe-Vent, Coud'Krâne, Piqué, or Lance-Soleil), cet objet est consommé et le chargement est passé.  Coud'Krâne fournit toujours un boost de Défense.",
      "short_effect": "Tenu: Les deux tours d'un coup en deux tours ont lieu en un. Consommé quand utilisé.",
      "language": {
        "name": "fr",
        "url": "/api/v2/language/5/"
      }
    },
    {
      "effect": "Held: Whenever the holder uses a move that requires a turn to charge first (Bounce, Dig, Dive, Fly, Razor Wind, Skull Bash, Sky Attack, or Solarbeam), this item is consumed and the charge is skipped.  Skull Bash still provides a Defense boost.",
      "short_effect": "Held: Both turns of a two-turn charge move happen at once. Consumed upon use.",
      "language": {
        "name": "en",
        "url": "/api/v2/language/9/"
      }
    }
  ],
  "flavor_text_entries": [
    {
      "text": "A single-use item to be held by a\nPokémon. It allows the immediate use of\na move that charges on the first turn.",
