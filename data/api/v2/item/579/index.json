        "url": "/api/v2/version-group/15/"
      },
      "language": {
        "name": "ko",
        "url": "/api/v2/language/3/"
      }
    },
    {
      "text": "Un papier à lettres avec un motif de pont\nbâti sur des arches. Peut être tenu et livré\npar un Pokémon.",
