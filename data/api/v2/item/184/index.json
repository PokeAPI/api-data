        "name": "x-y",
        "url": "/api/v2/version-group/15/"
      },
      "language": {
        "name": "es",
        "url": "/api/v2/language/7/"
      }
    },
    {
      "text": "Se il Pokémon che ha questa bacca si trova\nin difficoltà, una delle sue statistiche aumenta\ndi molto.",
