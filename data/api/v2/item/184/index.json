  "effect_entries": [
    {
      "effect": "Tenu au combat\n:   Quand le porteur a 1/4 de ses PV max restants ou moins, cela consomme cet objet pour augmenter une stat aléatoire de deux niveaux.",
      "short_effect": "Tenu: Consommé à 1/4 des PV max pour booster une stat aléatoire de deux niveaux.",
      "language": {
        "name": "fr",
        "url": "/api/v2/language/5/"
      }
    },
    {
      "effect": "Held in battle\n:   When the holder has 1/4 its max HP remaining or less, it consumes this item to raise a random stat by two stages.",
      "short_effect": "Held: Consumed at 1/4 max HP to boost a random stat by two stages.",
      "language": {
        "name": "en",
        "url": "/api/v2/language/9/"
      }
    }
  ],
  "flavor_text_entries": [
    {
      "text": "A hold item that\nsharply boosts a\nstat in a pinch.",
