  "effect_entries": [
    {
      "effect": "Tenu: Permet à Carchacrok de Méga-Évoluer en Méga-Carchacrok.",
      "short_effect": "Tenu: Permet à Carchacrok de Méga-Évoluer en Méga-Carchacrok.",
      "language": {
