  "effect_entries": [
    {
      "effect": "Tenu: Permet à Cizayox de Méga-Évoluer en Méga-Cizayox.",
      "short_effect": "Tenu: Permet à Cizayox de Méga-Évoluer en Méga-Cizayox.",
      "language": {
