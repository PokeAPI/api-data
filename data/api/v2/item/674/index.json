  "effect_entries": [
    {
      "effect": "",
      "short_effect": "Double les chances que deux Pokémon produisent un œuf à la pension tous les 255 pas.",
      "language": {
        "name": "fr",
        "url": "/api/v2/language/5/"
      }
    },
    {
      "effect": "",
      "short_effect": "Doubles the chance of two Pokémon producing an egg at the daycare every 255 steps.",
      "language": {
        "name": "en",
        "url": "/api/v2/language/9/"
      }
    }
  ],
  "flavor_text_entries": [
    {
      "text": "An oval charm said to increase the\nchance of Eggs being found\nat the Day Care.",
      "version_group": {
        "name": "black-2-white-2",
        "url": "/api/v2/version-group/14/"
      },
      "language": {
        "name": "en",
        "url": "/api/v2/language/9/"
      }
    },
    {
      "text": "もっていると　そだてやさんで\nタマゴが　みつかりやすくなる\nふしぎで　とてもまるい　おまもり。",
      "version_group": {
        "name": "x-y",
        "url": "/api/v2/version-group/15/"
      },
      "language": {
        "name": "ja-hrkt",
        "url": "/api/v2/language/1/"
      }
    },
    {
      "text": "지니고 있으면 키우미집에서\n알을 발견하기 쉬워지는\n이상하고 매우 둥근 부적.",
      "version_group": {
        "name": "x-y",
        "url": "/api/v2/version-group/15/"
      },
      "language": {
        "name": "ko",
        "url": "/api/v2/language/3/"
      }
    },
    {
      "text": "Un mystérieux charme rond qui permet de trouver\nplus facilement des Œufs à la Pension Pokémon.",
      "version_group": {
        "name": "x-y",
        "url": "/api/v2/version-group/15/"
      },
      "language": {
        "name": "fr",
        "url": "/api/v2/language/5/"
      }
    },
    {
      "text": "Ein mysteriöser, ovaler Glücksbringer, der die\nWahrscheinlichkeit erhöht, in der Pension Eier\nzu finden.",
      "version_group": {
        "name": "x-y",
        "url": "/api/v2/version-group/15/"
      },
      "language": {
        "name": "de",
        "url": "/api/v2/language/6/"
      }
    },
    {
      "text": "Gafa que protege de los efectos adversos del\nclima y del polvo lanzado por los rivales.",
      "version_group": {
        "name": "x-y",
        "url": "/api/v2/version-group/15/"
      },
      "language": {
        "name": "es",
        "url": "/api/v2/language/7/"
      }
    },
    {
      "text": "Misterioso amuleto di forma sferica che\naumenta la probabilità di trovare Uova\nnella Pensione Pokémon.",
      "version_group": {
        "name": "x-y",
        "url": "/api/v2/version-group/15/"
      },
      "language": {
        "name": "it",
        "url": "/api/v2/language/8/"
      }
    },
    {
      "text": "An oval charm said to increase\nthe chance of Pokémon Eggs\nbeing found at the Day Care.",
      "version_group": {
        "name": "x-y",
        "url": "/api/v2/version-group/15/"
      },
      "language": {
        "name": "en",
        "url": "/api/v2/language/9/"
      }
    },
    {
      "text": "持っていると　育て屋さんで\nタマゴが　みつかりやすくなる\n不思議で　とてもまるい　おまもり。",
      "version_group": {
        "name": "x-y",
        "url": "/api/v2/version-group/15/"
      },
      "language": {
        "name": "ja",
        "url": "/api/v2/language/11/"
      }
    },
    {
      "text": "Gafa que protege de los efectos adversos del\nclima y del polvo lanzado por los rivales.",
      "version_group": {
        "name": "x-y",
