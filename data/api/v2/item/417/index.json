        "name": "x-y",
        "url": "/api/v2/version-group/15/"
      },
      "language": {
        "name": "es",
        "url": "/api/v2/language/7/"
      }
    },
    {
      "text": "Chiave a scheda per disattivare i sistemi\ndi sicurezza nella Sede Galassia. Se la si perde,\nsi viene puniti.",
