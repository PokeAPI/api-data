  "effect_entries": [
    {
      "effect": "Révèle les dresseurs qui veulent une revanche, en affichant !! au dessus de leurs têtes.  Chaque utilisation consomme de la batterie; requiert 100 pas pour charger.",
      "short_effect": "Permet de combattre les dresseurs à l'écran à nouveau. 100 pas pour recharger.",
      "language": {
        "name": "fr",
        "url": "/api/v2/language/5/"
      }
    },
    {
      "effect": "Reveals trainers who want a rematch, by showing !! over their heads.  Each use drains the battery; requires 100 steps to charge.",
      "short_effect": "Allows rebattling of on-screen trainers. 100 steps to recharge.",
      "language": {
        "name": "en",
        "url": "/api/v2/language/9/"
      }
    }
  ],
