  "effect_entries": [
    {
      "effect": "Utilisé au combat\n:   Tente de capturer un Pokémon sauvage.  Si l'espèce Pokémon sauvage est marqué comme capturée dans le Pokédex du dresseur, cette ball a un taux de capture de 3x.  Sinon, elle a un taux de capture de 1x.\n\n    Si utilisé pendant un combat de dresseurs, rien ne se passe et la ball est perdue.",
      "short_effect": "Tente de capturer un Pokémon sauvage. Le taux de succès est 3× pour les Pokémon déjà capturés.",
      "language": {
        "name": "fr",
        "url": "/api/v2/language/5/"
      }
    },
    {
      "effect": "Used in battle\n:   Attempts to catch a wild Pokémon.  If the wild Pokémon’s species is marked as caught in the trainer’s Pokédex, this ball has a catch rate of 3×.  Otherwise, it has a catch rate of 1×.\n\n    If used in a trainer battle, nothing happens and the ball is lost.",
      "short_effect": "Tries to catch a wild Pokémon.  Success rate is 3× for previously-caught Pokémon.",
      "language": {
        "name": "en",
        "url": "/api/v2/language/9/"
      }
    }
  ],
  "flavor_text_entries": [
    {
      "text": "A BALL that works\nbetter on POKéMON\ncaught before.",
