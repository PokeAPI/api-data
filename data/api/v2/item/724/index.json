  "effect_entries": [
    {
      "effect": "Tenu: Quand le porteur est touché par une capacité physique, augmente sa Défense d'un niveau.",
      "short_effect": "Tenu: Quand le porteur est touché par une capacité physique, augmente sa Défense d'un niveau.",
      "language": {
        "name": "fr",
        "url": "/api/v2/language/5/"
      }
    },
    {
      "effect": "Held: When the holder is hit by a physical move, increases its Defense by one stage.",
      "short_effect": "Held: When the holder is hit by a physical move, increases its Defense by one stage.",
      "language": {
        "name": "en",
        "url": "/api/v2/language/9/"
      }
    }
  ],
  "flavor_text_entries": [
    {
      "text": "ポケモンに　もたせると\nぶつりわざを　うけたとき\nじぶんの　ぼうぎょが　あがる。",
      "version_group": {
        "name": "x-y",
        "url": "/api/v2/version-group/15/"
      },
      "language": {
        "name": "ja-hrkt",
        "url": "/api/v2/language/1/"
      }
    },
    {
      "text": "포켓몬에게 지니게 하면\n물리 기술을 당했을 때\n자신의 방어가 올라간다.",
      "version_group": {
        "name": "x-y",
        "url": "/api/v2/version-group/15/"
      },
      "language": {
        "name": "ko",
        "url": "/api/v2/language/3/"
      }
    },
    {
      "text": "Baie à tenir augmentant la Défense du Pokémon\nlorsqu’il est touché par une attaque physique.",
      "version_group": {
        "name": "x-y",
        "url": "/api/v2/version-group/15/"
      },
      "language": {
        "name": "fr",
        "url": "/api/v2/language/5/"
      }
    },
    {
      "text": "Als getragenes Item erhöht diese Beere die\nVerteidigung des Trägers, wenn dieser von\nphysischen Attacken getroffen wird.",
      "version_group": {
        "name": "x-y",
        "url": "/api/v2/version-group/15/"
      },
      "language": {
        "name": "de",
        "url": "/api/v2/language/6/"
      }
    },
    {
      "text": "Baúl ligero de increíble capacidad donde pueden\nguardarse todas las prendas de ropa adquiridas.",
      "version_group": {
        "name": "x-y",
        "url": "/api/v2/version-group/15/"
      },
      "language": {
        "name": "es",
        "url": "/api/v2/language/7/"
      }
    },
    {
      "text": "Bacca da dare a un Pokémon.\nSe chi ce l’ha subisce una mossa fisica,\nla sua Difesa aumenta.",
      "version_group": {
        "name": "x-y",
        "url": "/api/v2/version-group/15/"
      },
      "language": {
        "name": "it",
        "url": "/api/v2/language/8/"
      }
    },
    {
      "text": "If held by a Pokémon, this Berry\nwill increase the holder’s Defense\nif it’s hit with a physical move.",
      "version_group": {
        "name": "x-y",
        "url": "/api/v2/version-group/15/"
      },
      "language": {
        "name": "en",
        "url": "/api/v2/language/9/"
      }
    },
    {
      "text": "ポケモンに　持たせると\n物理技を　受けたとき\n自分の　防御が　あがる。",
      "version_group": {
        "name": "x-y",
        "url": "/api/v2/version-group/15/"
      },
      "language": {
        "name": "ja",
        "url": "/api/v2/language/11/"
      }
    },
    {
      "text": "Baúl ligero de increíble capacidad donde pueden\nguardarse todas las prendas de ropa adquiridas.",
