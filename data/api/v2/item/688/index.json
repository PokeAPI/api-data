  "effect_entries": [
    {
      "effect": "Tenu: Si le porteur est touché par une capacité offensive Eau, cela consomme cet objet et augmente sa Défense Spéciale d'un niveau.",
      "short_effect": "Tenu: Si le porteur est touché par une capacité offensive Eau, augmente sa Défense Spéciale d'un niveau.",
      "language": {
        "name": "fr",
        "url": "/api/v2/language/5/"
      }
    },
    {
      "effect": "Held: If the holder is hit by a damaging Water move, it consumes this item and raises its Special Defense by one stage.",
      "short_effect": "Held: If the holder is hit by a damaging Water move, raises its Special Defense by one stage.",
      "language": {
        "name": "en",
        "url": "/api/v2/language/9/"
      }
    }
  ],
  "flavor_text_entries": [
    {
      "text": "つかいすての　ひかりごけ。\nもたせて　みずの　わざを　うけると\nとくぼうが　あがる。",
      "version_group": {
        "name": "x-y",
        "url": "/api/v2/version-group/15/"
      },
      "language": {
        "name": "ja-hrkt",
        "url": "/api/v2/language/1/"
      }
    },
    {
      "text": "단 한 번 쓰면 없어지는 빛이끼.\n지니게 하고 물 기술을 받으면\n특수방어가 올라간다.",
      "version_group": {
        "name": "x-y",
        "url": "/api/v2/version-group/15/"
      },
      "language": {
        "name": "ko",
        "url": "/api/v2/language/3/"
      }
    },
    {
      "text": "Du lichen à usage unique.\nTenu, il augmente la Défense Spéciale lorsque\nle Pokémon subit une attaque de type Eau.",
      "version_group": {
        "name": "x-y",
        "url": "/api/v2/version-group/15/"
      },
      "language": {
        "name": "fr",
        "url": "/api/v2/language/5/"
      }
    },
    {
      "text": "Wird der Träger von einer Wasser-Attacke\ngetroffen, steigt seine Spezial-Verteidigung\nund das Item verschwindet.",
      "version_group": {
        "name": "x-y",
        "url": "/api/v2/version-group/15/"
      },
      "language": {
        "name": "de",
        "url": "/api/v2/language/6/"
      }
    },
    {
      "text": "Una de las misteriosas Megapiedras. Permite\nmegaevolucionar a Aggron en combate.",
      "version_group": {
        "name": "x-y",
        "url": "/api/v2/version-group/15/"
      },
      "language": {
        "name": "es",
        "url": "/api/v2/language/7/"
      }
    },
    {
      "text": "Muschio luminoso monouso. Se il Pokémon\nche ha questo strumento subisce una mossa\ndi tipo Acqua, la sua Difesa Speciale aumenta.",
      "version_group": {
        "name": "x-y",
        "url": "/api/v2/version-group/15/"
      },
      "language": {
        "name": "it",
        "url": "/api/v2/language/8/"
      }
    },
    {
      "text": "An item to be held by a Pokémon.\nIt boosts Sp. Def if hit with a Water-\ntype attack. It can only be used once.",
