  "effect_entries": [
    {
      "effect": "Utilisé au combat\n:   Tente de capturer un Pokémon sauvage, utilisant un taux de capture de 1x.\n\n    Si utilisé pendant un combat de dresseurs, rien ne se passe et la ball est perdue.",
      "short_effect": "Tente de capturer un Pokémon sauvage.",
      "language": {
        "name": "fr",
        "url": "/api/v2/language/5/"
      }
    },
    {
      "effect": "Used in battle\n:   Attempts to catch a wild Pokémon, using a catch rate of 1×.\n\n    If used in a trainer battle, nothing happens and the ball is lost.",
      "short_effect": "Tries to catch a wild Pokémon.",
      "language": {
        "name": "en",
        "url": "/api/v2/language/9/"
      }
    }
  ],
  "flavor_text_entries": [
    {
      "text": "A tool used for\ncatching wild\nPOKéMON.",
