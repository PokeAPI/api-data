  "flavor_text_entries": [
    {
      "text": "シーキンセツの　そうこに\nはいる　ための　カギ。",
      "version_group": {
        "name": "ultra-sun-ultra-moon",
        "url": "/api/v2/version-group/18/"
      },
      "language": {
        "name": "ja-hrkt",
        "url": "/api/v2/language/1/"
      }
    },
    {
      "text": "씨보라의 창고로\n들어가기 위한 열쇠.",
      "version_group": {
        "name": "ultra-sun-ultra-moon",
        "url": "/api/v2/version-group/18/"
      },
      "language": {
        "name": "ko",
        "url": "/api/v2/language/3/"
      }
    },
    {
      "text": "用於進入\n海紫菫的房間的鑰匙。",
      "version_group": {
        "name": "ultra-sun-ultra-moon",
        "url": "/api/v2/version-group/18/"
      },
      "language": {
        "name": "zh-hant",
        "url": "/api/v2/language/4/"
      }
    },
    {
      "text": "La clé de la réserve de Lavandia Sea.",
      "version_group": {
        "name": "ultra-sun-ultra-moon",
        "url": "/api/v2/version-group/18/"
      },
      "language": {
        "name": "fr",
        "url": "/api/v2/language/5/"
      }
    },
    {
      "text": "Ein Schlüssel, der in das Schloss des Lagerraums\nauf Seewoge Malvenfroh passt.",
      "version_group": {
        "name": "ultra-sun-ultra-moon",
        "url": "/api/v2/version-group/18/"
      },
      "language": {
        "name": "de",
        "url": "/api/v2/language/6/"
      }
    },
    {
      "text": "Llave de acceso al almacén de Malvamar.",
      "version_group": {
        "name": "ultra-sun-ultra-moon",
        "url": "/api/v2/version-group/18/"
      },
      "language": {
        "name": "es",
        "url": "/api/v2/language/7/"
      }
    },
    {
      "text": "Chiave per accedere al magazzino di Ciclamare.",
      "version_group": {
        "name": "ultra-sun-ultra-moon",
        "url": "/api/v2/version-group/18/"
      },
      "language": {
        "name": "it",
        "url": "/api/v2/language/8/"
      }
    },
    {
      "text": "A key that opens the storage hold inside\nSea Mauville.",
      "version_group": {
        "name": "ultra-sun-ultra-moon",
        "url": "/api/v2/version-group/18/"
      },
      "language": {
        "name": "en",
        "url": "/api/v2/language/9/"
