  ],
  "flavor_text_entries": [
    {
      "text": "A box-shaped machine\nthat stores Medals and\nMedal information.",
      "version_group": {
        "name": "black-2-white-2",
        "url": "/api/v2/version-group/14/"
      },
      "language": {
        "name": "en",
        "url": "/api/v2/language/9/"
      }
    },
    {
      "text": "かくとくした　メダルを　しゅうのうし\nメダルについての　じょうほうを\nきろくする　はこがたの　きかい。",
      "version_group": {
        "name": "x-y",
        "url": "/api/v2/version-group/15/"
      },
      "language": {
        "name": "ja-hrkt",
        "url": "/api/v2/language/1/"
      }
    },
    {
      "text": "획득한 메달을 수납하고\n메달에 대한 정보를\n기록하는 상자 모양의 기계.",
      "version_group": {
        "name": "x-y",
        "url": "/api/v2/version-group/15/"
      },
      "language": {
        "name": "ko",
        "url": "/api/v2/language/3/"
      }
    },
    {
      "text": "Une boîte qui permet de ranger les Médailles et\nd’enregistrer des informations à leur sujet.",
      "version_group": {
        "name": "x-y",
        "url": "/api/v2/version-group/15/"
      },
      "language": {
        "name": "fr",
        "url": "/api/v2/language/5/"
      }
    },
    {
      "text": "Ein Gerät in Form einer Box, in der Medaillen\naufbewahrt und Informationen dazu gespeichert\nwerden.",
