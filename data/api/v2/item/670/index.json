        "url": "/api/v2/version-group/15/"
      },
      "language": {
        "name": "de",
        "url": "/api/v2/language/6/"
      }
    },
    {
      "text": "Un dulce a base de suave y esponjosa nata\nmontada. A algunos Pokémon les encanta.",
