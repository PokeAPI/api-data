  "effect_entries": [],
  "flavor_text_entries": [
    {
      "text": "めいちゅうりつに　よって\nわざが　はずれたとき\nすばやさが　ぐーんと　あがる。",
      "version_group": {
        "name": "sword-shield",
        "url": "/api/v2/version-group/20/"
      },
      "language": {
        "name": "ja-hrkt",
        "url": "/api/v2/language/1/"
      }
    },
    {
      "text": "명중률에 의해\n기술이 빗나갔을 때\n스피드가 크게 올라간다.",
      "version_group": {
        "name": "sword-shield",
        "url": "/api/v2/version-group/20/"
      },
      "language": {
        "name": "ko",
        "url": "/api/v2/language/3/"
      }
    },
    {
      "text": "當招式受命中率影響\n而未能擊中對手時，\n自己的速度將大幅提高。",
      "version_group": {
        "name": "sword-shield",
        "url": "/api/v2/version-group/20/"
      },
      "language": {
        "name": "zh-hant",
        "url": "/api/v2/language/4/"
      }
    },
    {
      "text": "Si un Pokémon manque sa cible parce qu’une capacité\na peu de Précision, sa Vitesse augmente beaucoup.",
      "version_group": {
        "name": "sword-shield",
        "url": "/api/v2/version-group/20/"
      },
      "language": {
        "name": "fr",
        "url": "/api/v2/language/5/"
      }
    },
    {
      "text": "Schlägt eine Attacke des Anwenders mangels\nGenauigkeit fehl, steigt im Gegenzug dessen\nInitiative stark an.",
      "version_group": {
        "name": "sword-shield",
        "url": "/api/v2/version-group/20/"
      },
      "language": {
        "name": "de",
        "url": "/api/v2/language/6/"
      }
    },
    {
      "text": "Aumenta mucho la Velocidad cuando el Pokémon yerra\nel movimiento debido a la precisión.",
      "version_group": {
        "name": "sword-shield",
        "url": "/api/v2/version-group/20/"
      },
      "language": {
        "name": "es",
        "url": "/api/v2/language/7/"
      }
    },
    {
      "text": "Se una mossa non va a segno a causa della scarsa\nprecisione, la Velocità aumenta considerevolmente.",
      "version_group": {
        "name": "sword-shield",
        "url": "/api/v2/version-group/20/"
      },
      "language": {
        "name": "it",
        "url": "/api/v2/language/8/"
      }
    },
    {
      "text": "Raises Speed sharply when a Pokémon misses with a\nmove because of accuracy.",
      "version_group": {
        "name": "sword-shield",
        "url": "/api/v2/version-group/20/"
      },
      "language": {
        "name": "en",
        "url": "/api/v2/language/9/"
      }
    },
    {
      "text": "命中率に　よって\n技が　はずれたとき\n素早さが　ぐーんと　上がる。",
      "version_group": {
        "name": "sword-shield",
        "url": "/api/v2/version-group/20/"
      },
      "language": {
        "name": "ja",
        "url": "/api/v2/language/11/"
      }
    },
    {
      "text": "招式因命中率影响而落空时，\n速度会大幅提高。",
