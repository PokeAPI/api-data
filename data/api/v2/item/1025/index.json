  "flavor_text_entries": [
    {
      "text": "みちの　はしっこで　ひろった\nしろっぽい　ちいさな　いし。",
      "version_group": {
        "name": "lets-go-pikachu-lets-go-eevee",
        "url": "/api/v2/version-group/19/"
      },
      "language": {
        "name": "ja-hrkt",
        "url": "/api/v2/language/1/"
      }
    },
    {
      "text": "길가 구석에서 주운\n하얗고 작은 돌.",
      "version_group": {
        "name": "lets-go-pikachu-lets-go-eevee",
        "url": "/api/v2/version-group/19/"
      },
      "language": {
        "name": "ko",
        "url": "/api/v2/language/3/"
      }
    },
    {
      "text": "在路邊撿到的\n白白的小石頭。",
      "version_group": {
        "name": "lets-go-pikachu-lets-go-eevee",
        "url": "/api/v2/version-group/19/"
      },
      "language": {
        "name": "zh-hant",
        "url": "/api/v2/language/4/"
      }
    },
    {
      "text": "Une petite pierre blanchâtre trouvée sur le bord\nde la route.",
