        "name": "lets-go-pikachu-lets-go-eevee",
        "url": "/api/v2/version-group/19/"
      },
      "language": {
        "name": "fr",
        "url": "/api/v2/language/5/"
      }
    },
    {
      "text": "Ein kleiner Stein mit weißlicher Färbung, der vom\nStraßenrand aufgehoben wurde.",
