        "name": "lets-go-pikachu-lets-go-eevee",
        "url": "/api/v2/version-group/19/"
      },
      "language": {
        "name": "de",
        "url": "/api/v2/language/6/"
      }
    },
    {
      "text": "Piedra de yeso pequeña y blanquecina encontrada en\nla linde de un camino.",
