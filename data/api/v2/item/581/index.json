        "name": "x-y",
        "url": "/api/v2/version-group/15/"
      },
      "language": {
        "name": "de",
        "url": "/api/v2/language/6/"
      }
    },
    {
      "text": "Joya de un solo uso que potencia los\nmovimientos de tipo Psíquico. Debe llevarla\nun Pokémon.",
