  "effect_entries": [
    {
      "effect": "Tenu: Diminue la Vitesse du porteur de 50%.  Quand le porteur gagne des EV d'Attaque d'un combat, augmente cet EV de 4; cela s'applique avant l'effet doublant du PokéRUS.",
      "short_effect": "Tenu: Le porteur gagne 4 EV d'Attaque, mais a sa Vitesse divisée par deux en combat.",
      "language": {
        "name": "fr",
        "url": "/api/v2/language/5/"
      }
    },
    {
      "effect": "Held: Decreases the holder’s Speed by 50%.  Whenever the holder gains Attack effort from battle, increases that effort by 4; this applies before the PokéRUS doubling effect.",
      "short_effect": "Held: Holder gains 4 Attack effort values, but has halved Speed in battle.",
      "language": {
        "name": "en",
        "url": "/api/v2/language/9/"
      }
    }
  ],
  "flavor_text_entries": [
    {
