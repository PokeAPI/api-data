        "name": "x-y",
        "url": "/api/v2/version-group/15/"
      },
      "language": {
        "name": "de",
        "url": "/api/v2/language/6/"
      }
    },
    {
      "text": "Tabla de piedra que potencia los movimientos de\ntipo Volador. Debe llevarla un Pokémon.",
