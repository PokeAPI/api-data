        "name": "platinum",
        "url": "/api/v2/version-group/9/"
      },
      "language": {
        "name": "en",
        "url": "/api/v2/language/9/"
      }
    },
    {
      "text": "In the Sinnoh region, they like to make\nsweets known as Poffins with this Berry\nand feed them to their Pokémon.",
