  "flavor_text_entries": [
    {
      "text": "ポケモンの　すあなに　なげいれると\nダイマックスポケモンが　あらわれる。",
      "version_group": {
        "name": "sword-shield",
        "url": "/api/v2/version-group/20/"
      },
      "language": {
        "name": "ja-hrkt",
        "url": "/api/v2/language/1/"
      }
    },
    {
      "text": "포켓몬굴에 던져넣으면\n다이맥스 포켓몬이 나타난다.",
      "version_group": {
        "name": "sword-shield",
        "url": "/api/v2/version-group/20/"
      },
      "language": {
        "name": "ko",
        "url": "/api/v2/language/3/"
      }
    },
    {
      "text": "投進寶可夢的巢穴裡，\n極巨化寶可夢就會現身。",
      "version_group": {
        "name": "sword-shield",
        "url": "/api/v2/version-group/20/"
      },
      "language": {
        "name": "zh-hant",
        "url": "/api/v2/language/4/"
      }
    },
    {
      "text": "Un objet à lancer dans l’antre d’un Pokémon\npour y faire apparaître un Pokémon Dynamax.",
      "version_group": {
        "name": "sword-shield",
        "url": "/api/v2/version-group/20/"
      },
      "language": {
        "name": "fr",
        "url": "/api/v2/language/5/"
      }
    },
    {
      "text": "Wirft man ihn in ein Pokémon-Nest, taucht ein\nDynamax-Pokémon auf.",
      "version_group": {
        "name": "sword-shield",
        "url": "/api/v2/version-group/20/"
      },
      "language": {
        "name": "de",
        "url": "/api/v2/language/6/"
      }
    },
    {
      "text": "Al lanzarlo en un nido Pokémon, aparece un Pokémon\nDinamax.",
      "version_group": {
        "name": "sword-shield",
        "url": "/api/v2/version-group/20/"
      },
      "language": {
        "name": "es",
        "url": "/api/v2/language/7/"
      }
    },
    {
      "text": "Se lanciato dentro una tana di Pokémon\nfa comparire un Pokémon Dynamax.",
      "version_group": {
        "name": "sword-shield",
        "url": "/api/v2/version-group/20/"
      },
      "language": {
        "name": "it",
        "url": "/api/v2/language/8/"
      }
    },
    {
      "text": "Throw one into a Pokémon Den to attract\na wild Dynamax Pokémon.",
      "version_group": {
        "name": "sword-shield",
        "url": "/api/v2/version-group/20/"
      },
      "language": {
        "name": "en",
        "url": "/api/v2/language/9/"
      }
    },
    {
      "text": "ポケモンの　巣穴に　投げいれると\nダイマックスポケモンが　現れる。",
      "version_group": {
        "name": "sword-shield",
        "url": "/api/v2/version-group/20/"
      },
      "language": {
        "name": "ja",
        "url": "/api/v2/language/11/"
      }
    },
    {
      "text": "投掷到宝可梦的巢穴里，\n就会有极巨化宝可梦出现。",
      "version_group": {
        "name": "sword-shield",
        "url": "/api/v2/version-group/20/"
