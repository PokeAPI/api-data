  "category": {
    "name": "miracle-shooter",
    "url": "/api/v2/item-category/43/"
  },
  "effect_entries": [
    {
      "effect": "Utilisé sur un Pokémon de l'équipe au combat\n:   Sélectionne un autre Pokémon allié au hasard.  Retire toutes les modifications de stat de ce Pokémon.\n\nCet objet ne peut être obtenu ou utilisé que via le Shooter Miracle.",
      "short_effect": "Réinitialise les changements de stat d'un Pokémon allié.",
      "language": {
        "name": "fr",
        "url": "/api/v2/language/5/"
      }
    },
    {
      "effect": "Used on a party Pokémon in battle\n:   Selects another friendly Pokémon at random.  Removes all of that Pokémon’s stat changes.\n\nThis item can only be obtained or used via the Wonder Launcher.",
      "short_effect": "Resets a friendly Pokémon’s stat changes.",
      "language": {
        "name": "en",
        "url": "/api/v2/language/9/"
      }
    }
  ],
  "flavor_text_entries": [
    {
      "text": "Permet d’annuler les variations de\nstats d’un Pokémon de l’équipe.",
