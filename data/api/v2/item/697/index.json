  "effect_entries": [
    {
      "effect": "Tenu: Permet à Pharamp de Méga-Évoluer en Méga-Pharamp.",
      "short_effect": "Tenu: Permet à Pharamp de Méga-Évoluer en Méga-Pharamp.",
      "language": {
