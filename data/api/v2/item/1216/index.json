  "flavor_text_entries": [
    {
      "text": "かたくて　りっぱな　つので　おもいっきり\nあいてを　つきさして　こうげきする。",
      "version_group": {
        "name": "sword-shield",
        "url": "/api/v2/version-group/20/"
      },
      "language": {
        "name": "ja-hrkt",
        "url": "/api/v2/language/1/"
      }
    },
    {
      "text": "단단하고 훌륭한 뿔로 마음껏\n상대를 꿰찔러서 공격한다.",
      "version_group": {
        "name": "sword-shield",
        "url": "/api/v2/version-group/20/"
      },
      "language": {
        "name": "ko",
        "url": "/api/v2/language/3/"
      }
    },
    {
      "text": "用堅硬且華麗的角狠狠地\n刺進對手進行攻擊。",
      "version_group": {
        "name": "sword-shield",
        "url": "/api/v2/version-group/20/"
      },
      "language": {
        "name": "zh-hant",
        "url": "/api/v2/language/4/"
      }
    },
    {
      "text": "Le lanceur utilise ses gigantesques cornes\npour charger l’ennemi.",
      "version_group": {
        "name": "sword-shield",
        "url": "/api/v2/version-group/20/"
      },
      "language": {
        "name": "fr",
        "url": "/api/v2/language/5/"
      }
    },
    {
      "text": "Brutaler Ramm-Angriff mit spitzem,\nbeeindruckendem Horn.",
      "version_group": {
        "name": "sword-shield",
        "url": "/api/v2/version-group/20/"
      },
      "language": {
        "name": "de",
        "url": "/api/v2/language/6/"
      }
    },
    {
      "text": "Violenta embestida con cuernos imponentes.",
      "version_group": {
        "name": "sword-shield",
        "url": "/api/v2/version-group/20/"
      },
      "language": {
        "name": "es",
        "url": "/api/v2/language/7/"
      }
    },
    {
      "text": "Chi la usa utilizza il suo robusto e imponente\ncorno per colpire il bersaglio con tutto se stesso.",
      "version_group": {
        "name": "sword-shield",
        "url": "/api/v2/version-group/20/"
      },
      "language": {
        "name": "it",
        "url": "/api/v2/language/8/"
      }
    },
    {
      "text": "Using its tough and impressive horn, the user rams\ninto the target with no letup.",
      "version_group": {
        "name": "sword-shield",
        "url": "/api/v2/version-group/20/"
      },
      "language": {
        "name": "en",
        "url": "/api/v2/language/9/"
      }
    },
    {
      "text": "硬くて　りっぱな　つので　おもいっきり\n相手を　突き刺して　攻撃する。",
      "version_group": {
        "name": "sword-shield",
        "url": "/api/v2/version-group/20/"
      },
      "language": {
        "name": "ja",
        "url": "/api/v2/language/11/"
      }
    },
    {
      "text": "用坚硬且华丽的角狠狠地\n刺入对手进行攻击。",
      "version_group": {
        "name": "sword-shield",
        "url": "/api/v2/version-group/20/"
