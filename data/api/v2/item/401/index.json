      }
    }
  ],
  "flavor_text_entries": [
    {
      "text": "Looses a powerful\nblast of light that\nreduces accuracy.",
      "version_group": {
        "name": "ruby-sapphire",
        "url": "/api/v2/version-group/5/"
      },
      "language": {
        "name": "en",
        "url": "/api/v2/language/9/"
      }
    },
    {
      "text": "Looses a powerful\nblast of light that\nreduces accuracy.",
      "version_group": {
        "name": "emerald",
        "url": "/api/v2/version-group/6/"
      },
      "language": {
        "name": "en",
        "url": "/api/v2/language/9/"
      }
    },
    {
      "text": "A blast of light\nthat cuts the foe’s\naccuracy. It also\nilluminates caves.",
      "version_group": {
        "name": "firered-leafgreen",
        "url": "/api/v2/version-group/7/"
      },
      "language": {
        "name": "en",
        "url": "/api/v2/language/9/"
      }
    },
    {
      "text": "Obstacles are moved, reducing the\nfoe’s evasion stat. It can also be\nused to clear deep fog.",
      "version_group": {
        "name": "diamond-pearl",
        "url": "/api/v2/version-group/8/"
      },
      "language": {
        "name": "en",
        "url": "/api/v2/language/9/"
      }
    },
    {
      "text": "Obstacles are moved, reducing the\nfoe’s evasion stat. It can also be\nused to clear deep fog.",
      "version_group": {
        "name": "platinum",
        "url": "/api/v2/version-group/9/"
      },
      "language": {
        "name": "en",
        "url": "/api/v2/language/9/"
      }
    },
    {
      "text": "Traps foes in a violent swirling\nwhirlpool. It can also be used to\ntraverse whirlpools.",
      "version_group": {
        "name": "heartgold-soulsilver",
        "url": "/api/v2/version-group/10/"
      },
      "language": {
        "name": "en",
        "url": "/api/v2/language/9/"
      }
    },
    {
      "text": "Le lanceur charge l’ennemi à une\nvitesse remarquable. Permet aussi\nde franchir une cascade.",
      "version_group": {
        "name": "black-white",
        "url": "/api/v2/version-group/11/"
      },
      "language": {
        "name": "fr",
        "url": "/api/v2/language/5/"
      }
    },
    {
      "text": "The user charges the target at an\nawesome speed. It can also be used\nto climb a waterfall.",
      "version_group": {
        "name": "black-white",
        "url": "/api/v2/version-group/11/"
      },
      "language": {
        "name": "en",
        "url": "/api/v2/language/9/"
      }
    },
    {
      "text": "The user charges the target at an\nawesome speed. It can also be used\nto climb a waterfall.",
      "version_group": {
        "name": "black-2-white-2",
        "url": "/api/v2/version-group/14/"
      },
      "language": {
        "name": "en",
        "url": "/api/v2/language/9/"
      }
    },
    {
      "text": "たきを　さかのぼるような　すさまじい\nいきおいで　とっしん　こうげきする。\nたきを　のぼることも　できる。",
      "version_group": {
        "name": "x-y",
        "url": "/api/v2/version-group/15/"
      },
      "language": {
        "name": "ja-hrkt",
        "url": "/api/v2/language/1/"
      }
    },
    {
      "text": "폭포를 거꾸로 오르는 듯한\n엄청난 기세로 돌진하여 공격한다.\n폭포를 오를 수도 있다.",
      "version_group": {
        "name": "x-y",
        "url": "/api/v2/version-group/15/"
      },
      "language": {
        "name": "ko",
        "url": "/api/v2/language/3/"
      }
    },
    {
      "text": "Le lanceur charge l’ennemi à une vitesse\nremarquable. Permet aussi de franchir une\ncascade.",
      "version_group": {
        "name": "x-y",
        "url": "/api/v2/version-group/15/"
      },
      "language": {
        "name": "fr",
        "url": "/api/v2/language/5/"
      }
    },
    {
      "text": "Eine mächtige Attacke, die das Ziel eventuell\nzurückschrecken lässt. Sie macht Wasserfälle\nbezwingbar.",
      "version_group": {
        "name": "x-y",
        "url": "/api/v2/version-group/15/"
      },
      "language": {
        "name": "de",
        "url": "/api/v2/language/6/"
      }
    },
    {
      "text": "Dispositivo que busca Entrenadores listos para el\ncombate. La batería se carga mientras caminas.",
      "version_group": {
        "name": "x-y",
        "url": "/api/v2/version-group/15/"
      },
      "language": {
        "name": "es",
        "url": "/api/v2/language/7/"
      }
    },
    {
      "text": "Carica il nemico a grande velocità e può farlo\ntentennare.\nFuori dalla lotta fa risalire le cascate.",
      "version_group": {
        "name": "x-y",
        "url": "/api/v2/version-group/15/"
      },
      "language": {
        "name": "it",
        "url": "/api/v2/language/8/"
      }
    },
    {
      "text": "The user charges at the target and may make it\nflinch. This can also be used to climb a waterfall.",
      "version_group": {
        "name": "x-y",
        "url": "/api/v2/version-group/15/"
      },
      "language": {
        "name": "en",
        "url": "/api/v2/language/9/"
      }
    },
