        "url": "/api/v2/version-group/15/"
      },
      "language": {
        "name": "ko",
        "url": "/api/v2/language/3/"
      }
    },
    {
      "text": "Le lanceur se déplace si vite qu’il crée des\ncopies illusoires de lui, augmentant son Esquive.",
