        "url": "/api/v2/version-group/19/"
      },
      "language": {
        "name": "fr",
        "url": "/api/v2/language/5/"
      }
    },
    {
      "text": "Der Anwender feuert einen mächtigen Lichtblitz ab,\nder dem Ziel Schaden zufügt.",
