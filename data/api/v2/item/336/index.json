        "url": "/api/v2/version-group/15/"
      },
      "language": {
        "name": "fr",
        "url": "/api/v2/language/5/"
      }
    },
    {
      "text": "Der Angreifer ist so schnell, dass virtuelle\nAbbilder generiert werden, die den Fluchtwert\nerhöhen.",
