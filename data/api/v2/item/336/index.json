        "url": "/api/v2/version-group/19/"
      },
      "language": {
        "name": "zh-hant",
        "url": "/api/v2/language/4/"
      }
    },
    {
      "text": "Libère une puissante décharge lumineuse qui inflige\ndes dégâts à l’ennemi.",
