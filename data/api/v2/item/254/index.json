        "url": "/api/v2/language/9/"
      }
    },
    {
      "text": "Objet à tenir boostant une capacité\nutilisée à répétition. L’effet s’annule\nsi une autre capacité est utilisée.",
      "version_group": {
        "name": "black-white",
        "url": "/api/v2/version-group/11/"
      },
