        "name": "lets-go-pikachu-lets-go-eevee",
        "url": "/api/v2/version-group/19/"
      },
      "language": {
        "name": "es",
        "url": "/api/v2/language/7/"
      }
    },
    {
      "text": "Mossa d’attacco che raddoppia la potenza\nse chi la usa è scottato, avvelenato o paralizzato.",
