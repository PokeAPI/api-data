        "name": "black-white",
        "url": "/api/v2/version-group/11/"
      },
      "language": {
        "name": "fr",
        "url": "/api/v2/language/5/"
      }
    },
    {
      "text": "A consumable bulb. If the holder is hit\nby a Water-type move, its Sp. Atk\nwill rise.",
      "version_group": {
        "name": "black-white",
        "url": "/api/v2/version-group/11/"
      },
      "language": {
        "name": "en",
        "url": "/api/v2/language/9/"
      }
    },
    {
      "text": "A consumable bulb. If the holder is hit\nby a Water-type move, its Sp. Atk\nwill rise.",
