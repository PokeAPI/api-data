        "name": "sword-shield",
        "url": "/api/v2/version-group/20/"
      },
      "language": {
        "name": "de",
        "url": "/api/v2/language/6/"
      }
    },
    {
      "text": "Si el usuario está quemado, paralizado o envenenado,\nataca con el doble de potencia.",
