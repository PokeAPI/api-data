  "effect_entries": [],
  "flavor_text_entries": [
    {
      "text": "まんまるの　ガラスだま。\nとうめいな　たまの　なかに\nいろガラスの　もようが　みえる。",
      "version_group": {
        "name": "lets-go-pikachu-lets-go-eevee",
        "url": "/api/v2/version-group/19/"
      },
      "language": {
        "name": "ja-hrkt",
        "url": "/api/v2/language/1/"
      }
    },
    {
      "text": "동글동글한 유리구슬.\n투명한 구슬 안에\n색유리의 무늬가 비친다.",
      "version_group": {
        "name": "lets-go-pikachu-lets-go-eevee",
        "url": "/api/v2/version-group/19/"
      },
      "language": {
        "name": "ko",
        "url": "/api/v2/language/3/"
      }
    },
    {
      "text": "圓滾滾的玻璃彈珠。\n在透明的彈珠中\n能看見彩色玻璃的花紋。",
      "version_group": {
        "name": "lets-go-pikachu-lets-go-eevee",
        "url": "/api/v2/version-group/19/"
      },
      "language": {
        "name": "zh-hant",
        "url": "/api/v2/language/4/"
      }
    },
    {
      "text": "Une bille de verre transparente avec un motif coloré\nà l’intérieur.",
      "version_group": {
        "name": "lets-go-pikachu-lets-go-eevee",
        "url": "/api/v2/version-group/19/"
      },
      "language": {
        "name": "fr",
        "url": "/api/v2/language/5/"
      }
    },
    {
      "text": "Eine runde, durchsichtige Kugel aus Glas. In ihrer Mitte\nbefinden sich Muster in verschiedensten Farben.",
      "version_group": {
        "name": "lets-go-pikachu-lets-go-eevee",
        "url": "/api/v2/version-group/19/"
      },
      "language": {
        "name": "de",
        "url": "/api/v2/language/6/"
      }
    },
    {
      "text": "Esfera de cristal transparente en cuyo interior se pueden\napreciar diferentes colores.",
      "version_group": {
        "name": "lets-go-pikachu-lets-go-eevee",
        "url": "/api/v2/version-group/19/"
      },
      "language": {
        "name": "es",
        "url": "/api/v2/language/7/"
      }
    },
    {
      "text": "Una biglia di vetro perfettamente rotonda. Al suo\ninterno si vede in trasparenza del vetro colorato.",
      "version_group": {
        "name": "lets-go-pikachu-lets-go-eevee",
        "url": "/api/v2/version-group/19/"
      },
      "language": {
        "name": "it",
        "url": "/api/v2/language/8/"
      }
    },
    {
      "text": "A round glass marble. You can see colored glass\ninside the transparent marble.",
      "version_group": {
        "name": "lets-go-pikachu-lets-go-eevee",
        "url": "/api/v2/version-group/19/"
      },
      "language": {
        "name": "en",
        "url": "/api/v2/language/9/"
      }
    },
    {
