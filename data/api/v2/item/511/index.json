  "flavor_text_entries": [
    {
      "text": "It holds Pokéathlon records. It’s a\ncard that shows how many times you’ve\ninstructed your Pokémon.",
      "version_group": {
        "name": "heartgold-soulsilver",
        "url": "/api/v2/version-group/10/"
      },
      "language": {
        "name": "en",
        "url": "/api/v2/language/9/"
      }
    },
    {
      "text": "Contient vos données du Pokéathlon.\nIl y est inscrit le nombre de fois\noù vous avez touché vos Pokémon.",
      "version_group": {
        "name": "black-white",
        "url": "/api/v2/version-group/11/"
      },
      "language": {
        "name": "fr",
        "url": "/api/v2/language/5/"
      }
    },
    {
      "text": "It holds Pokéathlon records. It’s a\ncard that shows how many times you’ve\ninstructed your Pokémon.",
