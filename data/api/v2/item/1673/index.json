  "effect_entries": [],
  "flavor_text_entries": [
    {
      "text": "ちいさな　めずらしいタケノコ。一部のグルメの　あいだではけっこう人気が　高い。",
      "version_group": {
        "name": "scarlet-violet",
        "url": "/api/v2/version-group/25/"
      },
      "language": {
        "name": "ja-hrkt",
        "url": "/api/v2/language/1/"
      }
    },
    {
      "text": "작고 진귀한 죽순. 일부 미식가 사이에서는 매우 인기가 높다.",
      "version_group": {
        "name": "scarlet-violet",
        "url": "/api/v2/version-group/25/"
      },
      "language": {
        "name": "ko",
        "url": "/api/v2/language/3/"
      }
    },
    {
      "text": "既小巧又罕見的竹筍。在一些饕客之間相當受歡迎。",
      "version_group": {
        "name": "scarlet-violet",
        "url": "/api/v2/version-group/25/"
      },
      "language": {
        "name": "zh-hant",
        "url": "/api/v2/language/4/"
      }
    },
    {
      "text": "Une petite pousse de bambou assez rare. Elle est plutôt populaire auprès de certains gourmets.",
      "version_group": {
        "name": "scarlet-violet",
        "url": "/api/v2/version-group/25/"
      },
      "language": {
        "name": "fr",
        "url": "/api/v2/language/5/"
      }
    },
    {
      "text": "Ein kleiner und recht seltener Bambusspross, der sich bei einigen Feinschmeckern großer Beliebtheit erfreut.",
      "version_group": {
        "name": "scarlet-violet",
        "url": "/api/v2/version-group/25/"
      },
      "language": {
        "name": "de",
        "url": "/api/v2/language/6/"
      }
    },
    {
      "text": "Un pequeño brote de bambú que es poco común y bastante popular entre determinados grupos de gourmets.",
      "version_group": {
        "name": "scarlet-violet",
        "url": "/api/v2/version-group/25/"
      },
      "language": {
        "name": "es",
        "url": "/api/v2/language/7/"
      }
    },
    {
      "text": "Germoglio di bambù piccolo e raro. È discretamente apprezzato da alcuni gourmet.",
      "version_group": {
        "name": "scarlet-violet",
        "url": "/api/v2/version-group/25/"
      },
      "language": {
        "name": "it",
        "url": "/api/v2/language/8/"
      }
    },
    {
      "text": "A small and rare bamboo shoot. It’s quite popular with a certain class of gourmands.",
      "version_group": {
        "name": "scarlet-violet",
        "url": "/api/v2/version-group/25/"
      },
      "language": {
        "name": "en",
        "url": "/api/v2/language/9/"
      }
    },
    {
      "text": "ちいさな　めずらしいタケノコ。一部のグルメの　あいだではけっこう人気が　高い。",
      "version_group": {
        "name": "scarlet-violet",
        "url": "/api/v2/version-group/25/"
      },
      "language": {
        "name": "ja",
        "url": "/api/v2/language/11/"
      }
    },
    {
      "text": "小小的珍贵竹笋。在部分美食家中拥有很高人气。",
      "version_group": {
        "name": "scarlet-violet",
        "url": "/api/v2/version-group/25/"
