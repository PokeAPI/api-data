  "effect_entries": [
    {
      "effect": "Utilisé au combat\n:   Tente de capturer un Pokémon sauvage.  Si le Pokémon sauvage est de type Eau ou Insecte, cette ball a un taux de capture de 3x.  Sinon, elle a un taux de capture de 1x.\n\n    Si utilisé pendant un combat de dresseurs, rien ne se passe et la ball est perdue.",
      "short_effect": "Tente de capturer un Pokémon sauvage. Le taux de succès est 3× pour les Pokémon eau et insecte.",
      "language": {
        "name": "fr",
        "url": "/api/v2/language/5/"
      }
    },
    {
      "effect": "Used in battle\n:   Attempts to catch a wild Pokémon.  If the wild Pokémon is Water- or Bug-type, this ball has a catch rate of 3×.  Otherwise, it has a catch rate of 1×.\n\n    If used in a trainer battle, nothing happens and the ball is lost.",
      "short_effect": "Tries to catch a wild Pokémon.  Success rate is 3× for water and bug Pokémon.",
      "language": {
        "name": "en",
        "url": "/api/v2/language/9/"
      }
    }
  ],
  "flavor_text_entries": [
