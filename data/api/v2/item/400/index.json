        "name": "x-y",
        "url": "/api/v2/version-group/15/"
      },
      "language": {
        "name": "es",
        "url": "/api/v2/language/7/"
      }
    },
    {
      "text": "Colpisce il nemico con un’enorme energia.\nFuori dalla lotta si usa per spostare i massi.",
