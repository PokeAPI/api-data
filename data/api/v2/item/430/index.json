        "name": "x-y",
        "url": "/api/v2/version-group/15/"
      },
      "language": {
        "name": "it",
        "url": "/api/v2/language/8/"
      }
    },
    {
      "text": "A feather that glows like the moon.\nIt’s said to possess the power to\ndispel nightmares.",
