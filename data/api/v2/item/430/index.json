        "url": "/api/v2/language/9/"
      }
    },
    {
      "text": "Plume qui brille comme la lune. On dit\nqu’elle a le pouvoir de chasser les\ncauchemars.",
      "version_group": {
        "name": "black-white",
        "url": "/api/v2/version-group/11/"
      },
