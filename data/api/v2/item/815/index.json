  "effect_entries": [
    {
      "effect": "Transforme la Météorite en sa forme finale, permettant à Rayquaza de Méga-Évoluer.",
      "short_effect": "Transforme la Météorite en sa forme finale, permettant à Rayquaza de Méga-Évoluer.",
      "language": {
