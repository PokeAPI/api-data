        "name": "sun-moon",
        "url": "/api/v2/version-group/17/"
      },
      "language": {
        "name": "zh-hant",
        "url": "/api/v2/language/4/"
      }
    },
    {
      "text": "Une flûte capable d’appeler Latios ou Latias\noù que l’on soit.",
