        "url": "/api/v2/version-group/17/"
      },
      "language": {
        "name": "fr",
        "url": "/api/v2/language/5/"
      }
    },
    {
      "text": "Eine Flöte, mit der man Latios oder Latias\nherbeirufen kann, egal wo sie sich gerade befinden.",
