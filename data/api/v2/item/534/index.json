    "url": "/api/v2/item-category/20/"
  },
  "effect_entries": [
    {
      "effect": "Donne accès à l'Île du Sud et soit Latias ou Latios, celui qui ne sera pas disponible errant autour d'Hoenn.",
      "short_effect": "Permet d'accéder à l'ïle du Sud et Latias ou Latios.",
      "language": {
        "name": "fr",
        "url": "/api/v2/language/5/"
      }
    },
    {
      "effect": "Provides access to Southern Island and either Latias or Latios, whichever is not available roaming around Hoenn.",
      "short_effect": "Provides access to Southern Island and Latias or Latios.",
      "language": {
        "name": "en",
        "url": "/api/v2/language/9/"
      }
    }
  ],
  "flavor_text_entries": [
    {
      "text": "The ticket for a\nferry to a distant\nsouthern island.",
      "version_group": {
        "name": "ruby-sapphire",
        "url": "/api/v2/version-group/5/"
      },
      "language": {
        "name": "en",
        "url": "/api/v2/language/9/"
      }
    },
    {
      "text": "The ticket for a\nferry to a distant\nsouthern island.",
      "version_group": {
        "name": "emerald",
        "url": "/api/v2/version-group/6/"
      },
      "language": {
        "name": "en",
        "url": "/api/v2/language/9/"
      }
    },
    {
      "text": "The ticket required for sailing on a\nferry to a distant southern island.\nIt features a drawing of an island.",
      "version_group": {
        "name": "firered-leafgreen",
        "url": "/api/v2/version-group/7/"
      },
      "language": {
        "name": "en",
        "url": "/api/v2/language/9/"
      }
    },
    {
      "text": "みなみのことうへ　いく　ふねの\nチケット。トウカジムの　ジムリーダー\nセンリが　ひみつを　しっている！？",
      "version_group": {
        "name": "sun-moon",
        "url": "/api/v2/version-group/17/"
      },
      "language": {
        "name": "ja-hrkt",
        "url": "/api/v2/language/1/"
      }
    },
    {
      "text": "남쪽의 외딴섬으로 가는 배의\n승선티켓. 등화체육관 관장\n종길이 비밀을 알고 있다!?",
      "version_group": {
        "name": "sun-moon",
        "url": "/api/v2/version-group/17/"
      },
      "language": {
        "name": "ko",
        "url": "/api/v2/language/3/"
      }
    },
    {
      "text": "前往南方孤島的船票。\n橙華道館的館主千里\n知道其中的秘密！？",
      "version_group": {
        "name": "sun-moon",
        "url": "/api/v2/version-group/17/"
      },
      "language": {
        "name": "zh-hant",
        "url": "/api/v2/language/4/"
      }
    },
    {
      "text": "Un billet de ferry pour l’Île du Sud.\nNorman, le Champion de l’Arène de Clémenti-Ville,\nsemble savoir quelque chose à son sujet.",
      "version_group": {
        "name": "sun-moon",
        "url": "/api/v2/version-group/17/"
      },
      "language": {
        "name": "fr",
        "url": "/api/v2/language/5/"
      }
    },
    {
      "text": "Ein Bootsticket, mit dem du zu einer fernen Insel im\nSüden schippern kannst. Kennt der Arenaleiter von\nBlütenburg, Norman, ein Geheimnis?!",
      "version_group": {
        "name": "sun-moon",
        "url": "/api/v2/version-group/17/"
      },
      "language": {
        "name": "de",
        "url": "/api/v2/language/6/"
      }
    },
    {
      "text": "Billete de barco para viajar a Isla del Sur.\nEs posible que Norman, Líder del Gimnasio de\nCiudad Petalia, sepa algo al respecto.",
      "version_group": {
        "name": "sun-moon",
        "url": "/api/v2/version-group/17/"
      },
      "language": {
        "name": "es",
        "url": "/api/v2/language/7/"
      }
    },
    {
      "text": "Biglietto per il traghetto che porta all’Isola Remota.\nNorman, il Capopalestra di Petalipoli, dovrebbe\nsapere come usarlo.",
      "version_group": {
        "name": "sun-moon",
        "url": "/api/v2/version-group/17/"
      },
      "language": {
        "name": "it",
        "url": "/api/v2/language/8/"
      }
    },
    {
      "text": "The ticket required for sailing on a ferry to the\nSouthern Island. Does Norman, the Petalburg Gym\nLeader, know a secret?!",
      "version_group": {
        "name": "sun-moon",
        "url": "/api/v2/version-group/17/"
      },
      "language": {
        "name": "en",
        "url": "/api/v2/language/9/"
      }
    },
    {
      "text": "南の孤島へ　行く　船の\nチケット。トウカジムの　ジムリーダー\nセンリが　秘密を　知っている！？",
      "version_group": {
        "name": "sun-moon",
