        "name": "legends-za",
        "url": "/api/v2/version-group/30/"
      },
      "language": {
        "name": "fr",
        "url": "/api/v2/language/5/"
      }
    },
    {
      "text": "Einer der mysteriösen Mega-Steine. Wird er von einem Pixi getragen, kann es im Kampf eine Mega-Entwicklung durchführen.",
      "version_group": {
        "name": "legends-za",
        "url": "/api/v2/version-group/30/"
      },
      "language": {
        "name": "de",
        "url": "/api/v2/language/6/"
      }
    },
    {
      "text": "Una de las misteriosas Megapiedras. Permite megaevolucionar a Clefable en combate.",
