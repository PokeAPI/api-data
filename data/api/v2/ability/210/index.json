  "effect_entries": [
    {
      "effect": "Transforme ce Pokémon en Amphinobi Forme Sacha après être mis KO par un adversaire.  La puissance de Sheauriken est 20 et frappe toujours trois fois.\n\nCe talent ne peut pas être copié ou remplacé.  Ce talent s'active seulement pour Amphinobi.",
      "short_effect": "Transforme ce Pokémon en Amphinobi Forme Sacha après avoir mis KO un adversaire.  La puissance de Sheauriken est 20 et frappe toujours trois fois.",
      "language": {
        "name": "fr",
        "url": "/api/v2/language/5/"
      }
    },
    {
      "effect": "Transforms this Pokémon into Ash-Greninja after fainting an opponent.  Water Shuriken's power is 20 and always hits three times.\n\nThis ability cannot be copied or replaced.  This ability only takes effect for Greninja.",
      "short_effect": "Transforms this Pokémon into Ash-Greninja after fainting an opponent.  Water Shuriken's power is 20 and always hits three times.",
      "language": {
        "name": "en",
        "url": "/api/v2/language/9/"
      }
    }
  ],
  "effect_changes": [],
  "flavor_text_entries": [
    {
      "flavor_text": "あいてを　たおすと　トレーナーとの\nきずなが　ふかまり　サトシゲッコウガに\nへんげする。みずしゅりけんが　つよくなる。",
      "language": {
        "name": "ja-hrkt",
        "url": "/api/v2/language/1/"
      },
      "version_group": {
        "name": "sun-moon",
        "url": "/api/v2/version-group/17/"
      }
    },
    {
      "flavor_text": "상대를 쓰러뜨리면 트레이너와의\n유대감이 깊어져서 지우개굴닌자로\n변한다. 물수리검이 강해진다.",
      "language": {
        "name": "ko",
        "url": "/api/v2/language/3/"
      },
      "version_group": {
        "name": "sun-moon",
        "url": "/api/v2/version-group/17/"
      }
    },
    {
      "flavor_text": "打倒對手時，與訓練家的牽絆會加深，\n變化成小智版甲賀忍蛙。\n飛水手裡劍的威力會增強。",
      "language": {
        "name": "zh-hant",
        "url": "/api/v2/language/4/"
      },
      "version_group": {
        "name": "sun-moon",
        "url": "/api/v2/version-group/17/"
      }
    },
    {
      "flavor_text": "En battant un ennemi, ce Pokémon renforce ses liens\navec son Dresseur. Il prend alors sa Forme Sacha\net ses Sheauriken gagnent en puissance.",
      "language": {
        "name": "fr",
        "url": "/api/v2/language/5/"
      },
      "version_group": {
        "name": "sun-moon",
        "url": "/api/v2/version-group/17/"
      }
    },
    {
      "flavor_text": "Besiegt es ein Ziel, vertieft dies die Freundschaft zu\nseinem Trainer, wodurch es die Ash-Form annimmt\nund sein Wasser-Shuriken stärker wird.",
      "language": {
        "name": "de",
        "url": "/api/v2/language/6/"
      },
      "version_group": {
        "name": "sun-moon",
        "url": "/api/v2/version-group/17/"
      }
    },
    {
      "flavor_text": "Al derrotar a un rival, los vínculos con su Entrenador\nse refuerzan y se convierte en Greninja Ash. Su\nShuriken de Agua también se ve potenciado.",
      "language": {
        "name": "es",
        "url": "/api/v2/language/7/"
      },
      "version_group": {
        "name": "sun-moon",
        "url": "/api/v2/version-group/17/"
      }
    },
    {
      "flavor_text": "Se il Pokémon manda KO un nemico, il legame con\nl’Allenatore si rafforza, attivando la trasformazione\nin Greninja Forma Ash. Acqualame si potenzia.",
      "language": {
        "name": "it",
        "url": "/api/v2/language/8/"
      },
      "version_group": {
        "name": "sun-moon",
        "url": "/api/v2/version-group/17/"
      }
    },
    {
      "flavor_text": "Defeating an opposing Pokémon strengthens the\nPokémon’s bond with its Trainer, and it becomes\nAsh-Greninja. Water Shuriken gets more powerful.",
      "language": {
        "name": "en",
        "url": "/api/v2/language/9/"
      },
      "version_group": {
        "name": "sun-moon",
        "url": "/api/v2/version-group/17/"
      }
    },
    {
      "flavor_text": "相手を　倒すと　トレーナーとの\nキズナが　深まり　サトシゲッコウガに\n変化する。みずしゅりけんが　強くなる。",
      "language": {
        "name": "ja",
        "url": "/api/v2/language/11/"
      },
      "version_group": {
        "name": "sun-moon",
        "url": "/api/v2/version-group/17/"
      }
    },
    {
