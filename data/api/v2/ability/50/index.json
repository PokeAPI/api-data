  "effect_entries": [
    {
      "effect": "Ce Pokémon fuit toujours les combats sauvages avec succès, même s'il est piégé par une capacité ou un talent.",
      "short_effect": "Garantit la fuite lors de combats sauvages.",
      "language": {
        "name": "fr",
        "url": "/api/v2/language/5/"
      }
    },
    {
      "effect": "Pokémon mit dieser Fähigkeit können immer aus Kämpfen mit wilden Pokémon fliehen, selbst wenn es durch eine Attacke oder eine Fähigkeit gefangen ist.",
      "short_effect": "Stellt sicher, dass die Flucht vor wilden Pokémon gelingt.",
      "language": {
        "name": "de",
        "url": "/api/v2/language/6/"
      }
    },
    {
      "effect": "This Pokémon is always successful fleeing from wild battles, even if trapped by a move or ability.",
      "short_effect": "Ensures success fleeing from wild battles.",
      "language": {
        "name": "en",
