  "effect_entries": [
    {
      "effect": "Les capacités utilisées par ou contre ce Pokémon ne manquent jamais leur cible.\n\nLes capacités OHKO ne sont pas affectées.  Les capacités affectées par ce talent peuvent frapper les Pokémon pendant le tour de préparation de capacités comme Tunnel ou Vol.\n\nMonde extérieur: Si le Pokémon de tête a ce talent, le taux de rencontre sauvage est doublé.",
      "short_effect": "Assure que toutes les capacités utilisés par et contre le Pokémon touchent.",
      "language": {
        "name": "fr",
        "url": "/api/v2/language/5/"
      }
    },
    {
      "effect": "Attacken die gegen ein oder von einem Pokémon mit dieser Fähigkeit eingesetzt werden treffen immer.\n\nK.O.-Attacken sind davon nicht betroffen. Attacken die von der Fähigkeit beeinflusst werden können auch in Vorbereitungsrunden von Schaufler oder Fliegen treffen.\n\nAußerhalb vom Kampf: Wenn ein Pokémon mit dieser Fähigkeit an erster Stelle im Team steht, ist die Wahrscheinlichkeit einem wilden Pokémon zu begegnen doppelt so hoch wie normal.",
      "short_effect": "Stellt sicher das Attacken die von dem oder gegen das Pokémon eingesetzt werden treffen.",
      "language": {
        "name": "de",
        "url": "/api/v2/language/6/"
      }
    },
    {
      "effect": "Moves used by or against this Pokémon never miss.\n\nOne-hit KO moves are unaffected.  Moves affected by this ability can hit Pokémon during the preparation turn of moves like Dig or Fly.\n\nOverworld: If the lead Pokémon has this ability, the wild encounter rate is doubled.",
      "short_effect": "Ensures all moves used by and against the Pokémon hit.",
      "language": {
        "name": "en",
        "url": "/api/v2/language/9/"
      }
    }
  ],
  "effect_changes": [
    {
      "version_group": {
        "name": "platinum",
        "url": "/api/v2/version-group/9/"
      },
      "effect_entries": [
        {
          "effect": "À cause d'un glitch, les capacités affectées par ce talent ont (100 - accuracy)% de chance de transpercer Détection ou Abri.",
          "language": {
            "name": "fr",
            "url": "/api/v2/language/5/"
          }
        },
        {
          "effect": "Wegen eines Glitches haben Attacken die von dieser Fähigkeit beeinflusst sind eine (100 - Genauigkeit)% Chance durch den Scanner oder Schutzschild zu treffen.",
          "language": {
            "name": "de",
            "url": "/api/v2/language/6/"
          }
        },
        {
          "effect": "Due to a glitch, moves affected by this ability have a (100 - accuracy)% chance to hit through Detect or Protect.",
          "language": {
            "name": "en",
            "url": "/api/v2/language/9/"
          }
        }
      ]
    }
  ],
