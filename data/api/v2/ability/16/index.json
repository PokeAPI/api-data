          }
        },
        {
          "effect": "Löst bei Attacken die mehrmals Treffen bei jedem Treffer aus.",
          "language": {
            "name": "de",
            "url": "/api/v2/language/6/"
          }
        },
        {
          "effect": "Triggers on every hit of multiple-hit moves.",
          "language": {
            "name": "en",
            "url": "/api/v2/language/9/"
          }
        }
      ]
    }
  ],
