  "effect_entries": [
    {
      "effect": "Quand une capacité de type Plante frappe ce Pokémon, son Attaque augmente d'un niveau, annulant n'importe quel autre effet sur lui.",
      "short_effect": "Absorbe les capacités Plante, augmentant l'Attaque d'un niveau.",
      "language": {
        "name": "fr",
        "url": "/api/v2/language/5/"
      }
    },
    {
      "effect": "Wenn ein Pokémon mit dieser Fähigkeit von einer Pflanze Attacke getroffen wird, steigt sein Angriff um 1 Stufe, wobei jeder andere Effekt entfernt wird.",
      "short_effect": "Absorbiert Pflanze Attacken und erhöhrt dabei den Angriff um 1 Stufe.",
      "language": {
        "name": "de",
        "url": "/api/v2/language/6/"
      }
    },
    {
      "effect": "Whenever a Grass-type move hits this Pokémon, its Attack rises one stage, negating any other effect on it.",
      "short_effect": "Absorbs Grass moves, raising Attack one stage.",
      "language": {
