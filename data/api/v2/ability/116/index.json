  "effect_entries": [
    {
      "effect": "Ce Pokémon subit 0.75× de dégâts des capacités qui sont super efficaces contre lui.\n\nCe talent fonctionne de la même manière que Filtre.",
      "short_effect": "Diminue les dégâts subis des capacités super efficaces de 1/4.",
      "language": {
        "name": "fr",
        "url": "/api/v2/language/5/"
      }
    },
    {
      "effect": "Pokémon mit dieser Fähigkeit erleiden nur 75% des Schadens, der durch Attacken die super effektiv sind verursacht wurde.\n\nDie Fähigkeit ist identisch mit Filter.",
      "short_effect": "Reduziert den durch sehr effektive Attacken verursachten Schaden um 1/4.",
      "language": {
        "name": "de",
        "url": "/api/v2/language/6/"
      }
    },
    {
      "effect": "This Pokémon takes 0.75× as much damage from moves that are super effective against it.\n\nThis ability functions identically to Filter.",
