  "effect_entries": [
    {
      "effect": "Tous les Pokémon alliés subissent 0.75× de dégâts directs des capacités tant que ce Pokémon est au combat.\n\nCet effet se cumule si plusieurs Pokémon alliés l’ont.",
      "short_effect": "Diminue tous les dégâts directs subis par les Pokémon alliés de 0.75×.",
      "language": {
        "name": "fr",
        "url": "/api/v2/language/5/"
      }
    },
    {
      "effect": "Alle Teampartner von Pokémon mit dieser Fähigkeit erhalten nur 0,75× so viel Schaden durch Attacken während das Pokémon im Kampf ist.\n\nDer Effekt stapelt, wenn mehrere Pokémon mit dieser Fähigkeit im Kampf sind.",
      "short_effect": "Verringert allen von Teampartnern erlitten Schaden um 75%.",
      "language": {
        "name": "de",
        "url": "/api/v2/language/6/"
      }
    },
    {
      "effect": "All friendly Pokémon take 0.75× as much direct damage from moves while this Pokémon is in battle.\n\nThis effect stacks if multiple allied Pokémon have it.",
      "short_effect": "Decreases all direct damage taken by friendly Pokémon to 0.75×.",
      "language": {
        "name": "en",
        "url": "/api/v2/language/9/"
      }
    }
  ],
