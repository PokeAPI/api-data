  "effect_entries": [
    {
      "effect": "Quand ce Pokémon est endormi, brûlé, paralysé, ou empoisonné, il a 1.5× son Attaque.  Ce Pokémon n'est pas affecté par les baisses d'Attaque habituelles de la brûlure.\n\nCe bonus ne compte pas comme une modification de stat.",
      "short_effect": "Augmente l'Attaque d'1.5× avec une altération majeure de statut.",
      "language": {
        "name": "fr",
        "url": "/api/v2/language/5/"
      }
    },
    {
      "effect": "Wenn ein Pokémon mit dieser Fähigkeit schläft, brennt, paralysiert oder vergiftet ist, ist sein Angriff 1,5× so hoch wie sonst. Bei Verbrennung gibt es keine Halbierung des Angriffs.\n\nDer Bonus zählt nicht als Statuswerte Änderung.",
      "short_effect": "Erhöht den Angriff um 50% wenn das Pokémon unter einer Primäre Statusveränderungen leidet.",
      "language": {
        "name": "de",
        "url": "/api/v2/language/6/"
      }
    },
    {
      "effect": "Whenever this Pokémon is asleep, burned, paralyzed, or poisoned, it has 1.5× its Attack.  This Pokémon is not affected by the usual Attack cut from a burn.\n\nThis bonus does not count as a stat modifier.",
      "short_effect": "Increases Attack to 1.5× with a major status ailment.",
      "language": {
        "name": "en",
        "url": "/api/v2/language/9/"
      }
    }
  ],
