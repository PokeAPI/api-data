  "effect_entries": [
    {
      "effect": "Ce Pokémon regagne 1/3 de ses PV max en mangeant une baie en plus des bénéfices normaux de celle-ci.",
      "short_effect": "Restaure les PV en mangeant une Baie, en plus de l'effet de la Baie.",
      "language": {
        "name": "fr",
        "url": "/api/v2/language/5/"
      }
    },
    {
      "effect": "Wenn ein Pokémon mit dieser Fähigkeit eine Beere isst, stellt es 1/3 seiner maximalen KP wieder her, zusätzlich zum eigentlichen Effekt der Beere.\n\nDie Fähigkeit wirkt auch, wenn das Pokémon die Beere durch Schleuder, Käferbiss oder Pflücker erhalten hat, solange es von der Beere profitiert.\n\nDie Fähigkeit wirkt nicht, wenn die Beere mit Beerenkräfte verbraucht wird.",
      "short_effect": "Stellt zusätzlich zum eigentlichen Effekt einer Beere zusätzliche KP wieder her.",
      "language": {
        "name": "de",
        "url": "/api/v2/language/6/"
      }
    },
    {
      "effect": "Restores HP upon eating a Berry, in addition to the Berry's effect.",
      "short_effect": "Restores HP upon eating a Berry, in addition to the Berry's effect.",
      "language": {
        "name": "en",
        "url": "/api/v2/language/9/"
      }
    }
  ],
