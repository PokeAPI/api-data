  "effect_entries": [
    {
      "effect": "Quand une capacité de contact touche ce Pokémon, le talent du Pokémon attaquant change en Momie.\n\nMulti-Type n’est pas affecté.  Si un Pokémon avec Impudence met ce Pokémon KO, le talent du premier changera sans prendre effet.",
      "short_effect": "Change les talents des Pokémon attaquants en Momie en cas de contact.",
      "language": {
        "name": "fr",
        "url": "/api/v2/language/5/"
      }
    },
    {
      "effect": "Wenn ein Pokémon mit dieser Fähigkeit von einer Attacke mit Kontakt getroffen wird, ändert sich die Fähigkeit des Gegners in Mumie.\n\nVariabilität ist nicht betroffen. Wenn das Pokémon von einem mit der Fähigkeit Hochmut besiegt wird, ändert sich dessen Fähigkeit ohne ihren Effekt auszulösen.",
      "short_effect": "Ändert bei Kontakt die Fähigkeit von Angreifern in Mumie.",
      "language": {
        "name": "de",
        "url": "/api/v2/language/6/"
      }
    },
    {
      "effect": "Whenever a contact move hits this Pokémon, the attacking Pokémon's ability changes to Mummy.\n\nMultitype is unaffected.  If a Pokémon with Moxie knocks this Pokémon out, the former's ability will change without taking effect.",
      "short_effect": "Changes attacking Pokémon's abilities to Mummy on contact.",
      "language": {
        "name": "en",
        "url": "/api/v2/language/9/"
      }
    }
  ],
