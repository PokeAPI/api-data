  "effect_entries": [
    {
      "effect": "Quand un Pokémon devrait se soigner après avoir frappé ce Pokémon avec une capacité de drainage comme Vole-Vie, il perdrait autant de PV qu'il devrait gagner à la place.\n\nDévorêve n'est pas affecté.",
      "short_effect": "Inflige des dégâts aux adversaires qui utilisent des capacités drainantes d'autant qu'elles soigneraient.",
      "language": {
        "name": "fr",
        "url": "/api/v2/language/5/"
      }
    },
    {
      "effect": "Wenn ein Pokémon mit dieser Fähigkeit von einer absorbierenden Attacke wie Absorber getroffen wird, erleidet der Gegner so viele KP Schaden wie ihn die Attacke geheilt hätte.\n\nTraumfresser ist davon nicht betroffen.",
      "short_effect": "Gegnern die absorbierende Attacken einsetzen, wird Schaden in der Höhe zugefügt, die die Attacke geheilt hätte.",
      "language": {
        "name": "de",
        "url": "/api/v2/language/6/"
      }
    },
    {
      "effect": "Whenever a Pokémon would heal after hitting this Pokémon with a leeching move like Absorb, it instead loses as many HP as it would usually gain.\n\nDream Eater is unaffected.",
      "short_effect": "Damages opponents using leeching moves for as much as they would heal.",
      "language": {
        "name": "en",
        "url": "/api/v2/language/9/"
      }
    }
  ],
