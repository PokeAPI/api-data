  "effect_entries": [
    {
      "effect": "Ce Pokémon ne peut pas être attiré et est immunisé contre Séduction.\n\nSi un Pokémon est attiré et acquiert ce ca telent, son attraction disparaît.",
      "short_effect": "Empêche l'attirance et protège contre Séduction.",
      "language": {
        "name": "fr",
        "url": "/api/v2/language/5/"
      }
    },
    {
      "effect": "Dieses Pokémon kann sich nicht verlieben und ist immun gegen Liebreiz.\n\nWenn ein Pokémon verliebt ist und diese Fähigkeit erhält, wird es von der Verliebtheit geheilt.",
      "short_effect": "Verhindert Verliebtheit und schützt gegen Liebreiz.",
      "language": {
        "name": "de",
        "url": "/api/v2/language/6/"
      }
    },
    {
      "effect": "This Pokémon cannot be infatuated and is immune to Captivate.\n\nIf a Pokémon is infatuated and acquires this ability, its infatuation is cleared.",
      "short_effect": "Prevents infatuation and protects against Captivate.",
      "language": {
        "name": "en",
        "url": "/api/v2/language/9/"
      }
    }
