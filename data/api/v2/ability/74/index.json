  "effect_entries": [
    {
      "effect": "L'Attaque de ce Pokémon est doublée au combat.\n\nCe bonus ne compte pas comme une modification de stat.\n\nCe talent fonctionne de la même manière que Coloforce.",
      "short_effect": "Double l'Attaque au combat.",
      "language": {
        "name": "fr",
        "url": "/api/v2/language/5/"
      }
    },
    {
      "effect": "Solange sich ein Pokémon mit dieser Fähigkeit im Kampf befindet ist sein Angriff doppelt so hoch wie sonst.\n\nDieser Bonus zählt nicht als Statusveränderung.\n\nDiese Fähigkeit ist identisch mit Kraftkoloss.",
      "short_effect": "Verdoppelt den Angriff im Kampf.",
      "language": {
        "name": "de",
        "url": "/api/v2/language/6/"
      }
    },
    {
      "effect": "This Pokémon's Attack is doubled in battle.\n\nThis bonus does not count as a stat modifier.\n\nThis ability functions identically to Huge Power.",
      "short_effect": "Doubles Attack in battle.",
