  "effect_entries": [
    {
      "effect": "Ce Pokémon ignore les immunités des Pokémon de type Spectre aux capacités de type Normal et Combat.\n\nLes autres types des Pokémon Spectre affectent les dégâts normalement.",
      "short_effect": "Laisse les capacités Normal et Combat du Pokémon frapper les Pokémon Spectre.",
      "language": {
        "name": "fr",
        "url": "/api/v2/language/5/"
      }
    },
    {
      "effect": "Pokémon mit dieser Fähigkeit ignorieren die Immunität von Geist Pokémon gegen Normal und Kampf Attacken.\n\nDer zweite Typ des Geist Pokémons beeinflusst den Schaden wie sonst auch.",
      "short_effect": "Lässt die Normal und Kampf Attacken des Pokémons Geist Pokémon treffen.",
      "language": {
        "name": "de",
        "url": "/api/v2/language/6/"
      }
    },
    {
      "effect": "This Pokémon ignores Ghost-type Pokémon's immunity to Normal- and Fighting-type moves.\n\nGhost Pokémon's other types affect damage as usual.",
      "short_effect": "Lets the Pokémon's Normal and Fighting moves hit Ghost Pokémon.",
      "language": {
        "name": "en",
        "url": "/api/v2/language/9/"
      }
    }
  ],
