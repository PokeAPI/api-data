            "url": "/api/v2/language/5/"
          }
        },
        {
          "effect": "Feuerzahn und Attacken die typenlosen Schaden verursachen, ignorieren diese Fähigkeit unabhängig von ihrem Typ.",
          "language": {
            "name": "de",
            "url": "/api/v2/language/6/"
          }
        },
        {
          "effect": "Fire Fang and moves that inflict typeless damage ignore this ability regardless of type.",
          "language": {
            "name": "en",
            "url": "/api/v2/language/9/"
          }
        }
      ]
    }
  ],
