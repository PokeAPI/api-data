  "effect_entries": [
    {
      "effect": "Ce Pokémon ne peut pas être empoisonné.  Cela inclut le poison grave.\n\nSi un Pokémon est empoisonné et acquiert ce talent, le poison est soigné; également lorsqu'il regagne un talent perdu en quittant le combat.",
      "short_effect": "Empêche le poison.",
      "language": {
        "name": "fr",
        "url": "/api/v2/language/5/"
      }
    },
    {
      "effect": "Ein Pokémon mit dieser Fähigkeit kann nicht vergiftet werden. Das schließt schwere Vergiftung mit ein.\n\nWenn ein vergiftetes Pokémon diese Fähigkeit erhält, wird es von der Vergiftung geheilt. Das bezieht das Wiedererlangen dieser Fähigkeit nach dem Kampf mit ein.",
      "short_effect": "Verhindert Vergiftung.",
      "language": {
        "name": "de",
        "url": "/api/v2/language/6/"
      }
    },
    {
      "effect": "This Pokémon cannot be poisoned.  This includes bad poison.\n\nIf a Pokémon is poisoned and acquires this ability, its poison is healed; this includes when regaining a lost ability upon leaving battle.",
      "short_effect": "Prevents poison.",
      "language": {
        "name": "en",
        "url": "/api/v2/language/9/"
      }
    }
  ],
