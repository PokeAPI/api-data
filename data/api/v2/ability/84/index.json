  "effect_entries": [
    {
      "effect": "Quand ce Pokémon utilise ou perd son objet tenu, sa Vitesse est doublée.  S’il gagne un autre objet ou quitte le combat, ce bonus est perdu.\n\nCeci inclut quand le Pokémon fait tomber son objet à cause de Sabotage.  Ce bonus ne compte pas comme une modification de stat.  Il n’y a pas de notification quand ce talent s’active.",
      "short_effect": "Double la Vitesse en utilisant ou perdant un objet tenu.",
      "language": {
        "name": "fr",
        "url": "/api/v2/language/5/"
      }
    },
    {
      "effect": "Wenn ein Pokémon mit dieser Fähigkeit ein getragenes Item benutzt oder verliert, wird seine Initiative verdoppelt. Wenn es ein neues Item erhält oder den Kampf verlässt, erlischt der Bonus.\n\nDas passiert auch, wenn das Item durch Abschlag fallengelassen wird. Der Bonus zählt nicht als Statuswert-Änderung. Es gibt keine Benachrichtigung wenn der Effekt eintritt.",
      "short_effect": "Verdoppelt die Initiative wenn das Pokémon ein getragenes Item benutzt oder verliert.",
      "language": {
        "name": "de",
        "url": "/api/v2/language/6/"
      }
    },
    {
      "effect": "When this Pokémon uses or loses its held item, its Speed is doubled.  If it gains another item or leaves battle, this bonus is lost.\n\nThis includes when the Pokémon drops its item because of Knock Off.  This bonus does not count as a stat modifier.  There is no notification when this ability takes effect.",
      "short_effect": "Doubles Speed upon using or losing a held item.",
      "language": {
        "name": "en",
        "url": "/api/v2/language/9/"
      }
    }
  ],
