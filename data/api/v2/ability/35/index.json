  "effect_entries": [
    {
      "effect": "Monde extérieur: Si le Pokémon de tête a ce talent, le taux de rencontre sauvage est doublé.\n\nCe talent n'a pas d'effet au combat.",
      "short_effect": "Double le taux de rencontre sauvage.",
      "language": {
        "name": "fr",
        "url": "/api/v2/language/5/"
      }
    },
    {
      "effect": "Außerhalb vom Kampf: Wenn ein Pokémon mit dieser Fähigkeit an erster Stelle im Team steht, ist die Wahrscheinlichkeit einem wilden Pokémon zu begegnen doppelt so hoch wie normal.\n\nDiese Fähigkeit hat im Kampf keinen Effekt.",
      "short_effect": "Verdoppelt die Wahrscheinlichkeit, einem wilden Pokémon zu begegnen.",
      "language": {
        "name": "de",
        "url": "/api/v2/language/6/"
      }
    },
    {
      "effect": "Overworld: If the lead Pokémon has this ability, the wild encounter rate is doubled.\n\nThis ability has no effect in battle.",
      "short_effect": "Doubles the wild encounter rate.",
      "language": {
        "name": "en",
        "url": "/api/v2/language/9/"
      }
    }
  ],
