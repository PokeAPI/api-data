  "effect_entries": [
    {
      "effect": "Quand ce Pokémon entre au combat, son Attaque ou Attaque Spéciale, celle qui correspond à la plus faible stat défensive totale des adversaires, augmente d’un niveau.  En cas d’égalité, l’Attaque spéciale est augmentée.\n\nCe talent s’active aussi quand acquis au combat.",
      "short_effect": "Augmente la stat d'attaque correspondant à la défense la plus faible de l'adversaire d'un niveau en entrant au combat.",
      "language": {
        "name": "fr",
        "url": "/api/v2/language/5/"
      }
    },
    {
      "effect": "Wenn ein Pokémon mit dieser Fähigkeit den Kampf betritt, wird sein Angriff oder Spezialangriff um 1 Stufe erhöht, je nachdem, welcher Verteidigungswert des Gegners niedriger ist. Bei Gleichstand wird der Spezialangriff erhöht.\n\nDie Fähigkeit löst auch aus, wenn sie während des Kampfes erlangt wird.",
      "short_effect": "Erhöht den Angriffswert entsprechend des schwächeren Verteidigungswerts um 1 Stufe beim Betreten des Kampfs.",
      "language": {
        "name": "de",
        "url": "/api/v2/language/6/"
      }
    },
    {
      "effect": "When this Pokémon enters battle, its Attack or Special Attack, whichever corresponds to its opponents' weaker total defensive stat, rises one stage.  In the event of a tie, Special Attack is raised.\n\nThis ability also takes effect when acquired during a battle.",
      "short_effect": "Raises the attack stat corresponding to the opponents' weaker defense one stage upon entering battle.",
      "language": {
        "name": "en",
        "url": "/api/v2/language/9/"
      }
    }
  ],
