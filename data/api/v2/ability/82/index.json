  "effect_entries": [
    {
      "effect": "Ce Pokémon mange n'importe quelle Baie déclenchée par des PV bas quand il tombe sous 50% de ses PV, peu importe le seuil habituel de la Baie.",
      "short_effect": "Fait manger au Pokémon n'importe quelle Baie tenue déclenchée par des PV bas sous la moitié de ses PV max.",
      "language": {
        "name": "fr",
        "url": "/api/v2/language/5/"
      }
    },
    {
      "effect": "Pokémon mit dieser Fähigkeit essen eine getragene Beere, wenn sie weniger als die Hälfte ihrer maximalen KP haben, unabhängig von der Auslöseschwelle der Beere.",
      "short_effect": "Lässt das Pokémon eine getragene Beere essen, wenn es weniger als die Hälfte seiner maximalen KP hat.",
      "language": {
        "name": "de",
        "url": "/api/v2/language/6/"
      }
    },
    {
      "effect": "This Pokémon eats any held Berry triggered by low HP when it falls below 50% of its HP, regardless of the Berry's usual threshold.",
      "short_effect": "Makes the Pokémon eat any held Berry triggered by low HP below 1/2 its max HP.",
      "language": {
        "name": "en",
        "url": "/api/v2/language/9/"
      }
    }
