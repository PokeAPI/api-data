  "effect_entries": [
    {
      "effect": "Ce Pokémon a 1.5× son Attaque Spéciale si n'importe quel Pokémon allié a Plus ou Moins.\n\nCe bonus ne compte pas comme une modification de stat.  Si l'un des talents est désactivé par Suc Digestif, les deux perdent leur effet.",
      "short_effect": "Augmente l'Attaque Spéciale d'1.5× quand un Pokémon allié a Plus ou Moins.",
      "language": {
        "name": "fr",
        "url": "/api/v2/language/5/"
      }
    },
    {
      "effect": "Pokémon mit dieser Fähigkeit haben einen 1,5× so hohen Spezialangriff wenn ein Team-Pokémon die Fähigkeit Plus oder Minus hat.\n\nDer Bonus zählt nicht als Statusveränderung. Wenn eine der Fähigkeiten deaktiviert wird, z.B. von Magensäfte, verlieren beide ihren Effekt.",
      "short_effect": "Erhöht den Spezialangriff um 50% wenn ein Team-Pokémon Plus oder Minus hat.",
      "language": {
        "name": "de",
        "url": "/api/v2/language/6/"
      }
    },
    {
      "effect": "This Pokémon has 1.5× its Special Attack if any friendly Pokémon has Plus or Minus.\n\nThis bonus does not count as a stat modifier.  If either ability is disabled by Gastro Acid, both lose their effect.",
      "short_effect": "Increases Special Attack to 1.5× when a friendly Pokémon has Plus or Minus.",
      "language": {
        "name": "en",
        "url": "/api/v2/language/9/"
      }
    }
  ],
