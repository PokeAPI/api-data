  "effect_entries": [
    {
      "effect": "Après chaque tour, une des stats au hasard de ce Pokémon augmente de deux niveaux, et une autre chute d’un niveau.\n\nSi une stat est déjà aux niveaux 6 ou -6, elle ne sera pas choisie pour être augmentée ou diminuée, respectivement.",
      "short_effect": "Augmente une stat aléatoire de deux niveaux et baisse une autre d'un niveau après chaque tour.",
      "language": {
        "name": "fr",
        "url": "/api/v2/language/5/"
      }
    },
    {
      "effect": " Nach jeder Runde erhöht sich ein zufälliger Statuswert von Pokémon mit dieser Fähigkeit um 2 Stufen und ein anderer wird um 1 Stufe gesenkt.\n\nWenn ein Statuswert bereits -6 oder +6 Stufen erreicht hat, wird er nicht zufällig ausgewählt.",
      "short_effect": "Erhöht einen zufälligen Statuswert um 2 Stufen und senkt einen anderen um 1 Stufe nach jeder Runde.",
      "language": {
        "name": "de",
        "url": "/api/v2/language/6/"
      }
    },
    {
      "effect": "After each turn, one of this Pokémon's stats at random rises two stages, and another falls one stage.\n\nIf a stat is already at 6 or -6 stages, it will not be chosen to be increased or decreased, respectively.",
      "short_effect": "Raises a random stat two stages and lowers another one stage after each turn.",
      "language": {
        "name": "en",
        "url": "/api/v2/language/9/"
      }
    }
  ],
