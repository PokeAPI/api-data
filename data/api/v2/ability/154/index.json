  "effect_entries": [
    {
      "effect": "Quand une capacité de type Ténèbres frappe ce Pokémon, son Attaque augmente d’un niveau.\n\nLa capacité n’est en aucun cas annulée.",
      "short_effect": "Augmente l'Attaque d'un niveau en subissant des dégâts d'une capacité Ténèbres.",
      "language": {
        "name": "fr",
        "url": "/api/v2/language/5/"
      }
    },
    {
      "effect": "Wenn ein Pokémon mit dieser Fähigkeit von einer Unlicht Attacke getroffen wird, wird sein Angriff um 1 Stufe erhöht.\n\nDie Attacke wird nicht beeinflusst.",
      "short_effect": "Erhöht den Angriff um 1 Stufe, wenn es von Unlicht Attacken getroffen wird.",
      "language": {
        "name": "de",
        "url": "/api/v2/language/6/"
      }
    },
    {
      "effect": "Whenever a Dark-type move hits this Pokémon, its Attack rises one stage.\n\nThe move is not negated in any way.",
      "short_effect": "Raises Attack one stage upon taking damage from a Dark move.",
      "language": {
        "name": "en",
        "url": "/api/v2/language/9/"
      }
    }
  ],
