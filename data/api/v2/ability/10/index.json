  "effect_entries": [
    {
      "effect": "Lorsqu'une capacité de type Électrik touche ce Pokémon, elle lui soigne 1/4 de ses PV max, annulant tous les autres effets.\n\nCe talent ne s'activera pas si ce Pokémon est de type Sol et est ainsi immunisé aux capacités Électrik.  Les capacités Électrik ignorent le Clonage de ce Pokémon.\n\nCet effet inclut les capacités non-offensives, i.e. Cage Éclair.",
      "short_effect": "Absorbe les capacités Électrik, soignant 1/4 des PV max.",
      "language": {
        "name": "fr",
        "url": "/api/v2/language/5/"
      }
    },
    {
      "effect": "Wenn ein Pokémon mit dieser Fähigkeit von einer Elektro Attacke getroffen wird, wird es um 1/4 seiner maximalen KP geheilt. Jeder andere Effekt der Attacke wird ignoriert.\n\nDie Fähigkeit wirkt nicht, wenn das Pokémon vom Typ Boden ist. Elektro Attacken ignorieren den Delegator dieses Pokémons.\n\nDer Effekt gilt auch für Attacken die keinen Schaden verursachen, wie z.B. Donnerwelle.",
      "short_effect": "Absorbiert Elektro Attacken und heilt 1/4 der max KP.",
      "language": {
        "name": "de",
        "url": "/api/v2/language/6/"
      }
    },
    {
      "effect": "Whenever an Electric-type move hits this Pokémon, it heals for 1/4 of its maximum HP, negating any other effect on it.\n\nThis ability will not take effect if this Pokémon is Ground-type and thus immune to Electric moves.  Electric moves will ignore this Pokémon's Substitute.\n\nThis effect includes non-damaging moves, i.e. Thunder Wave.",
      "short_effect": "Absorbs Electric moves, healing for 1/4 max HP.",
      "language": {
        "name": "en",
        "url": "/api/v2/language/9/"
      }
    }
  ],
  "effect_changes": [
    {
      "version_group": {
        "name": "diamond-pearl",
        "url": "/api/v2/version-group/8/"
      },
      "effect_entries": [
        {
          "effect": "N'absorbe pas les capacités Électrik non-offensives, i.e. Cage Éclair.",
          "language": {
            "name": "fr",
            "url": "/api/v2/language/5/"
          }
        },
        {
          "effect": "Elektro-Attacken die keinen Schaden anrichten, wie Donnerwelle, werden nicht absorbiert.",
          "language": {
            "name": "de",
            "url": "/api/v2/language/6/"
          }
        },
        {
          "effect": "Does not absorb non-damaging Electric moves, i.e. Thunder Wave.",
          "language": {
            "name": "en",
            "url": "/api/v2/language/9/"
          }
        }
      ]
    }
  ],
