  "effect_entries": [
    {
      "effect": "Ce Pokémon ne peut pas être retiré de force du combat par des capacités telles que Cyclone.\n\nDraco-Queue et Projection infligent toujours des dégâts contre ce Pokémon.\n\nMonde extérieur: Si le Pokémon de tête a ce talent, le taux de succès en pêchant est augmenté.",
      "short_effect": "Empêche d'être retiré du combat par les capacités d'autres Pokémon.",
      "language": {
        "name": "fr",
        "url": "/api/v2/language/5/"
      }
    },
    {
      "effect": "Ein Pokémon mit dieser Fähigkeit kann nicht mit Attacken wie Wirbelwind ausgetauscht werden.\n\nDrachenrute und Überkopfwurf verursachen trotzdem Schaden.\n\nAußerhalb vom Kampf: Wenn ein Pokémon mit dieser Fähigkeit an erster Stelle im Team steht, erhöht sich die Erfolgsrate beim Angeln.",
      "short_effect": "Verhindert den Austausch von Pokémon durch Attacken.",
      "language": {
        "name": "de",
        "url": "/api/v2/language/6/"
      }
    },
    {
      "effect": "This Pokémon cannot be forced out of battle by moves such as Whirlwind.\n\nDragon Tail and Circle Throw still inflict damage against this Pokémon.\n\nOverworld: If the lead Pokémon has this ability, the success rate while fishing is increased.",
      "short_effect": "Prevents being forced out of battle by other Pokémon's moves.",
      "language": {
        "name": "en",
        "url": "/api/v2/language/9/"
      }
    }
  ],
