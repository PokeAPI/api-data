  "effect_entries": [
    {
      "effect": "Quand ce Pokémon a une altération majeure de statut, il a 1.5× sa Vitesse.  Ce Pokémon n'est pas affecté par la baisse de Vitesse habituelle de la paralysie.\n\nMonde extérieur: Si le Pokémon de tête a ce talent, le taux de rencontre sauvage est divisé par deux.",
      "short_effect": "Augmente la Vitesse de 1.5× avec une altération majeure de statut.",
      "language": {
        "name": "fr",
        "url": "/api/v2/language/5/"
      }
    },
    {
      "effect": "Wenn ein Pokémon mit dieser Fähigkeit unter einer Primäre Statusveränderungen leidet, hat es 1,5× so viel Initiative wie sonst. Die Initiative des Pokémon wird nicht halbiert, wenn es paralysiert ist.\n\nAußerhalb vom Kampf: Wenn ein Pokémon mit dieser Fähigkeit an erster Stelle im Team steht, tauchen wilde Pokémon nur halb so oft auf.",
      "short_effect": "Erhöht die Initiative um 50% wenn das Pokémon an einer Primäre Statusveränderungen leidet.",
      "language": {
        "name": "de",
        "url": "/api/v2/language/6/"
      }
    },
    {
      "effect": "Whenever this Pokémon has a major status ailment, it has 1.5× its Speed.  This Pokémon is not affected by the usual Speed cut from paralysis.\n\nOverworld: If the lead Pokémon has this ability, the wild encounter rate is halved.",
      "short_effect": "Increases Speed to 1.5× with a major status ailment.",
      "language": {
        "name": "en",
        "url": "/api/v2/language/9/"
      }
    }
  ],
