  "effect_entries": [
    {
      "effect": "Si ce Pokémon subit une baisse de stat, son Attaque Spéciale augmente de deux niveaux.\n\nCet effet se déclenche à chaque baisse de stat, quelque soit son importance.",
      "short_effect": "Augmente l'Attaque Spéciale de deux niveaux quand n'importe quelle stat est diminuée.",
      "language": {
        "name": "fr",
        "url": "/api/v2/language/5/"
      }
    },
    {
      "effect": "Wenn ein Statuswert eines Pokémon mit dieser Fähigkeit gesenkt wird, wird sein Spezialangriff um 2 Stufen erhöht.\n\nWenn mehrere Statuswerte gesenkt löst die Fähigkeit für jeden Statuswert aus.",
      "short_effect": "Erhöht den Spezialangriff um 2 Stufen wenn ein Statuswert gesenkt wird.",
      "language": {
        "name": "de",
        "url": "/api/v2/language/6/"
      }
    },
    {
      "effect": "Raises Special Attack by two stages upon having any stat lowered.",
