  "effect_entries": [
    {
      "effect": "Le compteur de tours restants en sommeil de ce Pokémon chute de 2 plutôt qu'1.\n\nSi le compteur de sommeir de ce Pokémon est à 1, il tombera à 0 et le Pokémon se réveillera.",
      "short_effect": "Fait passer le sommeil deux fois plus rapidement.",
      "language": {
        "name": "fr",
        "url": "/api/v2/language/5/"
      }
    },
    {
      "effect": "Bei Pokémon mit dieser Fähigkeit sinkt die Anzahl der Verbleibenden Runden im Schlaf pro Runde um 2 statt um 1.\n\nWenn der Zähler bei 1 ist fällt er auf 0 und das Pokémon wacht auf.",
      "short_effect": "Pokémon wachen doppelt so schnell wieder auf.",
      "language": {
        "name": "de",
        "url": "/api/v2/language/6/"
      }
    },
    {
      "effect": "This Pokémon's remaining sleep turn count falls by 2 rather than 1.\n\nIf this Pokémon's sleep counter is at 1, it will fall to 0 and then the Pokémon will wake up.",
      "short_effect": "Makes sleep pass twice as quickly.",
      "language": {
        "name": "en",
        "url": "/api/v2/language/9/"
      }
    }
  ],
