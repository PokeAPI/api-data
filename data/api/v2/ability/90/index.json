  "effect_entries": [
    {
      "effect": "Si ce Pokémon est empoisonné, il sera soigné d'1/8 de ses PV maximum après chaque tour plutôt que de subir des dégâts.  Cela inclut le poison grave.",
      "short_effect": "Soigne 1/8 des PV max après chaque tour quand empoisonné à la place de recevoir des dégâts.",
      "language": {
        "name": "fr",
        "url": "/api/v2/language/5/"
      }
    },
    {
      "effect": "Wenn ein Pokémon mit dieser Fähigkeit vergiftet ist, erhält es anstatt Schaden zu erleiden 1/8 seiner maximalen KP nach jeder Runde. Das gilt auch für schwere Vergiftung.",
      "short_effect": "Heilt jede Runde 1/8 der max KP wenn vergiftet.",
      "language": {
        "name": "de",
        "url": "/api/v2/language/6/"
      }
    },
    {
      "effect": "If this Pokémon is poisoned, it will heal for 1/8 of its maximum HP after each turn rather than taking damage.  This includes bad poison.",
      "short_effect": "Heals for 1/8 max HP after each turn when poisoned in place of damage.",
      "language": {
        "name": "en",
        "url": "/api/v2/language/9/"
      }
    }
  ],
