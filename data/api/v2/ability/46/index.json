            "url": "/api/v2/language/5/"
          }
        },
        {
          "effect": "Betrifft keine Attacken von Teammitgliedern die alle anderen Pokémon als Ziel haben. Diese Fähigkeit wird im Kampf nicht angekündigt.",
          "language": {
