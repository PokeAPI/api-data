  "effect_entries": [
    {
      "effect": "Quand ce Pokémon entre au combat, il révèle un objet tenu d’un Pokémon opposé à tous les dresseurs participants.\n\nDans un combat double, si un adversaire a un objet, ce Pokémon Fouillera ce Pokémon; si les deux ont un objet, il en Fouillera un au hasard.",
      "short_effect": "Révèle un objet tenu de l'adversaire en entrant au combat.",
      "language": {
        "name": "fr",
        "url": "/api/v2/language/5/"
      }
    },
    {
      "effect": "Wenn ein Pokémon mit dieser Fähigkeit den Kampf betritt, wird allen Trainern mitgeteilt, welches Item der Gegner hält.\n\nWenn bei Mehrfachkämpfen ein Gegner ein Item hält, wird dieses angezeigt, wenn mehr ein Item halten wird ein zufälliges angekündigt.",
      "short_effect": "Enthüllt bei Kampfantritt das getragene Item des Gegners.",
      "language": {
        "name": "de",
        "url": "/api/v2/language/6/"
      }
    },
    {
      "effect": "When this Pokémon enters battle, it reveals an opposing Pokémon's held item to all participating trainers.\n\nIn a double battle, if one opponent has an item, this Pokémon will Frisk that Pokémon; if both have an item, it will Frisk one at random.",
      "short_effect": "Reveals an opponent's held item upon entering battle.",
      "language": {
        "name": "en",
        "url": "/api/v2/language/9/"
      }
    }
  ],
