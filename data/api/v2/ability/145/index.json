  "effect_entries": [
    {
      "effect": "La Défense de ce Pokémon ne peut pas être baissée par un autre Pokémon.\n\nCe Pokémon peut toujours recevoir des modifications négatives de Défense via Permucœur ou Permugarde.",
      "short_effect": "Protège contre les baisses de Défense.",
      "language": {
        "name": "fr",
        "url": "/api/v2/language/5/"
      }
    },
    {
      "effect": "Die Verteidigung von Pokémon mit dieser Fähigkeit kann nicht von anderen Pokémon gesenkt werden.\n\nDas Pokémon kann nagative Verteidigung durch Statustausch oder Schutztausch erhalten.",
      "short_effect": "Schützt vor dem Absenken der Verteidigung.",
      "language": {
        "name": "de",
        "url": "/api/v2/language/6/"
      }
    },
    {
      "effect": "This Pokémon's Defense cannot be lowered by other Pokémon.\n\nThis Pokémon can still be passed negative Defense modifiers through Heart Swap or Guard Swap.",
      "short_effect": "Protects against Defense drops.",
      "language": {
        "name": "en",
        "url": "/api/v2/language/9/"
      }
    }
  ],
