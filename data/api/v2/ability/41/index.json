  "effect_entries": [
    {
      "effect": "Ce Pokémon ne peut pas être brûlé.\n\nSi un Pokémon est brûlé et acquiert ce talent, sa brûlure est soignée; ceci inclut la récupération de talent perdu en quittant le combat.",
      "short_effect": "Empêche la brûlure.",
      "language": {
        "name": "fr",
        "url": "/api/v2/language/5/"
      }
    },
    {
      "effect": "Ein Pokémon mit dieser Fähigkeit kann keine Verbrennung erleiden.\n\nWenn ein Pokémon mit Verbrennung diese Fähigkeit erhält, wird es von der Verbrennung geheilt. Das bezieht das Wiedererlangen dieser Fähigkeit nach dem Kampf mit ein.",
      "short_effect": "Verhindert Verbrennung.",
      "language": {
        "name": "de",
        "url": "/api/v2/language/6/"
      }
    },
    {
      "effect": "This Pokémon cannot be burned.\n\nIf a Pokémon is burned and acquires this ability, its burn is healed; this includes when regaining a lost ability upon leaving battle.",
      "short_effect": "Prevents burns.",
      "language": {
        "name": "en",
        "url": "/api/v2/language/9/"
      }
    }
  ],
