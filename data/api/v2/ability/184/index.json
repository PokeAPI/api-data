  "effect_entries": [
    {
      "effect": "Change les capacités de type Normal du porteur en capacités de type Vol.  Les capacités changées par ce talent ont 1.3× leur puissance.",
      "short_effect": "Change les capacités Normal du porteur en capacités Vol et les renforce d’1.3× leur puissance.",
      "language": {
        "name": "fr",
        "url": "/api/v2/language/5/"
      }
    },
    {
      "effect": "Die Normal Attacken von Pokémon mit dieser Fäigkeit werden zu Flug Attacken. Attacken die durch diese Fähigkeit beeinflusst werden, haben 1,3× so viel Basisstärke wie sonst.",
      "short_effect": "Ändert die Normal Attacken des Anwenders in Flug Attacken und verstärkt sie um 30%.",
      "language": {
        "name": "de",
        "url": "/api/v2/language/6/"
      }
    },
    {
      "effect": "Turns the bearer's Normal-type moves into Flying-type moves.  Moves changed by this ability have 1.3× their power.",
