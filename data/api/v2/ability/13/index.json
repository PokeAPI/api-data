  "effect_entries": [
    {
      "effect": "Quand ce Pokémon est au combat, la météo reste en jeu, mais n'a aucun de ses effets.\n\nCe talent fonctionne de la même manière que Air Lock.",
      "short_effect": "Annule tous les effets de la météo, mais n'empêche pas la météo elle-même.",
      "language": {
        "name": "fr",
        "url": "/api/v2/language/5/"
      }
    },
    {
      "effect": "Während ein Pokémon mit dieser Fähigkeit im Kampf ist, kann das Wetter zwar geändert werden, hat aber keinen Effekt.\n\nDiese Fähigkeit ist identisch mit Klimaschutz.",
      "short_effect": "Entfernt alle Wettereffekte aber ändert nicht das Wetter selbst.",
      "language": {
        "name": "de",
        "url": "/api/v2/language/6/"
      }
    },
    {
      "effect": "While this Pokémon is in battle, weather can still be in play, but will not have any of its effects.\n\nThis ability functions identically to Air Lock.",
      "short_effect": "Negates all effects of weather, but does not prevent the weather itself.",
      "language": {
        "name": "en",
        "url": "/api/v2/language/9/"
      }
    }
  ],
