  "effect_entries": [
    {
      "effect": "Si un Pokémon allié consomme son objet tenu, comme une Baie, alors ce Pokémon lui donnera l'objet que lui-même tient. ",
      "short_effect": "Transmet l’objet tenu du porteur à un allié quand l’allié utilise son objet.",
      "language": {
        "name": "fr",
        "url": "/api/v2/language/5/"
      }
    },
    {
      "effect": "Gibt das eigene getragene Item an einen Teampartner weiter, wenn dieser sein Item benutzt hat.\n\nDas gilt auch, wenn der Partner das Item mit Schleuder verbraucht hat, wenn er eine gegnerische Beere mit Pflücker gegessen hat und kein Item trägt oder sein Luftballon platzt. Wenn mehrere Teampartner ihre Items in der gleichen Runde verbrauchen, erhält derjenige mit der höheren Initiative das Item ohne dabei Bizarroraum zu beachten.\n\nDie Fähigkeit löst nicht aus, wenn das Item nur bewegt wird, beispielsweise durch Raub, Zauberer oder Klettdorn, wenn es durch Einäschern zerstört oder fallengelassen wird.",
      "short_effect": "Gibt das eigene Item an einen Verbündeten weiter, wenn dieser seins benutzt hat.",
      "language": {
        "name": "de",
        "url": "/api/v2/language/6/"
      }
    },
    {
      "effect": "Passes the bearer's held item to an ally when the ally uses up its item.",
      "short_effect": "Passes the bearer's held item to an ally when the ally uses up its item.",
      "language": {
        "name": "en",
        "url": "/api/v2/language/9/"
      }
    }
  ],
