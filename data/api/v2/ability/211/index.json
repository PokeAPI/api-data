        "url": "/api/v2/language/6/"
      },
      "version_group": {
        "name": "sun-moon",
        "url": "/api/v2/version-group/17/"
      }
    },
    {
      "flavor_text": "Cuando sus PS se ven reducidos a la mitad, las\ncélulas se reagrupan y adopta su Forma Completa.",
