  "flavor_text_entries": [
    {
      "flavor_text": "When this Pokémon whips the winglike fur on its\nback as though beating its wings, it sends an\nintimidating aura flying at its opponents.",
      "language": {
        "name": "en",
        "url": "/api/v2/language/9/"
      },
      "version": {
        "name": "sun",
        "url": "/api/v2/version/27/"
      }
    },
    {
      "flavor_text": "As the energy of Mega Evolution fills it, its\nfur bristles. What you see on its back are not\ntrue wings, and this Pokémon isn’t able to fly.",
      "language": {
        "name": "en",
        "url": "/api/v2/language/9/"
      },
      "version": {
        "name": "moon",
        "url": "/api/v2/version/28/"
      }
    },
    {
      "flavor_text": "Normally, it dislikes fighting, so it really\nhates changing to this form for battles.",
      "language": {
