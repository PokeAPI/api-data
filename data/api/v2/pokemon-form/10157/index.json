        "url": "/api/v2/language/9/"
      },
      "version": {
        "name": "ultra-sun",
        "url": "/api/v2/version/29/"
      }
    },
    {
      "flavor_text": "It converts the energy from Mega Evolution into\nan intimidating aura. Fainthearted people expire\nfrom shock at the sight of it.",
