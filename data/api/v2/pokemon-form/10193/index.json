  "flavor_text_entries": [
    {
      "flavor_text": "With its incisors, it gnaws through doors and\ninfiltrates people’s homes. Then, with a twitch\nof its whiskers, it steals whatever food it\nfinds.",
      "language": {
        "name": "en",
        "url": "/api/v2/language/9/"
      },
      "version": {
        "name": "sun",
        "url": "/api/v2/version/27/"
      }
    },
    {
      "flavor_text": "When the sun goes down, it becomes active. It\nruns around town on a chase for good food for\nthe boss of its nest—Raticate.",
      "language": {
        "name": "en",
        "url": "/api/v2/language/9/"
      },
      "version": {
        "name": "moon",
        "url": "/api/v2/version/28/"
      }
    },
    {
      "flavor_text": "It shows no interest in anything that isn’t\nfresh. If you take it shopping with you, it will\nhelp you pick out ingredients.",
      "language": {
        "name": "en",
        "url": "/api/v2/language/9/"
      },
      "version": {
        "name": "ultra-sun",
        "url": "/api/v2/version/29/"
      }
    },
    {
      "flavor_text": "Night after night, they sneak into people’s\nhomes seeking food. A massive outbreak of them\nhas become an issue of public concern.",
      "language": {
        "name": "en",
        "url": "/api/v2/language/9/"
      },
      "version": {
        "name": "ultra-moon",
        "url": "/api/v2/version/30/"
      }
    },
    {
      "flavor_text": "Its whiskers provide it with a keen sense of\nsmell, enabling it to pick up the scent of\nhidden food and locate it instantly.",
      "language": {
        "name": "en",
        "url": "/api/v2/language/9/"
      },
      "version": {
        "name": "lets-go-pikachu",
        "url": "/api/v2/version/31/"
      }
    },
