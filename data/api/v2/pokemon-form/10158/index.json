  "flavor_text_entries": [
    {
      "flavor_text": "Excess energy melted its arms and wings,\ntransforming them into giant scythes.",
      "language": {
        "name": "en",
        "url": "/api/v2/language/9/"
      },
      "version": {
        "name": "sun",
        "url": "/api/v2/version/27/"
      }
    },
    {
      "flavor_text": "Its vaunted wings become scythes, sending it mad\nwith rage. It swings its scythes wildly and\nslices the ground to pieces.",
      "language": {
        "name": "en",
        "url": "/api/v2/language/9/"
      },
      "version": {
        "name": "moon",
        "url": "/api/v2/version/28/"
      }
    },
    {
      "flavor_text": "Its arms and wings melted into something like\nscythes. Mad with rage, it rampages on and on.",
      "language": {
        "name": "en",
        "url": "/api/v2/language/9/"
      },
      "version": {
        "name": "ultra-sun",
        "url": "/api/v2/version/29/"
      }
    },
    {
      "flavor_text": "Its disposition is more vicious than before its\nMega Evolution. Garchomp carves its opponents up\nwith the scythes on both arms.",
      "language": {
        "name": "en",
        "url": "/api/v2/language/9/"
      },
      "version": {
        "name": "ultra-moon",
