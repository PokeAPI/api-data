  "flavor_text_entries": [
    {
      "flavor_text": "The excess energy from Mega Evolution spilled\nover from its mouth, breaking its jaw. It spews\nendless blizzards.",
      "language": {
        "name": "en",
        "url": "/api/v2/language/9/"
      },
      "version": {
        "name": "sun",
        "url": "/api/v2/version/27/"
      }
    },
    {
      "flavor_text": "It envelops prey in its mouth, freezing them\ninstantly. But its jaw is dislocated, so it’s\nunable to eat them.",
      "language": {
        "name": "en",
        "url": "/api/v2/language/9/"
      },
      "version": {
        "name": "moon",
        "url": "/api/v2/version/28/"
      }
    },
    {
      "flavor_text": "When it spews stupendously cold air from its\nbroken mouth, the entire area around it gets\nwhited out.",
      "language": {
        "name": "en",
        "url": "/api/v2/language/9/"
      },
      "version": {
        "name": "ultra-sun",
        "url": "/api/v2/version/29/"
      }
    },
    {
      "flavor_text": "The power of Mega Evolution was so strong that\nit smashed Glalie’s jaw. Its inability to eat\nvery well leaves Glalie irritated.",
      "language": {
        "name": "en",
        "url": "/api/v2/language/9/"
      },
      "version": {
        "name": "ultra-moon",
        "url": "/api/v2/version/30/"
      }
    }
  ]
