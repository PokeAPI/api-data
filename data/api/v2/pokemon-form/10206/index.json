  "flavor_text_entries": [
    {
      "flavor_text": "It creates drops of ice in its coat and showers\nthem over its enemies. Anyone who angers it will\nbe frozen stiff in an instant.",
      "language": {
        "name": "en",
        "url": "/api/v2/language/9/"
      },
      "version": {
        "name": "sun",
        "url": "/api/v2/version/27/"
      }
    },
    {
      "flavor_text": "Possessing a calm demeanor, this Pokémon was\nrevered as a deity incarnate before it was\nidentified as a regional variant of Ninetales.",
      "language": {
        "name": "en",
        "url": "/api/v2/language/9/"
      },
      "version": {
        "name": "moon",
        "url": "/api/v2/version/28/"
      }
    },
    {
      "flavor_text": "The reason it guides people all the way down to\nthe mountain’s base is that it wants them to\nhurry up and leave.",
      "language": {
        "name": "en",
        "url": "/api/v2/language/9/"
      },
      "version": {
        "name": "ultra-sun",
        "url": "/api/v2/version/29/"
      }
    },
    {
      "flavor_text": "Some said that deities visited mountains where\nNinetales live, so in times long past, no one\nwas allowed to go into those mountains.",
      "language": {
        "name": "en",
        "url": "/api/v2/language/9/"
      },
      "version": {
        "name": "ultra-moon",
        "url": "/api/v2/version/30/"
      }
    },
    {
      "flavor_text": "It lives on mountains perpetually covered in\nsnow and is revered as a deity incarnate. It\nappears draped in a blizzard.",
      "language": {
        "name": "en",
        "url": "/api/v2/language/9/"
      },
      "version": {
        "name": "lets-go-pikachu",
        "url": "/api/v2/version/31/"
      }
    },
