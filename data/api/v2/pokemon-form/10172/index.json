  "flavor_text_entries": [
    {
      "flavor_text": "The spines sprouting from its head are\ntransformed fangs. If they’re injured or broken\noff, the spines will regenerate countless times.",
      "language": {
        "name": "en",
        "url": "/api/v2/language/9/"
      },
      "version": {
        "name": "sun",
        "url": "/api/v2/version/27/"
      }
    },
    {
      "flavor_text": "As a consequence of Mega Evolution, its\ncombative instincts exploded. The yellow marks\nit bears are scars from a long history of\nbattles.",
      "language": {
        "name": "en",
        "url": "/api/v2/language/9/"
      },
      "version": {
        "name": "moon",
        "url": "/api/v2/version/28/"
      }
    },
    {
      "flavor_text": "The yellow patterns it bears are old scars. The\nenergy from Mega Evolution runs through them,\ncausing it sharp pain and suffering.",
      "language": {
        "name": "en",
        "url": "/api/v2/language/9/"
      },
      "version": {
        "name": "ultra-sun",
        "url": "/api/v2/version/29/"
      }
    },
    {
      "flavor_text": "The moment it charges into its opponent, sharp\nspikes pop out of Sharpedo’s head, leaving its\nopponent with deep wounds.",
      "language": {
        "name": "en",
        "url": "/api/v2/language/9/"
      },
      "version": {
        "name": "ultra-moon",
        "url": "/api/v2/version/30/"
      }
    }
  ]
