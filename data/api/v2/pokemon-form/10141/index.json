  "flavor_text_entries": [
    {
      "flavor_text": "Mega Evolution also affects its brain, leaving\nno other function except its destructive\ninstinct to burn everything to cinders.",
      "language": {
        "name": "en",
        "url": "/api/v2/language/9/"
      },
      "version": {
        "name": "sun",
        "url": "/api/v2/version/27/"
      }
    },
    {
      "flavor_text": "It jets water from the orifices on its sides,\nstreaking above the water surface at supersonic\nspeed.",
      "language": {
        "name": "en",
        "url": "/api/v2/language/9/"
      },
      "version": {
        "name": "moon",
        "url": "/api/v2/version/28/"
      }
    },
    {
      "flavor_text": "Mega Evolution places a burden on its body. The\nstress causes it to become all the more\nferocious.",
      "language": {
        "name": "en",
        "url": "/api/v2/language/9/"
      },
      "version": {
        "name": "ultra-sun",
        "url": "/api/v2/version/29/"
      }
    },
    {
      "flavor_text": "It zooms out of the water at Mach speeds. Even\nlarge ships caught in its path are split cleanly\nin two!",
      "language": {
        "name": "en",
        "url": "/api/v2/language/9/"
      },
      "version": {
        "name": "ultra-moon",
        "url": "/api/v2/version/30/"
      }
    },
    {
      "flavor_text": "Although it obeys its instinctive drive to\ndestroy everything within its reach, it will\nrespond to orders from a Trainer it truly\ntrusts.",
      "language": {
        "name": "en",
        "url": "/api/v2/language/9/"
      },
      "version": {
        "name": "lets-go-pikachu",
        "url": "/api/v2/version/31/"
      }
    },
    {
      "flavor_text": "Although it obeys its instinctive drive to\ndestroy everything within its reach, it will\nrespond to orders from a Trainer it truly\ntrusts.",
