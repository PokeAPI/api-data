  "flavor_text_entries": [
    {
      "flavor_text": "The garbage it eats causes continuous chemical\nchanges in its body, which produce its\nexceedingly vivid coloration.",
      "language": {
        "name": "en",
        "url": "/api/v2/language/9/"
      },
      "version": {
        "name": "sun",
        "url": "/api/v2/version/27/"
      }
    },
    {
      "flavor_text": "While it’s unexpectedly quiet and friendly, if\nit’s not fed any trash for a while, it will\nsmash its Trainer’s furnishings and eat up the\nfragments.",
      "language": {
        "name": "en",
        "url": "/api/v2/language/9/"
      },
      "version": {
        "name": "moon",
        "url": "/api/v2/version/28/"
      }
    },
    {
      "flavor_text": "There are over a hundred kinds of poison inside\nits body. Chemical reactions between different\npoisons are the source of its vitality.",
      "language": {
        "name": "en",
        "url": "/api/v2/language/9/"
      },
      "version": {
        "name": "ultra-sun",
        "url": "/api/v2/version/29/"
      }
    },
    {
      "flavor_text": "What look like fangs and claws are actually\ncrystallized poison that will afflict you at a\nmere touch, so don’t get too close.",
      "language": {
        "name": "en",
        "url": "/api/v2/language/9/"
      },
      "version": {
        "name": "ultra-moon",
        "url": "/api/v2/version/30/"
      }
    },
    {
      "flavor_text": "Muk’s coloration becomes increasingly vivid the\nmore it feasts on its favorite dish—trash.",
