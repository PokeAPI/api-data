  "flavor_text_entries": [
    {
      "flavor_text": "The DNA of a space virus underwent a\nsudden mutation upon exposure to a\nlaser beam and resulted in DEOXYS.\fThe crystalline organ on this POKéMON’s\nchest appears to be its brain.",
      "language": {
        "name": "en",
        "url": "/api/v2/language/9/"
      },
      "version": {
        "name": "ruby",
        "url": "/api/v2/version/7/"
      }
    },
    {
      "flavor_text": "DEOXYS emerged from a virus that came\nfrom space. It is highly intelligent and\nwields psychokinetic powers.\fThis POKéMON shoots lasers from the\ncrystalline organ on its chest.",
      "language": {
        "name": "en",
        "url": "/api/v2/language/9/"
      },
