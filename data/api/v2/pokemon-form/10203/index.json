  "flavor_text_entries": [
    {
      "flavor_text": "It lives on snowy mountains. Its steel shell is\nvery hard—so much so, it can’t roll its body up\ninto a ball.",
      "language": {
        "name": "en",
        "url": "/api/v2/language/9/"
      },
      "version": {
        "name": "sun",
        "url": "/api/v2/version/27/"
      }
    },
    {
      "flavor_text": "An ancient tradition of Alolan festivals, still\ncarried on to this day, is a competition to\nslide Sandshrew across ice as far as one can.",
      "language": {
        "name": "en",
        "url": "/api/v2/language/9/"
      },
      "version": {
        "name": "moon",
        "url": "/api/v2/version/28/"
      }
    },
    {
      "flavor_text": "After fleeing a volcanic eruption, it ended up\nmoving to an area of snowy mountains. Its ice\nshell is as hard as steel.",
      "language": {
        "name": "en",
        "url": "/api/v2/language/9/"
      },
      "version": {
        "name": "ultra-sun",
        "url": "/api/v2/version/29/"
      }
    },
    {
      "flavor_text": "The skin on its back is as hard as steel.\nPredators go after its soft belly, so it clings\nto the ground desperately.",
      "language": {
        "name": "en",
        "url": "/api/v2/language/9/"
      },
      "version": {
        "name": "ultra-moon",
        "url": "/api/v2/version/30/"
      }
    },
    {
      "flavor_text": "Its ice-covered body lets it slide across the\nground with bullet-like speed, sending its\nenemies flying when it hits them.",
      "language": {
        "name": "en",
        "url": "/api/v2/language/9/"
      },
      "version": {
        "name": "lets-go-pikachu",
        "url": "/api/v2/version/31/"
      }
    },
    {
