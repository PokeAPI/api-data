  "flavor_text_entries": [
    {
      "flavor_text": "This Pokémon was not originally found in Alola.\nHuman actions caused a surge in their numbers,\nand they went feral. They’re prideful and\ncrafty.",
      "language": {
        "name": "en",
        "url": "/api/v2/language/9/"
      },
      "version": {
        "name": "sun",
        "url": "/api/v2/version/27/"
      }
    },
    {
      "flavor_text": "When its delicate pride is wounded, or when the\ngold coin on its forehead is dirtied, it flies\ninto a hysterical rage.",
      "language": {
        "name": "en",
        "url": "/api/v2/language/9/"
      },
      "version": {
        "name": "moon",
        "url": "/api/v2/version/28/"
      }
    },
    {
      "flavor_text": "It’s impulsive, selfish, and fickle. It’s very\npopular with some Trainers who like giving it\nthe attention it needs.",
      "language": {
        "name": "en",
        "url": "/api/v2/language/9/"
      },
      "version": {
        "name": "ultra-sun",
        "url": "/api/v2/version/29/"
      }
    },
    {
      "flavor_text": "A royal house that flourished in the distant\npast brought it here from another region. Meowth\nis both selfish and prideful.",
      "language": {
        "name": "en",
        "url": "/api/v2/language/9/"
      },
      "version": {
        "name": "ultra-moon",
        "url": "/api/v2/version/30/"
      }
    },
    {
      "flavor_text": "Highly intelligent and prideful, it’s famously\ndifficult to handle—but that’s also a reason for\nits popularity.",
      "language": {
        "name": "en",
        "url": "/api/v2/language/9/"
      },
      "version": {
        "name": "lets-go-pikachu",
        "url": "/api/v2/version/31/"
      }
    },
    {
      "flavor_text": "Highly intelligent and prideful, it’s famously\ndifficult to handle—but that’s also a reason for\nits popularity.",
      "language": {
