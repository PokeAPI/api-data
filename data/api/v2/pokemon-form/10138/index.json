  "flavor_text_entries": [
    {
      "flavor_text": "Gengar’s relationships are warped. It has no\ninterest in opponents unless it perceives them\nas prey.",
      "language": {
        "name": "en",
        "url": "/api/v2/language/9/"
      },
      "version": {
        "name": "sun",
        "url": "/api/v2/version/27/"
      }
    },
    {
      "flavor_text": "The energy of Mega Evolution awakened it. It\nsinks into another dimension, where it keeps a\npatient watch for its chance to attack.",
      "language": {
        "name": "en",
        "url": "/api/v2/language/9/"
      },
      "version": {
        "name": "moon",
        "url": "/api/v2/version/28/"
      }
    },
    {
      "flavor_text": "It tries to take the lives of anyone and\neveryone. It will even try to curse the Trainer\nwho is its master!",
      "language": {
        "name": "en",
        "url": "/api/v2/language/9/"
      },
      "version": {
        "name": "ultra-sun",
        "url": "/api/v2/version/29/"
      }
    },
    {
      "flavor_text": "Mega Evolution has made it possible for Gengar\nto access other dimensions. Its entire body is\nbrimming with strange power.",
      "language": {
        "name": "en",
        "url": "/api/v2/language/9/"
      },
      "version": {
        "name": "ultra-moon",
        "url": "/api/v2/version/30/"
      }
    },
    {
      "flavor_text": "It can pass through other dimensions and appear\nanywhere. It caused a stir one time when it\nstuck just one leg out of a wall.",
      "language": {
        "name": "en",
        "url": "/api/v2/language/9/"
      },
      "version": {
        "name": "lets-go-pikachu",
        "url": "/api/v2/version/31/"
      }
    },
    {
