  "flavor_text_entries": [
    {
      "flavor_text": "Its round face and smooth coat—softer than the\nmost high-class velvet—have made this a very\npopular Pokémon in Alola.",
      "language": {
        "name": "en",
        "url": "/api/v2/language/9/"
