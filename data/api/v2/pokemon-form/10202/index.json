  "flavor_text_entries": [
    {
      "flavor_text": "It only evolves to this form in the Alola\nregion. According to researchers, its diet is\none of the causes of this change.",
      "language": {
        "name": "en",
        "url": "/api/v2/language/9/"
      },
      "version": {
        "name": "sun",
        "url": "/api/v2/version/27/"
      }
    },
    {
      "flavor_text": "It uses psychokinesis to control electricity. It\nhops aboard its own tail, using psychic power to\nlift the tail and move about while riding it.",
      "language": {
        "name": "en",
        "url": "/api/v2/language/9/"
      },
      "version": {
        "name": "moon",
        "url": "/api/v2/version/28/"
      }
    },
    {
      "flavor_text": "It focuses psychic energy into its tail and\nrides it like it’s surfing. Another name for\nthis Pokémon is “hodad.”",
      "language": {
        "name": "en",
        "url": "/api/v2/language/9/"
      },
      "version": {
        "name": "ultra-sun",
        "url": "/api/v2/version/29/"
      }
    },
    {
      "flavor_text": "When you rub its cheeks, a sweet fragrance comes\nwafting out. However, you’ll also get a light\nshock!",
      "language": {
        "name": "en",
        "url": "/api/v2/language/9/"
      },
      "version": {
        "name": "ultra-moon",
        "url": "/api/v2/version/30/"
      }
    },
    {
      "flavor_text": "It loves pancakes prepared with a secret Alolan\nrecipe. Some wonder whether that recipe holds\nthe key to this Pokémon’s evolution.",
