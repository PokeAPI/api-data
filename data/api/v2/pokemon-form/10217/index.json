  "flavor_text_entries": [
    {
      "flavor_text": "The bones it possesses were once its mother’s.\nIts mother’s regrets have become like a vengeful\nspirit protecting this Pokémon.",
      "language": {
        "name": "en",
        "url": "/api/v2/language/9/"
      },
      "version": {
        "name": "sun",
        "url": "/api/v2/version/27/"
      }
    },
    {
      "flavor_text": "Its custom is to mourn its lost companions.\nMounds of dirt by the side of the road mark the\ngraves of the Marowak.",
      "language": {
        "name": "en",
        "url": "/api/v2/language/9/"
      },
      "version": {
        "name": "moon",
        "url": "/api/v2/version/28/"
      }
    },
    {
      "flavor_text": "The rich greenery of the Alola region is hard on\nMarowak. It controls fire to stay alive.",
      "language": {
        "name": "en",
        "url": "/api/v2/language/9/"
      },
      "version": {
        "name": "ultra-sun",
        "url": "/api/v2/version/29/"
      }
    },
    {
      "flavor_text": "When it beats opponents with its bone, the\ncursed flames spread to them. No amount of water\nwill stop those flames from burning.",
      "language": {
        "name": "en",
        "url": "/api/v2/language/9/"
      },
      "version": {
        "name": "ultra-moon",
        "url": "/api/v2/version/30/"
      }
    },
    {
      "flavor_text": "It has transformed the spirit of its dear\ndeparted mother into flames, and tonight it will\nonce again dance in mourning of others of its\nkind.",
      "language": {
        "name": "en",
        "url": "/api/v2/language/9/"
      },
