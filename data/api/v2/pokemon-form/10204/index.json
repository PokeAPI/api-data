  "flavor_text_entries": [
    {
      "flavor_text": "Fleeing a volcanic eruption, it settled on a\nsnowy mountain. As it races through the\nsnowfields, it sends up a spray of snow.",
      "language": {
        "name": "en",
        "url": "/api/v2/language/9/"
      },
      "version": {
        "name": "sun",
        "url": "/api/v2/version/27/"
      }
    },
    {
      "flavor_text": "This Pokémon’s steel spikes are sheathed in ice.\nStabs from these spikes cause deep wounds and\nsevere frostbite as well.",
      "language": {
        "name": "en",
        "url": "/api/v2/language/9/"
      },
      "version": {
        "name": "moon",
        "url": "/api/v2/version/28/"
      }
    },
    {
      "flavor_text": "It runs across snow-covered plains at high\nspeeds. It developed thick, sharp claws to plow\nthrough the snow.",
      "language": {
        "name": "en",
        "url": "/api/v2/language/9/"
      },
      "version": {
        "name": "ultra-sun",
        "url": "/api/v2/version/29/"
      }
    },
    {
      "flavor_text": "A long, long time ago, it lived in the desert.\nWith its sharp claws fully extended, it can\nclimb right up an iceberg without slipping.",
      "language": {
        "name": "en",
        "url": "/api/v2/language/9/"
      },
      "version": {
        "name": "ultra-moon",
        "url": "/api/v2/version/30/"
      }
    },
    {
      "flavor_text": "This is Sandslash’s form after adaptation to a\nfrigid environment. The cold air emitted by its\nbody sharpens its icy spikes.",
      "language": {
