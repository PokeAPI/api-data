  "flavor_text_entries": [
    {
      "flavor_text": "Mega Kangaskhan’s strength derives from the\nmother’s happiness about her child’s growth.\nWatching it grow up keeps her spirits high.",
      "language": {
        "name": "en",
        "url": "/api/v2/language/9/"
      },
      "version": {
        "name": "sun",
        "url": "/api/v2/version/27/"
      }
    },
    {
      "flavor_text": "Thanks to Mega Evolution, its child grows. But\nas the child is good only at fighting and\nnothing else, its mother feels uneasy about its\nfuture.",
      "language": {
        "name": "en",
        "url": "/api/v2/language/9/"
      },
      "version": {
        "name": "moon",
        "url": "/api/v2/version/28/"
      }
    },
    {
      "flavor_text": "The explosive energy the child is bathed in\ncauses temporary growth. The mother is beside\nherself with worry about it.",
      "language": {
        "name": "en",
        "url": "/api/v2/language/9/"
      },
      "version": {
        "name": "ultra-sun",
        "url": "/api/v2/version/29/"
      }
    },
    {
      "flavor_text": "When the mother sees the back of her\nMega-Evolved child, it makes her think of the\nday when her child will inevitably leave her.",
      "language": {
        "name": "en",
        "url": "/api/v2/language/9/"
      },
      "version": {
        "name": "ultra-moon",
        "url": "/api/v2/version/30/"
      }
    },
    {
      "flavor_text": "Its child has grown rapidly, thanks to the\nenergy of Mega Evolution. Mother and child show\noff their harmonious teamwork in battle.",
      "language": {
        "name": "en",
        "url": "/api/v2/language/9/"
      },
      "version": {
        "name": "lets-go-pikachu",
        "url": "/api/v2/version/31/"
      }
    },
    {
