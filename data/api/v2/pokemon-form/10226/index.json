  "flavor_text_entries": [
    {
      "flavor_text": "This Oricorio relaxes by swaying gently. This\nincreases its psychic energy, which it then\nfires at its enemies.",
      "language": {
        "name": "en",
        "url": "/api/v2/language/9/"
      },
      "version": {
        "name": "sun",
        "url": "/api/v2/version/27/"
      }
    },
    {
      "flavor_text": "This Oricorio has sipped pink nectar. Its\nenemies’ hearts melt at the sight of its gently\nswaying hips.",
      "language": {
        "name": "en",
        "url": "/api/v2/language/9/"
      },
      "version": {
        "name": "moon",
        "url": "/api/v2/version/28/"
      }
    },
    {
      "flavor_text": "It relaxes its opponents with its elegant\ndancing. When they let their guard down, it\nshowers them with psychic energy.",
      "language": {
        "name": "en",
        "url": "/api/v2/language/9/"
      },
      "version": {
        "name": "ultra-sun",
        "url": "/api/v2/version/29/"
      }
    },
    {
      "flavor_text": "This Oricorio has sipped pink nectar. It gets so\ncaught up in its dancing that it sometimes\ndoesn’t hear its Trainer’s orders.",
      "language": {
        "name": "en",
        "url": "/api/v2/language/9/"
      },
      "version": {
        "name": "ultra-moon",
        "url": "/api/v2/version/30/"
      }
    }
  ]
