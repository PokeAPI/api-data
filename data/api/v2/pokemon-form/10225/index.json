  "flavor_text_entries": [
    {
      "flavor_text": "This Oricorio has sipped bright yellow nectar.\nIts bright, cheerful dance melts the hearts of\nits enemies.",
      "language": {
        "name": "en",
        "url": "/api/v2/language/9/"
      },
      "version": {
        "name": "sun",
        "url": "/api/v2/version/27/"
      }
    },
    {
      "flavor_text": "It creates an electric charge by rubbing its\nfeathers together. It dances over to its enemies\nand delivers shocking electrical punches.",
      "language": {
        "name": "en",
        "url": "/api/v2/language/9/"
      },
      "version": {
        "name": "moon",
        "url": "/api/v2/version/28/"
      }
    },
    {
      "flavor_text": "It lifts its opponents’ spirits with its\ncheerful dance moves. When they let their guard\ndown, it electrocutes them with a jolt.",
      "language": {
        "name": "en",
        "url": "/api/v2/language/9/"
      },
      "version": {
        "name": "ultra-sun",
        "url": "/api/v2/version/29/"
      }
    },
    {
      "flavor_text": "This Oricorio has drunk bright yellow nectar.\nWhen it sees someone looking glum, it will try\nto cheer them up with a dance.",
      "language": {
        "name": "en",
        "url": "/api/v2/language/9/"
      },
      "version": {
        "name": "ultra-moon",
        "url": "/api/v2/version/30/"
      }
    }
  ]
