  "flavor_text_entries": [
    {
      "flavor_text": "Black streaks all over its body show where its\nauras and the energy of Mega Evolution\nintermingled and raced through it.",
      "language": {
        "name": "en",
        "url": "/api/v2/language/9/"
      },
      "version": {
        "name": "sun",
        "url": "/api/v2/version/27/"
      }
    },
    {
      "flavor_text": "It readies itself to face its enemies by\nfocusing its mental energies. Its fighting style\ncan be summed up in a single word: heartless.",
      "language": {
        "name": "en",
        "url": "/api/v2/language/9/"
      },
      "version": {
        "name": "moon",
        "url": "/api/v2/version/28/"
      }
    },
    {
      "flavor_text": "Its aura has expanded due to Mega Evolution.\nGoverned only by its combative instincts, it\nstrikes enemies without mercy.",
      "language": {
        "name": "en",
        "url": "/api/v2/language/9/"
      },
      "version": {
        "name": "ultra-sun",
        "url": "/api/v2/version/29/"
      }
    },
    {
      "flavor_text": "Bathed in explosive energy, its combative\ninstincts have awakened. For its enemies, it has\nno mercy whatsoever.",
      "language": {
        "name": "en",
        "url": "/api/v2/language/9/"
      },
      "version": {
        "name": "ultra-moon",
        "url": "/api/v2/version/30/"
      }
    }
  ]
