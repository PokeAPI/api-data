  "flavor_text_entries": [
    {
      "flavor_text": "Alola is the best environment for this Pokémon.\nLocal people take pride in its appearance,\nsaying this is how Exeggutor ought to look.",
      "language": {
        "name": "en",
        "url": "/api/v2/language/9/"
      },
      "version": {
        "name": "sun",
        "url": "/api/v2/version/27/"
      }
    },
    {
      "flavor_text": "As it grew taller and taller, it outgrew its\nreliance on psychic powers, while within it\nawakened the power of the sleeping dragon.",
      "language": {
        "name": "en",
        "url": "/api/v2/language/9/"
      },
      "version": {
        "name": "moon",
        "url": "/api/v2/version/28/"
      }
    },
    {
      "flavor_text": "Exeggutor is the pride of the Alolan people. Its\nimage is carved into historical buildings and\nmurals.",
      "language": {
        "name": "en",
        "url": "/api/v2/language/9/"
      },
      "version": {
        "name": "ultra-sun",
        "url": "/api/v2/version/29/"
      }
    },
    {
      "flavor_text": "It swings its long neck like a whip and smacks\nits opponents. This makes Exeggutor itself\ndizzy, too.",
      "language": {
        "name": "en",
        "url": "/api/v2/language/9/"
      },
      "version": {
        "name": "ultra-moon",
        "url": "/api/v2/version/30/"
      }
    },
    {
      "flavor_text": "The strong sunlight of the Alola region has\nawakened the power hidden within Exeggcute. This\nis the result.",
      "language": {
        "name": "en",
        "url": "/api/v2/language/9/"
      },
      "version": {
        "name": "lets-go-pikachu",
        "url": "/api/v2/version/31/"
      }
    },
