  "flavor_text_entries": [
    {
      "flavor_text": "It exhales air colder than -58 degrees\nFahrenheit. Elderly people in Alola call this\nPokémon by an older name—Keokeo.",
      "language": {
        "name": "en",
        "url": "/api/v2/language/9/"
      },
      "version": {
        "name": "sun",
        "url": "/api/v2/version/27/"
      }
    },
    {
      "flavor_text": "In hot weather, this Pokémon makes ice shards\nwith its six tails and sprays them around to\ncool itself off.",
      "language": {
        "name": "en",
        "url": "/api/v2/language/9/"
      },
      "version": {
        "name": "moon",
        "url": "/api/v2/version/28/"
      }
    },
    {
      "flavor_text": "If you carelessly approach it because it’s cute,\nthe boss of the pack, Ninetales, will appear and\nfreeze you.",
      "language": {
        "name": "en",
        "url": "/api/v2/language/9/"
      },
      "version": {
        "name": "ultra-sun",
        "url": "/api/v2/version/29/"
      }
    },
    {
      "flavor_text": "They live together in a skulk, helping one\nanother. Before eating their prey, they freeze\nit solid with their -58 degree Fahrenheit\nbreath.",
      "language": {
        "name": "en",
        "url": "/api/v2/language/9/"
      },
      "version": {
        "name": "ultra-moon",
        "url": "/api/v2/version/30/"
      }
    },
    {
      "flavor_text": "It looks like snow come to life, and the breath\nit exhales is -58 degrees Fahrenheit. Another\nname for it is Keokeo.",
      "language": {
