  "flavor_text_entries": [
    {
      "flavor_text": "This Oricorio has sipped purple nectar. Its\nelegant, attractive dance will send the minds\nand hearts of its enemies to another world.",
      "language": {
        "name": "en",
        "url": "/api/v2/language/9/"
      },
      "version": {
        "name": "sun",
        "url": "/api/v2/version/27/"
      }
    },
    {
      "flavor_text": "It summons the dead with its dreamy dancing.\nFrom their malice, it draws power with which to\ncurse its enemies.",
      "language": {
        "name": "en",
        "url": "/api/v2/language/9/"
      },
      "version": {
        "name": "moon",
        "url": "/api/v2/version/28/"
      }
    },
    {
      "flavor_text": "It charms its opponents with its refined\ndancing. When they let their guard down, it\nplaces a curse on them that will bring on their\ndemise.",
      "language": {
        "name": "en",
        "url": "/api/v2/language/9/"
      },
      "version": {
        "name": "ultra-sun",
        "url": "/api/v2/version/29/"
      }
    },
    {
      "flavor_text": "This Oricorio has sipped purple nectar. Some\ndancers use its graceful, elegant dancing as\ninspiration.",
      "language": {
        "name": "en",
        "url": "/api/v2/language/9/"
      },
      "version": {
        "name": "ultra-moon",
        "url": "/api/v2/version/30/"
      }
    }
  ]
