  "flavor_text_entries": [
    {
      "flavor_text": "Part of its body has become stone. Some scholars\nclaim that this is Aerodactyl’s true appearance.",
      "language": {
        "name": "en",
        "url": "/api/v2/language/9/"
      },
      "version": {
        "name": "sun",
        "url": "/api/v2/version/27/"
      }
    },
    {
      "flavor_text": "When it Mega Evolves, it becomes more vicious\nthan ever before. Some say that’s because its\nexcess of power is causing it pain.",
      "language": {
        "name": "en",
        "url": "/api/v2/language/9/"
      },
      "version": {
        "name": "moon",
        "url": "/api/v2/version/28/"
      }
    },
    {
      "flavor_text": "It will attack anything that moves. Mega\nEvolution is a burden on its body, so it’s\nincredibly irritated.",
      "language": {
        "name": "en",
        "url": "/api/v2/language/9/"
      },
      "version": {
        "name": "ultra-sun",
        "url": "/api/v2/version/29/"
      }
    },
    {
      "flavor_text": "Mega Evolution awakened some dormant genes,\nbringing back the sharp rocks that once covered\nAerodactyl’s entire body.",
      "language": {
        "name": "en",
        "url": "/api/v2/language/9/"
      },
      "version": {
        "name": "ultra-moon",
        "url": "/api/v2/version/30/"
      }
    },
    {
      "flavor_text": "The power of Mega Evolution has completely\nrestored its genes. The rocks on its body are\nharder than diamond.",
      "language": {
        "name": "en",
        "url": "/api/v2/language/9/"
      },
