  "flavor_text_entries": [
    {
      "flavor_text": "Its head sports an altered form of whiskers made\nof metal. When in communication with its\ncomrades, its whiskers wobble to and fro.",
      "language": {
        "name": "en",
        "url": "/api/v2/language/9/"
      },
      "version": {
        "name": "sun",
        "url": "/api/v2/version/27/"
      }
    },
    {
      "flavor_text": "Its golden hairs function as sensors. It pokes\nthem out of its burrow to monitor its\nsurroundings.",
      "language": {
        "name": "en",
        "url": "/api/v2/language/9/"
      },
      "version": {
        "name": "moon",
        "url": "/api/v2/version/28/"
      }
    },
    {
      "flavor_text": "Although it’s powerful enough to dig right\nthrough volcanic rock, it doesn’t allow itself\nto be seen very often.",
      "language": {
        "name": "en",
        "url": "/api/v2/language/9/"
      },
      "version": {
        "name": "ultra-sun",
        "url": "/api/v2/version/29/"
      }
    },
    {
      "flavor_text": "The need to dig through volcanic rock in the\nground has made them more powerful than the\nDiglett of other regions.",
      "language": {
        "name": "en",
        "url": "/api/v2/language/9/"
      },
      "version": {
        "name": "ultra-moon",
        "url": "/api/v2/version/30/"
      }
    },
    {
      "flavor_text": "After living in soil with high iron content for\nsome time, three steel whiskers sprouted from\nthe top of its head.",
