  "flavor_text_entries": [
    {
      "flavor_text": "All the energy from Mega Evolution poured into\nthe Shellder on its tail, leaving Slowpoke to be\nswallowed whole.",
      "language": {
        "name": "en",
        "url": "/api/v2/language/9/"
      },
      "version": {
        "name": "sun",
        "url": "/api/v2/version/27/"
      }
    },
    {
      "flavor_text": "When bathed in the energy of Mega Evolution,\nShellder converts into impregnable armor. There\nis virtually no change in Slowpoke.",
      "language": {
        "name": "en",
        "url": "/api/v2/language/9/"
      },
      "version": {
        "name": "moon",
        "url": "/api/v2/version/28/"
      }
    },
    {
      "flavor_text": "Tremendous energy strengthened the power of the\nShellder on its tail, but it doesn’t really\naffect Slowpoke.",
      "language": {
        "name": "en",
        "url": "/api/v2/language/9/"
      },
      "version": {
        "name": "ultra-sun",
        "url": "/api/v2/version/29/"
      }
    },
    {
      "flavor_text": "Having been swallowed whole by Shellder, Slowbro\nnow has an iron defense. It’s pretty comfortable\nin there, too.",
      "language": {
        "name": "en",
        "url": "/api/v2/language/9/"
      },
      "version": {
        "name": "ultra-moon",
        "url": "/api/v2/version/30/"
      }
    },
    {
      "flavor_text": "Under the influence of Shellder’s digestive\nfluids, Slowpoke has awakened, gaining a great\ndeal of power—and a little motivation to boot.",
      "language": {
        "name": "en",
        "url": "/api/v2/language/9/"
      },
      "version": {
        "name": "lets-go-pikachu",
        "url": "/api/v2/version/31/"
      }
    },
    {
