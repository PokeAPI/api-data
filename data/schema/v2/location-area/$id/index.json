{
  "$schema": "http://json-schema.org/schema#",
  "type": "object",
  "properties": {
    "id": {
      "type": "integer"
    },
    "name": {
      "type": "string"
    },
    "game_index": {
      "type": "integer"
    },
    "encounter_method_rates": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "encounter_method": {
            "$ref": "/schema/v2/named_api_resource.json"
          },
          "version_details": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "rate": {
                  "type": "integer"
                },
                "version": {
                  "$ref": "/schema/v2/named_api_resource.json"
                }
              },
              "required": [
                "rate",
                "version"
              ]
            }
          }
        },
        "required": [
          "encounter_method",
          "version_details"
        ]
      }
    },
    "location": {
      "$ref": "/schema/v2/named_api_resource.json"
    },
    "names": {
      "type": "array",
      "items": {
        "$ref": "/schema/v2/name.json"
      }
    },
    "pokemon_encounters": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "pokemon": {
            "$ref": "/schema/v2/named_api_resource.json"
          },
          "version_details": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "version": {
                  "$ref": "/schema/v2/named_api_resource.json"
                },
                "max_chance": {
                  "type": "integer"
                },
                "encounter_details": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "min_level": {
                        "type": "integer"
                      },
                      "max_level": {
                        "type": "integer"
                      },
                      "chance": {
                        "type": "integer"
                      },
                      "method": {
                        "$ref": "/schema/v2/named_api_resource.json"
                      },
                      "condition_values": {
                        "type": "array",
                        "items": {
                          "$ref": "/schema/v2/named_api_resource.json"
                        }
                      },
                      "pokemon_details": {
                        "anyOf": [
                          {
                            "type": "null"
                          },
                          {
                            "type": "object",
                            "properties": {
                              "min_perfect_ivs": {
                                "type": "null"
                              },
                              "always_shiny": {
                                "type": "boolean"
                              },
                              "never_shiny": {
                                "type": "boolean"
                              },
                              "is_alpha": {
                                "type": "boolean"
                              }
                            },
                            "required": [
                              "always_shiny",
                              "is_alpha",
                              "min_perfect_ivs",
                              "never_shiny"
                            ]
                          }
                        ]
                      }
                    },
                    "required": [
                      "chance",
                      "condition_values",
                      "max_level",
                      "method",
                      "min_level",
                      "pokemon_details"
                    ]
                  }
                }
              },
              "required": [
                "encounter_details",
                "max_chance",
                "version"
              ]
            }
          }
        },
        "required": [
          "pokemon",
          "version_details"
        ]
      }
    }
  },
  "required": [
    "encounter_method_rates",
    "game_index",
    "id",
    "location",
    "name",
    "names",
    "pokemon_encounters"
  ]
}