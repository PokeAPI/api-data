{
  "$schema": "http://json-schema.org/schema#",
  "type": "object",
  "properties": {
    "id": {
      "type": "integer"
    },
    "appeal": {
      "type": "integer"
    },
    "jam": {
      "type": "integer"
    },
    "effect_entries": {
      "type": "array",
      "items": {
        "$ref": "/schema/v2/effect.json"
      }
    },
    "flavor_text_entries": {
      "type": "array",
      "items": {
        "$ref": "/schema/v2/flavor_text.json"
      }
    }
  },
  "required": [
    "appeal",
    "effect_entries",
    "flavor_text_entries",
    "id",
    "jam"
  ]
}