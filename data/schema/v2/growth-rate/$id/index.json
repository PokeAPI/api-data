{
  "$schema": "http://json-schema.org/schema#",
  "type": "object",
  "properties": {
    "id": {
      "type": "integer"
    },
    "name": {
      "type": "string"
    },
    "formula": {
      "type": "string"
    },
    "descriptions": {
      "type": "array",
      "items": {
        "$ref": "/schema/v2/description.json"
      }
    },
    "levels": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "level": {
            "type": "integer"
          },
          "experience": {
            "type": "integer"
          }
        },
        "required": [
          "experience",
          "level"
        ]
      }
    },
    "pokemon_species": {
      "type": "array",
      "items": {
        "$ref": "/schema/v2/named_api_resource.json"
      }
    }
  },
  "required": [
    "descriptions",
    "formula",
    "id",
    "levels",
    "name",
    "pokemon_species"
  ]
}