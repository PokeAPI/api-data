    "name": {
      "type": "string"
    },
    "locations": {
      "type": "array",
      "items": {
        "$ref": "/schema/v2/named_api_resource.json"
      }
    },
    "main_generation": {
      "anyOf": [
        {
          "type": "null"
        },
