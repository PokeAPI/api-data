      "type": "integer"
    },
    "appeal": {
      "type": "integer"
    },
    "flavor_text_entries": {
      "type": "array",
      "items": {
        "$ref": "/schema/v2/flavor_text.json"
      }
    },
    "moves": {
      "type": "array",
      "items": {
        "$ref": "/schema/v2/named_api_resource.json"
      }
