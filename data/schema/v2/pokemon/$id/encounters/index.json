{
  "$schema": "http://json-schema.org/schema#",
  "type": "array",
  "items": {
    "type": "object",
    "properties": {
      "location_area": {
        "$ref": "/schema/v2/named_api_resource.json"
      },
      "version_details": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "version": {
              "$ref": "/schema/v2/named_api_resource.json"
            },
            "max_chance": {
              "type": "integer"
            },
            "encounter_details": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "min_level": {
                    "type": "integer"
                  },
                  "max_level": {
                    "type": "integer"
                  },
                  "chance": {
                    "type": "integer"
                  },
                  "method": {
                    "$ref": "/schema/v2/named_api_resource.json"
                  },
                  "condition_values": {
                    "type": "array",
                    "items": {
                      "$ref": "/schema/v2/named_api_resource.json"
                    }
                  },
                  "pokemon_details": {
                    "anyOf": [
                      {
                        "type": "null"
                      },
                      {
                        "type": "object",
                        "properties": {
                          "min_perfect_ivs": {
                            "type": "null"
                          },
                          "always_shiny": {
                            "type": "boolean"
                          },
                          "never_shiny": {
                            "type": "boolean"
                          },
                          "is_alpha": {
                            "type": "boolean"
                          }
                        },
                        "required": [
                          "always_shiny",
                          "is_alpha",
                          "min_perfect_ivs",
                          "never_shiny"
                        ]
                      }
                    ]
                  }
                },
                "required": [
                  "chance",
                  "condition_values",
                  "max_level",
                  "method",
                  "min_level",
                  "pokemon_details"
                ]
              }
            }
          },
          "required": [
            "encounter_details",
            "max_chance",
            "version"
          ]
        }
      }
    },
    "required": [
      "location_area",
      "version_details"
    ]
  }
}