{
  "$schema": "http://json-schema.org/schema#",
  "type": "object",
  "properties": {
    "id": {
      "type": "integer"
    },
    "name": {
      "type": "string"
    },
    "growth_time": {
      "type": [
        "integer",
        "null"
      ]
    },
    "max_harvest": {
      "type": [
        "integer",
        "null"
      ]
    },
    "natural_gift_power": {
      "type": [
        "integer",
        "null"
      ]
    },
    "size": {
      "type": [
        "integer",
        "null"
      ]
    },
    "smoothness": {
      "type": [
        "integer",
        "null"
      ]
    },
    "soil_dryness": {
      "type": [
        "integer",
        "null"
      ]
    },
    "firmness": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "$ref": "/schema/v2/named_api_resource.json"
        }
      ]
    },
    "flavors": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "potency": {
            "type": "integer"
          },
          "flavor": {
            "$ref": "/schema/v2/named_api_resource.json"
          }
        },
        "required": [
          "flavor",
          "potency"
        ]
      }
    },
    "item": {
      "$ref": "/schema/v2/named_api_resource.json"
    },
    "natural_gift_type": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "$ref": "/schema/v2/named_api_resource.json"
        }
      ]
    }
  },
  "required": [
    "firmness",
    "flavors",
    "growth_time",
    "id",
    "item",
    "max_harvest",
    "name",
    "natural_gift_power",
    "natural_gift_type",
    "size",
    "smoothness",
    "soil_dryness"
  ]
}