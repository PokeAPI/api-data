{
  "$schema": "http://json-schema.org/schema#",
  "type": "object",
  "properties": {
    "id": {
      "type": "integer"
    },
    "name": {
      "type": "string"
    },
    "berries": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "potency": {
            "type": "integer"
          },
          "berry": {
            "$ref": "/schema/v2/named_api_resource.json"
          }
        },
        "required": [
          "berry",
          "potency"
        ]
      }
    },
    "contest_type": {
      "$ref": "/schema/v2/named_api_resource.json"
    },
    "names": {
      "type": "array",
      "items": {
        "$ref": "/schema/v2/name.json"
      }
    }
  },
  "required": [
    "berries",
    "contest_type",
    "id",
    "name",
    "names"
  ]
}