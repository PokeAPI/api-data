{
  "$schema": "http://json-schema.org/schema#",
  "type": "object",
  "properties": {
    "id": {
      "type": "integer"
    },
    "name": {
      "type": "string"
    },
    "awesome_names": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "awesome_name": {
            "type": "string"
          },
          "language": {
            "$ref": "/schema/v2/named_api_resource.json"
          }
        },
        "required": [
          "awesome_name",
          "language"
        ]
      }
    },
    "names": {
      "type": "array",
      "items": {
        "$ref": "/schema/v2/name.json"
      }
    },
    "pokemon_species": {
      "type": "array",
      "items": {
        "$ref": "/schema/v2/named_api_resource.json"
      }
    }
  },
  "required": [
    "awesome_names",
    "id",
    "name",
    "names",
    "pokemon_species"
  ]
}