{
  "$schema": "http://json-schema.org/schema#",
  "type": "object",
  "properties": {
    "id": {
      "type": "integer"
    },
    "name": {
      "type": "string"
    },
    "fling_power": {
      "type": [
        "integer",
        "null"
      ]
    },
    "fling_effect": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "$ref": "/schema/v2/named_api_resource.json"
        }
      ]
    },
    "attributes": {
      "type": "array",
      "items": {
        "$ref": "/schema/v2/named_api_resource.json"
      }
    },
    "category": {
      "$ref": "/schema/v2/named_api_resource.json"
    },
    "effect_entries": {
      "type": "array",
      "items": {
        "$ref": "/schema/v2/verbose_effect.json"
      }
    },
    "flavor_text_entries": {
      "type": "array",
      "items": {
        "$ref": "/schema/v2/version_group_flavor_text.json"
      }
    },
    "game_indices": {
      "type": "array",
      "items": {
        "$ref": "/schema/v2/generation_game_index.json"
      }
    },
    "prices": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "purchase_price": {
            "type": [
              "integer",
              "null"
            ]
          },
          "sell_price": {
            "type": [
              "integer",
              "null"
            ]
          },
          "currency": {
            "$ref": "/schema/v2/named_api_resource.json"
          },
          "version_group": {
            "$ref": "/schema/v2/named_api_resource.json"
          }
        },
        "required": [
          "currency",
          "purchase_price",
          "sell_price",
          "version_group"
        ]
      }
    },
    "names": {
      "type": "array",
      "items": {
        "$ref": "/schema/v2/name.json"
      }
    },
    "held_by_pokemon": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "pokemon": {
            "$ref": "/schema/v2/named_api_resource.json"
          },
          "version_details": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "rarity": {
                  "type": "integer"
                },
                "version": {
                  "$ref": "/schema/v2/named_api_resource.json"
                }
              },
              "required": [
                "rarity",
                "version"
              ]
            }
          }
        },
        "required": [
          "pokemon",
          "version_details"
        ]
      }
    },
    "sprites": {
      "type": "object",
      "properties": {
        "default": {
          "type": [
            "null",
            "string"
          ]
        }
      },
      "required": [
        "default"
      ]
    },
    "baby_trigger_for": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "$ref": "/schema/v2/api_resource.json"
        }
      ]
    },
    "machines": {
      "type": "array",
      "items": {
        "$ref": "/schema/v2/machine_version_detail.json"
      }
    }
  },
  "required": [
    "attributes",
    "baby_trigger_for",
    "category",
    "effect_entries",
    "flavor_text_entries",
    "fling_effect",
    "fling_power",
    "game_indices",
    "held_by_pokemon",
    "id",
    "machines",
    "name",
    "names",
    "prices",
    "sprites"
  ]
}